// Q.0 ABI PROBE ONLY.  No QSAM datasets are opened.
GLOBAL $( START:1; STOP:30; DEBUGINT:150; QSAMSVC:200 $)
MANIFEST $( QS_QUERY=0; QS_INFO=5; QS_ERR_OPCODE=-2;
           QS_ERR_CAPACITY=-1 $)

LET START() BE
$(1
    LET REQ = VEC 3
    LET OUT = VEC 7
    LET CAP = VEC 5
    LET RC = 0

    REQ!0 := 17
    REQ!1 := 25
    REQ!2 := 0
    REQ!3 := 0
    RC := QSAMSVC(QS_INFO, REQ, OUT)
    IF RC NE 0 DO STOP(8)
    IF OUT!0 NE 0 DO STOP(8)
    IF OUT!1 NE 42 DO STOP(8)
    IF OUT!7 NE 777 DO STOP(8)
    IF REQ!0 NE 17 | REQ!1 NE 25 DO STOP(8)

    RC := QSAMSVC(QS_QUERY, 0, 0)
    IF RC NE 6 DO STOP(8)
    CAP!0 := 999
    CAP!1 := 999
    RC := QSAMSVC(QS_QUERY, CAP, 2)
    IF RC NE QS_ERR_CAPACITY DO STOP(8)
    IF CAP!0 NE 999 | CAP!1 NE 999 DO STOP(8)

    RC := QSAMSVC(QS_QUERY, CAP, 6)
    IF RC NE 6 DO STOP(8)
    IF CAP!0 NE 1 | CAP!1 NE 1 DO STOP(8)
    IF CAP!2 NE 0 | CAP!3 NE 6 DO STOP(8)
    IF CAP!4 NE 16 | CAP!5 NE 0 DO STOP(8)

    RC := QSAMSVC(99, REQ, OUT)
    IF RC NE QS_ERR_OPCODE DO STOP(8)
    IF OUT!0 NE QS_ERR_OPCODE DO STOP(8)
    IF OUT!1 NE 0 | OUT!7 NE 0 DO STOP(8)

    DEBUGINT(42)
    FINISH
$)1
