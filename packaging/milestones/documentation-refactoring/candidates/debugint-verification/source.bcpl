GLOBAL $( START:1; WRITES:60; WRCH:14; DEBUGINT:150 $)

LET SHOW(S,N) BE
$( WRITES(S)
   DEBUGINT(N)
   WRCH(10)
$)

LET START() BE
$( SHOW("RP: DR5 DEBUGINT ZERO ",0)
   SHOW("RP: DR5 DEBUGINT POS ",42)
   SHOW("RP: DR5 DEBUGINT MAX ",#X7FFFFFFF)
   SHOW("RP: DR5 DEBUGINT NEG1 ",-1)
   SHOW("RP: DR5 DEBUGINT NEG42 ",-42)
   SHOW("RP: DR5 DEBUGINT MIN ",#X80000000)
   FINISH
$)
