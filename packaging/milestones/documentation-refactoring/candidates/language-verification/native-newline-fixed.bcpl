GLOBAL $( START:1; SELECTINPUT:11; RDCH:13; WRCH:14
          STOP:30; FINDINPUT:42; WRITES:60; NEWLINE:63
          WRITEF:76; GETBYTE:85 $)

LET START() BE
$( LET S = FINDINPUT("BCPIN")
   UNLESS S NE 0 DO STOP(16)
   SELECTINPUT(S)
   WRITEF("RP: DR5 NEWLINE %N %N*N", GETBYTE("*N",1), '*N')
   WRITEF("RP: DR5 EBCDIC %N %N*N", GETBYTE("A",1), 'A')
   UNLESS RDCH()='A' DO STOP(20)
   UNLESS RDCH()='*N' DO STOP(21)
   UNLESS RDCH()='B' DO STOP(22)
   UNLESS RDCH()='*N' DO STOP(23)
   UNLESS RDCH()=-1 DO STOP(24)
   WRITES("RP: DR5 INPUT")
   NEWLINE()
   WRITES("RP: DR5 WRITES*N")
   WRITES("RP: DR5 DIRECT")
   WRCH('*N')
   WRITEF("RP: DR5 END*N")
   FINISH
$)
