GLOBAL $( START:1; SELECTINPUT:11; STOP:30; FINDINPUT:42
          ENDREAD:46; READN:70; TERMINATOR:71; WRITEF:76 $)

LET CHECK(I,N,T) BE
$( LET V = READN()
   LET C = TERMINATOR
   WRITEF("RP: DR5 READN %N %N %N*N", I, V, C)
   UNLESS V=N & C=T DO STOP(8)
$)

LET START() BE
$( LET S = FINDINPUT("BCPIN")
   IF S=0 DO STOP(8)
   SELECTINPUT(S)
   CHECK(1,12,',')
   CHECK(2,-34,'*S')
   CHECK(3,0,'*S')
   CHECK(4,0,'X')
   CHECK(5,56,'*N')
   CHECK(6,0,'?')
   CHECK(7,0,'*S')
   CHECK(8,7,'*S')
   CHECK(9,0,'*N')
   CHECK(10,89,'*N')
   CHECK(11,0,-1)
   CHECK(12,0,-1)
   ENDREAD()
   FINISH
$)
