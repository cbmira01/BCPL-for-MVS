GLOBAL $(
  START:1
  WRITES:60
  NEWLINE:63
  GETVEC:87
  FREEVEC:88
  CO1RES:295
  CO1DROP:296
  ROOTCTX:297
  CO1INIT:298
  CHANGECO:299
$)

LET CALLH(V,H) = VALOF
$(1
  LET P=CO1RES(H)
  IF P=0 RESULTIS -1
  RESULTIS CHANGECO(V,P)
$)1

LET WORK1(A) = VALOF
$(1
  LET TOKEN=3101
  AND RETURNED=0
  IF A \=7 RESULTIS 97
  WRITES("CO1BCPL A1")
  NEWLINE()
  RETURNED := CHANGECO(101,ROOTCTX)
  IF RETURNED \=11 | TOKEN \=3101 RESULTIS 98
  RESULTIS 31
$)1

LET WORK2(A) = VALOF
$(1
  LET TOKEN=4202
  AND RETURNED=0
  IF A \=8 RESULTIS 97
  WRITES("CO1BCPL A2")
  NEWLINE()
  RETURNED := CHANGECO(202,ROOTCTX)
  IF RETURNED \=22 | TOKEN \=4202 RESULTIS 98
  RESULTIS 42
$)1

LET START() BE
$(1
  LET ROOT=VEC 23
  AND P1=GETVEC(23)
  AND STACK1=GETVEC(1087)
  AND STACK2=0
  AND OLD=0
  AND NEW=0
  AND A=0
  AND B=0
  AND C=0
  AND D=0
  AND E=0
  AND F=0
  AND ROOTFLAG=2718
  IF P1=0 | STACK1=0 DO
  $(2 WRITES("CO1BCPL FALLOC")
      NEWLINE()
      FINISH
  $)2
  ROOTCTX := ROOT
  OLD := CO1INIT(ROOT,P1,STACK1,WORK1)
  IF OLD\=6 | CO1RES(OLD)\=P1 DO
  $(2 WRITES("CO1BCPL FINIT")
      NEWLINE()
      FINISH
  $)2
  A := CALLH(7,OLD)
  IF A\=101 | ROOTFLAG\=2718 DO
  $(2 WRITES("CO1BCPL FVALUE")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL R1")
  NEWLINE()
  B := CALLH(11,OLD)
  IF B\=31 | P1!0\=3 | ROOTFLAG\=2718 DO
  $(2 WRITES("CO1BCPL FLOCAL")
      NEWLINE()
      FINISH
  $)2
  IF CO1DROP(P1)\=0 | P1!0\=4 | CO1RES(OLD)\=0 DO
  $(2 WRITES("CO1BCPL FLOCAL")
      NEWLINE()
      FINISH
  $)2
  FREEVEC(STACK1)
  STACK2 := GETVEC(1087)
  IF STACK2=0 DO
  $(2 WRITES("CO1BCPL FALLOC")
      NEWLINE()
      FINISH
  $)2
  NEW := CO1INIT(ROOT,P1,STACK2,WORK2)
  IF NEW\=10 | NEW=OLD | CO1RES(NEW)\=P1 DO
  $(2 WRITES("CO1BCPL FINIT")
      NEWLINE()
      FINISH
  $)2
  IF CO1RES(OLD)\=0 | CO1RES(0)\=0 DO
  $(2 WRITES("CO1BCPL FVALUE")
      NEWLINE()
      FINISH
  $)2
  C := CALLH(777,OLD)
  IF C\=-1 | P1!0\=2 | ROOTFLAG\=2718 DO
  $(2 WRITES("CO1BCPL FVALUE")
      NEWLINE()
      FINISH
  $)2
  D := CALLH(8,NEW)
  IF D\=202 | ROOTFLAG\=2718 DO
  $(2 WRITES("CO1BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL R2")
  NEWLINE()
  E := CALLH(22,NEW)
  IF E\=42 | P1!0\=3 | ROOTFLAG\=2718 DO
  $(2 WRITES("CO1BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  F := CO1DROP(P1)
  IF F\=0 | CO1RES(NEW)\=0 | ROOTFLAG\=2718 DO
  $(2 WRITES("CO1BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  FREEVEC(STACK2)
  FREEVEC(P1)
  IF CALLH(888,NEW)\=-1 | CALLH(999,OLD)\=-1 DO
  $(2 WRITES("CO1BCPL FVALUE")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL PASS")
  NEWLINE()
  FINISH
$)1
