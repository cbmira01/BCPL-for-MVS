GLOBAL $(
  START:1
  WRITES:60
  NEWLINE:63
  GETVEC:87
  PEER1:295
  PEER2:296
  ROOTCTX:297
  CO1INIT:298
  CHANGECO:299
$)

LET WORK1(A) = VALOF
$(1
  LET TOKEN=3101
  AND FROMB=0
  AND FROMROOT=0
  IF A \=7 | PEER1!1 \=ROOTCTX RESULTIS 97
  WRITES("CO1BCPL A1")
  NEWLINE()
  FROMB := CHANGECO(17,PEER2)
  IF FROMB \=23 | TOKEN \=3101 RESULTIS 98
  WRITES("CO1BCPL A2")
  NEWLINE()
  FROMROOT := CHANGECO(33,ROOTCTX)
  IF FROMROOT \=44 | TOKEN \=3101 RESULTIS 98
  RESULTIS 31
$)1

LET WORK2(A) = VALOF
$(1
  LET TOKEN=4202
  AND FROMROOT=0
  IF A \=17 | PEER2!1 \=ROOTCTX RESULTIS 97
  WRITES("CO1BCPL R1")
  NEWLINE()
  FROMROOT := CHANGECO(23,PEER1)
  IF FROMROOT \=55 | TOKEN \=4202 RESULTIS 98
  RESULTIS 42
$)1

LET START() BE
$(1
  LET ROOT=VEC 23
  AND P1=VEC 23
  AND P2=VEC 23
  AND STACK1=GETVEC(1087)
  AND STACK2=GETVEC(1087)
  AND A=0
  AND B=0
  AND C=0
  AND ROOTFLAG=2718
  IF STACK1=0 | STACK2=0 | STACK1=STACK2 DO
  $(2 WRITES("CO1BCPL FALLOC")
      NEWLINE()
      FINISH
  $)2
  ROOTCTX := ROOT
  PEER1 := P1
  PEER2 := P2
  IF CO1INIT(ROOT,P1,STACK1,WORK1) \=0 DO
  $(2 WRITES("CO1BCPL FINIT")
      NEWLINE()
      FINISH
  $)2
  IF CO1INIT(ROOT,P2,STACK2,WORK2) \=0 DO
  $(2 WRITES("CO1BCPL FINIT")
      NEWLINE()
      FINISH
  $)2
  A := CHANGECO(7,PEER1)
  IF A \=33 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FVALUE")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL R2")
  NEWLINE()
  B := CHANGECO(55,PEER2)
  IF B \=42 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  C := CHANGECO(44,PEER1)
  IF C \=31 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FLOCAL")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL PASS")
  NEWLINE()
  FINISH
$)1
