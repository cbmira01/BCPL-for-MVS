GLOBAL $(
  START:1
  WRITES:60
  NEWLINE:63
  GETVEC:87
  FREEVEC:88
  CO1DROP:296
  ROOTCTX:297
  CO1INIT:298
  CHANGECO:299
$)

LET WORK1(A) = VALOF
$(1
  LET TOKEN=3101
  AND RETURNED=0
  IF A \=7 RESULTIS 97
  WRITES("CO1BCPL A1")
  NEWLINE()
  RETURNED := CHANGECO(101,ROOTCTX)
  IF RETURNED \=11 | TOKEN \=3101 RESULTIS 98
  RESULTIS 31
$)1

LET WORK2(A) = VALOF
$(1
  LET TOKEN=4202
  AND RETURNED=0
  IF A \=8 RESULTIS 97
  WRITES("CO1BCPL A2")
  NEWLINE()
  RETURNED := CHANGECO(202,ROOTCTX)
  IF RETURNED \=22 | TOKEN \=4202 RESULTIS 98
  RESULTIS 42
$)1

LET START() BE
$(1
  LET ROOT=VEC 23
  AND P1=GETVEC(23)
  AND P2=GETVEC(23)
  AND STACK1=GETVEC(1087)
  AND STACK2=GETVEC(1087)
  AND STALE1=0
  AND STALE2=0
  AND A=0
  AND B=0
  AND C=0
  AND D=0
  AND E=0
  AND F=0
  AND G=0
  AND H=0
  AND I=0
  AND J=0
  AND ROOTFLAG=2718
  IF P1=0 | P2=0 | STACK1=0 | STACK2=0 DO
  $(2 WRITES("CO1BCPL FALLOC")
      NEWLINE()
      FINISH
  $)2
  IF P1=P2 | STACK1=STACK2 DO
  $(2 WRITES("CO1BCPL FALLOC")
      NEWLINE()
      FINISH
  $)2
  ROOTCTX := ROOT
  IF CO1INIT(ROOT,P1,STACK1,WORK1) \=0 DO
  $(2 WRITES("CO1BCPL FINIT")
      NEWLINE()
      FINISH
  $)2
  IF CO1INIT(ROOT,P2,STACK2,WORK2) \=0 DO
  $(2 WRITES("CO1BCPL FINIT")
      NEWLINE()
      FINISH
  $)2
  IF CO1DROP(P2) \=-2 | CO1DROP(ROOT) \=-2 DO
  $(2 WRITES("CO1BCPL FLOCAL")
      NEWLINE()
      FINISH
  $)2
  A := CHANGECO(7,P1)
  IF A \=101 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FVALUE")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL R1")
  NEWLINE()
  B := CHANGECO(8,P2)
  IF B \=202 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL R2")
  NEWLINE()
  IF CO1DROP(P2) \=-2 | CO1DROP(-1) \=-2 DO
  $(2 WRITES("CO1BCPL FLOCAL")
      NEWLINE()
      FINISH
  $)2
  C := CHANGECO(11,P1)
  IF C \=31 | P1!0 \=3 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FLOCAL")
      NEWLINE()
      FINISH
  $)2
  D := CO1DROP(P1)
  IF D \=0 | P1!0 \=4 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FLOCAL")
      NEWLINE()
      FINISH
  $)2
  STALE1 := P1
  FREEVEC(STACK1)
  FREEVEC(P1)
  E := CHANGECO(777,STALE1)
  F := CO1DROP(STALE1)
  IF E \=-1 | F \=-2 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FVALUE")
      NEWLINE()
      FINISH
  $)2
  G := CHANGECO(22,P2)
  IF G \=42 | P2!0 \=3 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  H := CO1DROP(P2)
  IF H \=0 | P2!0 \=4 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  STALE2 := P2
  FREEVEC(STACK2)
  FREEVEC(P2)
  I := CHANGECO(888,STALE2)
  J := CO1DROP(STALE2)
  IF I \=-1 | J \=-2 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL PASS")
  NEWLINE()
  FINISH
$)1
