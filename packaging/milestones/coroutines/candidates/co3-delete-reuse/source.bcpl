// CO.3 native deletion: two live workers, revoke, free and reuse slots.
// Deliberately do not call any stale pointer after address reallocation.
GLOBAL $(
  START:1
  STACKBASE:54
  STACKEND:55
  WRITES:60
  WRCH:14
  CO3INIT:289
  CREATECO:290
  DELETECO:291
  CALLCO:292
  COWAIT:293
  CO3CURR:295
  CO3ROOT:296
  CO3LIST:297
$)

LET AWORK(A) = VALOF
$(1
  IF A \= 11 RESULTIS -11
  IF DELETECO(CO3CURR) RESULTIS -12
  WRITES("CO3BCPL A1")
  WRCH(10)
  RESULTIS COWAIT(101)
$)1

AND BWORK(A) = VALOF
$(1
  LET R=0
  IF A \= 21 RESULTIS -21
  WRITES("CO3BCPL B1")
  WRCH(10)
  R:=COWAIT(201)
  IF R \= 22 RESULTIS -22
  WRITES("CO3BCPL B2")
  WRCH(10)
  RESULTIS 202
$)1

AND CWORK(A) = VALOF
$(1
  LET R=0
  IF A=33 DO
  $(2 WRITES("CO3BCPL C1")
      WRCH(10)
      R:=COWAIT(301)
      IF R \= 34 RESULTIS -31
      WRITES("CO3BCPL C2")
      WRCH(10)
      RESULTIS 302
  $)2
  IF A=44 DO
  $(2 WRITES("CO3BCPL D1")
      WRCH(10)
      R:=COWAIT(401)
      IF R \= 45 RESULTIS -41
      WRITES("CO3BCPL D2")
      WRCH(10)
      RESULTIS 402
  $)2
  RESULTIS -51
$)1

LET START() BE
$(1
  LET ROOT=0
  AND A=0
  AND B=0
  AND C=0
  AND D=0
  AND R=0
  AND BASE=STACKBASE
  AND ROOTEND=STACKEND
  CO3ROOT:=0
  CO3CURR:=0
  CO3LIST:=0
  ROOT:=CO3INIT()
  IF ROOT=0 DO
  $(2 WRITES("CO3BCPL FINIT")
      WRCH(10)
      FINISH
  $)2
  A:=CREATECO(AWORK,1024)
  B:=CREATECO(BWORK,1024)
  IF A=0 | B=0 | A=B | CO3LIST \= B | B!26 \= A DO
  $(2 WRITES("CO3BCPL FCREATE")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL MADE")
  WRCH(10)
  R:=CREATECO(CWORK,1024)
  IF R \= 0 DO
  $(2 WRITES("CO3BCPL FFULL")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL FULL")
  WRCH(10)
  R:=CALLCO(A,11)
  IF R \= 101 | CO3CURR \= ROOT DO
  $(2 WRITES("CO3BCPL FCALLA")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL RA")
  WRCH(10)
  R:=CALLCO(B,21)
  IF R \= 201 | CO3CURR \= ROOT DO
  $(2 WRITES("CO3BCPL FCALLB")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL RB")
  WRCH(10)
  IF DELETECO(A) \= TRUE | CO3LIST \= B | B!26 \= 0 DO
  $(2 WRITES("CO3BCPL FDELA")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL DELA")
  WRCH(10)
  C:=CREATECO(CWORK,1024)
  IF C=0 | C=B | CO3LIST \= C | C!26 \= B DO
  $(2 WRITES("CO3BCPL FCREAC")
      WRCH(10)
      FINISH
  $)2
  R:=CALLCO(C,33)
  IF R \= 301 | CO3CURR \= ROOT DO
  $(2 WRITES("CO3BCPL FCALLC")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL RC")
  WRCH(10)
  R:=CALLCO(B,22)
  IF R \= 202 | CO3CURR \= ROOT DO
  $(2 WRITES("CO3BCPL FCALLB2")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL RB2")
  WRCH(10)
  IF DELETECO(B) \= TRUE | CO3LIST \= C | C!26 \= 0 DO
  $(2 WRITES("CO3BCPL FDELB")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL DELB")
  WRCH(10)
  R:=CALLCO(C,34)
  IF R \= 302 | CO3CURR \= ROOT DO
  $(2 WRITES("CO3BCPL FCALLC2")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL RC2")
  WRCH(10)
  IF DELETECO(C) \= TRUE | CO3LIST \= 0 DO
  $(2 WRITES("CO3BCPL FDELC")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL DELC")
  WRCH(10)
  D:=CREATECO(CWORK,1024)
  IF D=0 | CO3LIST \= D DO
  $(2 WRITES("CO3BCPL FCREAD")
      WRCH(10)
      FINISH
  $)2
  R:=CALLCO(D,44)
  IF R \= 401 | CO3CURR \= ROOT DO
  $(2 WRITES("CO3BCPL FCALLD")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL RD")
  WRCH(10)
  R:=CALLCO(D,45)
  IF R \= 402 | CO3CURR \= ROOT DO
  $(2 WRITES("CO3BCPL FCALLD2")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL RD2")
  WRCH(10)
  IF DELETECO(D) \= TRUE | CO3LIST \= 0 |
     STACKBASE \= BASE | STACKEND \= ROOTEND DO
  $(2 WRITES("CO3BCPL FDELD")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL DELD")
  WRCH(10)
  WRITES("CO3BCPL PASS")
  WRCH(10)
  FINISH
$)1
