GLOBAL $(
  START:1
  WRITES:60
  NEWLINE:63
  GETVEC:87
  ROOTCTX:297
  CO1INIT:298
  CHANGECO:299
$)

LET WORK1(A) = VALOF
$(1
  LET TOKEN=3101
  AND RETURNED=0
  IF A \=7 RESULTIS 97
  WRITES("CO1BCPL A1")
  NEWLINE()
  RETURNED := CHANGECO(101,ROOTCTX)
  IF RETURNED \=11 | TOKEN \=3101 RESULTIS 98
  RESULTIS 31
$)1

LET WORK2(A) = VALOF
$(1
  LET TOKEN=4202
  AND RETURNED=0
  IF A \=8 RESULTIS 97
  WRITES("CO1BCPL A2")
  NEWLINE()
  RETURNED := CHANGECO(202,ROOTCTX)
  IF RETURNED \=22 | TOKEN \=4202 RESULTIS 98
  RESULTIS 42
$)1

LET START() BE
$(1
  LET ROOT=VEC 23
  AND P1=VEC 23
  AND P2=VEC 23
  AND STACK1=GETVEC(1087)
  AND STACK2=GETVEC(1087)
  AND A=0
  AND B=0
  AND C=0
  AND D=0
  AND E=0
  AND F=0
  AND ROOTFLAG=2718
  IF STACK1=0 | STACK2=0 | STACK1=STACK2 DO
  $(2 WRITES("CO1BCPL FALLOC")
      NEWLINE()
      FINISH
  $)2
  ROOTCTX := ROOT
  IF CO1INIT(ROOT,P1,STACK1,WORK1) \=0 DO
  $(2 WRITES("CO1BCPL FINIT")
      NEWLINE()
      FINISH
  $)2
  IF CO1INIT(ROOT,P2,STACK2,WORK2) \=0 DO
  $(2 WRITES("CO1BCPL FINIT")
      NEWLINE()
      FINISH
  $)2
  A := CHANGECO(7,P1)
  IF A \=101 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FVALUE")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL R1")
  NEWLINE()
  B := CHANGECO(8,P2)
  IF B \=202 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL R2")
  NEWLINE()
  C := CHANGECO(11,P1)
  IF C \=31 | P1!0 \=3 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FLOCAL")
      NEWLINE()
      FINISH
  $)2
  D := CHANGECO(777,P1)
  IF D \=-1 | P1!0 \=3 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FVALUE")
      NEWLINE()
      FINISH
  $)2
  E := CHANGECO(22,P2)
  IF E \=42 | P2!0 \=3 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FLOCAL")
      NEWLINE()
      FINISH
  $)2
  F := CHANGECO(888,P2)
  IF F \=-1 | P2!0 \=3 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL PASS")
  NEWLINE()
  FINISH
$)1
