// CO.4 repeated create/call/delete and two-slot registration churn.
// Deliberately never touch a descriptor after DELETECO.
GLOBAL $(
  START:1
  WRCH:14
  STACKBASE:54
  STACKEND:55
  WRITES:60
  CO3INIT:289
  CREATECO:290
  DELETECO:291
  CALLCO:292
  COWAIT:293
  CO3CURR:295
  CO3ROOT:296
  CO3LIST:297
$)
LET MARK(S) BE
$(1 WRITES("CO4CHURN ")
    WRITES(S)
    WRCH(10)
$)1
AND FAIL() BE
$(1 MARK("FAIL")
    FINISH
$)1
AND WORKA(X) = VALOF
$(1 LET SELF=CO3CURR
    AND TOKEN=X+5000
    AND Y=0
    IF SELF=CO3ROOT RESULTIS -11
    Y:=COWAIT(X+1000)
    IF Y \= X+1 | TOKEN \= X+5000 RESULTIS -12
    RESULTIS X+2000
$)1
AND WORKB(X) = VALOF
$(1 LET SELF=CO3CURR
    AND TOKEN=X+6000
    AND Y=0
    IF SELF=CO3ROOT RESULTIS -21
    Y:=COWAIT(X+3000)
    IF Y \= X+1 | TOKEN \= X+6000 RESULTIS -22
    RESULTIS X+4000
$)1
LET START() BE
$(1 LET ROOT=0
    AND A=0
    AND B=0
    AND R=0
    AND BASE=STACKBASE
    AND TOP=STACKEND
    CO3ROOT:=0
    CO3CURR:=0
    CO3LIST:=0
    ROOT:=CO3INIT()
    IF ROOT=0 DO FAIL()
    MARK("INIT")
    FOR I=1 TO 16 DO
    $(2 A:=CREATECO(WORKA,1024)
        B:=CREATECO(WORKB,1024)
        IF A=0 | B=0 | A=B | CO3LIST \= B | B!26 \= A
           DO FAIL()
        IF CREATECO(WORKA,1024) \= 0 DO FAIL()
        IF CO3LIST \= B | B!26 \= A DO FAIL()
        R:=CALLCO(A,I*10)
        IF R \= I*10+1000 | CO3CURR \= ROOT | A!25 \= 0
           DO FAIL()
        R:=CALLCO(B,I*20)
        IF R \= I*20+3000 | CO3CURR \= ROOT | B!25 \= 0
           DO FAIL()
        R:=CALLCO(A,I*10+1)
        IF R \= I*10+2000 | CO3CURR \= ROOT | A!25 \= 0
           DO FAIL()
        R:=CALLCO(B,I*20+1)
        IF R \= I*20+4000 | CO3CURR \= ROOT | B!25 \= 0
           DO FAIL()
        IF STACKBASE \= BASE | STACKEND \= TOP DO FAIL()
        IF DELETECO(A) \= TRUE | CO3LIST \= B | B!26 \= 0
           DO FAIL()
        IF DELETECO(B) \= TRUE | CO3LIST \= 0 DO FAIL()
        IF CO3CURR \= ROOT DO FAIL()
        IF I=4 DO MARK("C04")
        IF I=8 DO MARK("C08")
        IF I=12 DO MARK("C12")
        IF I=16 DO MARK("C16")
    $)2
    MARK("CLEAN")
    MARK("PASS")
    FINISH
$)1
