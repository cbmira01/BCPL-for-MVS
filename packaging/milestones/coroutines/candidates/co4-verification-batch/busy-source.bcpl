// CO.4 nested busy-parent refusal with subsequent independent recovery.
// Only registered known-live root/A/B descriptors are ever examined.
GLOBAL $(
  START:1
  WRCH:14
  STACKBASE:54
  STACKEND:55
  WRITES:60
  CO3INIT:289
  CREATECO:290
  DELETECO:291
  CALLCO:292
  COWAIT:293
  RESUMECO:294
  CO3CURR:295
  CO3ROOT:296
  CO3LIST:297
$)
LET MARK(S) BE
$(1 WRITES("CO4BUSY ")
    WRITES(S)
    WRCH(10)
$)1
AND FAIL() BE
$(1 MARK("FAIL")
    FINISH
$)1
AND BWORK(X) = VALOF
$(1 LET SELF=CO3CURR
    AND PARENT=SELF!25
    AND R=0
    AND TOKEN=71513
    IF X \= 21 | PARENT=0 | PARENT=CO3ROOT RESULTIS -21
    IF PARENT!25 \= CO3ROOT RESULTIS -22
    IF CALLCO(PARENT,0) \= -2 RESULTIS -23
    IF RESUMECO(PARENT,0) \= -998 RESULTIS -24
    IF RESUMECO(SELF,0) \= -998 RESULTIS -25
    IF RESUMECO(CO3ROOT,0) \= -998 RESULTIS -26
    IF SELF!25 \= PARENT | PARENT!25 \= CO3ROOT
       RESULTIS -27
    MARK("REFUSE")
    R:=COWAIT(201)
    IF R \= 22 | TOKEN \= 71513 RESULTIS -28
    IF CO3CURR \= SELF | SELF!25 \= CO3ROOT RESULTIS -29
    MARK("B2")
    RESULTIS 202
$)1
AND AWORK(X) = VALOF
$(1 LET SELF=CO3CURR
    AND B=CO3LIST
    AND R=0
    AND TOKEN=61412
    IF X \= 11 | B=SELF | B!26 \= SELF RESULTIS -11
    IF SELF!25 \= CO3ROOT RESULTIS -12
    R:=CALLCO(B,21)
    IF R \= 201 | SELF!25 \= CO3ROOT RESULTIS -13
    IF TOKEN \= 61412 | CO3CURR \= SELF RESULTIS -14
    MARK("A1")
    R:=COWAIT(101)
    IF R \= 12 | TOKEN \= 61412 RESULTIS -15
    IF SELF!25 \= CO3ROOT | CO3CURR \= SELF RESULTIS -16
    MARK("A2")
    RESULTIS 102
$)1
LET START() BE
$(1 LET ROOT=0
    AND A=0
    AND B=0
    AND R=0
    AND BASE=STACKBASE
    AND TOP=STACKEND
    CO3ROOT:=0
    CO3CURR:=0
    CO3LIST:=0
    ROOT:=CO3INIT()
    IF ROOT=0 DO FAIL()
    A:=CREATECO(AWORK,1024)
    B:=CREATECO(BWORK,1024)
    IF A=0 | B=0 | CO3LIST \= B | B!26 \= A DO FAIL()
    MARK("MADE")
    R:=CALLCO(A,11)
    IF R \= 101 | CO3CURR \= ROOT | A!25 \= 0 DO FAIL()
    IF B!25 \= 0 | STACKBASE \= BASE | STACKEND \= TOP
       DO FAIL()
    MARK("RA1")
    R:=CALLCO(B,22)
    IF R \= 202 | CO3CURR \= ROOT | B!25 \= 0 DO FAIL()
    IF STACKBASE \= BASE | STACKEND \= TOP DO FAIL()
    MARK("RB2")
    R:=CALLCO(A,12)
    IF R \= 102 | CO3CURR \= ROOT | A!25 \= 0 DO FAIL()
    IF STACKBASE \= BASE | STACKEND \= TOP DO FAIL()
    MARK("RA2")
    IF DELETECO(A) \= TRUE | CO3LIST \= B | B!26 \= 0
       DO FAIL()
    IF DELETECO(B) \= TRUE | CO3LIST \= 0 DO FAIL()
    MARK("CLEAN")
    MARK("PASS")
    FINISH
$)1
