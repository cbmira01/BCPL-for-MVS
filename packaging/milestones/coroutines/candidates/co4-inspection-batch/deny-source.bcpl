// CO.4 simulated GETVEC refusal, rollback and survivor continuity.
// G87 override is temporary; original allocator restored immediately.
GLOBAL $(
  START:1
  WRCH:14
  WRITES:60
  GETVEC:87
  FREEVEC:88
  CO3INIT:289
  CREATECO:290
  DELETECO:291
  CALLCO:292
  COWAIT:293
  CO3CURR:295
  CO3ROOT:296
  CO3LIST:297
  CO4PROB:301
  PROBEPTR:305
  SAVEDGET:302
  FAILAT:303
  REQUESTS:304
$)
LET MARK(S) BE
$(1 WRITES("CO4DENY ")
    WRITES(S)
    WRCH(10)
$)1
AND FAIL() BE
$(1 MARK("FAIL")
    FINISH
$)1
AND DENY(N) = VALOF
$(1 REQUESTS:=REQUESTS+1
    IF REQUESTS=FAILAT RESULTIS 0
    RESULTIS SAVEDGET(N)
$)1
AND WORK(X) = VALOF
$(1 LET SELF=CO3CURR
    AND TOKEN=42144
    IF X \= 11 RESULTIS -11
    X:=COWAIT(101)
    IF X \= 12 | TOKEN \= 42144 RESULTIS -12
    IF CO3CURR \= SELF RESULTIS -13
    X:=COWAIT(102)
    IF X \= 13 | TOKEN \= 42144 RESULTIS -14
    RESULTIS 103
$)1
AND SNAP(N,B) = VALOF
$(1 LET P=PROBEPTR
    IF CO4PROB(P) \= 0 DO
    $(2 MARK("FPROBE")
        RESULTIS FALSE
    $)2
    IF P!5 \= N DO
    $(2 MARK("FCOUNT")
        RESULTIS FALSE
    $)2
    IF P!7 \= B DO
    $(2 MARK("FBYTES")
        RESULTIS FALSE
    $)2
    IF P!6 < P!5 | P!8 < P!7 DO
    $(2 MARK("FPEAK")
        RESULTIS FALSE
    $)2
    RESULTIS TRUE
$)1
LET START() BE
$(1 LET ROOT=0
    AND A=0
    AND B=0
    AND P=0
    AND R=0
    AND N=0
    AND BYTES=0
    P:=GETVEC(8)
    IF P=0 DO
    $(2 MARK("FALLOC")
        FAIL()
    $)2
    PROBEPTR:=P
    IF CO4PROB(P) \= 0 DO
    $(2 MARK("FPROB0")
        FAIL()
    $)2
    N:=P!5
    BYTES:=P!7
    CO3ROOT:=0
    CO3CURR:=0
    CO3LIST:=0
    ROOT:=CO3INIT()
    IF ROOT=0 DO
    $(2 MARK("FINIT0")
        FAIL()
    $)2
    A:=CREATECO(WORK,1024)
    IF A=0 | CO3LIST \= A DO
    $(2 MARK("FMAKE")
        FAIL()
    $)2
    SAVEDGET:=GETVEC
    IF SNAP(N+3,BYTES+4596)=FALSE DO FAIL()
    MARK("MADE")
    FAILAT:=1
    REQUESTS:=0
    GETVEC:=DENY
    R:=CREATECO(WORK,1024)
    GETVEC:=SAVEDGET
    IF R \= 0 | REQUESTS \= 1 DO FAIL()
    IF SNAP(N+3,BYTES+4596)=FALSE DO FAIL()
    MARK("DENY1")
    R:=CALLCO(A,11)
    IF R \= 101 | CO3CURR \= ROOT DO FAIL()
    MARK("A1")
    FAILAT:=2
    REQUESTS:=0
    GETVEC:=DENY
    R:=CREATECO(WORK,1024)
    GETVEC:=SAVEDGET
    IF R \= 0 | REQUESTS \= 2 DO FAIL()
    IF SNAP(N+3,BYTES+4596)=FALSE DO FAIL()
    MARK("DENY2")
    R:=CALLCO(A,12)
    IF R \= 102 | CO3CURR \= ROOT DO FAIL()
    MARK("A2")
    B:=CREATECO(WORK,1024)
    IF B=0 | CO3LIST \= B | B!26 \= A DO FAIL()
    IF SNAP(N+5,BYTES+9084)=FALSE DO FAIL()
    IF CREATECO(WORK,1024) \= 0 DO FAIL()
    IF SNAP(N+5,BYTES+9084)=FALSE DO FAIL()
    MARK("FULL")
    R:=CALLCO(A,13)
    IF R \= 103 | CO3CURR \= ROOT DO FAIL()
    MARK("RA3")
    R:=CALLCO(B,11)
    IF R \= 101 | CO3CURR \= ROOT DO FAIL()
    MARK("B1")
    R:=CALLCO(B,12)
    IF R \= 102 | CO3CURR \= ROOT DO FAIL()
    MARK("B2")
    R:=CALLCO(B,13)
    IF R \= 103 | CO3CURR \= ROOT DO FAIL()
    MARK("B3")
    IF DELETECO(A) \= TRUE | DELETECO(B) \= TRUE DO FAIL()
    IF CO3LIST \= 0 DO FAIL()
    IF SNAP(N+1,BYTES+108)=FALSE DO FAIL()
    MARK("CLEAN")
    FREEVEC(P)
    MARK("PASS")
    FINISH
$)1
