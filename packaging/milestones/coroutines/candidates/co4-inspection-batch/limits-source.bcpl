// CO.4 direct S1 limits and allocator snapshots on both worker stacks.
GLOBAL $(
  START:1
  WRCH:14
  STACKBASE:54
  STACKEND:55
  WRITES:60
  GETVEC:87
  FREEVEC:88
  CO3INIT:289
  CREATECO:290
  DELETECO:291
  CALLCO:292
  COWAIT:293
  CO3CURR:295
  CO3ROOT:296
  CO3LIST:297
  CO4PROB:301
  PROBEPTR:305
$)
LET MARK(S) BE
$(1 WRITES("CO4LIM ")
    WRITES(S)
    WRCH(10)
$)1
AND FAIL() BE
$(1 MARK("FAIL")
    FINISH
$)1
AND OBS(C,SAFE) = VALOF
$(1 LET P=PROBEPTR
    IF CO4PROB(P) \= 0 RESULTIS FALSE
    IF P!0 \= P!1 | P!2 \= STACKBASE | P!3 \= STACKEND
       RESULTIS FALSE
    IF P!4 \= C | CO3CURR \= C RESULTIS FALSE
    IF P!6 < P!5 | P!8 < P!7 RESULTIS FALSE
    IF P!0 \= (STACKBASE+SAFE)*4 RESULTIS FALSE
    IF C!4 \= STACKBASE | C!5 \= P!0 | C!6 \= STACKEND
       RESULTIS FALSE
    RESULTIS TRUE
$)1
AND AWORK(X) = VALOF
$(1 LET SELF=CO3CURR
    AND TOKEN=51411
    IF X \= 11 | OBS(SELF,1024)=FALSE RESULTIS -11
    MARK("A1")
    X:=COWAIT(101)
    IF X \= 12 | TOKEN \= 51411 RESULTIS -12
    IF OBS(SELF,1024)=FALSE RESULTIS -13
    MARK("A2")
    RESULTIS 102
$)1
AND BWORK(X) = VALOF
$(1 LET SELF=CO3CURR
    AND TOKEN=61421
    IF X \= 21 | OBS(SELF,1024)=FALSE RESULTIS -21
    MARK("B1")
    X:=COWAIT(201)
    IF X \= 22 | TOKEN \= 61421 RESULTIS -22
    IF OBS(SELF,1024)=FALSE RESULTIS -23
    MARK("B2")
    RESULTIS 202
$)1
LET START() BE
$(1 LET ROOT=0
    AND A=0
    AND B=0
    AND P=0
    AND R=0
    AND BASECOUNT=0
    AND BASEBYTES=0
    P:=GETVEC(8)
    IF P=0 DO FAIL()
    PROBEPTR:=P
    IF CO4PROB(P) \= 0 DO FAIL()
    BASECOUNT:=P!5
    BASEBYTES:=P!7
    CO3ROOT:=0
    CO3CURR:=0
    CO3LIST:=0
    ROOT:=CO3INIT()
    IF ROOT=0 DO FAIL()
    A:=CREATECO(AWORK,1024)
    B:=CREATECO(BWORK,1024)
    IF A=0 | B=0 | A=B | CO3LIST \= B | B!26 \= A
       DO FAIL()
    IF OBS(ROOT,16384)=FALSE DO FAIL()
    IF P!5 \= BASECOUNT+5 | P!7 \= BASEBYTES+9084 DO FAIL()
    MARK("ROOT")
    MARK("MADE")
    R:=CALLCO(A,11)
    IF R \= 101 | OBS(ROOT,16384)=FALSE DO FAIL()
    MARK("RA1")
    R:=CALLCO(B,21)
    IF R \= 201 | OBS(ROOT,16384)=FALSE DO FAIL()
    MARK("RB1")
    R:=CALLCO(A,12)
    IF R \= 102 | OBS(ROOT,16384)=FALSE DO FAIL()
    MARK("RA2")
    R:=CALLCO(B,22)
    IF R \= 202 | OBS(ROOT,16384)=FALSE DO FAIL()
    MARK("RB2")
    IF DELETECO(A) \= TRUE | DELETECO(B) \= TRUE DO FAIL()
    IF OBS(ROOT,16384)=FALSE DO FAIL()
    IF P!5 \= BASECOUNT+1 | P!7 \= BASEBYTES+108 DO FAIL()
    IF CO3LIST \= 0 DO FAIL()
    MARK("CLEAN")
    FREEVEC(P)
    MARK("PASS")
    FINISH
$)1
