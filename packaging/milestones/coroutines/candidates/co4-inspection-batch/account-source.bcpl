// CO.4 allocation-byte/count accounting across repeated worker churn.
// On failure emit a unique diagnostic before FAIL, preserving the oracle.
GLOBAL $(
  START:1
  WRCH:14
  STACKBASE:54
  STACKEND:55
  WRITES:60
  GETVEC:87
  FREEVEC:88
  CO3INIT:289
  CREATECO:290
  DELETECO:291
  CALLCO:292
  COWAIT:293
  CO3CURR:295
  CO3ROOT:296
  CO3LIST:297
  CO4PROB:301
  PROBEPTR:305
$)
LET MARK(S) BE
$(1 WRITES("CO4MEM ")
    WRITES(S)
    WRCH(10)
$)1
AND FAIL() BE
$(1 MARK("FAIL")
    FINISH
$)1
AND WORK(X) = VALOF
$(1 LET SELF=CO3CURR
    AND TOKEN=X+9000
    AND Y=0
    Y:=COWAIT(X+100)
    IF Y \= X+1 | TOKEN \= X+9000 RESULTIS -1
    IF CO3CURR \= SELF RESULTIS -2
    RESULTIS X+200
$)1
// CO3INIT publishes the root BCPL global before CO2INIT has ever run.
// The private machine CURPTR is still zero until first CREATECO.
// Observe allocator/root invariants without expecting early registration.
AND BOOTSNAP(N,B) = VALOF
$(1 LET P=PROBEPTR
    IF CO4PROB(P) \= 0 DO
    $(2 MARK("FBPROBE")
        RESULTIS FALSE
    $)2
    IF P!4 \= 0 | CO3CURR \= CO3ROOT | CO3ROOT=0 |
       CO3LIST \= 0 DO
    $(2 MARK("FBOOT")
        RESULTIS FALSE
    $)2
    IF P!5 \= N DO
    $(2 MARK("FBCOUNT")
        RESULTIS FALSE
    $)2
    IF P!7 \= B DO
    $(2 MARK("FBBYTES")
        RESULTIS FALSE
    $)2
    IF P!6 < P!5 | P!8 < P!7 DO
    $(2 MARK("FBPEAK")
        RESULTIS FALSE
    $)2
    RESULTIS TRUE
$)1
AND SNAP(N,B) = VALOF
$(1 LET P=PROBEPTR
    IF CO4PROB(P) \= 0 DO
    $(2 MARK("FPROBE")
        RESULTIS FALSE
    $)2
    IF P!0 \= P!1 DO
    $(2 MARK("FLIMIT")
        RESULTIS FALSE
    $)2
    IF P!4 \= CO3CURR DO
    $(2 MARK("FCURR")
        RESULTIS FALSE
    $)2
    IF P!5 \= N DO
    $(2 MARK("FCOUNT")
        RESULTIS FALSE
    $)2
    IF P!7 \= B DO
    $(2 MARK("FBYTES")
        RESULTIS FALSE
    $)2
    IF P!6 < P!5 | P!8 < P!7 DO
    $(2 MARK("FPEAK")
        RESULTIS FALSE
    $)2
    RESULTIS TRUE
$)1
LET START() BE
$(1 LET ROOT=0
    AND A=0
    AND B=0
    AND P=0
    AND R=0
    AND N=0
    AND BYTES=0
    P:=GETVEC(8)
    IF P=0 DO
    $(2 MARK("FALLOC")
        FAIL()
    $)2
    PROBEPTR:=P
    IF CO4PROB(P) \= 0 DO
    $(2 MARK("FPROB0")
        FAIL()
    $)2
    N:=P!5
    BYTES:=P!7
    CO3ROOT:=0
    CO3CURR:=0
    CO3LIST:=0
    ROOT:=CO3INIT()
    IF ROOT=0 DO
    $(2 MARK("FINIT0")
        FAIL()
    $)2
    IF BOOTSNAP(N+1,BYTES+108)=FALSE DO FAIL()
    MARK("INIT")
    IF GETVEC(-1) \= 0 DO FAIL()
    IF GETVEC(4194300) \= 0 DO FAIL()
    IF BOOTSNAP(N+1,BYTES+108)=FALSE DO FAIL()
    MARK("INVALID")
    FOR I=1 TO 12 DO
    $(2 A:=CREATECO(WORK,1024)
        B:=CREATECO(WORK,1024)
        IF A=0 | B=0 | A=B DO FAIL()
        IF SNAP(N+5,BYTES+9084)=FALSE DO FAIL()
        IF CREATECO(WORK,1024) \= 0 DO FAIL()
        IF SNAP(N+5,BYTES+9084)=FALSE DO FAIL()
        R:=CALLCO(A,I*10)
        IF R \= I*10+100 DO FAIL()
        R:=CALLCO(B,I*20)
        IF R \= I*20+100 DO FAIL()
        R:=CALLCO(A,I*10+1)
        IF R \= I*10+200 DO FAIL()
        R:=CALLCO(B,I*20+1)
        IF R \= I*20+200 DO FAIL()
        IF SNAP(N+5,BYTES+9084)=FALSE DO FAIL()
        IF DELETECO(A) \= TRUE | DELETECO(B) \= TRUE
           DO FAIL()
        IF CO3LIST \= 0 | CO3CURR \= ROOT DO FAIL()
        IF SNAP(N+1,BYTES+108)=FALSE DO FAIL()
        IF I=3 DO MARK("C03")
        IF I=6 DO MARK("C06")
        IF I=9 DO MARK("C09")
        IF I=12 DO MARK("C12")
    $)2
    MARK("CLEAN")
    FREEVEC(P)
    MARK("PASS")
    FINISH
$)1
