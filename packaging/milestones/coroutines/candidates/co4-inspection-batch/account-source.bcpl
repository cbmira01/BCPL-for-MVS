// CO.4 allocation-byte/count accounting across repeated worker churn.
GLOBAL $(
  START:1
  WRCH:14
  STACKBASE:54
  STACKEND:55
  WRITES:60
  GETVEC:87
  FREEVEC:88
  CO3INIT:289
  CREATECO:290
  DELETECO:291
  CALLCO:292
  COWAIT:293
  CO3CURR:295
  CO3ROOT:296
  CO3LIST:297
  CO4PROB:301
$)
LET MARK(S) BE
$(1 WRITES("CO4MEM ")
    WRITES(S)
    WRCH(10)
$)1
AND FAIL() BE
$(1 MARK("FAIL")
    FINISH
$)1
AND WORK(X) = VALOF
$(1 LET SELF=CO3CURR
    AND TOKEN=X+9000
    AND Y=0
    Y:=COWAIT(X+100)
    IF Y \= X+1 | TOKEN \= X+9000 RESULTIS -1
    IF CO3CURR \= SELF RESULTIS -2
    RESULTIS X+200
$)1
AND SNAP(P,N,B) = VALOF
$(1 IF CO4PROB(P) \= 0 RESULTIS FALSE
    IF P!0 \= P!1 | P!4 \= CO3CURR RESULTIS FALSE
    IF P!5 \= N | P!7 \= B RESULTIS FALSE
    IF P!6 < P!5 | P!8 < P!7 RESULTIS FALSE
    RESULTIS TRUE
$)1
LET START() BE
$(1 LET ROOT=0
    AND A=0
    AND B=0
    AND P=0
    AND R=0
    AND N=0
    AND BYTES=0
    P:=GETVEC(8)
    IF P=0 DO FAIL()
    IF CO4PROB(P) \= 0 DO FAIL()
    N:=P!5
    BYTES:=P!7
    CO3ROOT:=0
    CO3CURR:=0
    CO3LIST:=0
    ROOT:=CO3INIT()
    IF ROOT=0 DO FAIL()
    IF SNAP(P,N+1,BYTES+108)=FALSE DO FAIL()
    MARK("INIT")
    IF GETVEC(-1) \= 0 DO FAIL()
    IF GETVEC(4194300) \= 0 DO FAIL()
    IF SNAP(P,N+1,BYTES+108)=FALSE DO FAIL()
    MARK("INVALID")
    FOR I=1 TO 12 DO
    $(2 A:=CREATECO(WORK,1024)
        B:=CREATECO(WORK,1024)
        IF A=0 | B=0 | A=B DO FAIL()
        IF SNAP(P,N+5,BYTES+9084)=FALSE DO FAIL()
        IF CREATECO(WORK,1024) \= 0 DO FAIL()
        IF SNAP(P,N+5,BYTES+9084)=FALSE DO FAIL()
        R:=CALLCO(A,I*10)
        IF R \= I*10+100 DO FAIL()
        R:=CALLCO(B,I*20)
        IF R \= I*20+100 DO FAIL()
        R:=CALLCO(A,I*10+1)
        IF R \= I*10+200 DO FAIL()
        R:=CALLCO(B,I*20+1)
        IF R \= I*20+200 DO FAIL()
        IF SNAP(P,N+5,BYTES+9084)=FALSE DO FAIL()
        IF DELETECO(A) \= TRUE | DELETECO(B) \= TRUE
           DO FAIL()
        IF CO3LIST \= 0 | CO3CURR \= ROOT DO FAIL()
        IF SNAP(P,N+1,BYTES+108)=FALSE DO FAIL()
        IF I=3 DO MARK("C03")
        IF I=6 DO MARK("C06")
        IF I=9 DO MARK("C09")
        IF I=12 DO MARK("C12")
    $)2
    MARK("CLEAN")
    FREEVEC(P)
    MARK("PASS")
    FINISH
$)1
