// CO.3 first lifecycle: separate library, worker wait and re-entry.
GLOBAL $(
  START:1
  STACKBASE:54
  STACKEND:55
  WRITES:60
  NEWLINE:63
  CO3INIT:289
  CREATECO:290
  CALLCO:292
  COWAIT:293
  CO3CURR:295
  CO3ROOT:296
  CO3LIST:297
$)

LET WORKER(A) = VALOF
$(1
  LET R=0
  IF A=11 DO
  $(2 WRITES("CO3BCPL W1")
      NEWLINE()
      R := COWAIT(21)
      IF R \= 31 RESULTIS -1
      WRITES("CO3BCPL W2")
      NEWLINE()
      RESULTIS 41
  $)2
  IF A=51 DO
  $(2 WRITES("CO3BCPL W3")
      NEWLINE()
      RESULTIS 61
  $)2
  RESULTIS -2
$)1

LET START() BE
$(1
  LET ROOT=0
  AND CO=0
  AND R=0
  AND BASE=STACKBASE
  AND ROOTEND=STACKEND
  CO3ROOT := 0
  CO3CURR := 0
  CO3LIST := 0
  ROOT := CO3INIT()
  IF ROOT=0 DO
  $(2 WRITES("CO3BCPL FINIT")
      NEWLINE()
      FINISH
  $)2
  CO := CREATECO(WORKER,1024)
  IF CO=0 | CO3CURR \= ROOT |
     STACKBASE \= BASE | STACKEND \= ROOTEND DO
  $(2 WRITES("CO3BCPL FCREATE")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO3BCPL MADE")
  NEWLINE()
  R := CALLCO(CO,11)
  IF R \= 21 | CO3CURR \= ROOT |
     STACKBASE \= BASE | STACKEND \= ROOTEND DO
  $(2 WRITES("CO3BCPL FCALL1")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO3BCPL R1")
  NEWLINE()
  R := CALLCO(CO,31)
  IF R \= 41 | CO3CURR \= ROOT |
     STACKBASE \= BASE | STACKEND \= ROOTEND DO
  $(2 WRITES("CO3BCPL FCALL2")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO3BCPL R2")
  NEWLINE()
  R := CALLCO(CO,51)
  IF R \= 61 | CO3CURR \= ROOT |
     STACKBASE \= BASE | STACKEND \= ROOTEND DO
  $(2 WRITES("CO3BCPL FCALL3")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO3BCPL R3")
  NEWLINE()
  WRITES("CO3BCPL PASS")
  NEWLINE()
  FINISH
$)1

