// CO.3 parent-chain candidate: nested CALLCO, busy RESUMECO refusal,
// tail-like parent transfer, independent continuations and worker return.
GLOBAL $(
  START:1
  STACKBASE:54
  STACKEND:55
  WRITES:60
  WRCH:14
  CO3INIT:289
  CREATECO:290
  CALLCO:292
  COWAIT:293
  RESUMECO:294
  CO3CURR:295
  CO3ROOT:296
  CO3LIST:297
$)

LET AWORK(A) = VALOF
$(1
  LET R=0
  AND KEEP=123
  IF A \= 11 RESULTIS -10
  WRITES("CO3BCPL A1")
  WRCH(10)
  R := CALLCO(CO3LIST,22)
  IF R \= 33 RESULTIS -11
  WRITES("CO3BCPL A2")
  WRCH(10)
  R := RESUMECO(CO3LIST,44)
  IF R \= 55 RESULTIS -12
  WRITES("CO3BCPL A3")
  WRCH(10)
  R := COWAIT(66)
  IF R \= 77 | KEEP \= 123 RESULTIS -13
  WRITES("CO3BCPL A4")
  WRCH(10)
  RESULTIS 88
$)1

AND BWORK(A) = VALOF
$(1
  LET R=0
  AND KEEP=456
  IF A \= 22 RESULTIS -20
  WRITES("CO3BCPL B1")
  WRCH(10)
  // A is busy; this must fail without detaching B from parent A.
  R := RESUMECO(CO3LIST!26,0)
  IF R \= -998 RESULTIS -21
  R := COWAIT(33)
  IF R \= 44 RESULTIS -22
  WRITES("CO3BCPL B2")
  WRCH(10)
  R := COWAIT(99)
  IF R \= 110 | KEEP \= 456 RESULTIS -23
  WRITES("CO3BCPL B3")
  WRCH(10)
  RESULTIS 120
$)1

LET START() BE
$(1
  LET ROOT=0
  AND A=0
  AND B=0
  AND R=0
  AND BASE=STACKBASE
  AND ROOTEND=STACKEND
  CO3ROOT := 0
  CO3CURR := 0
  CO3LIST := 0
  ROOT := CO3INIT()
  IF ROOT=0 DO
  $(2 WRITES("CO3BCPL FINIT")
      WRCH(10)
      FINISH
  $)2
  A := CREATECO(AWORK,1024)
  B := CREATECO(BWORK,1024)
  IF A=0 | B=0 | A=B | CO3LIST \= B |
     B!26 \= A | CO3CURR \= ROOT DO
  $(2 WRITES("CO3BCPL FCREATE")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL MADE")
  WRCH(10)
  R := CALLCO(A,11)
  IF R \= 99 | CO3CURR \= ROOT |
     A!25 \= 0 | B!25 \= 0 DO
  $(2 WRITES("CO3BCPL FCALL1")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL R1")
  WRCH(10)
  R := CALLCO(A,55)
  IF R \= 66 | CO3CURR \= ROOT DO
  $(2 WRITES("CO3BCPL FCALL2")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL R2")
  WRCH(10)
  R := CALLCO(B,110)
  IF R \= 120 | CO3CURR \= ROOT DO
  $(2 WRITES("CO3BCPL FCALL3")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL R3")
  WRCH(10)
  R := CALLCO(A,77)
  IF R \= 88 | CO3CURR \= ROOT |
     STACKBASE \= BASE | STACKEND \= ROOTEND DO
  $(2 WRITES("CO3BCPL FCALL4")
      WRCH(10)
      FINISH
  $)2
  WRITES("CO3BCPL R4")
  WRCH(10)
  WRITES("CO3BCPL PASS")
  WRCH(10)
  FINISH
$)1
