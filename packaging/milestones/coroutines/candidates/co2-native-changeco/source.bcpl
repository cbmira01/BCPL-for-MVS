GLOBAL $(
  START:1
  STACKBASE:54
  STACKEND:55
  WRITES:60
  NEWLINE:63
  GETVEC:87
  PEER1:295
  PEER2:296
  ROOTCTX:297
  CO2INIT:298
  CHANGECO:299
$)

// Two nested, independently checked native call chains.
// All globals 295..299 are PRIVATE to this isolated application.
LET NEST1(N) = VALOF
$(1
  LET MARK=500+N
  AND V=0
  IF N=0 DO
  $(2
    IF STACKBASE \= PEER1!4 | STACKEND \= PEER1!6 RESULTIS 97
    WRITES("CO2BCPL A1")
    NEWLINE()
    V := CHANGECO(17,PEER2)
    IF V \=23 | MARK \=500 RESULTIS 98
    WRITES("CO2BCPL A2")
    NEWLINE()
    V := CHANGECO(33,ROOTCTX)
    IF V \=44 | MARK \=500 RESULTIS 98
    RESULTIS 13
  $)2
  V := NEST1(N-1)
  IF MARK \=500+N RESULTIS 98
  RESULTIS V+N
$)1

LET NEST2(N) = VALOF
$(1
  LET MARK=700+N
  AND V=0
  IF N=0 DO
  $(2
    IF STACKBASE \= PEER2!4 | STACKEND \= PEER2!6 RESULTIS 97
    WRITES("CO2BCPL B1")
    NEWLINE()
    V := CHANGECO(23,PEER1)
    IF V \=55 | MARK \=700 RESULTIS 98
    WRITES("CO2BCPL B2")
    NEWLINE()
    RESULTIS 17
  $)2
  V := NEST2(N-1)
  IF MARK \=700+N RESULTIS 98
  RESULTIS V+N
$)1

LET WORK1(A) = VALOF
$(1
  IF A \=7 RESULTIS 97
  IF NEST1(3) \=19 RESULTIS 98
  RESULTIS 31
$)1

LET WORK2(A) = VALOF
$(1
  IF A \=17 RESULTIS 97
  IF NEST2(4) \=27 RESULTIS 98
  RESULTIS 42
$)1

LET START() BE
$(1
  LET ROOT=VEC 23
  AND P1=VEC 23
  AND P2=VEC 23
  AND STACK1=GETVEC(1087)
  AND STACK2=GETVEC(1087)
  AND ROOTBASE=STACKBASE
  AND ROOTEND=STACKEND
  AND A=0
  AND B=0
  AND C=0
  AND ROOTFLAG=2718
  IF STACK1=0 | STACK2=0 | STACK1=STACK2 DO
  $(2 WRITES("CO2BCPL FALLOC")
      NEWLINE()
      FINISH
  $)2
  ROOTCTX := ROOT
  PEER1 := P1
  PEER2 := P2
  IF CO2INIT(ROOT,P1,STACK1,WORK1) \=0 |
     CO2INIT(ROOT,P2,STACK2,WORK2) \=0 DO
  $(2 WRITES("CO2BCPL FINIT")
      NEWLINE()
      FINISH
  $)2
  A := CHANGECO(7,P1)
  IF A \=33 | ROOTFLAG \=2718 |
     STACKBASE \= ROOTBASE | STACKEND \= ROOTEND DO
  $(2 WRITES("CO2BCPL FVALUE")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO2BCPL R1")
  NEWLINE()
  B := CHANGECO(55,P2)
  IF B \=42 | ROOTFLAG \=2718 |
     STACKBASE \= ROOTBASE | STACKEND \= ROOTEND DO
  $(2 WRITES("CO2BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO2BCPL R2")
  NEWLINE()
  C := CHANGECO(44,P1)
  IF C \=31 | ROOTFLAG \=2718 |
     STACKBASE \= ROOTBASE | STACKEND \= ROOTEND DO
  $(2 WRITES("CO2BCPL FLOCAL")
      NEWLINE()
      FINISH
  $)2
  IF CHANGECO(99,P1) \=-1 | CHANGECO(99,P2) \=-1 DO
  $(2 WRITES("CO2BCPL FTERM")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO2BCPL PASS")
  NEWLINE()
  FINISH
$)1
