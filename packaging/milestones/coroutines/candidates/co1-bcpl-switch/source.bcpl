GLOBAL $(
  START:1
  WRITES:60
  NEWLINE:63
  GETVEC:87
  ROOTCTX:297
  CO1INIT:298
  CHANGECO:299
$)

LET WORKER(A) = VALOF
$(1
  LET LOCAL=314
  AND B=0
  IF A \=7 RESULTIS 97
  WRITES("CO1BCPL A1")
  NEWLINE()
  B := CHANGECO(9,ROOTCTX)
  IF LOCAL \=314 | B \=10 RESULTIS 98
  WRITES("CO1BCPL A2")
  NEWLINE()
  RESULTIS 11
$)1

LET START() BE
$(1
  LET ROOT=VEC 23
  AND PEER=VEC 23
  AND STACK=GETVEC(1087)
  AND A=0
  AND B=0
  IF STACK=0 DO
  $(2 WRITES("CO1BCPL FALLOC")
      NEWLINE()
      FINISH
  $)2
  ROOTCTX := ROOT
  IF CO1INIT(ROOT,PEER,STACK,WORKER) \=0 DO
  $(2 WRITES("CO1BCPL FINIT")
      NEWLINE()
      FINISH
  $)2
  A := CHANGECO(7,PEER)
  IF A \=9 DO
  $(2 IF A=97 WRITES("CO1BCPL FARG")
      IF A=98 WRITES("CO1BCPL FLOCAL")
      IF A \=97 DO
      $(3 IF A \=98 WRITES("CO1BCPL FVALUE") $)3
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL R1")
  NEWLINE()
  B := CHANGECO(10,PEER)
  IF B \=11 DO
  $(2 IF B=98 WRITES("CO1BCPL FLOCAL")
      IF B \=98 WRITES("CO1BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL R2")
  NEWLINE()
  WRITES("CO1BCPL PASS")
  NEWLINE()
  FINISH
$)1
