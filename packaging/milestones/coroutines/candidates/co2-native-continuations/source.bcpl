GLOBAL $(
  START:1
  STACKBASE:54
  STACKEND:55
  WRITES:60
  NEWLINE:63
  GETVEC:87
  PEER1:295
  PEER2:296
  ROOTCTX:297
  CO2INIT:298
  CHANGECO:299
$)

// CO.2 candidate: each nested worker suspends twice before return.
// Experimental globals 295..299 are isolated to this test.
LET DEEP1(N) = VALOF
$(1
  LET GUARD=510+N
  AND R=0
  IF N=0 DO
  $(2
    IF STACKBASE \= PEER1!4 | STACKEND \= PEER1!6 RESULTIS 97
    WRITES("CO2BCPL X1")
    NEWLINE()
    R := CHANGECO(111,PEER2)
    IF R \=211 | GUARD \=510 RESULTIS 98
    IF STACKBASE \= PEER1!4 | STACKEND \= PEER1!6 RESULTIS 98
    WRITES("CO2BCPL X2")
    NEWLINE()
    R := CHANGECO(112,PEER2)
    IF R \=212 | GUARD \=510 RESULTIS 98
    IF STACKBASE \= PEER1!4 | STACKEND \= PEER1!6 RESULTIS 98
    WRITES("CO2BCPL X3")
    NEWLINE()
    RESULTIS 13
  $)2
  R := DEEP1(N-1)
  IF GUARD \=510+N RESULTIS 98
  RESULTIS R+N
$)1

LET DEEP2(N) = VALOF
$(1
  LET GUARD=710+N
  AND R=0
  IF N=0 DO
  $(2
    IF STACKBASE \= PEER2!4 | STACKEND \= PEER2!6 RESULTIS 97
    WRITES("CO2BCPL Y1")
    NEWLINE()
    R := CHANGECO(211,PEER1)
    IF R \=112 | GUARD \=710 RESULTIS 98
    IF STACKBASE \= PEER2!4 | STACKEND \= PEER2!6 RESULTIS 98
    WRITES("CO2BCPL Y2")
    NEWLINE()
    R := CHANGECO(212,PEER1)
    IF R \=313 | GUARD \=710 RESULTIS 98
    IF STACKBASE \= PEER2!4 | STACKEND \= PEER2!6 RESULTIS 98
    WRITES("CO2BCPL Y3")
    NEWLINE()
    RESULTIS 17
  $)2
  R := DEEP2(N-1)
  IF GUARD \=710+N RESULTIS 98
  RESULTIS R+N
$)1

LET WORK1(A) = VALOF
$(1
  IF A \=7 RESULTIS 97
  IF DEEP1(4) \=23 RESULTIS 98
  RESULTIS 31
$)1

LET WORK2(A) = VALOF
$(1
  IF A \=111 RESULTIS 97
  IF DEEP2(5) \=32 RESULTIS 98
  RESULTIS 42
$)1

LET START() BE
$(1
  LET ROOT=VEC 23
  AND P1=VEC 23
  AND P2=VEC 23
  AND STACK1=GETVEC(1087)
  AND STACK2=GETVEC(1087)
  AND ROOTBASE=STACKBASE
  AND ROOTEND=STACKEND
  AND ROOTMARK=2718
  AND R=0
  IF STACK1=0 | STACK2=0 | STACK1=STACK2 DO
  $(2 WRITES("CO2BCPL FALLOC")
      NEWLINE()
      FINISH
  $)2
  ROOTCTX := ROOT
  PEER1 := P1
  PEER2 := P2
  IF CO2INIT(ROOT,P1,STACK1,WORK1) \=0 |
     CO2INIT(ROOT,P2,STACK2,WORK2) \=0 DO
  $(2 WRITES("CO2BCPL FINIT")
      NEWLINE()
      FINISH
  $)2
  R := CHANGECO(7,P1)
  IF R \=31 | ROOTMARK \=2718 |
     STACKBASE \= ROOTBASE | STACKEND \= ROOTEND DO
  $(2 WRITES("CO2BCPL FVALUE")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO2BCPL R1")
  NEWLINE()
  R := CHANGECO(313,P2)
  IF R \=42 | ROOTMARK \=2718 |
     STACKBASE \= ROOTBASE | STACKEND \= ROOTEND DO
  $(2 WRITES("CO2BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO2BCPL R2")
  NEWLINE()
  IF CHANGECO(99,P1) \=-1 | CHANGECO(99,P2) \=-1 DO
  $(2 WRITES("CO2BCPL FTERM")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO2BCPL PASS")
  NEWLINE()
  FINISH
$)1
