GLOBAL $(
  START:1
  WRITES:60
  NEWLINE:63
  GETVEC:87
  ROOTCTX:297
  CO1INIT:298
  CHANGECO:299
$)

LET DEEP(N) = VALOF
$(1
  LET SENTINEL=410+N
  AND K=0
  AND RETURNED=0
  IF N=0 DO
  $(2 WRITES("CO1BCPL A1")
      NEWLINE()
      RETURNED := CHANGECO(9,ROOTCTX)
      IF RETURNED \=10 RESULTIS 90
      IF SENTINEL \=410 RESULTIS 91
      WRITES("CO1BCPL A2")
      NEWLINE()
      RESULTIS 13
  $)2
  K := DEEP(N-1)
  IF SENTINEL \=410+N RESULTIS 92
  RESULTIS K+N
$)1

LET WORKER(A) = VALOF
$(1
  LET K=0
  IF A \=7 RESULTIS 97
  K := DEEP(5)
  IF K \=28 RESULTIS 98
  RESULTIS 11
$)1

LET START() BE
$(1
  LET ROOT=VEC 23
  AND PEER=VEC 23
  AND STACK=GETVEC(1087)
  AND A=0
  AND B=0
  AND ROOTFLAG=2718
  IF STACK=0 DO
  $(2 WRITES("CO1BCPL FALLOC")
      NEWLINE()
      FINISH
  $)2
  ROOTCTX := ROOT
  IF CO1INIT(ROOT,PEER,STACK,WORKER) \=0 DO
  $(2 WRITES("CO1BCPL FINIT")
      NEWLINE()
      FINISH
  $)2
  A := CHANGECO(7,PEER)
  IF A \=9 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FVALUE")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL R1")
  NEWLINE()
  B := CHANGECO(10,PEER)
  IF B \=11 | ROOTFLAG \=2718 DO
  $(2 WRITES("CO1BCPL FSECOND")
      NEWLINE()
      FINISH
  $)2
  WRITES("CO1BCPL R2")
  NEWLINE()
  WRITES("CO1BCPL PASS")
  NEWLINE()
  FINISH
$)1
