//* TA1AWRIT - TWO SL DATASETS ON ONE NEW SCRATCH AWS VOLUME.
//* DESIGN APPROVED; NO MVS EXECUTION WITHOUT OWNER APPROVAL.
//* FRESH IMAGE: bcpl-ta1-a-20261117-01.aws; VOLSER BTA101.
//* CONFIRM UNUSED IMAGE/VOLSER AND IDLE HERCULES 0480/MVS 480.
//* READ-ONLY INPUT: HERC02.BCPL.DIST.DOCS, FB/80/800.
//* IF STEP 1 FAILS, STEP 2 MUST NOT EXECUTE.
//BOOTSTRP EXEC PGM=IEBGENER,REGION=256K
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=HERC02.BCPL.DIST.DOCS(README),DISP=SHR
//SYSUT2   DD DSN=BCPL.BT0001,UNIT=480,
//            VOL=(PRIVATE,RETAIN,SER=BTA101),
//            LABEL=(1,SL),DISP=(NEW,KEEP,KEEP),
//            DCB=(DSORG=PS,RECFM=FB,LRECL=80,BLKSIZE=800)
//UNLOAD   EXEC PGM=IEBCOPY,REGION=512K,COND=(0,NE,BOOTSTRP)
//SYSPRINT DD SYSOUT=*
//INPDS    DD DSN=HERC02.BCPL.DIST.DOCS,DISP=SHR
//OUTTAPE  DD DSN=BCPL.BT0002,UNIT=480,
//            VOL=(PRIVATE,SER=BTA101),
//            LABEL=(2,SL),DISP=(NEW,KEEP,KEEP)
//SYSUT3   DD UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSIN    DD *
 COPY OUTDD=OUTTAPE,INDD=INPDS
/*
//
