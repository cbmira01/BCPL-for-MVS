//* TO03REST - RESTORE BINARY OBJECT LIBRARY FROM BTO001.
//* REVIEW ONLY: MVS EXECUTION REQUIRES SEPARATE APPROVAL.
//* REUSE WRITTEN TAPE; NEVER REINITIALIZE OR OVERWRITE IT.
//* HERC02.BCPL.TPOBJ.RESTORE MUST NOT EXIST.
//RESTORE  EXEC PGM=IEBCOPY,REGION=256K
//SYSPRINT DD  SYSOUT=*
//INTAPE   DD  DSN=HERC02.BCTO01,UNIT=480,
//             VOL=SER=BTO001,LABEL=(1,SL),DISP=OLD
//OUTPDS   DD  DSN=HERC02.BCPL.TPOBJ.RESTORE,
//             UNIT=SYSDA,SPACE=(TRK,(20,5,10)),
//             DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=800),
//             DISP=(NEW,CATLG,DELETE)
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSIN    DD  *
 COPY OUTDD=OUTPDS,INDD=INTAPE
/*
//
