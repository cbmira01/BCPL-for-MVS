//* TP01PRE - MAKE A DISPOSABLE SOURCE PDS.
//* REVIEW ONLY: MVS EXECUTION REQUIRES SEPARATE APPROVAL.
//* JOB CARD IS NOT INCLUDED. ORIGINAL DIST.DOCS IS READ ONLY.
//* HERC02.BCPL.TPTEST.SRC MUST NOT EXIST BEFORE SUBMISSION.
//COPY     EXEC PGM=IEBCOPY,REGION=256K
//SYSPRINT DD  SYSOUT=*
//INPDS    DD  DSN=HERC02.BCPL.DIST.DOCS,DISP=SHR
//OUTPDS   DD  DSN=HERC02.BCPL.TPTEST.SRC,
//             UNIT=SYSDA,SPACE=(TRK,(5,2,5)),
//             DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=800),
//             DISP=(NEW,CATLG,DELETE)
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSUT4   DD  UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSIN    DD  *
 COPY OUTDD=OUTPDS,INDD=INPDS
/*
//
