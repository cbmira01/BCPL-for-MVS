//* TP03REST - IEBCOPY RESTORE TAPE FILE 1 INTO NEW PDS.
//* REVIEW ONLY: MVS EXECUTION REQUIRES SEPARATE APPROVAL.
//* INPUT TAPE IS BTP001; IMAGE MUST BE PRESERVED, NOT REINIT.
//* HERC02.BCPL.TPTEST.RESTORE MUST NOT ALREADY EXIST.
//RESTORE  EXEC PGM=IEBCOPY,REGION=256K
//SYSPRINT DD  SYSOUT=*
//INTAPE   DD  DSN=HERC02.BCTP01,UNIT=480,
//             VOL=SER=BTP001,LABEL=(1,SL),DISP=OLD
//OUTPDS   DD  DSN=HERC02.BCPL.TPTEST.RESTORE,
//             UNIT=SYSDA,SPACE=(TRK,(5,2,5)),
//             DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=800),
//             DISP=(NEW,CATLG,DELETE)
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSIN    DD  *
 COPY OUTDD=OUTPDS,INDD=INTAPE
/*
//
