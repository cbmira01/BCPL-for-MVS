//* TA1AR002 - RESTORE LOGICAL TAPE DATASET TWO TO NEW DASD PDS.
//* DESIGN APPROVED; NO MVS EXECUTION WITHOUT OWNER APPROVAL.
//* NO AUTO REMOUNT; OPERATOR VERIFIES VOLSER BTA101/0480.
//* TARGET HERC02.BCPL.TA1A.PDSREST MUST NOT EXIST.
//RESTORE  EXEC PGM=IEBCOPY,REGION=512K
//SYSPRINT DD SYSOUT=*
//INTAPE   DD DSN=BCPL.BT0002,UNIT=480,
//            VOL=SER=BTA101,LABEL=(2,SL),DISP=OLD
//OUTPDS   DD DSN=HERC02.BCPL.TA1A.PDSREST,
//            UNIT=SYSDA,SPACE=(TRK,(5,2,5)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=800),
//            DISP=(NEW,CATLG,DELETE)
//SYSUT3   DD UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSIN    DD *
 COPY OUTDD=OUTPDS,INDD=INTAPE
/*
//
