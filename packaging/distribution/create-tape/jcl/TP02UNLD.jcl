//* TP02UNLD - IEBCOPY SCRATCH PDS UNLOAD TO TAPE FILE 1.
//* REVIEW ONLY: MVS EXECUTION REQUIRES SEPARATE APPROVAL.
//* NEW AWS IMAGE; MOUNTED AT HERCULES 0480; VOLSER BTP001.
//* HERC02.BCTP01 MUST NOT EXIST ON THE TAPE BEFORE WRITING.
//* DO NOT SPECIFY SOURCE PDS DCB FOR THE TAPE UNLOAD.
//UNLOAD   EXEC PGM=IEBCOPY,REGION=256K
//SYSPRINT DD  SYSOUT=*
//INPDS    DD  DSN=HERC02.BCPL.TPTEST.SRC,DISP=SHR
//OUTTAPE  DD  DSN=HERC02.BCTP01,UNIT=480,
//             VOL=SER=BTP001,LABEL=(1,SL),DISP=(NEW,KEEP)
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSIN    DD  *
 COPY OUTDD=OUTTAPE,INDD=INPDS
/*
//
