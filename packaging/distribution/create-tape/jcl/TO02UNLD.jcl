//* TO02UNLD - UNLOAD SCRATCH OBJECT PDS TO FIRST TAPE FILE.
//* REVIEW ONLY: MVS EXECUTION REQUIRES SEPARATE APPROVAL.
//* NEW IMAGE: bcpl-objtest-20261108-01.aws VOLSER BTO001.
//* HERC02.BCTO01 MUST NOT ALREADY EXIST ON THIS TAPE.
//* DO NOT SUPPLY OBJECT PDS DCB TO SEQUENTIAL UNLOAD DD.
//UNLOAD   EXEC PGM=IEBCOPY,REGION=256K
//SYSPRINT DD  SYSOUT=*
//INPDS    DD  DSN=HERC02.BCPL.TPOBJ.SRC,DISP=SHR
//OUTTAPE  DD  DSN=HERC02.BCTO01,UNIT=480,
//             VOL=SER=BTO001,LABEL=(1,SL),DISP=(NEW,KEEP)
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSIN    DD  *
 COPY OUTDD=OUTTAPE,INDD=INPDS
/*
//
