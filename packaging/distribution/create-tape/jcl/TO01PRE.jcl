//* TO01PRE - COPY ACCEPTED BINARY BOOT.OBJ TO SCRATCH PDS.
//* REVIEW ONLY: MVS EXECUTION REQUIRES SEPARATE APPROVAL.
//* ORIGINAL BOOT.OBJ IS READ ONLY; NO OBJECT TEXT CONVERSION.
//* HERC02.BCPL.TPOBJ.SRC MUST NOT EXIST BEFORE SUBMISSION.
//COPY     EXEC PGM=IEBCOPY,REGION=256K
//SYSPRINT DD  SYSOUT=*
//INPDS    DD  DSN=HERC02.BCPL.BOOT.OBJ,DISP=SHR
//OUTPDS   DD  DSN=HERC02.BCPL.TPOBJ.SRC,
//             UNIT=SYSDA,SPACE=(TRK,(20,5,10)),
//             DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=800),
//             DISP=(NEW,CATLG,DELETE)
//SYSUT3   DD  UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSUT4   DD  UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSIN    DD  *
 COPY OUTDD=OUTPDS,INDD=INPDS
/*
//
