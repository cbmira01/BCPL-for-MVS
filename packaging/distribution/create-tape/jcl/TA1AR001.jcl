//* TA1AR001 - RESTORE LOGICAL TAPE DATASET ONE TO NEW DASD PS.
//* DESIGN APPROVED; NO MVS EXECUTION WITHOUT OWNER APPROVAL.
//* NO AUTO REMOUNT; OPERATOR VERIFIES VOLSER BTA101/0480.
//* TARGET HERC02.BCPL.TA1A.FBREST MUST NOT EXIST.
//RESTORE  EXEC PGM=IEBGENER,REGION=256K
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=BCPL.BT0001,UNIT=480,
//            VOL=SER=BTA101,LABEL=(1,SL),DISP=OLD
//SYSUT2   DD DSN=HERC02.BCPL.TA1A.FBREST,
//            UNIT=SYSDA,SPACE=(TRK,(3,1)),
//            DCB=(DSORG=PS,RECFM=FB,LRECL=80,BLKSIZE=800),
//            DISP=(NEW,CATLG,DELETE)
//
