//* TA1BREST - RESTORE ICINT19 FROM UNCATALOGED BTA102 TAPE.
//* DESIGN APPROVED; NO MVS EXECUTION WITHOUT OWNER APPROVAL.
//* NEVER REINITIALIZE/OVERWRITE OR AUTOMATICALLY REMOUNT THE TAPE.
//* RESTORED DASD PDS MUST BE ABSENT BEFORE THIS ONE-SHOT JOB.
//RESTORE  EXEC PGM=IEBCOPY,REGION=512K
//SYSPRINT DD SYSOUT=*
//INTAPE   DD DSN=BCPL.BT0001,UNIT=480,
//            VOL=SER=BTA102,LABEL=(1,SL),DISP=OLD
//OUTPDS   DD DSN=HERC02.BCPL.TA1B.LOAD,
//            UNIT=SYSDA,SPACE=(TRK,(20,5,10)),
//            DCB=(DSORG=PO,RECFM=U,LRECL=0,BLKSIZE=6144),
//            DISP=(NEW,CATLG,DELETE)
//SYSUT3   DD UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSIN    DD *
 COPY OUTDD=OUTPDS,INDD=INTAPE
/*
//
