//* TA1ACOMP - INDEPENDENT DATASET/RECORD COMPARISONS.
//* DESIGN APPROVED; NO MVS EXECUTION WITHOUT OWNER APPROVAL.
//* ALL INPUT DDs READ ONLY; SOURCE AND TARGET MUST EXIST.
//CMPFB    EXEC PGM=IEBCOMPR,REGION=256K
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=HERC02.BCPL.DIST.DOCS(README),DISP=SHR
//SYSUT2   DD DSN=HERC02.BCPL.TA1A.FBREST,DISP=SHR
//SYSIN    DD *
 COMPARE TYPORG=PS
/*
//CMPPDS   EXEC PGM=IEBCOMPR,REGION=256K,COND=(0,NE,CMPFB)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=HERC02.BCPL.DIST.DOCS,DISP=SHR
//SYSUT2   DD DSN=HERC02.BCPL.TA1A.PDSREST,DISP=SHR
//SYSIN    DD *
 COMPARE TYPORG=PO
/*
//
