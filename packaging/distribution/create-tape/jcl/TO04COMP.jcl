//* TO04COMP - COMPARE SCRATCH OBJECT PDS AND RESTORED PDS.
//* REVIEW ONLY: MVS EXECUTION REQUIRES SEPARATE APPROVAL.
//* PRESERVE BINARY FB80 RECORDS; CHECK IEBCOMPR REPORT.
//COMPARE  EXEC PGM=IEBCOMPR,REGION=256K
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  DSN=HERC02.BCPL.TPOBJ.SRC,DISP=SHR
//SYSUT2   DD  DSN=HERC02.BCPL.TPOBJ.RESTORE,DISP=SHR
//SYSIN    DD  *
 COMPARE TYPORG=PO
/*
//
