#!/usr/bin/env python3
"""TA.1 Track B: source-versus-restored IEHLIST FORMAT directory verification.

Default --check performs read-only MVS catalog inquiries; --run additionally
submits precisely two read-only IEHLIST jobs after separate owner authorization.
Never initializes/mounts tape, creates or rewrites MVS datasets, or runs GO.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[4]
SCRIPTS = ROOT / 'packaging/distribution/create-tape/scripts'
OPS = ROOT / 'workarea/ta1b-operations'
LOG = OPS / ('BTA102-track-b-directory-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + str(os.getpid()))
MARKER = OPS / 'BTA102-track-b-directory-attempt.json'
RESTORED_LOG = OPS / 'BTA102-track-b-restore-20261119T021135Z-10863'
RESTORED_MARKER = OPS / 'BTA102-track-b-restore.json'
TAPE = ROOT / 'mvs-state/tape/bcpl-ta1-b-20261117-01.aws'
SHA = 'c3b235ca78d221432199adcde1f7a83aead4f76bab0e0eaa19d77c81d9912210'
SOURCE = 'HERC02.BCPL.MR10KIT.LOAD'
TARGET = 'HERC02.BCPL.TA1B.LOAD'
JOBS = (('TA1BSRC', SOURCE, 'TSO003'), ('TA1BDST', TARGET, 'TSO002'))
EXPECTED_ENTRY = '000000'
EXPECTED_ATTR = '02E2'


class Halt(RuntimeError):
    pass


def need(ok: bool, why: str) -> None:
    if not ok:
        raise Halt(why)


def module(path: Path, label: str):
    need(path.is_file() and not path.is_symlink(), 'required helper missing/unsafe: ' + label)
    loader = importlib.machinery.SourceFileLoader(label, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    need(spec is not None and spec.loader is not None, 'cannot import helper ' + label)
    result = importlib.util.module_from_spec(spec)
    loader.exec_module(result)
    return result


def read_saved(path: Path, max_bytes: int = 8 * 1024 * 1024) -> str:
    need(path.is_file() and not path.is_symlink() and path.stat().st_size <= max_bytes,
         'missing or unsafe saved receipt: ' + path.name)
    return path.read_text(encoding='utf-8', errors='replace')


def verify_receipt() -> None:
    need(OPS.is_dir() and not OPS.is_symlink(), 'operations directory missing/unsafe')
    need(RESTORED_LOG.is_dir() and not RESTORED_LOG.is_symlink(),
         'JOB 9136 restored-load evidence missing/unsafe')
    receipt = json.loads(read_saved(RESTORED_MARKER, 8192))
    need(type(receipt) is dict and receipt.get('state') == 'RESTORE_ATTEMPTED' and
         receipt.get('job') == 'TA1BREST' and receipt.get('target') == TARGET and
         receipt.get('sha256') == SHA and receipt.get('no_retry') is True,
         'JOB 9136 one-shot receipt does not match expected restoration')
    summary = read_saved(RESTORED_LOG / 'summary.txt')
    need(re.search(r'(?m)^JOB\s+9136\s+TA1BREST\s*$', summary) is not None and
         'JOB RESULT: SUCCESS' in summary and 'HIGHEST RC: 0000' in summary and
         re.findall(r'(?m)^([A-Z0-9]{1,8})\s+(\S+)\s+RC=(\d{4})\s*$', summary)
         == [('RESTORE', 'IEBCOPY', '0000')], 'saved JOB 9136 summary not exactly successful')
    need(TAPE.is_file() and not TAPE.is_symlink(), 'BTA102 AWS missing/unsafe')
    with TAPE.open('rb') as f:
        actual = hashlib.file_digest(f, 'sha256').hexdigest()
    need(actual == SHA, 'BTA102 AWS hash changed; refuse all further verification')


def stat_contract(text: str, name: str, volume: str) -> None:
    t = text.upper()
    need('DATASET:   ' + name in t and
         all(re.search(r'\b' + field + r'\s*:\s*' + value + r'\b', t)
             for field, value in [('DSORG','PO'), ('RECFM','U'), ('LRECL','0'),
                                  ('BLKSIZE','6144'), ('VOLUME',volume)]),
         name + ' DCB or DASD VOLSER differs from approved source/restore')


def check_list(text: str, name: str) -> None:
    need(re.search(r'(?m)^' + re.escape(name) + r':\s*$', text) is not None,
         name + ' member-list identity absent')
    names = re.findall(r'(?m)^    ([A-Z0-9@$#]{1,8})\s*$', text)
    need(names == ['ICINT19'], name + ' member inventory differs from one ICINT19')


def live_preflight(preflight, contract, folder: Path) -> None:
    contract.validate_static()
    branch = preflight.checked(['git','branch','--show-current'], 'git-branch', folder)
    need(branch.strip() == 'main', 'must use authoritative GitHub main')
    changed = preflight.checked(['git','status','--porcelain','--untracked-files=no','--',
             'packaging/distribution/create-tape/scripts/run-ta1-track-b-directory',
             'packaging/distribution/create-tape/scripts/ta1b-contract',
             'packaging/distribution/create-tape/scripts/run-ta1-track-b-restore'],
             'git-contract', folder)
    need(not changed.strip(), 'tracked directory verification code modified')
    for key, name, volume in JOBS:
        stat = preflight.checked(['tools/datasets/dspal','stat',name],
                                  'stat-'+key, folder)
        stat_contract(stat, name, volume)
        members = preflight.checked(['tools/datasets/dspal','ls',name],
                                     'members-'+key, folder)
        check_list(members, name)
        deck = contract.directory_body(name, volume, 'SYSDA')
        need('DISP=SHR' in deck and 'PGM=IEHLIST' in deck and 'LISTPDS' in deck,
             'unexpected MVS IEHLIST directory deck')
    verify_receipt()
    need(not MARKER.exists() and not MARKER.is_symlink(),
         'directory jobs already attempted; never submit again')


def begin_once() -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0)
    try:
        fd = os.open(MARKER, flags, 0o600)
    except FileExistsError as exc:
        raise Halt('directory JES submission already attempted; do not retry') from exc
    with os.fdopen(fd, 'w', encoding='ascii') as out:
        json.dump({'state':'DIRECTORY_SUBMISSION_ATTEMPTED','jobs':list(name for name,_,_ in JOBS),
                   'restore_job':9136,'image_sha256':SHA,'no_retry':True}, out)
        out.write('\n'); out.flush(); os.fsync(out.fileno())


def validate_job(summary: str, report: str, jobname: str, job: int) -> None:
    need(re.search(r'(?m)^JOB\s+' + str(job) + r'\s+' + jobname + r'\s*$', summary) is not None and
         'JOB RESULT: SUCCESS' in summary and 'HIGHEST RC: 0000' in summary and
         re.findall(r'(?m)^([A-Z0-9]{1,8})\s+(\S+)\s+RC=(\d{4})\s*$', summary)
         == [('DIRLIST','IEHLIST','0000')], jobname + ' IEHLIST summary not RC=0000')
    need(re.search(r'(?m)^IEF142I\s+' + jobname +
                   r'\s+DIRLIST\s+-\s+STEP WAS EXECUTED\s+-\s+COND CODE 0000\s*$',
                   report) is not None, jobname + ' successful IEF142I missing')
    need(not re.search(r'\b(?:IEF450I|IEF472I|IEA995I)\b', report),
         jobname + ' possible MVS abend')


def submit_directory(contract, preflight, checker, config, core, jobname: str,
                     dsn: str, volume: str, folder: Path) -> dict:
    body = contract.directory_body(dsn, volume, 'SYSDA')
    need('PGM=IEHLIST' in body and 'DISP=SHR' in body,
         'IEHLIST JCL cannot alter load library')
    cards = core.authenticated_job_card(config, jobname, 'TA1B DIRECTORY', redact_password=False)
    deck = '\n'.join(cards) + '\n' + body
    cursor = OPS / ('BTA102-' + jobname + '.cursor.json')
    former = tempfile.tempdir
    try:
        tempfile.tempdir = str(OPS)
        job, summary = core.submit_and_wait(config, deck, max_rc=0, cursor_file=cursor)
    finally:
        tempfile.tempdir = former
    need(type(job) is int and 1 <= job <= 9999, 'unrecognized MVS JES job number')
    (folder / 'summary.txt').write_text(summary, encoding='utf-8')
    (folder / 'summary.txt').chmod(0o600)
    report = preflight.checked(['tools/mvs/dump-report-for-job',str(job),
                                '--cursor-file',str(cursor)], 'report', folder)
    validate_job(summary, report, jobname, job)
    result = checker.parse_directory(report, dsn=dsn, volser=volume, member='ICINT19')
    need(result['member'] == 'ICINT19' and result['other_member_rows'] == 0 and
         result['directory_dataset'] == dsn and result['directory_volume'] == volume,
         jobname + ' unexpected IEHLIST member list')
    return {'job':job, 'jobname':jobname, 'dsn':dsn, 'volume':volume,
            'entry':result['entry_point_hex'],'attributes':result['attributes_hex']}


def compare(items: list[dict]) -> dict:
    need(len(items) == 2 and
         [(x['jobname'],x['dsn'],x['volume']) for x in items] == list(JOBS),
         'source/restored job identities or volumes incorrect')
    a,b=items
    need(a['entry'] == b['entry'] == EXPECTED_ENTRY and
         a['attributes'] == b['attributes'] == EXPECTED_ATTR,
         'source/restored ICINT19 entry or load attributes mismatch')
    return {'source':a, 'restored':b,'status':'IEHLIST_DIRECTORY_MATCH_ONLY_NOT_EXECUTABLE_PROOF'}


def operation(*, run: bool) -> int:
    need(not LOG.exists() and not LOG.is_symlink(), 'directory evidence path collision')
    need(OPS.is_dir() and not OPS.is_symlink(), 'operations folder absent/unsafe')
    LOG.mkdir(mode=0o700, exist_ok=False)
    preflight = module(SCRIPTS/'ta1b-preflight', 'ta1b_directory_preflight')
    contract = module(SCRIPTS/'ta1b-contract', 'ta1b_directory_contract')
    first = LOG/'preflight-first'; first.mkdir(mode=0o700)
    live_preflight(preflight, contract, first)
    print('TA.1B IEHLIST preflight PASS: MR10_LOAD TSO003; restored LOAD TSO002; both PO/U/0/6144.')
    print('BTA102 SHA-256 and JOB 9136 receipt PASS; no tape media operation.')
    if not run:
        print('No IEHLIST JES submission or ICINT19 GO executed.')
        print('Evidence: '+str(LOG.relative_to(ROOT)))
        return 0
    need(sys.stdin.isatty(), 'interactive owner authorization required for IEHLIST jobs')
    token = 'COMPARE ICINT19 DIRECTORIES'
    need(input(f'Type {token} to authorize two read-only IEHLIST JES jobs: ').strip() == token,
         'IEHLIST job submission not confirmed')
    second = LOG/'preflight-second'; second.mkdir(mode=0o700)
    live_preflight(preflight, contract, second)
    begin_once()
    corepath = ROOT/'tools/datasets/dspal-core.py'
    need(corepath.is_file() and not corepath.is_symlink(), 'authenticated MVS core absent/unsafe')
    spec = importlib.util.spec_from_file_location('ta1b_directory_core', corepath)
    need(spec is not None and spec.loader is not None, 'cannot import MVS core')
    core = importlib.util.module_from_spec(spec);spec.loader.exec_module(core)
    config = core.load_config()
    need(str(config['mvs']['hlq']).upper() == 'HERC02', 'MVS authenticated HLQ changed')
    checker = module(ROOT/'tools/distribution/verify-iehlist-load-directory.py',
                     'ta1b_directory_parser')
    records=[]
    for jobname, dsn, volume in JOBS:
        jobdir=LOG/jobname;jobdir.mkdir(mode=0o700)
        records.append(submit_directory(contract,preflight,checker,config,core,
                                        jobname,dsn,volume,jobdir))
        print(jobname+': MVS JOB '+str(records[-1]['job'])+' IEHLIST RC=0000; ICINT19 entry='
              +records[-1]['entry']+' attrs='+records[-1]['attributes'])
    result=compare(records)
    (LOG/'directory-comparison.json').write_text(json.dumps(result,indent=2)+'\n')
    (LOG/'directory-comparison.json').chmod(0o600)
    verify_receipt()
    print('TA.1B SOURCE/RESTORED ICINT19 DIRECTORY MATCH (IEHLIST FORMAT only).')
    print('BTA102 SHA-256 preserved: '+SHA)
    print('Evidence: '+str(LOG.relative_to(ROOT)))
    print('Actual restored-STEPLIB ICINT19 GO remains separately gated.')
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run', action='store_true', help='separate owner authorization for two IEHLIST JES jobs')
    args=parser.parse_args(argv)
    try:
        return operation(run=args.run)
    except (Halt, OSError, RuntimeError, ValueError, UnicodeError) as exc:
        detail=str(exc) if isinstance(exc,Halt) else type(exc).__name__
        print('TA.1B DIRECTORY HALTED: '+detail, file=sys.stderr)
        print('No automatic JES retry; preserve original BTA102, load PDS and evidence.',file=sys.stderr)
        print('Evidence: '+str(LOG.relative_to(ROOT)),file=sys.stderr)
        return 2

if __name__ == '__main__':
    raise SystemExit(main())
