#!/usr/bin/env python3
"""TA.2 rc2: independent, read-only HETMAP SL structure review for 21 datasets.

No AWS initialization, device mount, JES, readback restore or tape mutation.
Existing evidence: --labels and --files; fresh image: --image BASENAME.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[4]
WORK = ROOT / 'workarea'
TAPES = ROOT / 'mvs-state/tape'
OUT = WORK / 'ta2-rc2-aws-review'
VOLSER = 'BC0002'
COUNT = 21
IMAGE = 'bcpl-0.1.0-rc2-BC0002.aws'
LABEL = re.compile(r"(?m)^Label\s+: '([A-Z0-9]{4})'\s*$")
FILE = re.compile(r'(?m)^File\s+#\s*:\s*(\d+)\s*$')
BLOCKS = re.compile(r'(?m)^Blocks\s*:\s*(\d+)\s*$')
RECORD = re.compile(r"(?m)^([A-Za-z ]+?)\s+: '([^']*)'\s*$")


class Refusal(ValueError):
    pass


def need(ok: bool, why: str) -> None:
    if not ok:
        raise Refusal(why)


def labels_report(report: str) -> dict:
    """Check exact ordered VOL/HDR/EOF labels and 21 logical identities."""
    matches = list(LABEL.finditer(report))
    want = ['VOL1']
    for _ in range(COUNT):
        want.extend(('HDR1', 'HDR2', 'EOF1', 'EOF2'))
    need([m.group(1) for m in matches] == want,
         'standard-label sequence/count differs from 21 ordered tape datasets')
    chunks = [report[m.end():matches[i + 1].start() if i + 1 < len(matches) else len(report)]
              for i, m in enumerate(matches)]
    header = dict(RECORD.findall(chunks[0]))
    need(header.get('Volume Serial') == VOLSER,
         'VOL1 does not identify the reserved candidate volume')
    result = []
    for sequence in range(1, COUNT + 1):
        index = 1 + (sequence - 1) * 4
        name = f'BCPL.BT{sequence:04d}'
        for offset in (0, 2):  # HDR1 and EOF1 independently attest identity.
            record = dict(RECORD.findall(chunks[index + offset]))
            need(record.get('Dataset ID', '').strip() == name and
                 record.get('Dataset Sequence') == f'{sequence:04d}' and
                 record.get('Volume Serial') == VOLSER,
                 f'{name}: HDR1/EOF1 DSN, sequence or volume mismatch')
        result.append(name)
    return {'volser': VOLSER, 'logical_datasets': COUNT,
            'dataset_names': result, 'label_records': len(want)}


def files_report(report: str) -> list[int]:
    """TA.1's observed SL physical tape-file model: 3*N+1 files."""
    rows = list(FILE.finditer(report))
    need(len(rows) == COUNT * 3 + 1,
         f'physical tape files differ: expected {COUNT * 3 + 1}, observed {len(rows)}')
    result = []
    for i, m in enumerate(rows):
        end = rows[i+1].start() if i + 1 < len(rows) else len(report)
        section = report[m.end():end]
        block = list(BLOCKS.finditer(section))
        need(int(m.group(1)) == i + 1 and len(block) == 1,
             'HETMAP file number/block count missing, repeated or out of order')
        result.append(int(block[0].group(1)))
    for n in range(COUNT):
        header, data, trailer = result[3*n:3*n+3]
        need(header == (3 if n == 0 else 2) and data > 0 and trailer == 2,
             f'BCPL.BT{n+1:04d}: unexpected header, empty data or trailer file')
    need(result[-1] == 0, 'no terminal empty tape file')
    return result


def evaluate(labels: str, files: str) -> dict:
    audited = labels_report(labels)
    blocks = files_report(files)
    audited['physical_files'] = len(blocks)
    audited['payload_blocks'] = sum(blocks[3*n+1] for n in range(COUNT))
    audited['payload_blocks_by_dataset'] = [blocks[3*n+1] for n in range(COUNT)]
    audited['qualification'] = 'AWS label and physical-file structure only; not MVS restore or member bytes'
    return audited


def save(path: Path, blob: bytes) -> None:
    with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL |
                          getattr(os, 'O_NOFOLLOW', 0), 0o600), 'wb') as f:
        f.write(blob)
        f.flush()
        os.fsync(f.fileno())


def new_folder() -> Path:
    need(WORK.is_dir() and not WORK.is_symlink() and
         WORK.resolve().is_relative_to(ROOT.resolve()) and not OUT.is_symlink(),
         'unsafe repository workarea')
    OUT.mkdir(mode=0o700, exist_ok=True)
    folder = OUT / (datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + str(os.getpid()))
    folder.mkdir(mode=0o700, exist_ok=False)
    return folder


def seal(folder: Path) -> None:
    lines = [hashlib.sha256(p.read_bytes()).hexdigest() + '  ' + p.name + '\n'
             for p in sorted(folder.iterdir()) if p.is_file() and p.name != 'SHA256SUMS']
    save(folder / 'SHA256SUMS', ''.join(lines).encode('ascii'))


def fresh_image(name: str) -> tuple[str, str, str]:
    need(name == IMAGE, 'only exact reserved rc2 image name is accepted')
    need(TAPES.is_dir() and not TAPES.is_symlink() and
         TAPES.resolve().is_relative_to(ROOT.resolve()), 'unsafe image directory')
    image = TAPES / name
    need(image.is_file() and not image.is_symlink() and image.stat().st_size > 0,
         'candidate image missing, linked or empty')
    outputs = []
    for opt in ('-l', '-f'):
        p = subprocess.run(['docker', 'exec', 'mvs38j', 'hetmap', opt,
                            '/tk5/tape/' + name], cwd=ROOT,
                           capture_output=True, text=True, check=False, timeout=90)
        need(p.returncode == 0 and p.stdout and not p.stderr.strip(),
             f'HETMAP {opt} did not return a clean report')
        outputs.append(p.stdout)
    with image.open('rb') as f:
        sha = hashlib.file_digest(f, 'sha256').hexdigest()
    return outputs[0], outputs[1], sha


def main(argv=None) -> int:
    p = argparse.ArgumentParser(description=__doc__)
    source = p.add_mutually_exclusive_group(required=True)
    source.add_argument('--image', help='read-only HETMAP review of exact rc2 image filename')
    source.add_argument('--labels', type=Path, help='saved HETMAP -l report for offline review')
    p.add_argument('--files', type=Path, help='saved HETMAP -f report; required with --labels')
    a = p.parse_args(argv)
    try:
        need((a.labels is None) == (a.files is None),
             '--labels and --files must be supplied together')
        if a.image:
            labels, files, sha = fresh_image(a.image)
        else:
            need(a.labels.is_file() and a.files.is_file() and
                 all(x.stat().st_size <= 4_000_000 for x in (a.labels, a.files)),
                 'missing/oversized saved HETMAP reports')
            labels, files = a.labels.read_text(encoding='utf-8'), a.files.read_text(encoding='utf-8')
            sha = None
        result = evaluate(labels, files)
        folder = new_folder()
        save(folder / 'labels-report.txt', labels.encode('utf-8'))
        save(folder / 'files-report.txt', files.encode('utf-8'))
        result['aws_sha256'] = sha
        save(folder / 'result.json', (json.dumps(result, indent=2, sort_keys=True) + '\n').encode())
        seal(folder)
        print(f'TA.2 RC2 AWS STRUCTURE PASS: {COUNT} standard-label datasets; '
              f'{result["physical_files"]} physical files; {result["payload_blocks"]} payload blocks.')
        if sha: print('AWS SHA-256: ' + sha)
        print('Private evidence: ' + str(folder.relative_to(ROOT)))
        print('No tape or MVS changes; restoration and execution remain independent gates.')
        return 0
    except (Refusal, ValueError, OSError, subprocess.TimeoutExpired, UnicodeError) as exc:
        print('TA.2 RC2 AWS STRUCTURE REFUSED: ' + str(exc), file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
