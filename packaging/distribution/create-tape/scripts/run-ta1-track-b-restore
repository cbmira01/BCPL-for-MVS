#!/usr/bin/env python3
"""TA.1 Track B: guarded, independently authorized BTA102 IEBCOPY restoration.

Default --check is a read-only MVS/Hercules evidence preflight.
--run requires distinct owner approval and TTY. It can mount ONLY the exact
existing BTA102 image if 0480 is empty, and can create ONLY the new DASD PDS.
Never initializes, overwrites, seeks, rewrites, retries or catalogs tape.
IEHLIST comparison and restored ICINT19 GO remain separate stages.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[4]
SCRIPT = ROOT / 'packaging/distribution/create-tape/scripts'
OPS = ROOT / 'workarea/ta1b-operations'
WRITE_LOG = OPS / 'BTA102-track-b-write-20261118T235204Z-9548'
TAPE = ROOT / 'mvs-state/tape/bcpl-ta1-b-20261117-01.aws'
ATTEMPT = OPS / 'BTA102-track-b-restore.json'
LOG = OPS / ('BTA102-track-b-restore-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + str(os.getpid()))
SHA = 'c3b235ca78d221432199adcde1f7a83aead4f76bab0e0eaa19d77c81d9912210'
JOB = 'TA1BREST'
DEST = 'HERC02.BCPL.TA1B.LOAD'
VOL = 'BTA102'


class Halt(RuntimeError):
    pass


def need(ok: bool, why: str) -> None:
    if not ok:
        raise Halt(why)


def helper(name: str):
    path = SCRIPT / name
    need(path.is_file() and not path.is_symlink(), f'unsafe/missing helper {name}')
    loader = importlib.machinery.SourceFileLoader('ta1b_restore_' + name.replace('-', '_'), str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    need(spec is not None and spec.loader is not None, 'helper load failed')
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def text_file(path: Path, max_bytes: int = 32 * 1024 * 1024) -> str:
    need(path.is_file() and not path.is_symlink() and path.stat().st_size <= max_bytes,
         'missing/unsafe saved evidence: ' + path.name)
    return path.read_text(encoding='utf-8', errors='replace')


def check_sha() -> None:
    need(TAPE.is_file() and not TAPE.is_symlink(), 'BTA102 original image missing/unsafe')
    with TAPE.open('rb') as f:
        actual = hashlib.file_digest(f, 'sha256').hexdigest()
    need(actual == SHA, 'BTA102 SHA-256 differs from JOB 9120; do not mount/read')


def write_receipt(writer) -> None:
    need(OPS.is_dir() and not OPS.is_symlink() and WRITE_LOG.is_dir() and
         not WRITE_LOG.is_symlink(), 'original write operations/evidence missing or linked')
    attempt = OPS / 'BTA102-track-b-init-write.json'
    record = json.loads(text_file(attempt, 8192))
    need(type(record) is dict and record.get('state') == 'STATEFUL_ATTEMPT_STARTED' and
         record.get('volser') == VOL and record.get('image') == TAPE.name and
         record.get('job') == 'TA1BWRIT' and record.get('no_retry') is True,
         'original virgin-tape no-retry receipt mismatch')
    need(text_file(WRITE_LOG / 'sha256.txt').strip() ==
         SHA + '  mvs-state/tape/' + TAPE.name,
         'JOB 9120 original SHA receipt mismatch')
    writer.check_summary(text_file(WRITE_LOG / 'summary.txt'), 9120)
    writer.final_labels(text_file(WRITE_LOG / 'labels-final.txt'))
    blocks = writer.physical_files(text_file(WRITE_LOG / 'files-final.txt'))
    need(blocks == [3, 8, 2, 0] and
         writer.physical_files(text_file(WRITE_LOG / 'map-final.txt')) == blocks,
         'JOB 9120 physical tape layout receipt mismatch')
    check_sha()


def check_paths() -> None:
    need(ROOT.joinpath('workarea').is_dir() and not ROOT.joinpath('workarea').is_symlink(),
         'unsafe/missing workarea')
    need(OPS.is_dir() and not OPS.is_symlink(), 'unsafe/missing TA1B operations folder')
    need(TAPE.parent.is_dir() and not TAPE.parent.is_symlink() and
         not TAPE.parent.parent.is_symlink(), 'unsafe tape directory')
    need(not ATTEMPT.exists() and not ATTEMPT.is_symlink(),
         'restore attempt already recorded: DO NOT RETRY')
    check_sha()


def tape_state(preflight, writer, folder: Path) -> str:
    console = preflight.checked(['tools/mvs/mvs-console', 'tape', 'status', '0480'],
                                 'tape-status', folder)
    matches = [x for x in console.splitlines() if re.search(r'\b0:0480\s+3420\s+', x)]
    need(len(matches) == 1 and not re.search(r'\bbusy\b', matches[0], re.I),
         'Hercules 0480 missing/busy/ambiguous')
    empty = bool(re.search(r'\b3420\s+\*\s', matches[0]))
    ours = bool(re.search(r'(?:^|\s)/tk5/tape/' + re.escape(TAPE.name) + r'(?=\s|$)', matches[0]))
    need(empty != ours, '0480 has unknown/foreign media or conflicting status')
    writer.unit_ready(preflight, folder, mounted=ours)
    return 'mounted' if ours else 'empty'


def other_media(preflight, folder: Path) -> int:
    count = 0
    for f in sorted(TAPE.parent.iterdir()):
        if f.name == '.gitkeep' or f == TAPE:
            continue
        need(f.is_file() and not f.is_symlink() and f.suffix.lower() in ('.aws', '.het'),
             'unknown tape media: ' + f.name)
        labels = preflight.checked(['docker', 'exec', 'mvs38j', 'hetmap', '-l',
                                    '/tk5/tape/' + f.name], 'other-hetmap-%03d' % count, folder)
        need(preflight.parse_volser(labels) != VOL,
             'BTA102 duplicate VOLSER on alternate image: ' + f.name)
        count += 1
    return count


def precheck(contract, preflight, writer, folder: Path) -> str:
    check_paths()
    contract.validate_static()
    branch = preflight.checked(['git', 'branch', '--show-current'], 'git-branch', folder).strip()
    need(branch == 'main', 'not on GitHub main')
    changes = [
        'packaging/distribution/create-tape/scripts/run-ta1-track-b-restore',
        'packaging/distribution/create-tape/scripts/run-ta1-track-b-write',
        'packaging/distribution/create-tape/scripts/ta1b-preflight',
        'packaging/distribution/create-tape/scripts/ta1b-contract',
        'packaging/distribution/create-tape/jcl/TA1BREST.jcl',
        'packaging/distribution/create-tape/jcl/TA1BWRIT.jcl',
    ]
    modified = preflight.checked(['git', 'status', '--porcelain', '--untracked-files=no',
                                  '--', *changes], 'git-restore-guard', folder)
    need(not modified.strip(), 'reviewed restore/contract/JCL differs from main')
    need(preflight.checked(['docker','inspect','-f','{{.State.Running}}','mvs38j'],
                           'docker-running', folder).strip() == 'true', 'MVS container stopped')
    bind = preflight.checked(['docker','inspect','-f',
           '{{range .Mounts}}{{if eq .Destination "/tk5/tape"}}{{.Source}}{{end}}{{end}}',
           'mvs38j'], 'docker-tape-bind', folder).strip()
    need(Path(bind).resolve() == TAPE.parent.resolve(), 'wrong Docker tape bind')
    source = preflight.checked(['tools/datasets/dspal','stat','MR10_LOAD'], 'source-stat', folder)
    need(preflight.parse_source_stat(source) == 'TSO003', 'MR10_LOAD source volume drift')
    preflight.parse_members(preflight.checked(['tools/datasets/dspal','ls','MR10_LOAD'],
                                               'source-members', folder))
    for number, name in enumerate((DEST, 'BCPL.BT0001'), 1):
        rc, output = preflight.run(['tools/datasets/dspal','stat',name],
                                   'absent-%d' % number, folder)
        preflight.absent(rc, output, name)
    checked = preflight.checked(['docker','exec','mvs38j','hetmap','-l',
                                 '/tk5/tape/'+TAPE.name], 'labels-fresh', folder)
    writer.final_labels(checked)
    blocks = writer.physical_files(preflight.checked(['docker','exec','mvs38j','hetmap','-f',
                                      '/tk5/tape/'+TAPE.name], 'files-fresh', folder))
    need(blocks == [3, 8, 2, 0], 'new tape filemark layout drift')
    need(writer.physical_files(preflight.checked(['docker','exec','mvs38j','hetmap','-a',
                            '/tk5/tape/'+TAPE.name], 'map-fresh', folder)) == blocks,
         'Hercules -a/-f disagree')
    count = other_media(preflight, folder)
    state = tape_state(preflight, writer, folder)
    check_sha()
    return state


def begin_once() -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0)
    try:
        fd = os.open(ATTEMPT, flags, 0o600)
    except FileExistsError as exc:
        raise Halt('restore attempt already exists; never retry') from exc
    with os.fdopen(fd, 'w', encoding='ascii') as out:
        json.dump({'state':'RESTORE_ATTEMPTED', 'job':JOB, 'volser':VOL,
                   'sha256':SHA, 'target':DEST, 'no_retry':True}, out)
        out.write('\n'); out.flush(); os.fsync(out.fileno())


def restore_job(contract, preflight, folder: Path) -> int:
    corepath = ROOT / 'tools/datasets/dspal-core.py'
    need(corepath.is_file() and not corepath.is_symlink(), 'dspal core missing/unsafe')
    spec = importlib.util.spec_from_file_location('ta1b_restore_dspal', corepath)
    need(spec is not None and spec.loader is not None, 'cannot load dspal core')
    core = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(core)
    config = core.load_config()
    need(str(config['mvs']['hlq']).upper() == 'HERC02', 'wrong authenticated HLQ')
    deck = ('\n'.join(core.authenticated_job_card(config, JOB, 'TA1B RESTORE',
              redact_password=False)) + '\n' + contract.file_cards(JOB))
    cursor = OPS / 'BTA102-TA1BREST.cursor.json'
    previous = tempfile.tempdir
    try:
        tempfile.tempdir = str(OPS)
        job, summary = core.submit_and_wait(config, deck, max_rc=0, cursor_file=cursor)
    finally:
        tempfile.tempdir = previous
    need(type(job) is int and job > 0, 'ambiguous MVS job number')
    private = folder / 'summary.txt'
    with private.open('x', encoding='utf-8') as out:
        os.fchmod(out.fileno(), 0o600)
        out.write(summary)
    need(re.search(rf'(?m)^JOB\s+{job}\s+{JOB}\s*$', summary) is not None and
         'JOB RESULT: SUCCESS' in summary and 'HIGHEST RC: 0000' in summary and
         re.findall(r'(?m)^([A-Z0-9]{1,8})\s+(\S+)\s+RC=(\d{4})\s*$', summary)
         == [('RESTORE','IEBCOPY','0000')], 'TA1BREST not verified IEBCOPY RC=0000')
    preflight.checked(['tools/mvs/dump-report-for-job',str(job),'--cursor-file',str(cursor)],
                      'jes-report', folder)
    return job


def check_restored(preflight, folder: Path) -> str:
    stat = preflight.checked(['tools/datasets/dspal','stat', DEST], 'restored-stat', folder).upper()
    need('DATASET:   ' + DEST in stat and
         all(re.search(r'\b' + key + r'\s*:\s*' + val + r'\b', stat)
             for key,val in [('DSORG','PO'),('RECFM','U'),('LRECL','0'),('BLKSIZE','6144')]),
         'restored load PDS not PO/U/0/6144')
    vol = re.search(r'\bVOLUME\s*:\s*([A-Z0-9]{1,6})\b', stat)
    need(vol is not None, 'restored DASD VOLSER unavailable')
    listing = preflight.checked(['tools/datasets/dspal','ls',DEST],
                                 'restored-members', folder)
    need(re.search(r'(?m)^' + re.escape(DEST) + r':\s*$', listing) is not None and
         re.findall(r'(?m)^    ([A-Z0-9@$#]{1,8})\s*$', listing) == ['ICINT19'],
         'restored load PDS member inventory differs from one ICINT19')
    return vol.group(1)


def operation(run: bool) -> int:
    need(not LOG.exists() and not LOG.is_symlink(), 'readback evidence path collision')
    need(OPS.is_dir() and not OPS.is_symlink(), 'TA1B operations folder missing/unsafe')
    LOG.mkdir(mode=0o700, exist_ok=False)
    writer = helper('run-ta1-track-b-write')
    preflight = helper('ta1b-preflight')
    contract = helper('ta1b-contract')
    write_receipt(writer)
    first = LOG / 'preflight-first'; first.mkdir(mode=0o700)
    state = precheck(contract, preflight, writer, first)
    print(f'BTA102 JOB 9120 write receipt and immutable SHA-256 PASS; drive {state}.')
    print('TA.1 Track B restore preflight PASS (new DASD PDS still absent).')
    if not run:
        print('No remount, new DASD dataset, restore, IEHLIST or GO executed.')
        print('Evidence: ' + str(LOG.relative_to(ROOT)))
        return 0
    need(sys.stdin.isatty(), 'interactive owner authorization required')
    token = 'RESTORE BTA102 ICINT19'
    need(input(f'Type {token} to authorize a new load PDS and conditional remount: ').strip() == token,
         'no explicit restore authorization')
    check_paths()
    second = LOG / 'preflight-second'; second.mkdir(mode=0o700)
    state = precheck(contract, preflight, writer, second)
    begin_once()  # no retry: irreversible receipt before any remount or JES submission
    third = LOG / 'mount'; third.mkdir(mode=0o700)
    if state == 'empty':
        # Last direct device check before mount; never displace newly arrived media.
        before_mount = LOG / 'pre-mount'; before_mount.mkdir(mode=0o700)
        need(tape_state(preflight, writer, before_mount) == 'empty',
             '0480 changed immediately before mount; preserve media and stop')
        preflight.checked(['tools/mvs/mvs-console','--yes','tape','mount','0480',TAPE.name],
                          'mount-exact-BTA102', third)
    need(tape_state(preflight, writer, third) == 'mounted',
         'BTA102 not mounted and MVS ready; stop without JES submission')
    check_sha()
    token = 'SUBMIT TA1BREST BTA102'
    print('BTA102 identity/ready status confirmed; one new PO/U/0/6144 DASD load PDS.')
    need(input(f'Type {token} to submit IEBCOPY restore exactly once: ').strip() == token,
         'restore submission not confirmed; preserve media and receipt')
    job = restore_job(contract, preflight, LOG)
    volume = check_restored(preflight, LOG)
    check_sha()
    print(f'TA1BREST MVS JOB {job}: IEBCOPY RESTORE RC=0000.')
    print(f'Restored {DEST}(ICINT19): PO/U/0/6144 on {volume}.')
    print('BTA102 SHA-256 unchanged: ' + SHA)
    print('Evidence: ' + str(LOG.relative_to(ROOT)))
    print('IEHLIST directory comparison and restored ICINT19 GO remain separately gated.')
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run', action='store_true', help='separate owner authorization required')
    args = parser.parse_args(argv)
    try:
        return operation(args.run)
    except (Halt, ValueError, OSError, RuntimeError, UnicodeError) as exc:
        detail = str(exc) if isinstance(exc, Halt) else type(exc).__name__
        print('TA.1B RESTORE HALTED: ' + detail, file=sys.stderr)
        print('Preserve BTA102 and MVS evidence; do not retry, remount, overwrite or GO.',
              file=sys.stderr)
        print('Evidence: ' + str(LOG.relative_to(ROOT)), file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
