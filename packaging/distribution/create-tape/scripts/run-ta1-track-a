#!/usr/bin/env python3
"""TA.1 Track A: authorized one-shot scratch tape init, mount, write, inspect.

Run ONLY under separately granted authorization for BTA101/0480/TA1AWRIT.
Stateful errors are terminal. Never retry, reinitialize, remount, or resume.
All generated files live under repository workarea/ or mvs-state/tape/.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys

# Dynamic imports and child Python utilities must not leave __pycache__
# files in tracked repository paths.
sys.dont_write_bytecode = True

ROOT = Path(__file__).resolve().parents[4]
IMAGE = 'bcpl-ta1-a-20261117-01.aws'
VOLSER = 'BTA101'
UNIT = '0480'
TAPE = ROOT / 'mvs-state/tape' / IMAGE
OPS = ROOT / 'workarea/ta1-operations'
ATTEMPT = OPS / 'BTA101-track-a-init-write.json'
LOG = OPS / ('BTA101-track-a-execution-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + str(os.getpid()))
SCRIPTS = ROOT / 'packaging/distribution/create-tape/scripts'
EXPECTED_MEMBERS = {'COMPILE', 'DATASETS', 'INSTALL', 'LICENSE', 'README', 'RELEASE', 'VERIFY'}
MISSING = ('HERC02.BCPL.TA1A.FBREST', 'HERC02.BCPL.TA1A.PDSREST',
           'BCPL.BT0001', 'BCPL.BT0002')


class Halt(RuntimeError):
    pass


def require(condition: bool, reason: str) -> None:
    if not condition:
        raise Halt(reason)


def load_guard():
    path = SCRIPTS / 'ta1-preflight'
    loader = importlib.machinery.SourceFileLoader('ta1_guard_for_operator', str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    require(spec is not None, 'missing static validator')
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def capture(name: str, argv: list[str], *, root: Path = ROOT,
            log: Path | None = None) -> tuple[int, str]:
    """Capture full evidence without flooding console; never use a shell."""
    workarea = root / 'workarea'
    env = dict(os.environ, TMPDIR=str(workarea), TMP=str(workarea), TEMP=str(workarea),
               PYTHONDONTWRITEBYTECODE='1')
    try:
        cp = subprocess.run(argv, cwd=root, env=env, text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            check=False)
        output, rc = cp.stdout or '', cp.returncode
    except OSError as exc:
        output, rc = f'{type(exc).__name__}: {exc}\n', 127
    if log is not None:
        log.mkdir(mode=0o700, parents=True, exist_ok=True)
        file = log / (name + '.txt')
        # Exclude credentials from logged argv. Actual output can include JES
        # printer messages and must remain in ignored workarea with private mode.
        with file.open('w', encoding='utf-8') as out:
            out.write(output)
        file.chmod(0o600)
    return rc, output


def must_run(name: str, argv: list[str], *, log: Path,
             acceptable: tuple[int, ...] = (0,)) -> tuple[int, str]:
    rc, output = capture(name, argv, log=log)
    require(rc in acceptable, f'{name} returned RC={rc}; examine {log.relative_to(ROOT)}/{name}.txt; DO NOT RETRY')
    return rc, output


def check_identity(log: Path) -> None:
    _, branch = must_run('git-branch', ['git', 'branch', '--show-current'], log=log)
    require(branch.strip() == 'main', 'refuse outside main')
    _, head = must_run('git-head', ['git', 'rev-parse', '--verify', 'HEAD'], log=log)
    require(bool(re.fullmatch('[a-f0-9]{40}', head.strip())), 'cannot identify Git HEAD')
    changes = [str((SCRIPTS / 'ta1-preflight').relative_to(ROOT)),
               str((SCRIPTS / 'submit-ta1-job').relative_to(ROOT)),
               str((SCRIPTS / 'run-ta1-track-a').relative_to(ROOT)),
               str((SCRIPTS.parent / 'jcl/TA1AWRIT.jcl').relative_to(ROOT))]
    rc, output = capture('git-guard', ['git', 'status', '--porcelain', '--untracked-files=no', '--', *changes], log=log)
    require(rc == 0 and not output.strip(), 'reviewed tracked files have local modifications')


def check_docker(log: Path) -> None:
    _, status = must_run('docker-running', ['docker', 'inspect', '-f', '{{.State.Running}}', 'mvs38j'], log=log)
    require(status.strip() == 'true', 'MVS/Hercules Docker container not running')
    _, bind = must_run('docker-tape-bind', ['docker', 'inspect', '-f',
        '{{range .Mounts}}{{if eq .Destination "/tk5/tape"}}{{.Source}}{{end}}{{end}}', 'mvs38j'], log=log)
    require(Path(bind.strip()).resolve() == TAPE.parent.resolve(),
            'Docker tape mount is NOT this checkout mvs-state/tape')
    envrc, envout = capture('docker-config-env', ['docker', 'inspect', '-f', '{{json .Config.Env}}', 'mvs38j'])
    require(envrc == 0, 'cannot inspect Docker runtime UID/GID')
    try:
        envlist = json.loads(envout)
    except (ValueError, TypeError) as exc:
        raise Halt('cannot parse Docker MVS runtime identity') from exc
    vars = dict(item.split('=', 1) for item in envlist if '=' in item)
    require(vars.get('MVS_UID') == str(os.getuid()) and vars.get('MVS_GID') == str(os.getgid()),
            'MVS runtime UID/GID differs from invoking repository user')
    (log / 'docker-runtime-identity.txt').write_text('MVS_UID=' + vars['MVS_UID'] + '\nMVS_GID=' + vars['MVS_GID'] + '\n')
    (log / 'docker-runtime-identity.txt').chmod(0o600)
    _, helptext = must_run('hetinit-help', ['docker', 'exec', 'mvs38j', 'hetinit', '-h'], log=log)
    require('-d' in helptext and '-i' in helptext,
            'installed hetinit help does not confirm -d -i')


def tape_map(name: str, log: Path) -> str:
    _, text = must_run('labels-' + name.replace('.', '-'),
        ['docker', 'exec', 'mvs38j', 'hetmap', '-l', '/tk5/tape/' + name], log=log)
    require("Label               : 'VOL1'" in text, f'{name}: no reliable VOL1 label')
    return text


def volser_of(labels: str) -> str:
    m = re.search(r"(?m)^Volume Serial\s+:\s+'([A-Z0-9]{1,6})'\s*$", labels)
    require(m is not None, 'cannot parse VOL1 VOLSER')
    return m.group(1)


def check_existing_media(log: Path) -> None:
    require(TAPE.parent.is_dir() and not TAPE.parent.is_symlink() and
            not TAPE.parent.parent.is_symlink() and
            TAPE.parent.resolve().is_relative_to(ROOT.resolve()),
            'unsafe tape directory')
    require(not TAPE.exists() and not TAPE.is_symlink(), 'new tape path already in use: NO OVERWRITE')
    for path in sorted(TAPE.parent.iterdir()):
        if path.name == '.gitkeep':
            continue
        require(path.is_file() and not path.is_symlink() and
                path.suffix.lower() in ('.aws', '.het'),
                f'unknown or unsafe media entry: {path.name}')
        serial = volser_of(tape_map(path.name, log))
        require(serial != VOLSER, f'VOLSER {VOLSER} already on {path.name}')


def check_guest(log: Path) -> None:
    _, src = must_run('mvs-source-stat', ['tools/datasets/dspal', 'stat', 'DIST_DOCS'], log=log)
    normalized = ' '.join(src.upper().split())
    require('HERC02.BCPL.DIST.DOCS' in normalized and
            'DSORG:PO' in normalized and 'RECFM:FB' in normalized and
            'LRECL:80' in normalized and 'BLKSIZE:800' in normalized,
            'DIST.DOCS does not match PO/FB/80/800 fixture')
    _, listing = must_run('mvs-source-members', ['tools/datasets/dspal', 'ls', 'DIST_DOCS'], log=log)
    seen = set(re.findall(r'(?m)^\s{4}([A-Z0-9@$#]{1,8})\s*$', listing))
    require(seen == EXPECTED_MEMBERS, 'source PDS members differ from seven-member fixture')
    for index, dsn in enumerate(MISSING, 1):
        rc, output = capture(f'mvs-absent-{index}', ['tools/datasets/dspal', 'stat', dsn], log=log)
        require(rc == 2 and 'data set not found: ' + dsn in output,
                f'MVS catalog collision or ambiguous inquiry for {dsn}')


def inspect_device(log: Path, suffix: str, *, mounted: bool) -> None:
    _, device = must_run('hercules-device-' + suffix,
        ['tools/mvs/mvs-console', 'tape', 'status', UNIT], log=log)
    lines = [x for x in device.splitlines() if re.search(r'\b0:0480\s+3420\s+', x)]
    require(len(lines) == 1, 'Hercules devlist does not prove one 0480/3420')
    line = lines[0]
    require('busy' not in line.lower(), 'tape device busy')
    if mounted:
        require(IMAGE in line, 'Hercules mount not confirmed by devlist; do not write')
    else:
        require(re.search(r'\b3420\s+\*\s', line) is not None,
                '0480 has mounted media; would displace existing tape')
    _, mvs = must_run('mvs-unit-' + suffix,
        ['tools/mvs/mvs-console', 'mvs', 'D U,TAPE'], log=log)
    unitrows = [x for x in mvs.splitlines() if re.search(r'\b480\s+3400\s+', x)]
    require(unitrows, 'MVS did not report tape unit 480')
    require(any(re.search(r'\b480\s+3400\s+O(?:\s|$)', x) for x in unitrows),
            'MVS tape unit 480 not online/ready')
    require(not any(re.search(r'\b480\s+3400\s+(?:ALLOC|BUSY)', x, re.I) for x in unitrows),
            'unit appears allocated/busy')


def reserve_once() -> None:
    require(not OPS.is_symlink(), 'unsafe workarea attempt directory')
    OPS.mkdir(parents=True, exist_ok=True)
    fd = -1
    try:
        fd = os.open(ATTEMPT, os.O_WRONLY | os.O_CREAT | os.O_EXCL |
                     getattr(os, 'O_NOFOLLOW', 0), 0o600)
        with os.fdopen(fd, 'w') as handle:
            fd = -1
            json.dump({'volser': VOLSER, 'image': IMAGE,
                       'state': 'AUTHORIZED_STATEFUL_ATTEMPT_STARTED',
                       'policy': 'DO_NOT_RETRY'}, handle)
            handle.write('\n')
            handle.flush()
            os.fsync(handle.fileno())
    except FileExistsError as exc:
        raise Halt('stateful operation already attempted; never retry this media') from exc
    finally:
        if fd >= 0:
            os.close(fd)


def reserve_image() -> None:
    fd = -1
    try:
        fd = os.open(TAPE, os.O_CREAT | os.O_EXCL | os.O_WRONLY |
                     getattr(os, 'O_NOFOLLOW', 0), 0o600)
    except FileExistsError as exc:
        raise Halt('image appeared during preflight; refuse overwrite') from exc
    finally:
        if fd >= 0:
            os.close(fd)


def finish_inspection(log: Path) -> None:
    # Do not change mount state, seek, append or retry even if this fails.
    for mode, label in (('-l', 'labels-final'), ('-f', 'files-final'),
                        ('-a', 'map-final')):
        must_run(label, ['docker', 'exec', 'mvs38j', 'hetmap', mode,
                          '/tk5/tape/' + IMAGE], log=log)
    labels = (log / 'labels-final.txt').read_text()
    require(volser_of(labels) == VOLSER, 'postwrite VOL1 VOLSER differs')
    blocks = re.split(r"(?=Label\s+: '\w{4}')", labels)
    label_types = [re.search(r"^Label\s+: '(\w{4})'", b).group(1)
                   for b in blocks if re.match(r"^Label\s+: '(\w{4})'", b)]
    for label, count in [('VOL1', 1), ('HDR1', 2), ('HDR2', 2),
                         ('EOF1', 2), ('EOF2', 2)]:
        require(label_types.count(label) == count,
                f'expected {count} {label} labels, observed {label_types.count(label)}')
    hdr = [b for b in blocks if b.startswith("Label               : 'HDR1'")]
    eof = [b for b in blocks if b.startswith("Label               : 'EOF1'")]
    for sequence, dsn in enumerate(('BCPL.BT0001', 'BCPL.BT0002'), start=1):
        for block in (hdr[sequence - 1], eof[sequence - 1]):
            require(f"Dataset ID          : '{dsn}" in block and
                    f"Dataset Sequence    : '{sequence:04d}'" in block and
                    f"Volume Serial       : '{VOLSER}'" in block,
                    f'missing correct DSN/VOLSER/sequence for {dsn}')
    with TAPE.open('rb') as f:
        digest = hashlib.file_digest(f, 'sha256').hexdigest()
    (log / 'sha256.txt').write_text(f'{digest}  mvs-state/tape/{IMAGE}\n')
    (log / 'sha256.txt').chmod(0o600)
    print('Written tape observed; SHA-256: ' + digest)
    print('Both BCPL.BT0001 and BCPL.BT0002 labels appear in hetmap output.')


def operation() -> int:
    require(sys.stdin.isatty(), 'interactive TTY required for one-shot operation')
    require((ROOT / 'workarea').is_dir() and not (ROOT / 'workarea').is_symlink(),
            'expected ignored workarea missing/unsafe')
    require(not ATTEMPT.exists() and not ATTEMPT.is_symlink(),
            'a previous stateful attempt already exists; NO REPLAY')
    require(not OPS.is_symlink() and not LOG.is_symlink(),
            'unsafe attempt/evidence directories')
    LOG.mkdir(parents=True, exist_ok=True, mode=0o700)
    print('TA.1 Track A: fresh MVS/catalog/Hercules/VOLSER preflight...')
    guard = load_guard()
    guard.validate_contract()
    guard.validate_image_absent()
    check_identity(LOG)
    check_docker(LOG)
    check_existing_media(LOG)
    inspect_device(LOG, 'before', mounted=False)
    check_guest(LOG)
    guard.validate_image_absent()
    print('Read-only live preflight PASS. No new tape file has been created.')
    confirm = 'INIT MOUNT WRITE BTA101'
    print(f'Approved one-shot operation: new {IMAGE}, 0480, TA1AWRIT.')
    require(input(f'Type {confirm} to proceed: ').strip() == confirm,
            'not confirmed; no stateful operation attempted')
    # Last snapshot before media creation; never allow an old image to be reused.
    check_existing_media(LOG)
    inspect_device(LOG, 'recheck', mounted=False)
    reserve_once()
    reserve_image()
    user = f'{os.getuid()}:{os.getgid()}'
    must_run('initialize', ['docker', 'exec', '--user', user, 'mvs38j',
                            'hetinit', '-d', '-i', '/tk5/tape/' + IMAGE, VOLSER], log=LOG)
    require(volser_of(tape_map(IMAGE, LOG)) == VOLSER,
            'initialized image did not report intended standard VOL1')
    inspect_device(LOG, 'before-mount', mounted=False)
    must_run('mount', ['tools/mvs/mvs-console', '--yes', 'tape', 'mount', UNIT, IMAGE], log=LOG)
    inspect_device(LOG, 'mounted', mounted=True)
    print('Initialized BTA101 and mounted at Hercules 0480. Submit TA1AWRIT once.')
    print('At the next prompt, type: SUBMIT TA1AWRIT BTA101')
    _, submit = must_run('submit', [str(SCRIPTS / 'submit-ta1-job'), 'TA1AWRIT', '--run'], log=LOG)
    m = re.search(r'TA1AWRIT: JES JOB (\d+) returned accepted RC=0', submit)
    require(m is not None, 'job result ambiguous; preserve media and examine JES')
    job = m.group(1)
    print('MVS TA1AWRIT JOB ' + job + ': submission helper reported RC=0.')
    cursor = OPS / 'BTA101-TA1AWRIT.cursor.json'
    _, summary = must_run('summary', ['tools/mvs/job-summary', job, '--max-rc', '0',
                                     '--cursor-file', str(cursor)], log=LOG)
    require(re.search(r'\bBOOTSTRP\b.*\bRC[= :]0+\b', summary) is not None and
            re.search(r'\bUNLOAD\b.*\bRC[= :]0+\b', summary) is not None,
            'two expected MVS steps with RC=0 not confirmed')
    must_run('jes-report', ['tools/mvs/dump-report-for-job', job,
                            '--cursor-file', str(cursor)], log=LOG)
    # Observe post-job console without changing mount state. Never remount automatically.
    must_run('hercules-after', ['tools/mvs/mvs-console', 'tape', 'status', UNIT], log=LOG)
    must_run('mvs-after', ['tools/mvs/mvs-console', 'mvs', 'D U,TAPE'], log=LOG)
    finish_inspection(LOG)
    print('TA.1 Track A write-only stage complete. Restores remain separately gated.')
    print('Evidence: ' + str(LOG.relative_to(ROOT)))
    return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--run', action='store_true', help='perform specifically approved operation')
    args = ap.parse_args(argv)
    if not args.run:
        print('No operation. --run requires explicit TA.1 BTA101 authorization.')
        return 0
    try:
        return operation()
    except (Halt, OSError, ValueError, RuntimeError) as exc:
        print('TA.1 HALTED: ' + str(exc), file=sys.stderr)
        print('If initialized or mounted, preserve media; do not retry, reinitialize, seek or remount.', file=sys.stderr)
        print('Evidence location: ' + str(LOG.relative_to(ROOT)), file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
