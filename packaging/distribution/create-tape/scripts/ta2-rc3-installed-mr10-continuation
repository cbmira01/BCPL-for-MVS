#!/usr/bin/env python3
"""TA.2 RC3: verify existing restored recipients and run installed MR10 ONCE.

This continuation is exclusively for BC0003 after JOB 9363 and the
read-only 9365/9366 diagnostic. It NEVER mounts/unmounts/initializes/writes
tape, restages or re-restores datasets. Default: offline receipt review.
--run: fresh read-only TSO DCB/directory inquiries, then one confirmed
installed 63-step MRREGRES job with independent 12-case semantic review.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[4]
SCRIPTS = ROOT / 'packaging/distribution/create-tape/scripts'
WORK = ROOT / 'workarea'
OUT = WORK / 'ta2-rc3-installed-mr10-continuation'
MARKER = OUT / 'BC0003-installed-mr10-one-shot.json'
DIAGNOSTIC = WORK / 'ta2-rc3-recipient-diagnostic/20261122T234725Z-32362'
JOBS = {'restore':9363, 'old_catalog':9365, 'old_members':9366}
DSN_LABEL = re.compile(r'[A-Z@$#][A-Z0-9@$#]{0,7}(?:\.[A-Z@$#][A-Z0-9@$#]{0,7})+\Z')


class Refusal(RuntimeError):
    pass


def need(ok, why):
    if not ok:
        raise Refusal(why)


def sealed(folder, rc3, required):
    need(folder.is_dir() and not folder.is_symlink() and
         folder.resolve().is_relative_to(WORK.resolve()),
         'MVS evidence folder missing/unsafe: ' + folder.name)
    checks = folder / 'SHA256SUMS'
    need(checks.is_file() and not checks.is_symlink(), 'MVS evidence seal absent')
    known = {}
    for line in checks.read_text('ascii').splitlines():
        match = re.fullmatch(r'([a-f0-9]{64})  ([A-Za-z0-9][A-Za-z0-9_.-]*)', line)
        need(match is not None and match.group(2) not in known,
             'MVS evidence seal malformed or duplicated')
        known[match.group(2)] = match.group(1)
    need(set(required) <= set(known) and
         {p.name for p in folder.iterdir()} == set(known) | {'SHA256SUMS'},
         'MVS evidence files incomplete/changed')
    for name, sha in known.items():
        p = folder / name
        need(p.is_file() and not p.is_symlink() and rc3.digest(p.read_bytes()) == sha,
             'MVS evidence checksum differs: ' + name)
    return known


def diagnostic_checkpoint(rc3, diag, cont, rows):
    """Verify historical saved MVS jobs and exact previous false BOOT hit."""
    restore, _ = diag.sealed_incident(rc3, cont)
    need(restore == JOBS['restore'], 'historical restored JOB changed')
    sealed(DIAGNOSTIC, rc3, {'diagnostic.json','catalog-summary.txt',
                            'catalog-report.txt','members-summary.txt','members-report.txt'})
    record = json.loads((DIAGNOSTIC / 'diagnostic.json').read_text('utf-8'))
    need(record.get('status') == 'DIAGNOSTIC_ONLY_NOT_INSTALL_ACCEPTANCE' and
         record.get('candidate') == cont.CANDIDATE and
         record.get('aws_sha256') == cont.AWS_SHA256 and
         record.get('restore_job') == JOBS['restore'] and
         record.get('catalog_job') == JOBS['old_catalog'] and
         record.get('directory_job') == JOBS['old_members'] and
         record.get('dcb_discrepancies') == 1 and
         record.get('member_discrepancies') == 0 and
         record.get('verified_member_count') == 146 and
         record.get('existing_restore_not_repeated') is True and
         record.get('regression_executed') is False and
         record.get('publication_authorized') is False,
         'original recipient diagnostic receipt differs')
    items = record.get('live_catalog')
    member_rows = record.get('members')
    expected_names = [r['target'] for r in rows]
    need(isinstance(items, list) and len(items) == 21 and
         [r.get('dataset') for r in items] == expected_names and
         isinstance(member_rows, list) and len(member_rows) == 20 and
         [r.get('dataset') for r in member_rows] == expected_names[1:] and
         all(r.get('match') is True and r.get('actual_count') == len(src['members'])
             for r, src in zip(member_rows, rows[1:])),
         'recipient diagnostic inventory changed')
    boot = items[0]
    raw = boot.get('raw_listds_block')
    need(boot.get('dataset') == expected_names[0] and
         boot.get('mismatches') == ['dsorg: expected PS, observed PO'] and
         boot.get('expected', {}).get('dsorg') == 'PS' and
         boot.get('actual', {}).get('dsorg') == 'PO' and
         isinstance(raw, list) and bool(raw) and
         raw[0].strip().upper() == expected_names[0] + '.JCL' and
         all(not r.get('mismatches') for r in items[1:]),
         'historic BOOT-prefix LISTDS diagnosis differs')
    need(cont.digest(cont.IMAGE) == cont.AWS_SHA256,
         'BC0003 physical image differs from accepted write')
    return (DIAGNOSTIC / 'catalog-report.txt').read_text('utf-8')


def exact_listds(core, report, dsn):
    """Select only stand-alone exact DSN labels, never DSN-prefix results.

    The accepted 9365 report includes e.g. BOOT and BOOT.JCL: the generic
    substring-based extract_listds_block chose the *last*, BOOT.JCL,
    wrongly returning PO for the separate PS BOOT dataset. Do not use
    command-echo text or a substring match as an MVS dataset identity.
    """
    lines = report.replace('\r', '').splitlines()
    wanted = dsn.upper()
    candidates = []
    for index, line in enumerate(lines):
        if line.strip().upper() != wanted:
            continue
        block = [line.rstrip()]
        for following in lines[index + 1:]:
            token = following.strip().upper()
            if (DSN_LABEL.fullmatch(token) or
                token.startswith(('IEF','JES2.JOB','$HASP')) or
                re.search(r"\bLISTDS\s+'", token)):
                break
            block.append(following.rstrip())
            if len(block) >= 24:
                break
        if not any('RECFM' in text.upper() and 'DSORG' in text.upper() for text in block):
            continue
        actual = core.parse_listds(block)
        required = ('volume','dsorg','recfm','lrecl','blksize')
        if all(actual.get(k) is not None for k in required):
            candidates.append((actual, block))
    need(candidates, 'exact MVS LISTDS label/DCB missing for: ' + dsn)
    attrs, block = candidates[-1]
    need(all(a == attrs for a, _ in candidates),
         'contradictory duplicate exact LISTDS entries for: ' + dsn)
    return attrs, block


def exact_inventory(core, rc3, rows, report):
    results = []
    for row in rows:
        name = row['target']
        actual, block = exact_listds(core, report, name)
        d = row['dcb']
        expected = {'volume': rc3.VOLUME, 'dsorg': d['dsorg'],
                    'recfm': d['recfm'], 'lrecl': str(d['lrecl']),
                    'blksize': str(d['blksize'])}
        need(not core.dataset_missing(report, name), 'MVS recipient missing: ' + name)
        differences = [f'{k} expected {v} observed {actual.get(k)}'
                       for k,v in expected.items() if actual.get(k) != v]
        results.append({'dataset':name, 'expected':expected, 'actual':actual,
                        'differences':differences,
                        'raw_block':block if differences else []})
    need(len(results) == 21, 'recipient inventory not exactly 21 datasets')
    return results


def catalog(core, cfg, rc3, folder, rows):
    """Actual MVS read-only TSO LISTDS; exact-name DCB verification."""
    deck = core.stat_deck(cfg, [r['target'] for r in rows])
    old, env = tempfile.tempdir, os.environ.get('TMPDIR')
    try:
        tempfile.tempdir = str(folder); os.environ['TMPDIR'] = str(folder)
        job, summary = core.submit_and_wait(cfg, deck, max_rc=0,
                          cursor_file=folder / 'catalog-cursor.json')
        rc3.artifact(folder, 'catalog-summary.txt', summary)
        report = core.job_report(job, cursor_file=folder / 'catalog-cursor.json')
        rc3.artifact(folder, 'catalog-report.txt', report)
    finally:
        tempfile.tempdir = old
        if env is None: os.environ.pop('TMPDIR', None)
        else: os.environ['TMPDIR'] = env
    need(re.search(rf'(?m)^JOB\s+{job}\s+DSPALST\s*$', summary) is not None and
         'JOB RESULT: SUCCESS' in summary and 'HIGHEST RC: 0000' in summary and
         re.search(r'(?m)^IEF142I\s+DSPALST\s+STAT\s+-\s+'
                   r'STEP WAS EXECUTED\s+-\s+COND CODE 0000\s*$', report),
         'fresh MVS LISTDS verification job not clean')
    results = exact_inventory(core, rc3, rows, report)
    rc3.artifact(folder,'catalog-comparison.json', json.dumps(results,indent=2)+'\n')
    wrong = [r for r in results if r['differences']]
    need(not wrong, 'restored MVS DCB/volume mismatch: ' +
         '; '.join(x['dataset']+': '+', '.join(x['differences']) for x in wrong[:3]))
    return job


def run(live=False):
    rc3 = None
    folder = None
    marked = False
    try:
        rc3 = load('ta2r3_mr_rc3', SCRIPTS/'ta2-rc3-consolidated')
        cont = load('ta2r3_mr_cont', SCRIPTS/'ta2-rc3-restore-continuation')
        diag = load('ta2r3_mr_diag', SCRIPTS/'ta2-rc3-recipient-diagnostic')
        git = rc3.check_git()
        rows, changes, _, _, reader, regression = rc3.plan()
        need(len(rows) == 21 and len(changes) == 12 and
             regression.count(rc3.INSTALL + 'MR10KIT.') >= 40,
             'canonical installed regression JCL drift')
        for member, relative, body in changes:
            need(git('show',rc3.COMMIT+':'+relative)==body.encode('ascii'),
                 'canonical 12-case BCPL source drift: '+member)
        aws = rc3.load('ta2r3_mr_aws', SCRIPTS/'ta2-rc2-aws-review')
        cont.accepted_tape(rc3,rows,aws)
        saved_catalog = diagnostic_checkpoint(rc3,diag,cont,rows)
        if not live:
            print('RC3 INSTALLED MR10 PLAN PASS: BC0003 original write/restore and '+
                  '9365/9366 diagnostic sealed; no MVS operation.')
            return 0
        need(sys.stdin.isatty(), 'MVS execution requires interactive operator')
        need(not MARKER.exists() and not MARKER.is_symlink(),
             'BC0003 installed regression attempt already consumed: NO RETRY')
        need(WORK.is_dir() and not WORK.is_symlink() and not OUT.is_symlink(),
             'unsafe repository workarea')
        OUT.mkdir(mode=0o700,exist_ok=True)
        folder = OUT/(datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')+
                      '-'+str(os.getpid()))
        folder.mkdir(mode=0o700,exist_ok=False)
        core = rc3.load('ta2r3_mr_core', ROOT/'tools/datasets/dspal-core.py')
        reviewer = rc3.load('ta2r3_mr_reviewer',
                            ROOT/'packaging/distribution/install-from-tape/scripts/ta2-rc2-mr10-review')
        acceptance = rc3.load('ta2r3_mr_acceptance',
                              ROOT/'packaging/distribution/install-from-tape/scripts/ta2-rc2-acceptance')
        cfg = core.load_config()
        need(cfg['mvs']['hlq']=='HERC02','unexpected MVS identity')
        core.require_reader_ready(cfg)
        # Independent reanalysis of already-sealed original MVS JOB 9365 data.
        saved = exact_inventory(core,rc3,rows,saved_catalog)
        correct_saved = all(not row['differences'] for row in saved)
        rc3.artifact(folder,'saved-catalog-exact.json',json.dumps(saved,indent=2)+'\n')
        job = catalog(core,cfg,rc3,folder,rows)
        # A second fresh MVS inquiry protects against recipient directory drift.
        directory,count = cont.directory_check(rc3,core,cfg,folder,rows)
        need(count==146,'fresh MVS PDS inventory not 146 members')
        need(cont.digest(cont.IMAGE)==cont.AWS_SHA256,'BC0003 image changed since restore')
        print(f'RC3 RECIPIENT VERIFIED: saved 9365 exact BOOT '+
              f'{"PASS" if correct_saved else "INCONCLUSIVE"}; '
              f'live DCB JOB {job} 21/21, directory JOB {directory} 146/146.')
        if input('Run installed RC3 MR10 12-case panel ONCE, no tape/restore? [y/N]: ').strip().upper()!='Y':
            rc3.artifact(folder,'result.json',json.dumps({'status':'DECLINED_NO_REGRESSION'})+'\n')
            rc3.seal(folder)
            print('RC3 MR10 declined. Read-only recipient verification retained.')
            return 0
        rc3.exclusive(MARKER,(json.dumps({
            'status':'OWNER_APPROVED_RC3_INSTALLED_MR10_NO_RETRY',
            'candidate':cont.CANDIDATE,'volser':cont.VOL,
            'original_restore_job':JOBS['restore'],
            'verification_jobs':{'catalog':job,'directory':directory},
            'image_sha256':cont.AWS_SHA256,
            'evidence':folder.relative_to(ROOT).as_posix(),
            'no_media_operations':True,'no_restore':True,'publication_authorized':False
            },sort_keys=True)+'\n').encode('ascii'))
        marked=True
        mr,report,summary = rc3.mvs_job(core,cfg,folder,'regression',
                                       rc3.JOBS['regression'],regression,[])
        renamed = re.sub(rf'(?m)^JOB\s+{mr}\s+{rc3.JOBS["regression"]}\s*$',
                         f'JOB {mr} TA2MR10',summary)
        acceptance.regression_steps(mr,renamed)
        rc3.verify_regression_execution(summary,report,regression)
        sem = rc3.validated_semantics(reviewer,report,mr)
        rc3.artifact(folder,'semantic-review.json',json.dumps(sem,indent=2)+'\n')
        need(cont.digest(cont.IMAGE)==cont.AWS_SHA256,'BC0003 changed after MR10')
        result={'status':'RC3_INSTALLED_MR10_EXP_RP_CODE_PASS_HUMAN_SIGNOFF_PENDING',
                'candidate':cont.CANDIDATE,'volser':cont.VOL,
                'aws_sha256':cont.AWS_SHA256,'original_restore_job':JOBS['restore'],
                'mvs_jobs':{'catalog':job,'directory':directory,'regression':mr},
                'verified_datasets':21,'verified_members':146,
                'mr10_steps':63,'mr10_cases':12,'exp_rp_code':True,
                'human_signoff':'PENDING','publication_authorized':False}
        rc3.artifact(folder,'result.json',json.dumps(result,indent=2)+'\n')
        rc3.seal(folder)
        print(f'RC3 INSTALLED MR10 PASS: JOB {mr}; 63/63 JES/IEF142I; '
              f'12/12 TEST/EXP/RP/CODE. HUMAN SIGNOFF PENDING.')
        print('Evidence: '+folder.relative_to(ROOT).as_posix())
        return 0
    except Exception as exc:
        if folder is not None and rc3 is not None:
            try:
                rc3.artifact(folder,'failure.json',json.dumps({
                    'status':'HALTED_NO_RETRY' if marked else 'READ_ONLY_PREFLIGHT_HALTED',
                    'reason':str(exc)},sort_keys=True)+'\n')
                rc3.seal(folder)
            except Exception:
                pass
        print('RC3 INSTALLED MR10 REFUSED: '+str(exc),file=sys.stderr)
        if folder is not None:
            print('Evidence: '+folder.relative_to(ROOT).as_posix(),file=sys.stderr)
        if marked:
            print('NO RETRY: preserve JOB, MR10 outputs and original recipient datasets.',
                  file=sys.stderr)
        return 2


def load(name,path):
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec,spec_from_loader
    need(path.is_file() and not path.is_symlink(),
         'canonical code missing: '+path.name)
    loader=SourceFileLoader(name,str(path))
    spec=spec_from_loader(loader.name,loader)
    need(spec is not None and spec.loader is not None,'cannot load '+path.name)
    mod=module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def main(argv=None):
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('--run',action='store_true',help='fresh MVS inquiry + one confirmed installed MR10')
    a=p.parse_args(argv)
    return run(a.run)


if __name__=='__main__':
    raise SystemExit(main())
