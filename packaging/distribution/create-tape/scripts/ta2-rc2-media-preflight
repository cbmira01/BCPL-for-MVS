#!/usr/bin/env python3
"""TA.2 rc2: bounded, read-only Hercules/MVS tape-unit inquiry.

--live performs only 'tape status 480' (Hercules DEVLIST) and 'mvs tapes'
(MVS D U,TAPE). It captures original responses below repository workarea.
It cannot authorize or initiate AWS media creation, mount, write, or JES.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[4]
HERE = Path(__file__).resolve().parent
WORK = ROOT / 'workarea'
OUT = WORK / 'ta2-rc2-media-preflight'
PREVIEW = HERE / 'ta2-rc2-producer-preview'
CONSOLE = ROOT / 'tools/mvs/mvs-console'
HERCULES = ('tools/mvs/mvs-console', 'tape', 'status', '480')
MVS = ('tools/mvs/mvs-console', 'mvs', 'tapes')
DEVICE = re.compile(r'\bHHC02279I\s+(?:[0-9A-Fa-f]+:)?0480\s+3420\s+(.*)$')
GUEST = re.compile(r'(?<![A-Z0-9])480[ \t]+3400[ \t]+(\S+)', re.I)
NEXT = re.compile(r'\b[0-9A-F]{3}[ \t]+[0-9A-F]{4}[ \t]+', re.I)


class Refusal(ValueError):
    pass


def need(ok: bool, why: str) -> None:
    if not ok:
        raise Refusal(why)


def load(name: str, path: Path):
    need(path.is_file() and not path.is_symlink(), 'canonical rc2 preview missing')
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    need(spec is not None and spec.loader is not None, 'cannot import canonical preview')
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def validate_plan() -> str:
    """Reuse approved rc2 contract and renderer; do not issue a new plan."""
    preview = load('ta2_rc2_media_preview', PREVIEW)
    contract = preview.module('ta2_rc2_media_contract', preview.CONTRACT)
    renderer = preview.module('ta2_rc2_media_renderer', preview.RENDERER)
    rc1 = preview.yaml.safe_load(preview.RC1.read_bytes())
    rc2_bytes = preview.RC2.read_bytes()
    rc2 = preview.yaml.safe_load(rc2_bytes)
    dspal = preview.yaml.safe_load(preview.DSPAL.read_bytes())
    registry = preview.yaml.safe_load(preview.REGISTRY.read_bytes())
    selection = json.loads(preview.SELECTION.read_bytes())
    contract.verify(rc1, rc2, dspal, registry, selection, rc2_bytes)
    jcl = preview.preview(rc1, rc2, renderer)
    need(rc2['release']['candidate_id'] == 'BCPL-0.1.0-rc2' and
         rc2['volume']['volser'] == 'BC0002', 'release identity drift')
    return hashlib.sha256(jcl.encode('ascii')).hexdigest()


def parse_hercules(output: str) -> str:
    rows = [m.group(1) for line in output.splitlines()
            if (m := DEVICE.search(line)) is not None]
    need(len(rows) == 1, 'Hercules 0480 DEVLIST missing or ambiguous')
    detail = rows[0]
    need(re.match(r'\*\s(?:|.*)$', detail) is not None and
         re.search(r'\bbusy\b', detail, re.I) is None,
         'Hercules 0480 is not verified empty/idle')
    return 'EMPTY'


def parse_mvs(output: str) -> str:
    # Ignore only exact repeated console echoes; conflicting observations fail.
    occurrences = [(line, match.start(), match.group(1).upper())
                   for line in output.splitlines()
                   for match in GUEST.finditer(line)]
    distinct = set(occurrences)
    need(len(distinct) == 1, 'MVS 480/3400 row missing, duplicated differently or ambiguous')
    line, start, state = next(iter(distinct))
    need(state in ('O', 'O-NRD'), 'MVS 480 not online/empty-compatible: ' + state)
    tail = line[start:]
    # A second unit may be printed on the same line; do not attribute it to 480.
    next_unit = NEXT.search(tail, 3)
    if next_unit is not None:
        tail = tail[:next_unit.start()]
    need(re.search(r'\b(?:ALLOC|ALLOCATED|BUSY)\b', tail, re.I) is None,
         'MVS 480 appears allocated/busy')
    return state


def create_run() -> Path:
    need(WORK.is_dir() and not WORK.is_symlink() and
         WORK.resolve().is_relative_to(ROOT.resolve()) and
         not OUT.is_symlink(), 'unsafe repository workarea')
    OUT.mkdir(mode=0o700, exist_ok=True)
    path = OUT / (datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + str(os.getpid()))
    path.mkdir(mode=0o700, exist_ok=False)
    return path


def save(path: Path, data: bytes) -> None:
    flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, 'O_NOFOLLOW', 0)
    with os.fdopen(os.open(path, flags, 0o600), 'wb') as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())


def seal(folder: Path) -> None:
    rows = [hashlib.sha256(p.read_bytes()).hexdigest() + '  ' + p.name + '\n'
            for p in sorted(folder.iterdir()) if p.is_file() and p.name != 'SHA256SUMS']
    save(folder / 'SHA256SUMS', ''.join(rows).encode('ascii'))


def inquire(args: tuple[str, ...], name: str, folder: Path) -> str:
    # Command list is hard-coded and contains only two display inquiries.
    need(args in (HERCULES, MVS), 'non-inquiry command refused')
    try:
        proc = subprocess.run([str(ROOT / args[0]), *args[1:]],
                              cwd=ROOT, text=True, capture_output=True,
                              timeout=45, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Refusal(name + ': inquiry transport failed (' + type(exc).__name__ + ')') from exc
    output = proc.stdout + ('\n' + proc.stderr if proc.stderr else '')
    save(folder / (name + '-report.txt'), output.encode('utf-8'))
    need(proc.returncode == 0, name + ': console inquiry RC=' + str(proc.returncode))
    need(len(output) <= 1024 * 1024, name + ': excessive console response')
    return output


def run(live: bool) -> int:
    jcl_sha = validate_plan()
    if not live:
        print('TA.2 RC2 MEDIA PREFLIGHT: static manifest/JCL PASS; no MVS inquiry.')
        return 0
    need(CONSOLE.is_file() and not CONSOLE.is_symlink(), 'project console client absent')
    folder = create_run()
    try:
        status = parse_hercules(inquire(HERCULES, 'hercules', folder))
        state = parse_mvs(inquire(MVS, 'mvs', folder))
        receipt = {'status': 'READ_ONLY_DRIVE_INQUIRY_PASS',
                   'candidate': 'BCPL-0.1.0-rc2', 'volser': 'BC0002',
                   'hercules_unit': '0480', 'hercules_medium': status,
                   'mvs_unit': '480', 'mvs_state': state,
                   'proposed_jobless_jcl_sha256': jcl_sha,
                   'media_creation_authorized': False,
                   'note': 'No AWS image check, catalog/volume collision scan, source-byte or rights clearance'}
        save(folder / 'result.json', (json.dumps(receipt, sort_keys=True, indent=2)+'\n').encode())
        seal(folder)
        print('TA.2 RC2 DRIVE PREFLIGHT PASS: Hercules 0480 empty; MVS 480 ' + state + '.')
        print('Private evidence: ' + str(folder.relative_to(ROOT)))
        print('No media, MVS datasets, or JES jobs changed; AWS production still unauthorized.')
        return 0
    except (Refusal, ValueError, OSError) as exc:
        if not (folder / 'SHA256SUMS').exists():
            try:
                save(folder / 'failure.json', (json.dumps({'status':'REFUSED', 'reason':str(exc)})+'\n').encode())
                seal(folder)
            except (OSError, Refusal):
                pass
        print('TA.2 RC2 DRIVE PREFLIGHT REFUSED: ' + str(exc), file=sys.stderr)
        print('Private evidence: ' + str(folder.relative_to(ROOT)), file=sys.stderr)
        return 2


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--live', action='store_true', help='run two read-only MVS/Hercules display commands')
    args = parser.parse_args(argv)
    try:
        return run(args.live)
    except (Refusal, ValueError, OSError, TypeError, KeyError, RuntimeError) as exc:
        print('TA.2 RC2 MEDIA PREFLIGHT REFUSED: ' + str(exc), file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
