#!/usr/bin/env python3
"""TA.2 BC0003 one-shot restore/verification continuation after accepted JOB 9361.

Does NOT re-stage, initialize, rewrite, or remove any tape/dataset.
Default: offline candidate/evidence review; --run: read-only MVS preflight,
then one operator-confirmed tape mount, restoration and installed MR10 GO.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[4]
BASE = ROOT / 'packaging/distribution'
SCRIPTS = BASE / 'create-tape/scripts'
WORK = ROOT / 'workarea'
OUT = WORK / 'ta2-rc3-restore-continuation'
MARKER = OUT / 'BC0003-restore-one-shot.json'
ORIGINAL = WORK / 'ta2-rc3-consolidated/20261122T202323Z-30995'
ORIGINAL_MARKER = WORK / 'ta2-rc3-consolidated/BC0003-one-shot.json'
IMAGE = ROOT / 'mvs-state/tape/bcpl-0.1.0-rc3-BC0003.aws'
AWS_SHA256 = '6c54c4df2b75020a698110061c4f8003b09adbe21f738848dcaed3da495d81e1'
ORIGINAL_JOBS = {'preflight': 9359, 'stage': 9360, 'write': 9361}
FAILURE = {'status': 'HALTED_NO_RETRY', 'reason': 'BC0003 disappeared after write'}
VOL = 'BC0003'
CANDIDATE = 'BCPL-0.1.0-rc3'


class Refusal(RuntimeError):
    pass


def need(ok, why):
    if not ok:
        raise Refusal(why)


def digest(path):
    need(path.is_file() and not path.is_symlink(), 'missing/linked file: ' + path.name)
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def sealed_original():
    """Read-only verification of the *original*, never-modified halt receipt."""
    need(ORIGINAL.is_dir() and not ORIGINAL.is_symlink() and
         ORIGINAL.resolve().is_relative_to(WORK.resolve()),
         'original RC3 receipt missing or outside workarea')
    manifest = ORIGINAL / 'SHA256SUMS'
    need(manifest.is_file() and not manifest.is_symlink(), 'original evidence seal absent')
    entries = {}
    for line in manifest.read_text('ascii').splitlines():
        match = re.fullmatch(r'([a-f0-9]{64})  ([A-Za-z0-9][A-Za-z0-9_.-]*)', line)
        need(match is not None and match.group(2) not in entries,
             'malformed or duplicate original evidence seal')
        entries[match.group(2)] = match.group(1)
    need({'failure.json','stage-summary.txt','stage-report.txt',
          'write-summary.txt','write-report.txt','aws-labels.txt',
          'aws-files.txt','drive-h-3.txt','drive-m-3.txt'} <= set(entries),
         'original MVS/HETMAP evidence incomplete')
    actual = {p.name for p in ORIGINAL.iterdir()}
    need(actual == set(entries) | {'SHA256SUMS'}, 'original receipt changed/incomplete')
    for name, sha in entries.items():
        need(digest(ORIGINAL / name) == sha, 'original receipt modified: ' + name)
    need(json.loads((ORIGINAL / 'failure.json').read_text('utf-8')) == FAILURE,
         'original halt cause differs')
    need(ORIGINAL_MARKER.is_file() and not ORIGINAL_MARKER.is_symlink(),
         'original production one-shot marker absent')
    marker = json.loads(ORIGINAL_MARKER.read_text('utf-8'))
    need(marker == {
         'status': 'ONE_SHOT_CONSENT_CONSUMED_NO_RETRY',
         'candidate': CANDIDATE, 'volser': VOL,
         'evidence': ORIGINAL.relative_to(ROOT).as_posix()},
         'original one-shot receipt differs')
    return entries


def checked_original_job(key, name, expected):
    """Recheck already accepted MVS JOB 9360/9361; never resubmit."""
    job = ORIGINAL_JOBS[key]
    summary = (ORIGINAL / (key + '-summary.txt')).read_text('utf-8')
    report = (ORIGINAL / (key + '-report.txt')).read_text('utf-8')
    need(re.search(rf'(?m)^JOB\s+{job}\s+{name}\s*$', summary) is not None and
         'JOB RESULT: SUCCESS' in summary and 'HIGHEST RC: 0000' in summary,
         f'original {key} JOB {job} summary differs')
    steps = re.findall(r'(?m)^([A-Z][0-9]{4})\s+(IEBGENER|IEBCOPY)\s+RC=(\d{4})\s*$', summary)
    need(steps == [(step, pgm, '0000') for step, pgm in expected],
         f'original {key} JES steps differ')
    raw = re.findall(
        rf'(?m)^IEF142I\s+{name}\s+([A-Z][0-9]{{4}})\s+-\s+'
        r'STEP WAS EXECUTED\s+-\s+COND CODE (\d{4})\s*$', report)
    need(raw == [(step, '0000') for step, _ in expected],
         f'original {key} IEF142I results differ')
    need(re.search(r'\b(?:ABEND|IEF450I|IEF472I|IEA995I)\b', report, re.I) is None,
         f'original {key} JES report includes ABEND')


def accepted_tape(rc3, rows, aws):
    sealed_original()
    stage = [(f'S{i:04d}', 'IEBGENER' if i == 1 else 'IEBCOPY')
             for i in range(1, 22)]
    stage += [(f'B{i:04d}', 'IEBGENER') for i in range(1, 5)]
    stage += [(f'E{i:04d}', 'IEBGENER') for i in range(1, 13)]
    checked_original_job('stage', rc3.JOBS['stage'], stage)
    checked_original_job('write', rc3.JOBS['write'],
                         [(f'T{i:04d}', 'IEBGENER' if i == 1 else 'IEBCOPY')
                          for i in range(1, 22)])
    need(len(rows) == 21 and sum(len(r['members']) for r in rows[1:]) == 146,
         'release selection no longer 21 datasets / 146 PDS members')
    aws.VOLSER = VOL
    original_labels = (ORIGINAL / 'aws-labels.txt').read_text('utf-8')
    original_files = (ORIGINAL / 'aws-files.txt').read_text('utf-8')
    verified = aws.evaluate(original_labels, original_files)
    need(verified['physical_files'] == 64, 'original AWS physical-file count differs')
    need(digest(IMAGE) == AWS_SHA256, 'BC0003 AWS content changed since JOB 9361')
    return verified


def directory_check(rc3, core, cfg, folder, rows):
    """Independent actual MVS LISTDS MEMBERS directory verification."""
    ls = rc3.load('ta2r3resume_ls', ROOT / 'tools/datasets/dspal-ls.py')
    pds = rows[1:]
    dsns = [r['target'] for r in pds]
    deck = ls.list_members_deck(cfg, dsns)
    old, env = tempfile.tempdir, os.environ.get('TMPDIR')
    try:
        tempfile.tempdir = str(folder)
        os.environ['TMPDIR'] = str(folder)
        job, summary = core.submit_and_wait(
            cfg, deck, max_rc=0, cursor_file=folder / 'directory-cursor.json')
        rc3.artifact(folder, 'directory-summary.txt', summary)
        report = core.job_report(job, cursor_file=folder / 'directory-cursor.json')
        rc3.artifact(folder, 'directory-report.txt', report)
    finally:
        tempfile.tempdir = old
        if env is None: os.environ.pop('TMPDIR', None)
        else: os.environ['TMPDIR'] = env
    need(re.search(rf'(?m)^JOB\s+{job}\s+DSPALLS\s*$', summary) is not None and
         'JOB RESULT: SUCCESS' in summary and 'HIGHEST RC: 0000' in summary and
         'IEF142I DSPALLS LIST - STEP WAS EXECUTED - COND CODE 0000' in report,
         'MVS directory inventory job not clean')
    blocks = ls.member_blocks(report, dsns)
    need(set(blocks) == set(dsns), 'MVS directory inventory missing/extra PDS blocks')
    count = 0
    for r in pds:
        actual = ls.parse_members(blocks[r['target']])
        expected = r['members']
        need(len(actual) == len(set(actual)) and
             len(actual) == len(expected) and set(actual) == set(expected),
             'restored MVS PDS member directory differs: ' + r['target'])
        count += len(actual)
    need(count == 146, 'MVS recipient directory inventory not 146 members')
    return job, count


def check_new_targets(core, cfg, rc3, folder, rows):
    dsns = [r['target'] for r in rows]
    deck = core.stat_deck(cfg, dsns)
    old, env = tempfile.tempdir, os.environ.get('TMPDIR')
    try:
        tempfile.tempdir = str(folder)
        os.environ['TMPDIR'] = str(folder)
        job, summary = core.submit_and_wait(
            cfg, deck, max_rc=8, cursor_file=folder / 'preflight-cursor.json')
        rc3.artifact(folder, 'preflight-summary.txt', summary)
        report = core.job_report(job, cursor_file=folder / 'preflight-cursor.json')
        rc3.artifact(folder, 'preflight-report.txt', report)
    finally:
        tempfile.tempdir = old
        if env is None: os.environ.pop('TMPDIR', None)
        else: os.environ['TMPDIR'] = env
    need(re.search(rf'(?m)^JOB\s+{job}\s+DSPALST\s*$', summary) is not None,
         'preflight LISTDS job identity ambiguous')
    for dsn in dsns:
        need(core.dataset_missing(report, dsn), 'recipient already exists: ' + dsn)
    return job


def fresh_tape(rc3, prod, media, aws, folder):
    need(digest(IMAGE) == AWS_SHA256, 'BC0003 image changed')
    labels = rc3.run_command(folder, 'aws-labels',
        ['docker','exec','mvs38j','hetmap','-l','/tk5/tape/' + IMAGE.name])
    files = rc3.run_command(folder, 'aws-files',
        ['docker','exec','mvs38j','hetmap','-f','/tk5/tape/' + IMAGE.name])
    aws.VOLSER = VOL
    checked = aws.evaluate(labels, files)
    need(checked['physical_files'] == 64, 'BC0003 AWS physical layout differs')
    need(rc3.drive(folder, prod, media) == 'EMPTY',
         'Hercules 0480 must be empty and MVS 480 O-NRD before mount')


def run(live=False):
    rc3 = None
    folder = None
    marked = False
    try:
        rc3 = load_rc3()
        if live:
            need(sys.stdin.isatty(), 'interactive operator confirmation required')
            need(not MARKER.exists() and not MARKER.is_symlink(),
                 'BC0003 restore continuation already consumed: NO RETRY')
            need(WORK.is_dir() and not WORK.is_symlink() and not OUT.is_symlink(),
                 'repository workarea absent/unsafe')
            rc3.check_git()
        rows, changes, boot, writer, reader, regression = rc3.plan()
        need(len(changes) == 12 and reader.count('DISP=(NEW,CATLG,DELETE)') == 21 and
             'BC0002' not in reader and 'TA2RB.' not in reader and
             'TA2R3S.' not in reader and
             regression.count(rc3.INSTALL + 'MR10KIT.') >= 40,
             'restore/installed regression JCL changed')
        aws = rc3.load('ta2r3resume_aws', SCRIPTS / 'ta2-rc2-aws-review')
        accepted_tape(rc3, rows, aws)
        if not live:
            print('RC3 CONTINUATION PLAN PASS: accepted JOBS 9360/9361; immutable BC0003; '
                  '21 restore datasets, 146 PDS members, 12 installed MR10 cases. '
                  'NO MVS operation.')
            return 0
        OUT.mkdir(mode=0o700, exist_ok=True)
        folder = OUT / (datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') +
                        '-' + str(os.getpid()))
        folder.mkdir(mode=0o700, exist_ok=False)
        core = rc3.load('ta2r3resume_core', ROOT / 'tools/datasets/dspal-core.py')
        prod = rc3.load('ta2r3resume_producer', SCRIPTS / 'ta2-rc2-produce-once')
        media = rc3.load('ta2r3resume_media', SCRIPTS / 'ta2-rc2-media-preflight')
        reviewer = rc3.load('ta2r3resume_reviewer',
                            BASE / 'install-from-tape/scripts/ta2-rc2-mr10-review')
        acceptance = rc3.load('ta2r3resume_casecheck',
                              BASE / 'install-from-tape/scripts/ta2-rc2-acceptance')
        cfg = core.load_config()
        need(cfg['mvs']['hlq'] == 'HERC02', 'unexpected MVS HLQ')
        core.require_reader_ready(cfg)
        prod.check_docker(folder)
        fresh_tape(rc3, prod, media, aws, folder)
        preflight_job = check_new_targets(core, cfg, rc3, folder, rows)
        # Detect any drive change while MVS LISTDS was running.
        need(rc3.drive(folder, prod, media) == 'EMPTY' and
             digest(IMAGE) == AWS_SHA256, 'tape changed during MVS preflight')
        print(f'RC3 RESTORE PREFLIGHT PASS: JOB {preflight_job}; BC0003 verified, '
              'drive EMPTY, 21 targets absent; original stage/write preserved.')
        if input('Mount existing BC0003, restore 21 datasets and run MR10 ONCE? [y/N]: ').strip().upper() != 'Y':
            rc3.artifact(folder, 'result.json', json.dumps({'status': 'DECLINED_NO_RESTORE'})+'\n')
            rc3.seal(folder)
            print('RC3 continuation declined; no tape mount or restore.')
            return 0
        rc3.exclusive(MARKER, (json.dumps({
            'status': 'OWNER_APPROVED_BC0003_RESTORE_NO_RETRY',
            'original_jobs': ORIGINAL_JOBS,
            'original_evidence': ORIGINAL.relative_to(ROOT).as_posix(),
            'evidence': folder.relative_to(ROOT).as_posix(),
            'candidate': CANDIDATE, 'volser': VOL,
            'image_sha256': AWS_SHA256,
            'no_restage': True, 'no_reinitialize': True, 'no_rewrite': True,
            'publication_authorized': False}, sort_keys=True)+'\n').encode('ascii'))
        marked = True
        rc3.run_command(folder, 'mount-existing',
            ['tools/mvs/mvs-console','--yes','tape','mount','480',IMAGE.name])
        need(rc3.drive(folder,prod,media) == 'RC3', 'BC0003 not mounted for readback')
        restore, report, summary = rc3.mvs_job(core, cfg, folder, 'restore',
            rc3.JOBS['restore'], reader,
            [(f'R{i:04d}', 'IEBGENER' if i == 1 else 'IEBCOPY') for i in range(1,22)])
        need(digest(IMAGE) == AWS_SHA256, 'BC0003 changed during MVS readback')
        print(f'RC3 READBACK PASS: JOB {restore}; 21/21 IEBGENER/IEBCOPY RC0000.')
        catalog = rc3.catalog(core, cfg, folder, rows, recipient=True)
        directory, count = directory_check(rc3, core, cfg, folder, rows)
        print(f'RC3 RESTORED INVENTORY PASS: DCB JOB {catalog}; '
              f'MEMBERS JOB {directory}; {count}/146 PDS members.')
        mr, mr_report, mr_summary = rc3.mvs_job(core, cfg, folder, 'regression',
            rc3.JOBS['regression'], regression, [])
        renamed = re.sub(rf'(?m)^JOB\s+{mr}\s+{rc3.JOBS["regression"]}\s*$',
                         f'JOB {mr} TA2MR10', mr_summary)
        acceptance.regression_steps(mr, renamed)
        rc3.verify_regression_execution(mr_summary, mr_report, regression)
        semantic = rc3.validated_semantics(reviewer, mr_report, mr)
        rc3.artifact(folder, 'semantic-review.json', json.dumps(semantic, indent=2)+'\n')
        # MVS may demount a volume after a completed tape step; either is valid.
        after = rc3.drive(folder, prod, media)
        need(after in ('EMPTY', 'RC3'), 'post-readback drive holds foreign medium')
        need(digest(IMAGE) == AWS_SHA256, 'BC0003 image hash changed after readback')
        receipt = {'status': 'RC3_MVS_RESTORE_INSTALL_USE_PASS_HUMAN_REVIEW_PENDING',
            'candidate': CANDIDATE, 'volser': VOL, 'aws_sha256': AWS_SHA256,
            'original_evidence': ORIGINAL.relative_to(ROOT).as_posix(),
            'original_jobs': ORIGINAL_JOBS,
            'mvs_jobs': {'preflight': preflight_job, 'restore': restore,
                         'recipient_catalog': catalog, 'members': directory,
                         'regression': mr},
            'restored_datasets': 21, 'verified_members': count,
            'regression_steps': 63, 'bcpl_cases': 12,
            'exp_rp_code': True, 'tape_drive_after': after,
            'human_signoff': 'PENDING', 'publication_authorized': False}
        rc3.artifact(folder, 'result.json', json.dumps(receipt, indent=2)+'\n')
        rc3.seal(folder)
        print(f'RC3 INSTALLED MR10 PASS: JOB {mr}; 63/63 steps; '
              '12/12 TEST/EXP/RP/CODE. HUMAN SIGNOFF PENDING.')
        print('Evidence: '+folder.relative_to(ROOT).as_posix())
        return 0
    except Exception as exc:
        if folder is not None and rc3 is not None:
            try:
                rc3.artifact(folder, 'failure.json', json.dumps({
                    'status':'HALTED_NO_RETRY' if marked else 'PREFLIGHT_HALTED',
                    'reason':str(exc)},sort_keys=True)+'\n')
                rc3.seal(folder)
            except Exception:
                pass
        print('RC3 RESTORE REFUSED: '+str(exc), file=sys.stderr)
        if folder is not None:
            print('Evidence: '+folder.relative_to(ROOT).as_posix(),file=sys.stderr)
        if marked:
            print('NO RETRY: preserve original BC0003, any recipients and JES evidence.',
                  file=sys.stderr)
        return 2


def load_rc3():
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec, spec_from_loader
    script = SCRIPTS / 'ta2-rc3-consolidated'
    need(script.is_file() and not script.is_symlink(), 'canonical RC3 producer unavailable')
    loader = SourceFileLoader('ta2r3_resume_original', str(script))
    spec = spec_from_loader(loader.name, loader)
    need(spec is not None and spec.loader is not None, 'original producer cannot load')
    module = module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run', action='store_true', help='one guarded MVS restore-and-use attempt')
    options = parser.parse_args()
    return run(options.run)


if __name__ == '__main__':
    raise SystemExit(main())
