#!/usr/bin/env python3
"""Read-only actual-MVS diagnosis of the halted BC0003 RC3 recipient DCB gate.

Does not mount/initialize/write tape, restore datasets or execute MR10. Saves
new sealed diagnostic evidence; original one-shot attempts remain consumed.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
import json
import os
from pathlib import Path
import re
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[4]
SCRIPTS = ROOT / 'packaging/distribution/create-tape/scripts'
WORK = ROOT / 'workarea'
OUT = WORK / 'ta2-rc3-recipient-diagnostic'
ORIGINAL = WORK / 'ta2-rc3-restore-continuation/20261122T232532Z-31994'
ORIGINAL_MARKER = WORK / 'ta2-rc3-restore-continuation/BC0003-restore-one-shot.json'


class Refusal(RuntimeError):
    pass


def need(ok, why):
    if not ok:
        raise Refusal(why)


def load(name, path):
    need(path.is_file() and not path.is_symlink(), 'canonical module missing: ' + path.name)
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(loader.name, loader)
    need(spec is not None and spec.loader is not None, 'cannot load ' + path.name)
    module = module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def sealed_incident(rc3, continuation):
    need(ORIGINAL.is_dir() and not ORIGINAL.is_symlink() and
         ORIGINAL.resolve().is_relative_to(WORK.resolve()), 'original continuation evidence missing')
    receipt = ORIGINAL / 'SHA256SUMS'
    need(receipt.is_file() and not receipt.is_symlink(), 'original continuation seal missing')
    listed = {}
    for line in receipt.read_text('ascii').splitlines():
        match = re.fullmatch(r'([0-9a-f]{64})  ([A-Za-z0-9][A-Za-z0-9_.-]*)', line)
        need(match is not None and match.group(2) not in listed, 'invalid original evidence seal')
        listed[match.group(2)] = match.group(1)
    required = {'failure.json', 'restore-summary.txt', 'restore-report.txt',
                'recipient-summary.txt', 'recipient-report.txt'}
    need(required <= listed.keys(), 'original continuation reports missing')
    need({p.name for p in ORIGINAL.iterdir()} == set(listed) | {'SHA256SUMS'},
         'original continuation evidence membership differs')
    for name, sha in listed.items():
        path = ORIGINAL / name
        need(path.is_file() and not path.is_symlink() and rc3.digest(path.read_bytes()) == sha,
             'original continuation evidence modified: ' + name)
    expected = {'status': 'HALTED_NO_RETRY',
                'reason': 'recipient DCB/volume differs: HERC02.BCPL.TA2R3I.BOOT'}
    need(json.loads((ORIGINAL / 'failure.json').read_text('utf-8')) == expected,
         'original refusal different from reported BOOT DCB mismatch')
    need(ORIGINAL_MARKER.is_file() and not ORIGINAL_MARKER.is_symlink(),
         'restore one-shot marker not consumed')
    marker = json.loads(ORIGINAL_MARKER.read_text('utf-8'))
    need(marker.get('status') == 'OWNER_APPROVED_BC0003_RESTORE_NO_RETRY' and
         marker.get('candidate') == 'BCPL-0.1.0-rc3' and
         marker.get('image_sha256') == continuation.AWS_SHA256 and
         marker.get('evidence') == ORIGINAL.relative_to(ROOT).as_posix(),
         'original restore marker differs')
    summary = (ORIGINAL / 'restore-summary.txt').read_text('utf-8')
    report = (ORIGINAL / 'restore-report.txt').read_text('utf-8')
    match = re.search(r'(?m)^JOB\s+(\d+)\s+TA2R3RES\s*$', summary)
    need(match and 'JOB RESULT: SUCCESS' in summary and 'HIGHEST RC: 0000' in summary,
         'original restore JOB did not complete successfully')
    steps = re.findall(r'(?m)^(R\d{4})\s+(IEBGENER|IEBCOPY)\s+RC=(\d{4})\s*$', summary)
    need(steps == [(f'R{i:04d}', 'IEBGENER' if i == 1 else 'IEBCOPY', '0000')
                   for i in range(1, 22)], 'original 21-step JES restore differs')
    system = re.findall(r'(?m)^IEF142I\s+TA2R3RES\s+(R\d{4})\s+-\s+'
                        r'STEP WAS EXECUTED\s+-\s+COND CODE (\d{4})\s*$', report)
    need(system == [(f'R{i:04d}', '0000') for i in range(1,22)],
         'original 21-step IEF142I restore differs')
    return int(match.group(1)), (ORIGINAL / 'recipient-report.txt').read_text('utf-8')


def analyze_catalog(core, rc3, rows, report):
    results = []
    for row in rows:
        dsn = row['target']
        block = core.extract_listds_block(report, dsn)
        actual = core.parse_listds(block) if block else {}
        expected = {'volume': rc3.VOLUME, 'dsorg': row['dcb']['dsorg'],
                    'recfm': row['dcb']['recfm'],
                    'lrecl': str(row['dcb']['lrecl']), 'blksize': str(row['dcb']['blksize'])}
        missing = core.dataset_missing(report, dsn)
        errors = (['dataset not found'] if missing else [])
        errors += [f'{field}: expected {value}, observed {actual.get(field, "?")}'
                   for field, value in expected.items() if actual.get(field) != value]
        results.append({'dataset': dsn, 'expected': expected, 'actual': actual,
                        'mismatches': errors, 'raw_listds_block': block if errors else []})
    need(len(results) == 21, 'not 21 datasets in RC3 inventory')
    return results


def analyze_members(ls, rows, report):
    pds = rows[1:]
    dsns = [r['target'] for r in pds]
    blocks = ls.member_blocks(report, dsns)
    result = []
    for r in pds:
        actual = ls.parse_members(blocks[r['target'].upper()]) if r['target'].upper() in blocks else []
        expected = r['members']
        ok = (r['target'].upper() in blocks and len(actual) == len(expected) and
              len(actual) == len(set(actual)) and set(actual) == set(expected))
        result.append({'dataset': r['target'], 'expected_count': len(expected),
                       'actual_count': len(actual), 'match': ok,
                       'missing': sorted(set(expected)-set(actual)),
                       'extra': sorted(set(actual)-set(expected))})
    need(len(result) == 20, 'not 20 PDS directory comparisons')
    return result


def submit_readonly(core, cfg, rc3, folder, name, deck):
    old, env = tempfile.tempdir, os.environ.get('TMPDIR')
    try:
        tempfile.tempdir = str(folder)
        os.environ['TMPDIR'] = str(folder)
        job, summary = core.submit_and_wait(cfg, deck, max_rc=0,
                                             cursor_file=folder / (name + '-cursor.json'))
        rc3.artifact(folder, name + '-summary.txt', summary)
        report = core.job_report(job, cursor_file=folder / (name + '-cursor.json'))
        rc3.artifact(folder, name + '-report.txt', report)
    finally:
        tempfile.tempdir = old
        if env is None: os.environ.pop('TMPDIR',None)
        else: os.environ['TMPDIR'] = env
    need(re.search(rf'(?m)^JOB\s+{job}\s+{("DSPALST" if name=="catalog" else "DSPALLS")}\s*$', summary)
         and 'JOB RESULT: SUCCESS' in summary and 'HIGHEST RC: 0000' in summary,
         name + ' read-only MVS JES job incomplete/nonzero')
    step = 'STAT' if name == 'catalog' else 'LIST'
    jobname = 'DSPALST' if name == 'catalog' else 'DSPALLS'
    need(re.search(rf'(?m)^IEF142I\s+{jobname}\s+{step}\s+-\s+'
                   r'STEP WAS EXECUTED\s+-\s+COND CODE 0000\s*$', report),
         name + ' IEF142I result missing/nonzero')
    return job, report


def run():
    rc3 = None
    folder = None
    try:
        rc3 = load('ta2r3diagnose', SCRIPTS / 'ta2-rc3-consolidated')
        cont = load('ta2r3diagnose_cont', SCRIPTS / 'ta2-rc3-restore-continuation')
        rc3.check_git()
        rows, changes, boot, writer, reader, regression = rc3.plan()
        need(len(rows)==21 and len(changes)==12, 'RC3 plan changed')
        restore_job, saved_report = sealed_incident(rc3, cont)
        need(cont.digest(cont.IMAGE) == cont.AWS_SHA256, 'BC0003 AWS SHA changed')
        need(WORK.is_dir() and not WORK.is_symlink() and not OUT.is_symlink(),
             'unsafe repository evidence root')
        OUT.mkdir(mode=0o700, exist_ok=True)
        folder = OUT / (datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')+'-'+str(os.getpid()))
        folder.mkdir(mode=0o700, exist_ok=False)
        core = rc3.load('ta2r3diagnose_core', ROOT / 'tools/datasets/dspal-core.py')
        ls = rc3.load('ta2r3diagnose_ls', ROOT / 'tools/datasets/dspal-ls.py')
        cfg = core.load_config()
        need(cfg['mvs']['hlq']=='HERC02', 'unexpected MVS HLQ')
        core.require_reader_ready(cfg)
        saved = analyze_catalog(core,rc3,rows,saved_report)
        catalog_job, live_report = submit_readonly(core,cfg,rc3,folder,'catalog',
                                                   core.stat_deck(cfg,[r['target'] for r in rows]))
        live = analyze_catalog(core,rc3,rows,live_report)
        directory_job, member_report = submit_readonly(core,cfg,rc3,folder,'members',
                              ls.list_members_deck(cfg,[r['target'] for r in rows[1:]]))
        members = analyze_members(ls,rows,member_report)
        need(cont.digest(cont.IMAGE) == cont.AWS_SHA256, 'BC0003 changed during diagnosis')
        failed = [r for r in live if r['mismatches']]
        bad_pds = [r for r in members if not r['match']]
        result = {'status': 'DIAGNOSTIC_ONLY_NOT_INSTALL_ACCEPTANCE',
                  'candidate':cont.CANDIDATE,'aws_sha256':cont.AWS_SHA256,
                  'restore_job':restore_job,'catalog_job':catalog_job,
                  'directory_job':directory_job,'existing_restore_not_repeated':True,
                  'state_changes':'TWO_READ_ONLY_MVS_TSO_INQUIRIES_ONLY',
                  'saved_catalog':saved,'live_catalog':live,'members':members,
                  'dcb_discrepancies':len(failed),'member_discrepancies':len(bad_pds),
                  'verified_member_count':sum(r['actual_count'] for r in members),
                  'regression_executed':False,'publication_authorized':False}
        rc3.artifact(folder,'diagnostic.json',json.dumps(result,indent=2)+'\n')
        rc3.seal(folder)
        print(f'RC3 MVS DIAGNOSTIC: restore JOB {restore_job}; live LISTDS JOB {catalog_job}; '
              f'MEMBERS JOB {directory_job}; DCB mismatches {len(failed)}/21; '
              f'PDS member mismatches {len(bad_pds)}/20.')
        for r in failed[:5]:
            print('DCB DIFFERENCE '+r['dataset']+': '+ '; '.join(r['mismatches']))
        for r in bad_pds[:5]:
            print(f'DIRECTORY DIFFERENCE {r["dataset"]}: expected {r["expected_count"]}, '
                  f'observed {r["actual_count"]}, missing {r["missing"][:3]}, extra {r["extra"][:3]}')
        boot_old = saved[0]
        print('BOOT SAVED: '+json.dumps(boot_old['actual'],sort_keys=True))
        print('BOOT LIVE: '+json.dumps(live[0]['actual'],sort_keys=True))
        if live[0]['mismatches']:
            print('BOOT RAW LISTDS (live):')
            for line in live[0]['raw_listds_block'][:16]: print(line)
        print('Evidence: '+folder.relative_to(ROOT).as_posix())
        print('No tape or restored dataset modified; no MR10 execution.')
        return 0
    except Exception as exc:
        if rc3 is not None and folder is not None:
            try:
                rc3.artifact(folder,'failure.json',json.dumps({'status':'READ_ONLY_DIAGNOSTIC_FAILED',
                                                             'reason':str(exc)})+'\n')
                rc3.seal(folder)
            except Exception:
                pass
        print('RC3 MVS DIAGNOSTIC REFUSED: '+str(exc),file=sys.stderr)
        if folder is not None:print('Evidence: '+folder.relative_to(ROOT).as_posix(),file=sys.stderr)
        return 2


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--live',action='store_true',help='two MVS read-only LISTDS jobs')
    options=parser.parse_args()
    if not options.live:
        print('RC3 diagnostic inert by default; --live runs two read-only MVS LISTDS jobs.')
        return 0
    return run()


if __name__=='__main__':
    raise SystemExit(main())
