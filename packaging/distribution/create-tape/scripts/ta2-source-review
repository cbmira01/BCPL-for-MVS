#!/usr/bin/env python3
"""TA.2 independent offline review of a saved, read-only MVS source inventory.

Verifies exact saved stat/ls bytes, SHA256SUMS, selected member closure and
reported exclusions. Never runs dspal, JES, Hercules or a write operation.
"""
from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[4]
DESIGN = ROOT / 'packaging/distribution/manifest/ta0-inventory.yaml'
DSPAL = ROOT / 'config/dspal.yaml'
PREFLIGHT = ROOT / 'packaging/distribution/create-tape/scripts/ta2-source-preflight'
BASE = ROOT / 'workarea/ta2-source-preflight'
RUN = re.compile(r'20\d{6}T\d{6}Z-\d+\Z')
SHA = re.compile(r'[a-f0-9]{64}\Z')
KEY = re.compile(r'[A-Z][A-Z0-9_]+\Z')
MAX_FILE = 16 * 1024 * 1024


class Refusal(ValueError):
    pass


def need(ok: bool, reason: str) -> None:
    if not ok:
        raise Refusal(reason)


def load_preflight():
    loader = importlib.machinery.SourceFileLoader('ta2_source_review_preflight', str(PREFLIGHT))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    need(spec is not None, 'cannot load source-preflight')
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def safe_run(root: Path, evidence: Path) -> Path:
    """Accept only one direct subdirectory under the local ignored evidence base."""
    parent = root / 'workarea/ta2-source-preflight'
    work = root / 'workarea'
    need(work.is_dir() and not work.is_symlink() and
         parent.is_dir() and not parent.is_symlink() and
         work.resolve().is_relative_to(root.resolve()),
         'unsafe/missing source-preflight evidence root')
    need(evidence.name and RUN.fullmatch(evidence.name) is not None,
         'expected a timestamped TA.2 source-preflight evidence run')
    need(not evidence.is_symlink() and evidence.is_dir() and
         evidence.resolve().parent == parent.resolve(),
         'evidence run is linked, missing or outside workarea')
    return evidence.resolve()


def saved_bytes(path: Path) -> bytes:
    need(path.is_file() and not path.is_symlink(), 'missing/linked evidence file: ' + path.name)
    need(path.stat().st_size <= MAX_FILE, 'oversized evidence file: ' + path.name)
    return path.read_bytes()


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def audit_files(evidence: Path, items: list[dict]) -> dict[str, bytes]:
    """Reject missing, extra, linked, duplicate or checksum-drifted evidence."""
    expected = {'summary.json'}
    for row in items:
        key = row['key']
        need(KEY.fullmatch(key) is not None, 'unsafe source key')
        expected.update({key + '.stat.txt', key + '.ls.txt'})
    observed = {p.name for p in evidence.iterdir()}
    need(observed == expected | {'SHA256SUMS'},
         'missing/extra saved MVS evidence files')
    checksum_lines = saved_bytes(evidence / 'SHA256SUMS').decode('ascii').splitlines()
    recorded: dict[str, str] = {}
    for line in checksum_lines:
        match = re.fullmatch(r'([a-f0-9]{64})  ([A-Za-z0-9_.-]+)', line)
        need(match is not None, 'malformed SHA256SUMS line')
        h, filename = match.groups()
        need(filename not in recorded and filename in expected,
             'duplicated or unexpected SHA256SUMS file')
        recorded[filename] = h
    need(set(recorded) == expected, 'incomplete SHA256SUMS file coverage')
    outputs = {name: saved_bytes(evidence / name) for name in sorted(expected)}
    for name, data in outputs.items():
        need(sha256(data) == recorded[name], 'saved MVS evidence checksum mismatch: ' + name)
    return outputs


def inquiry_body(data: bytes, key: str, action: str) -> str:
    try:
        content = data.decode('utf-8')
    except UnicodeDecodeError as exc:
        raise Refusal(key + ' invalid UTF-8 ' + action + ' report') from exc
    need(content.startswith('RC=0\n') and content.count('\nRC=') == 0,
         key + ' inquiry not recorded with success return code: ' + action)
    return content.split('\n', 1)[1]


def inspect(evidence: Path, items: list[dict], preflight, *, root: Path = ROOT) -> dict:
    evidence = safe_run(root, evidence)
    need(len(items) == 18 and sum(len(x['selected']) for x in items) == 127,
         'source inventory/selected-member count drift')
    saved = audit_files(evidence, items)
    try:
        summary = json.loads(saved['summary.json'].decode('utf-8'))
    except (ValueError, UnicodeDecodeError) as exc:
        raise Refusal('saved summary.json invalid') from exc
    need(isinstance(summary, dict) and summary.get('status') == 'PASS (source metadata only)' and
         summary.get('errors') == [] and summary.get('source_dataset_count') == len(items),
         'source collector summary is failed or incomplete')
    records = summary.get('results')
    need(isinstance(records, list) and len(records) == len(items),
         'source collector summary result count differs')
    extras_total = 0
    observed_total = 0
    distinct = set()
    for row, entry in zip(items, records):
        key, dsn = row['key'], row['dsn']
        need(key not in distinct, 'duplicate source library key')
        distinct.add(key)
        stat = inquiry_body(saved[key + '.stat.txt'], key, 'stat')
        ls = inquiry_body(saved[key + '.ls.txt'], key, 'ls')
        try:
            vol = preflight.inspect_stat(stat, dsn, key, row['dcb'])
            details = preflight.inspect_ls(ls, dsn, row['selected'])
        except preflight.Refusal as exc:
            raise Refusal(f'{key}: {exc}') from exc
        need(not details['missing_members'], key + ': selected member absent')
        observed_total += details['observed_members']
        extras_total += len(details['development_extras'])
        expected = {'key': key, 'source_dsn': dsn,
                    'tape_sequence': row['sequence'], 'source_volume': vol, **details}
        need(entry == expected, key + ': summary disagrees with independently re-parsed MVS output')
    return {'status': 'PASS (saved MVS source metadata only)',
            'checked_libraries': len(items), 'curated_members': 127,
            'observed_members': observed_total, 'excluded_development_members': extras_total,
            'evidence_directory': evidence.relative_to(root).as_posix(),
            'summary_sha256': sha256(saved['summary.json']),
            'sha256sums_sha256': sha256(saved_bytes(evidence / 'SHA256SUMS')),
            'qualification': 'No source-byte identity, build provenance, staging or tape evidence'}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--evidence', type=Path, required=True,
                        help='saved workarea/ta2-source-preflight/<run-id> directory')
    parser.add_argument('--json', action='store_true', help='emit concise verified JSON to stdout')
    args = parser.parse_args(argv)
    try:
        source = load_preflight()
        canonical = source.core()
        manifest, dspal = canonical.load(DESIGN), canonical.load(DSPAL)
        canonical.check(manifest, dspal, ROOT, release=False)
        need(manifest['phase'] == 'design', 'source audit requires canonical TA.0 design')
        items = source.expected_sources(manifest, dspal)
        result = inspect(args.evidence, items, source)
        if args.json:
            print(json.dumps(result, indent=2, sort_keys=True))
        else:
            print(f'TA.2 SAVED MVS SOURCE REVIEW PASS: {result["checked_libraries"]}/18 libraries; '
                  f'{result["curated_members"]} curated, '
                  f'{result["excluded_development_members"]} excluded development members')
            print('Evidence: ' + result['evidence_directory'])
            print('Member bytes, build provenance, staging and tape not verified.')
        return 0
    except (Refusal, OSError, KeyError, TypeError, ValueError) as exc:
        print('TA.2 SAVED MVS SOURCE REVIEW REFUSED: ' + str(exc), file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
