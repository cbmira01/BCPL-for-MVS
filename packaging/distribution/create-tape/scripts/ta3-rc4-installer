#!/usr/bin/env python3
"""TA.3 RC4: deterministic tape-resident MVS/370 installer construction.

Offline only: no JES, DASD, tape initialization, mount or media write.
BT0002 profiles use OS/VS2 in-stream PROC symbolic defaults and a
separate SYSIN PDS member, never prohibited DD * inside a PROC.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import sys

import yaml

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[4]
BASE = ROOT / "packaging/distribution"
MANIFEST = BASE / "manifest/releases/BCPL-0.1.0-rc4.yaml"
RC3 = BASE / "manifest/releases/BCPL-0.1.0-rc3.yaml"
REGISTRY = BASE / "registry/releases.yaml"
SPACE = BASE / "create-tape/ta2-stage-space-proposal-20261119.json"
OUT = ROOT / "workarea/ta3-rc4-installer"
CANDIDATE = "BCPL-0.1.0-rc4"
VOLSER = "BC0004"
OLD = "BCPL-0.1.0-rc3"
STAGE = "HERC02.BCPL.TA3R4S."
SOURCE = "HERC02.BCPL.TA2R3S."
MEMBERS = ("INSTALL", "DATASETS", "RELEASE", "RESTORE", "COPY",
           "MR10", "NATIVE", "COMBINED")
PROFILES = {
    "MR10": ("M10PROC", "R4MR", tuple(range(3,13))),
    "NATIVE": ("NATPROC", "R4NT", (3,*range(13,22))),
    "COMBINED": ("ALLPROC", "R4CB", tuple(range(3,22))),
}


class Refusal(ValueError):
    pass


def need(ok, message):
    if not ok:
        raise Refusal(message)


def sha(data):
    return hashlib.sha256(data).hexdigest()


def cards(lines, *, jcl=False):
    need(all(isinstance(x,str) and x.isascii() and "\t" not in x and
             "\r" not in x and len(x)<=80 for x in lines), "FB80 record overflow")
    if jcl:
        need(all(len(x)<=71 for x in lines
                 if x.startswith("//") and not x.startswith("//*")),
             "JCL extends beyond MVS column 71")
    return "\n".join(lines)+"\n"


def load():
    need(all(p.is_file() and not p.is_symlink()
             for p in (MANIFEST,RC3,REGISTRY,SPACE)),
         "canonical RC3/RC4 manifest or registry input unavailable")
    raw=MANIFEST.read_bytes()
    m=yaml.safe_load(raw)
    old=yaml.safe_load(RC3.read_bytes())
    reg=yaml.safe_load(REGISTRY.read_bytes())
    need(m["schema_version"]==old["schema_version"]==1 and
         m["phase"]=="candidate" and
         m["volume"]==dict(old["volume"],volser=VOLSER,
                            registry_reservation=CANDIDATE) and
         m["release"]==dict(old["release"],version="0.1.0-rc4",
                            candidate_id=CANDIDATE),
         "RC4 identity or compiler payload scope changed")
    original=old["datasets"]
    changed=m["datasets"]
    need(len(changed)==len(original)==21 and
         changed[0]==original[0] and changed[2:]==original[2:] and
         changed[1]==dict(original[1],members=list(MEMBERS)),
         "RC4 altered accepted RC3 payload or installer member selection")
    candidates=reg.get("candidates",[])
    need(reg.get("schema_version")==1 and len(candidates)==4 and
         candidates[-1]=={"candidate_id":CANDIDATE,"version":"0.1.0-rc4",
                          "source_commit":m["release"]["source_commit"],
                          "volser":VOLSER,"manifest_sha256":sha(raw),
                          "state":"reserved"} and
         len(set(c["volser"] for c in candidates))==4,
         "RC4 registry reservation or manifest SHA-256 differs")
    budget=json.loads(SPACE.read_bytes())
    need(budget["volume"]=="TSO002" and
         [x["sequence"] for x in budget["targets"]]==list(range(3,21)),
         "accepted allocation budget changed")
    sizes={x["sequence"]:(x["primary_tracks"],
                           x["secondary_tracks"],
                           x["directory_blocks"]) for x in budget["targets"]}
    sizes[21]=(100,10,10)
    return m,sizes


def boot(m):
    lines=[
        "CAMBRIDGE BCPL PROGRAMMING SYSTEM FOR MVS 3.8J",
        "CANDIDATE BCPL-0.1.0-rc4 / VOLUME BC0004 / 21 SL DATASETS",
        "NATIVE CAMBRIDGE COMPILER ABSENT; CAMBRIDGE SOURCE INCLUDED.",
        "BT0001 IS PLAIN FB80 TEXT READABLE USING IEBGENER BEFORE BCPL.",
        "READ BT0002 USING IEBCOPY: INPUT DSN=BCPL.BT0002 LABEL=(2,SL).",
        "RESTORE BT0002 TO A NEW SITE PDS WITH DSORG=PO FB80 BLKSIZE=800.",
        "USE AN MVS JOB CARD; MVS UTILITY IEBCOPY IS ALREADY INSTALLED.",
        "SITE TARGET <HLQ>.BCPL.<SITE>.DIST.INST MUST BE ABSENT.",
        "INSTALLER DIRECTORY: INSTALL DATASETS RELEASE RESTORE COPY",
        "PROFILE JOB MEMBERS: MR10 NATIVE COMBINED; NO PYTHON REQUIRED.",
        "INSTALLER PROFILE JCL USES IN-STREAM MVS PROC SYMBOLIC DEFAULTS.",
        "EXAMPLE SITE DEFAULT HLQ=HERC02, UNIT=SYSDA, DASD VOL=TSO002.",
        "EACH PROFILE HAS ITS OWN SITE DEFAULT; SELECT EXACTLY ONE.",
        "PROFILES SUPPLY A COMPLETE PROC AND EXEC CALL, EXCLUDING JOB CARD.",
        "TO CHANGE SITE: OVERRIDE HLQ SITE TU DU DV ON THE PROFILE EXEC.",
        "PROC IEBCOPY SYSIN IS DIST.INST(COPY); NOT DD * INSIDE PROC.",
        "ONLY ABSENT RECIPIENT DATASETS; NO OVERWRITE, SCRATCH OR RETRY.",
        "MR10 KIT COMPILER EXECUTES INTCODE UNDER ICINT19.",
        "NATIVE PROFILE DISTRIBUTES RUNTIME/LIBRARY/EXTENSION COMPONENTS.",
        "COMBINED INCLUDES BOTH AND CAMBRIDGE COMPILER SOURCES (WIP).",
        "BT0003 THROUGH BT0021 ARE UNCHANGED RC3 PROGRAM PAYLOAD.",
        "VERIFY MVS JES IEBCOPY RC=0000, DCB, DIRECTORY AND BCPL RESULTS.",
    ]
    need(all(len(x)<=80 for x in lines),"BT0001 text overflow")
    return cards(lines)


def profile(m,sizes,which):
    proc,site,positions=PROFILES[which]
    lines=[
        f"//* BCPL-0.1.0-rc4 BC0004 MVS-ONLY {which} INSTALL.",
        "//* SUPPLY AN AUTHORIZED JOB CARD BEFORE THESE RECORDS.",
        "//* DEFAULT HLQ/SITE/UNIT/VOLUME ARE OVERRIDABLE ON //GO EXEC.",
        "//* TARGETS MUST NOT EXIST: NO RESTART, SCRATCH OR OVERWRITE.",
        f"//{proc} PROC HLQ=HERC02,SITE={site},TU=480,DU=SYSDA,",
        "//             DV=TSO002",
    ]
    for n in positions:
        row=m["datasets"][n-1]
        dcb=row["target_dcb"]
        target=row["target_dsn_template"]
        need(target.startswith("{HLQ}.BCPL."),"RC4 unsafe target template")
        suffix=target[len("{HLQ}.BCPL."):]
        p,s,b=sizes[n]
        cond="" if n==positions[0] else ",COND=(0,NE)"
        lines.extend([
            f"//R{n:04d} EXEC PGM=IEBCOPY,REGION=512K{cond}",
            "//SYSPRINT DD SYSOUT=*",
            f"//INTAPE DD DSN=BCPL.BT{n:04d},UNIT=&TU,",
            "//            VOL=(PRIVATE,RETAIN,SER=BC0004),",
            f"//            LABEL=({n},SL),DISP=OLD",
            f"//OUTPDS DD DSN=&HLQ..BCPL.&SITE..{suffix},",
            "//            DISP=(NEW,CATLG,DELETE),UNIT=&DU,",
            "//            VOL=SER=&DV,",
            f"//            SPACE=(TRK,({p},{s},{b})),",
            ("//            DCB=(DSORG=PO,RECFM=U,BLKSIZE=6144)" if n==12
             else "//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,"),
            *([] if n==12 else ["//            BLKSIZE=800)"]),
            "//SYSUT3 DD UNIT=SYSDA,SPACE=(TRK,(10,5))",
            "//SYSUT4 DD UNIT=SYSDA,SPACE=(TRK,(10,5))",
            "//SYSIN DD DSN=&HLQ..BCPL.&SITE..DIST.INST(COPY),",
            "//         DISP=SHR",
        ])
    lines+=["// PEND",f"//GO EXEC {proc}","//"]
    text=cards(lines,jcl=True)
    active=text.splitlines()
    need(re.findall(r"(?m)^//R(\d{4}) EXEC PGM=IEBCOPY",text)==
         [f"{i:04d}" for i in positions],"profile IEBCOPY step selection")
    need(text.count("DISP=(NEW,CATLG,DELETE)")==len(positions) and
         text.count("DIST.INST(COPY)")==len(positions) and
         "DD *" not in text and "DD DATA" not in text,
         "unsafe PROC SYSIN or output allocation")
    return text


def materials(m,sizes):
    boottext=boot(m)
    instr=[
        "CAMBRIDGE BCPL PROGRAMMING SYSTEM - RC4 MVS INSTALLER.",
        "THIS PDS WAS RESTORED FROM STANDARD-LABELED BT0002 USING IEBCOPY.",
        "MEMBERS MR10, NATIVE, COMBINED ARE EXECUTABLE JOBLESS MVS JCL.",
        "ADD A SITE JOB CARD BEFORE THE DESIRED PROFILE MEMBER.",
        "THE PROFILE IN-STREAM PROC DEFAULTS ARE SITE-SPECIFIC.",
        "OVERRIDE HLQ SITE TU DU DV ON THE FINAL //GO EXEC IF REQUIRED.",
        "HLQ IS THE ROOT QUALIFIER; SITE NAMES A FRESH CHILD QUALIFIER.",
        "THE INSTALLER PDS MUST BE <HLQ>.BCPL.<SITE>.DIST.INST.",
        "DEFAULT SITE FOR MR10 R4MR; NATIVE R4NT; COMBINED R4CB.",
        "BT0002(COPY) SUPPLIES IEBCOPY SYSIN FROM AN MVS PDS MEMBER.",
        "VERIFY EVERY OUTPUT IS NOT CATALOGED BEFORE FIRST SUBMISSION.",
        "ALL OUTPUTS ARE NEW, CATALOGED ON SUCCESS; NEVER RESTART BLINDLY.",
        "USE MVS JES, IEBCOPY, LISTDS; NO BCPL DEVELOPMENT TOOLS REQUIRED.",
        "MR10 IS INTERPRETED; THE NATIVE CAMBRIDGE COMPILER IS ABSENT.",
        "DISTRIBUTED NATIVE CODE INCLUDES CORE RUNTIME BLIB COROUTINES.",
        "COMBINED PROFILE ALSO PROVIDES UNFINISHED CAMBRIDGE SOURCE.",
        "READ RELEASE, DATASETS, RESTORE BEFORE SELECTING A PROFILE.",
    ]
    rows=m["datasets"]
    dataset_lines=["21 STANDARD-LABELED TAPE DATASETS; 3 PROFILE CHOICES."]
    for row in rows:
        n=row["sequence"]
        if n>2:
            dataset_lines.append(f"BT{n:04d} {row['group']} {row['target_dsn_template']}")
    release=[
        "CAMBRIDGE BCPL PROGRAMMING SYSTEM FOR MVS 3.8J",
        "CANDIDATE BCPL-0.1.0-rc4; VOLSER BC0004; LABEL TYPE SL.",
        "SCOPE MR10 KIT COMPILER PLUS NATIVE RUNTIME/LIBRARIES/EXTENSIONS.",
        "NATIVE CAMBRIDGE COMPILER: ABSENT. HISTORICAL SOURCE INCLUDED.",
        "21 TAPE DATASETS; ORIGINAL RC3 PROGRAM PAYLOAD RETAINED.",
        "CHECK RELEASE MANIFEST, PROVENANCE AND ACCEPTANCE EVIDENCE.",
    ]
    restore=[
        "THE OLD BC0003 RESTORE TEMPLATE HAS BEEN REPLACED.",
        "BT0002 NOW DISTRIBUTES EXECUTABLE MVS PROFILE JCL MEMBERS.",
        "SELECT MR10, NATIVE OR COMBINED; USE ONE FRESH SITE NAMESPACE.",
        "COPY MEMBER CONTAINS THE IEBCOPY CONTROL STATEMENT.",
        "SITE SYMBOLS HLQ SITE TU DU DV OVERRIDABLE ON //GO EXEC.",
        "NEVER OVERWRITE AN EXISTING DATASET OR RERUN AMBIGUOUS JOBS.",
    ]
    result={"INSTALL":cards(instr),"DATASETS":cards(dataset_lines),
            "RELEASE":cards(release),"RESTORE":cards(restore),
            "COPY":cards([" COPY OUTDD=OUTPDS,INDD=INTAPE"])}
    for name in PROFILES:
        result[name]=profile(m,sizes,name)
    need(set(result)==set(MEMBERS) and
         sum(len(x.splitlines()) for x in result.values())>500,
         "RC4 installer member inventory incomplete")
    return boottext,result


def stage_deck(bt1,members):
    lines=["//* TA.3 RC4 BOOTSTRAP AND INSTALLER STAGING; NEW TARGETS ONLY."]
    def data(text):
        content=text.splitlines()
        need(all(not x.startswith("Z9") for x in content),
             "DD DATA delimiter collision")
        return ["//SYSUT1 DD DATA,DLM=Z9",*content,"Z9"]
    lines += ["//B0001 EXEC PGM=IEBGENER,REGION=512K",
              "//SYSPRINT DD SYSOUT=*","//SYSIN DD DUMMY",*data(bt1),
              "//SYSUT2 DD DSN="+STAGE+"BT0001,",
              "//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,",
              "//            VOL=SER=TSO002,SPACE=(TRK,(5,1)),",
              "//            DCB=(DSORG=PS,RECFM=FB,LRECL=80,BLKSIZE=800)",
              "//A0002 EXEC PGM=IEFBR14,COND=(0,NE)",
              "//OUTPDS DD DSN="+STAGE+"BT0002,",
              "//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,",
              "//            VOL=SER=TSO002,SPACE=(TRK,(50,5,15)),",
              "//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=800)"]
    for i,member in enumerate(MEMBERS,1):
        lines.extend([f"//M{i:04d} EXEC PGM=IEBGENER,REGION=512K,COND=(0,NE)",
                      "//SYSPRINT DD SYSOUT=*","//SYSIN DD DUMMY",
                      *data(members[member]),
                      "//SYSUT2 DD DSN="+STAGE+f"BT0002({member}),",
                      "//            DISP=SHR"])
    lines.append("//")
    outer=[]
    indata=False
    for line in lines:
        if line=="//SYSUT1 DD DATA,DLM=Z9":
            need(not indata,"nested DD DATA")
            indata=True
            outer.append(line)
        elif line=="Z9" and indata:
            indata=False
        elif not indata:
            outer.append(line)
    need(not indata and
         len([x for x in outer if " EXEC PGM=IEBGENER" in x])==9 and
         len([x for x in outer if x=="//SYSUT1 DD DATA,DLM=Z9"])==9 and
         sum("DISP=(NEW,CATLG,DELETE)" in x for x in outer)==2,
         "staging steps or new allocation count changed")
    return cards(lines)


def write_deck(m):
    """Reuse approved tape producer, selecting new BT0001/2 and accepted RC3 3-21."""
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec,spec_from_loader
    path=BASE/"create-tape/scripts/ta2-offline"
    loader=SourceFileLoader("ta3r4_tape_renderer",str(path))
    spec=spec_from_loader(loader.name,loader)
    need(spec is not None and spec.loader is not None,"canonical tape renderer unavailable")
    mod=module_from_spec(spec)
    spec.loader.exec_module(mod)
    import copy
    plan=copy.deepcopy(m)
    for row in plan["datasets"]:
        n=row["sequence"]
        row["producer_source_dsn"]=(STAGE if n<=2 else SOURCE)+f"BT{n:04d}"
    result=mod.render_write_jcl(plan)
    need(result.count(" EXEC PGM=IEBGENER")==1 and
         result.count(" EXEC PGM=IEBCOPY")==20 and
         result.count(" SELECT MEMBER=")==150 and
         "SER=BC0004" in result and "SER=BC0003" not in result and
         "TA2R3S.BT0003" in result and "TA3R4S.BT0002" in result,
         "RC4 writer 21-dataset/150-member selection drift")
    return result


def plan():
    m,sizes=load()
    bt1,members=materials(m,sizes)
    stage=stage_deck(bt1,members)
    writer=write_deck(m)
    need(len(bt1.splitlines())<=80 and
         all(len(x.splitlines())<1200 for x in members.values()),
         "unbounded installer content")
    return bt1,members,stage,writer


def save_preview(bt1,members,stage,writer):
    need(OUT.parent.is_dir() and not OUT.parent.is_symlink() and
         not OUT.exists() and not OUT.is_symlink(),
         "preview directory already exists; no overwrite")
    OUT.mkdir(mode=0o700)
    files={"BT0001.txt":bt1,"stage.jcl":stage,"write.jcl":writer}
    for name,value in members.items():
        files["BT0002-"+name+".txt"]=value
    manifest={}
    for name,data in sorted(files.items()):
        target=OUT/name
        with target.open("x",encoding="ascii") as f:
            f.write(data)
        manifest[name]=sha(data.encode("ascii"))
    with (OUT/"SHA256SUMS").open("x",encoding="ascii") as f:
        for name,digest in sorted(manifest.items()):
            f.write(digest+"  "+name+"\n")
    return len(files)


def main(argv=None):
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prepare",action="store_true",
                        help="write new offline source and JCL into repository workarea")
    args=parser.parse_args(argv)
    try:
        bt1,members,stage,write=plan()
        if args.prepare:
            n=save_preview(bt1,members,stage,write)
            print(f"TA.3 RC4 OFFLINE PREPARED: {n} artifacts; 21 tape datasets; "
                  "8 installer members. NO MVS/TAPE action.")
            print("Evidence: workarea/ta3-rc4-installer")
        else:
            print("TA.3 RC4 OFFLINE PLAN PASS: 21 tape datasets; "
                  "8 BT0002 members; 3 MVS PROC profile jobs. NO MVS/TAPE action.")
        return 0
    except (Refusal,ValueError,OSError,KeyError,AssertionError) as exc:
        print("TA.3 RC4 REFUSED: "+str(exc),file=sys.stderr)
        return 2


if __name__=="__main__":
    raise SystemExit(main())
