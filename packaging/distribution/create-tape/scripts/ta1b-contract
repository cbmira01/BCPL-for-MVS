#!/usr/bin/env python3
"""TA.1 Track B: static source/JCL contract and safe generated MVS JCL.

No JES, tape, device or dataset access. Never modifies existing source.
The exact eight-step restored-STEPLIB job is derived from pinned MRREGRES.
"""
from __future__ import annotations

import hashlib
import importlib.util
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[4]
JCL = ROOT / 'packaging/distribution/create-tape/jcl'
MR10 = ROOT / 'mr10-kit-compiler/jcl/run-regression-tests.jcl'
PILOT = ROOT / 'tools/distribution/verify-icint19-executable.py'
SOURCE_BLOB = '28abf582b286401f483f1c11fcd63e303764f75e'
SOURCE = 'HERC02.BCPL.MR10KIT.LOAD'
TARGET = 'HERC02.BCPL.TA1B.LOAD'
TAPE_DSN = 'BCPL.BT0001'
VOLSER = 'BTA102'
IMAGE = 'bcpl-ta1-b-20261117-01.aws'
MEMBER = 'ICINT19'
STEP_NAMES = ('SSYNI', 'STRNI', 'SCGI', 'SBLIBI', 'SICLIB', 'C01A', 'G01A', 'R01')
PROGRAMS = ('IEBGENER',) * 5 + ('ICINT19',) * 3
EXPECTED_RP = ('RP: SCALAR 17 42', 'RP: VECTOR 5 10 15 20')
QUALIFIER = re.compile(r'[A-Z@$#][A-Z0-9@$#]{0,7}\Z')
VOL_PATTERN = re.compile(r'[A-Z0-9]{1,6}\Z')
UNIT_PATTERN = re.compile(r'[A-Z0-9@$#]{1,8}\Z')
EXEC = re.compile(r'^//([A-Z0-9]{1,8})\s+EXEC\s+PGM=([A-Z0-9]+)', re.M)


class ContractError(ValueError):
    pass


def need(ok: bool, why: str) -> None:
    if not ok:
        raise ContractError(why)


def file_cards(name: str, *, root: Path = ROOT) -> str:
    path = root / 'packaging/distribution/create-tape/jcl' / (name + '.jcl')
    need(path.is_file() and not path.is_symlink(), name + ': missing/unsafe JCL')
    source = path.read_text(encoding='ascii')
    need(source.endswith('/*\n//\n'), name + ': missing JES end cards')
    need('NO MVS EXECUTION WITHOUT OWNER APPROVAL' in source,
         name + ': execution warning missing')
    need(all(len(line) <= 80 and '\t' not in line for line in source.splitlines()),
         name + ': JCL exceeds 80 columns')
    need(not re.search(r'(?m)^//[^\s*/]+\s+(JOB|PROC|INCLUDE|JCLLIB)\b', source),
         name + ': unexpected JOB/procedure expansion')
    return source


def validate_tape_jobs(*, root: Path = ROOT) -> None:
    write = file_cards('TA1BWRIT', root=root)
    rest = file_cards('TA1BREST', root=root)
    need(EXEC.findall(write) == [('UNLOAD', 'IEBCOPY')],
         'unexpected unload steps')
    need(EXEC.findall(rest) == [('RESTORE', 'IEBCOPY')],
         'unexpected restore steps')
    need(re.findall(r'\bDSN=([A-Z0-9.]+)', write) == [SOURCE, TAPE_DSN],
         'unload must read source and write only first tape dataset')
    need(re.findall(r'\bDSN=([A-Z0-9.]+)', rest) == [TAPE_DSN, TARGET],
         'restore must read tape and write only scratch DASD load PDS')
    need('DSN=' + SOURCE + ',DISP=SHR' in write,
         'source MR10_LOAD must be read only')
    need('SELECT MEMBER=(ICINT19)' in write and write.count('SELECT MEMBER=') == 1,
         'only ICINT19 may be unloaded')
    need(write.count('COPY OUTDD=OUTTAPE,INDD=INPDS') == 1,
         'exact IEBCOPY selective unload not found')
    need('DSN=' + TAPE_DSN + ',UNIT=480,' in write and
         'VOL=(PRIVATE,SER=' + VOLSER + ')' in write and
         'LABEL=(1,SL)' in write and
         'DISP=(NEW,KEEP,KEEP)' in write,
         'new SL tape output must be kept, not cataloged')
    active = '\n'.join(x for x in write.splitlines() if not x.startswith('//*'))
    need('DSORG=PO' not in active and 'RECFM=U' not in active and
         'BLKSIZE=6144' not in active,
         'do not force PO/U load DCB onto sequential IEBCOPY unload')
    need('COPY OUTDD=OUTPDS,INDD=INTAPE' in rest and
         rest.count('COPY OUTDD=') == 1,
         'IEBCOPY restore control statement incorrect')
    need('DSN=' + TAPE_DSN + ',UNIT=480,' in rest and
         'VOL=SER=' + VOLSER in rest and
         'LABEL=(1,SL)' in rest and 'DISP=OLD' in rest,
         'restore must read uncataloged BTA102 tape dataset 1')
    need('DSN=' + TARGET in rest and
         'DCB=(DSORG=PO,RECFM=U,LRECL=0,BLKSIZE=6144)' in rest and
         'DISP=(NEW,CATLG,DELETE)' in rest,
         'restore must allocate fresh PO/U/0/6144 DASD PDS')
    for deck in (write, rest):
        need('DISP=MOD' not in deck and 'DISP=(MOD' not in deck and
             'DISP=(OLD,CATLG' not in deck, 'overwrite/append prohibited')


def git_blob(data: bytes) -> str:
    return hashlib.sha1(b'blob ' + str(len(data)).encode('ascii') + b'\0' + data).hexdigest()


def source_bytes(*, root: Path = ROOT) -> bytes:
    path = root / 'mr10-kit-compiler/jcl/run-regression-tests.jcl'
    need(path.is_file() and not path.is_symlink(), 'canonical MRREGRES JCL unavailable')
    data = path.read_bytes()
    need(git_blob(data) == SOURCE_BLOB, 'canonical MRREGRES Git blob changed')
    return data


def pilot_module(path: Path = PILOT):
    need(path.is_file() and not path.is_symlink(), 'canonical TA.0 MR10 pilot unavailable')
    spec = importlib.util.spec_from_file_location('ta1b_reviewed_mr10_pilot', path)
    need(spec is not None and spec.loader is not None, 'cannot load canonical pilot')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def go_body(*, canonical: bytes | None = None, pilot=None) -> str:
    if canonical is None:
        canonical = source_bytes()
    need(git_blob(canonical) == SOURCE_BLOB, 'MRREGRES pin mismatch')
    if pilot is None:
        pilot = pilot_module()
    need(getattr(pilot, 'SOURCE_BLOB', None) == SOURCE_BLOB and
         tuple(getattr(pilot, 'STEPS', ())) == STEP_NAMES and
         tuple(getattr(pilot, 'GOLDEN', ())) == EXPECTED_RP,
         'TA.0 approved scalar/vector contract has changed')
    body, verified_blob = pilot.canonical_steps(canonical, hlq='HERC02', load_dsn=SOURCE)
    need(verified_blob == SOURCE_BLOB, 'canonical pilot did not verify source')
    old = f'DSN={SOURCE},DISP=SHR'
    new = f'DSN={TARGET},DISP=SHR'
    need(body.count(old) == 3 and body.count('//STEPLIB') == 3,
         'expected exactly three original ICINT19 STEPLIB DDs')
    body = body.replace(old, new)
    need(body.count(new) == 3 and SOURCE not in body and
         tuple(name for name, _ in EXEC.findall(body)) == STEP_NAMES and
         tuple(pgm for _, pgm in EXEC.findall(body)) == PROGRAMS,
         'restored-execution job steps/source bindings are inconsistent')
    cards = ('//* TA.1 TRACK B GO: RESTORED ICINT19 ONLY; NEW TEMP && DATA.\n'
             '//* DESIGN APPROVED; NO MVS EXECUTION WITHOUT OWNER APPROVAL.\n'
             '//* DERIVED FROM PINNED MRREGRES SCALVEC CASE; NO NEW COMPILER.\n'
             + body + '//\n')
    need(all(len(line) <= 80 and '\t' not in line for line in cards.splitlines()),
         'generated GO exceeds 80 columns')
    return cards


def directory_body(dsn: str, volser: str, unit: str) -> str:
    need(dsn in (SOURCE, TARGET), 'IEHLIST may inspect only source or restored load PDS')
    need(VOL_PATTERN.fullmatch(volser) is not None and
         UNIT_PATTERN.fullmatch(unit) is not None,
         'invalid DASD VOLSER/UNIT for IEHLIST')
    need(all(QUALIFIER.fullmatch(part) for part in dsn.split('.')),
         'invalid load-library DSN')
    body = '\n'.join([
        '//* TA.1 TRACK B: READ-ONLY IEHLIST LOAD DIRECTORY FORMAT.',
        '//* DESIGN APPROVED; NO MVS EXECUTION WITHOUT OWNER APPROVAL.',
        '//DIRLIST  EXEC PGM=IEHLIST',
        '//SYSPRINT DD SYSOUT=*',
        f'//VOLDD    DD DSN={dsn},',
        f'//            DISP=SHR,UNIT={unit},VOL=SER={volser}',
        '//SYSIN    DD *',
        f' LISTPDS DSNAME={dsn},VOL={unit}={volser},FORMAT',
        '/*',
        '//',
        '',
    ])
    need(all(len(line) <= 80 for line in body.splitlines()),
         'generated IEHLIST exceeds 80 columns')
    return body


def validate_static(*, root: Path = ROOT, pilot=None) -> None:
    validate_tape_jobs(root=root)
    canonical = source_bytes(root=root)
    go_body(canonical=canonical, pilot=pilot)
    directory_body(SOURCE, 'TSO002', 'SYSDA')
    directory_body(TARGET, 'TSO002', 'SYSDA')


if __name__ == '__main__':
    try:
        validate_static()
    except (ContractError, OSError, UnicodeError, ValueError) as exc:
        print('TA.1 TRACK B STATIC REFUSED: ' + str(exc), file=sys.stderr)
        sys.exit(2)
    print('TA.1 TRACK B STATIC PASS; NO MVS/TAPE OPERATION')
