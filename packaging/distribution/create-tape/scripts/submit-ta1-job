#!/usr/bin/env python3
"""Explicit, one-shot TA.1 Track A JES submission, never tape initialization.

A successful local guard does NOT prove correct live MVS/Hercules position,
VOLSER, source/target catalog, or independently authorized media operation.
Review those manually before --run; on uncertainty stop, never retry.
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[4]
SCRIPT_DIR = ROOT / 'packaging/distribution/create-tape/scripts'
TAPE = ROOT / 'mvs-state/tape/bcpl-ta1-a-20261117-01.aws'
LOCKDIR = ROOT / 'workarea/ta1-operations'
JOBS = ('TA1AWRIT', 'TA1AR001', 'TA1AR002', 'TA1ACOMP')


class Refusal(ValueError):
    pass


def load_script(path: Path, name: str):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise Refusal('missing approved repository helper')
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def validate_media() -> None:
    if TAPE.is_symlink() or not TAPE.is_file() or TAPE.stat().st_size == 0:
        raise Refusal('expected initialized media absent or unsafe; no JES submission')
    # A file check cannot verify VOL1, mounted identity, MVS readiness, or position.


def record_attempt(job: str) -> Path:
    root = ROOT / 'workarea'
    if root.is_symlink() or (root.exists() and not root.is_dir()):
        raise Refusal('unsafe workarea root')
    root.mkdir(exist_ok=True)
    if LOCKDIR.is_symlink() or (LOCKDIR.exists() and not LOCKDIR.is_dir()):
        raise Refusal('unsafe attempt ledger directory')
    LOCKDIR.mkdir(exist_ok=True)
    marker = LOCKDIR / ('BTA101-' + job + '.json')
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0)
    try:
        fd = os.open(marker, flags, 0o600)
    except FileExistsError as exc:
        raise Refusal('attempt already recorded; NEVER retry or auto-resume') from exc
    with os.fdopen(fd, 'w', encoding='ascii') as out:
        json.dump({'job': job, 'volser': 'BTA101',
                   'image': TAPE.name, 'state': 'SUBMISSION_ATTEMPTED',
                   'policy': 'NO_AUTOMATIC_RETRY'}, out)
        out.write('\n')
        out.flush()
        os.fsync(out.fileno())
    return marker


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('job', choices=JOBS)
    ap.add_argument('--run', action='store_true', help='one JES submission only')
    ap.add_argument('--show-deck', action='store_true', help='redacted preview')
    args = ap.parse_args(argv)
    try:
        guard = load_script(SCRIPT_DIR / 'ta1-preflight', 'ta1_static_guard')
        submit = load_script(SCRIPT_DIR / 'submit-scratch-job', 'ta1_submit_util')
        guard.validate_contract()
        body = guard.validate_card_file(args.job)
        core = submit.load_core()
        config = core.load_config()
        if str(config['mvs']['hlq']).upper() != 'HERC02':
            raise Refusal('effective HLQ differs from reviewed JCL')
        if not args.run:
            print(f'{args.job}: approved JCL static check PASS; no JES operation')
            print('Live VOLSER, device, dataset and owner media authorization NOT CHECKED')
            if args.show_deck:
                print(submit.make_deck(core, config, args.job, body, redact=True))
            return 0
        if args.show_deck:
            raise Refusal('show-deck and --run must be separate invocations')
        validate_media()
        if not sys.stdin.isatty():
            raise Refusal('--run requires interactive operator confirmation')
        token = 'SUBMIT ' + args.job + ' BTA101'
        print(f'{args.job} can modify MVS/tape; no automatic retry after any result.')
        answer = input(f'After independent live checks and explicit approval, type {token}: ')
        if answer.strip() != token:
            raise Refusal('operator did not confirm this single submission')
        # Durable one-shot marker is created BEFORE transport. A failed or
        # ambiguous submission consumes the attempt; no automatic retry.
        marker = record_attempt(args.job)
        deck = submit.make_deck(core, config, args.job, body, redact=False)
        # Keep dspal-core's private JCL deck in repository workarea, not /tmp.
        # The core uses tempfile.NamedTemporaryFile without a directory.
        old_tempdir = tempfile.tempdir
        try:
            tempfile.tempdir = str(LOCKDIR)
            jobno, summary = core.submit_and_wait(
                config, deck, max_rc=0,
                cursor_file=LOCKDIR / ('BTA101-' + args.job + '.cursor.json'))
        finally:
            tempfile.tempdir = old_tempdir
        print(f'{args.job}: JES JOB {jobno} returned accepted RC=0')
        for line in summary.splitlines()[:18]:
            print(line)
        print(f'Attempt receipt: {marker.relative_to(ROOT)}')
        return 0
    except Refusal as exc:
        print('TA.1 JOB REFUSED: ' + str(exc), file=sys.stderr)
        print('No automatic JES retry. Preserve tape and existing evidence.', file=sys.stderr)
        return 2
    except (OSError, RuntimeError, ValueError, UnicodeError) as exc:
        # Existing authenticated-core errors may include private JES material.
        print('TA.1 JOB FAILED: ' + type(exc).__name__, file=sys.stderr)
        print('No automatic JES retry. Preserve tape and existing evidence.', file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
