#!/usr/bin/env python3
"""TA.1 Track B: approved-only, one-shot BTA102 IEBCOPY tape producer.

DESIGN/READ-ONLY PREFLIGHT APPROVAL IS NOT MEDIA-WRITE AUTHORIZATION.
No state change by default. --run requires separate owner approval and a TTY.
No resume, overwrite, retry, remount, automatic restore or GO execution.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[4]
SCRIPT = ROOT / 'packaging/distribution/create-tape/scripts'
JCL = ROOT / 'packaging/distribution/create-tape/jcl/TA1BWRIT.jcl'
TAPE = ROOT / 'mvs-state/tape/bcpl-ta1-b-20261117-01.aws'
OPS = ROOT / 'workarea/ta1b-operations'
ATTEMPT = OPS / 'BTA102-track-b-init-write.json'
EVIDENCE = OPS / ('BTA102-track-b-write-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + str(os.getpid()))
VOLSER = 'BTA102'
UNIT = '0480'
JOB = 'TA1BWRIT'
DSN = 'BCPL.BT0001'


class Halt(RuntimeError):
    pass


def need(condition: bool, reason: str) -> None:
    if not condition:
        raise Halt(reason)


def import_script(filename: str, name: str):
    path = SCRIPT / filename
    need(path.is_file() and not path.is_symlink(), f'unsafe helper: {filename}')
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    need(spec is not None and spec.loader is not None, f'helper unavailable: {filename}')
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def check_paths() -> None:
    work = ROOT / 'workarea'
    tapes = TAPE.parent
    need(work.is_dir() and not work.is_symlink(), 'workarea missing/linked')
    need(tapes.is_dir() and not tapes.is_symlink() and
         not tapes.parent.is_symlink() and tapes.resolve().is_relative_to(ROOT.resolve()),
         'tape directory missing/linked/outside repository')
    need(not OPS.is_symlink(), 'unsafe operations directory')
    need(not ATTEMPT.exists() and not ATTEMPT.is_symlink(), 'one-shot attempt already recorded: DO NOT RETRY')
    need(not TAPE.exists() and not TAPE.is_symlink(), 'BTA102 image already exists: DO NOT OVERWRITE')


def take_attempt() -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0)
    try:
        fd = os.open(ATTEMPT, flags, 0o600)
    except FileExistsError as exc:
        raise Halt('prior attempt recorded; DO NOT RETRY') from exc
    with os.fdopen(fd, 'w', encoding='ascii') as out:
        json.dump({'state': 'STATEFUL_ATTEMPT_STARTED', 'image': TAPE.name,
                   'volser': VOLSER, 'job': JOB, 'no_retry': True}, out)
        out.write('\n')
        out.flush()
        os.fsync(out.fileno())


def reserve_image() -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0)
    try:
        fd = os.open(TAPE, flags, 0o600)
    except FileExistsError as exc:
        raise Halt('BTA102 image appeared during preflight; refuse overwrite') from exc
    os.close(fd)


def unit_ready(preflight, evidence: Path, *, mounted: bool) -> None:
    status = preflight.checked(['tools/mvs/mvs-console', 'tape', 'status', UNIT],
                               'device-mounted' if mounted else 'device-empty', evidence)
    rows = [x for x in status.splitlines() if re.search(r'\b0:0480\s+3420\s+', x)]
    need(len(rows) == 1 and 'busy' not in rows[0].lower(), 'Hercules unit missing/busy/ambiguous')
    if mounted:
        need(re.search(r'(?:^|[/\s])' + re.escape(TAPE.name) + r'(?=\s|$)', rows[0]) is not None,
             'expected BTA102 image not mounted')
    else:
        need(re.search(r'\b3420\s+\*\s', rows[0]) is not None,
             'Hercules unit holds media; cannot displace it')
    guest = preflight.checked(['tools/mvs/mvs-console', 'mvs', 'D U,TAPE'],
                              'mvs-mounted' if mounted else 'mvs-empty', evidence)
    matches = [x for x in guest.splitlines() if re.match(r'^\s*480\s+3400\s+', x)]
    need(len(matches) == 1, 'MVS tape unit 480 status row missing/ambiguous')
    state = re.match(r'^\s*480\s+3400\s+(O(?:-NRD)?)(?=\s|$)', matches[0])
    need(state is not None, 'MVS unit 480 status unrecognized: ' + matches[0].strip())
    if mounted:
        need(state.group(1) == 'O',
             'MVS tape unit 480 is not ready after BTA102 mount: ' + state.group(1))
    else:
        need(state.group(1) in ('O', 'O-NRD'),
             'MVS tape unit 480 not online before mount')
    need(not re.search(r'\b(?:ALLOC|BUSY)\b', matches[0], re.I), 'MVS tape unit allocated/busy')


def docker_identity(preflight, evidence: Path) -> None:
    rc, result = preflight.run(['docker', 'inspect', '-f', '{{json .Config.Env}}', 'mvs38j'],
                                'docker-uid-gid', None)  # Do not persist other environment secrets.
    need(rc == 0, 'cannot inspect MVS container effective UID/GID')
    try:
        envlist = json.loads(result)
        env = dict(x.split('=', 1) for x in envlist if '=' in x)
    except (TypeError, ValueError) as exc:
        raise Halt('invalid MVS container environment') from exc
    need(env.get('MVS_UID') == str(os.getuid()) and
         env.get('MVS_GID') == str(os.getgid()),
         'MVS container UID/GID mismatch with repository owner')
    helptext = preflight.checked(['docker', 'exec', 'mvs38j', 'hetinit', '-h'],
                                 'hetinit-help', evidence)
    need('-d' in helptext and '-i' in helptext, 'installed hetinit contract not confirmed')


def volume_label(text: str) -> str:
    need(text.count("Label               : 'VOL1'") == 1, 'expected exactly one VOL1 label')
    m = re.search(r"(?m)^Volume Serial\s+:\s+'([A-Z0-9]{1,6})'\s*$", text)
    need(m is not None, 'cannot parse volume serial')
    return m.group(1)


def final_labels(text: str) -> None:
    need(volume_label(text) == VOLSER, 'wrong VOL1 serial on written image')
    for name in ('HDR1', 'HDR2', 'EOF1', 'EOF2'):
        need(text.count(f"Label               : '{name}'") == 1,
             f'expected exactly one {name} label')
    for name in ('HDR1', 'EOF1'):
        block = re.search(rf"Label\s+: '{name}'(.*?)(?=Label\s+: '|\Z)", text, re.S)
        need(block is not None and
             f"Dataset ID          : '{DSN}" in block.group(1) and
             "Volume Serial       : 'BTA102'" in block.group(1) and
             "Dataset Sequence    : '0001'" in block.group(1),
             f'{name} missing DSN/VOLSER/sequence 0001')


def physical_files(text: str) -> list[int]:
    rows = list(re.finditer(r'(?m)^File\s+#\s*:\s*(\d+)\s*$', text))
    sizes = []
    for i, row in enumerate(rows):
        end = rows[i + 1].start() if i + 1 < len(rows) else len(text)
        section = text[row.end():end]
        count = re.search(r'(?m)^Blocks\s*:\s*(\d+)\s*$', section)
        need(int(row.group(1)) == i + 1 and count is not None,
             'hetmap file numbering/block count ambiguous')
        sizes.append(int(count.group(1)))
    need(len(sizes) == 4 and sizes[0] == 3 and sizes[1] > 0 and
         sizes[2] == 2 and sizes[3] == 0,
         f'unexpected single-dataset physical layout: {sizes}')
    return sizes


def check_summary(summary: str, job: int) -> None:
    need(re.search(rf'(?m)^JOB\s+{job}\s+{JOB}\s*$', summary) is not None,
         'JES job identity missing/mismatched')
    need('JOB RESULT: SUCCESS' in summary and 'HIGHEST RC: 0000' in summary,
         'MVS job not successful')
    matches = re.findall(r'(?m)^([A-Z0-9]{1,8})\s+([A-Z0-9]+)\s+RC=(\d{4})\s*$', summary)
    need(matches == [('UNLOAD', 'IEBCOPY', '0000')],
         'IEBCOPY UNLOAD is not the one successful job step')


def submit_once(contract, preflight, evidence: Path) -> int:
    # The JES password is generated in memory; never write the authenticated deck.
    core_path = ROOT / 'tools/datasets/dspal-core.py'
    need(core_path.is_file() and not core_path.is_symlink(), 'dspal core unavailable')
    spec = importlib.util.spec_from_file_location('ta1b_dspal_core', core_path)
    need(spec is not None and spec.loader is not None, 'dspal core load failed')
    core = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(core)
    config = core.load_config()
    need(str(config['mvs']['hlq']).upper() == 'HERC02', 'effective HLQ differs from source JCL')
    body = contract.file_cards(JOB)
    cards = core.authenticated_job_card(config, JOB, 'TA1B LOAD UNLOAD', redact_password=False)
    deck = '\n'.join(cards) + '\n' + body
    cursor = OPS / 'BTA102-TA1BWRIT.cursor.json'
    previous = tempfile.tempdir
    try:
        tempfile.tempdir = str(OPS)
        job, summary = core.submit_and_wait(config, deck, max_rc=0, cursor_file=cursor)
    finally:
        tempfile.tempdir = previous
    need(isinstance(job, int) and job > 0, 'unrecognized JES job number')
    (evidence / 'summary.txt').write_text(summary, encoding='utf-8')
    (evidence / 'summary.txt').chmod(0o600)
    check_summary(summary, job)
    preflight.checked(['tools/mvs/dump-report-for-job', str(job), '--cursor-file', str(cursor)],
                      'jes-report', evidence)
    return job


def inspect_written(preflight, evidence: Path) -> tuple[str, list[int]]:
    basename = '/tk5/tape/' + TAPE.name
    labels = preflight.checked(['docker', 'exec', 'mvs38j', 'hetmap', '-l', basename],
                               'labels-final', evidence)
    final_labels(labels)
    files = preflight.checked(['docker', 'exec', 'mvs38j', 'hetmap', '-f', basename],
                              'files-final', evidence)
    all_map = preflight.checked(['docker', 'exec', 'mvs38j', 'hetmap', '-a', basename],
                                'map-final', evidence)
    blocks = physical_files(files)
    need(physical_files(all_map) == blocks, 'hetmap physical file listings disagree')
    need(TAPE.is_file() and not TAPE.is_symlink(), 'written tape path changed/unsafe')
    with TAPE.open('rb') as stream:
        digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    (evidence / 'sha256.txt').write_text(digest + '  mvs-state/tape/' + TAPE.name + '\n')
    (evidence / 'sha256.txt').chmod(0o600)
    return digest, blocks


def operation() -> int:
    need(sys.stdin.isatty(), 'operator TTY required for stateful operation')
    check_paths()
    need(not EVIDENCE.exists() and not EVIDENCE.is_symlink(), 'evidence path already exists')
    OPS.mkdir(mode=0o700, parents=True, exist_ok=True)
    EVIDENCE.mkdir(mode=0o700, exist_ok=False)
    contract = import_script('ta1b-contract', 'ta1b_write_contract')
    preflight = import_script('ta1b-preflight', 'ta1b_write_preflight')
    contract.validate_static()
    first = EVIDENCE / 'preflight-first'
    first.mkdir(mode=0o700)
    source_volume, state, count = preflight.live(contract, first)
    need(source_volume == 'TSO003', 'MR10_LOAD volume changed from approved preflight')
    need(state == 'EMPTY', 'Hercules 0480 occupied: no mount permitted')
    unit_ready(preflight, first, mounted=False)
    docker_identity(preflight, first)
    guard = preflight.checked(['git', 'status', '--porcelain', '--untracked-files=no', '--',
        'packaging/distribution/create-tape/scripts/run-ta1-track-b-write',
        'packaging/distribution/create-tape/scripts/ta1b-preflight',
        'packaging/distribution/create-tape/scripts/ta1b-contract',
        'packaging/distribution/create-tape/jcl/TA1BWRIT.jcl'], 'git-writer-guard', first)
    need(not guard.strip(), 'reviewed writer/JCL differs from GitHub main')
    print(f'TA.1 Track B: fresh read-only preflight PASS; {count} existing images inspected.')
    print('No new media or MVS datasets were written.')
    token = 'INIT MOUNT WRITE BTA102'
    need(input(f'Type {token} to authorize one new BTA102 scratch tape: ').strip() == token,
         'operator did not confirm stateful authorization')
    check_paths()
    again = EVIDENCE / 'preflight-second'
    again.mkdir(mode=0o700)
    source_volume, state, _ = preflight.live(contract, again)
    need(source_volume == 'TSO003', 'MR10_LOAD source DASD volume changed')
    need(state == 'EMPTY', 'Hercules 0480 occupied on final preflight')
    unit_ready(preflight, again, mounted=False)
    take_attempt()                       # Irreversible no-retry decision precedes file creation.
    reserve_image()                      # O_EXCL prevents replacement of any prior AWS bytes.
    preflight.checked(['docker', 'exec', '--user', f'{os.getuid()}:{os.getgid()}',
                       'mvs38j', 'hetinit', '-d', '-i', '/tk5/tape/' + TAPE.name, VOLSER],
                      'initialize', EVIDENCE)
    fresh = preflight.checked(['docker', 'exec', 'mvs38j', 'hetmap', '-l',
                               '/tk5/tape/' + TAPE.name], 'labels-initial', EVIDENCE)
    need(volume_label(fresh) == VOLSER, 'freshly initialized image VOLSER mismatch')
    third = EVIDENCE / 'preflight-third'
    third.mkdir(mode=0o700)
    unit_ready(preflight, third, mounted=False)
    preflight.checked(['tools/mvs/mvs-console', '--yes', 'tape', 'mount', UNIT, TAPE.name],
                      'mount', EVIDENCE)
    fourth = EVIDENCE / 'preflight-fourth'
    fourth.mkdir(mode=0o700)
    unit_ready(preflight, fourth, mounted=True)
    print('BTA102 initialized and mounted at Hercules 0480; next step is one MVS unload.')
    token = 'SUBMIT TA1BWRIT BTA102'
    print(f'Type {token} to submit the approved IEBCOPY selected-member unload exactly once.')
    need(input('Submission confirmation: ').strip() == token,
         'unload not confirmed; preserve mounted image and attempt receipt')
    job = submit_once(contract, preflight, EVIDENCE)
    preflight.checked(['tools/mvs/mvs-console', 'tape', 'status', UNIT],
                      'hercules-after', EVIDENCE)
    preflight.checked(['tools/mvs/mvs-console', 'mvs', 'D U,TAPE'],
                      'mvs-after', EVIDENCE)
    digest, physical = inspect_written(preflight, EVIDENCE)
    print(f'TA1BWRIT MVS JOB {job}: IEBCOPY UNLOAD RC=0000.')
    print('Hercules physical-file blocks: ' + ', '.join(map(str, physical)))
    print('Immutable BTA102 image SHA-256: ' + digest)
    print('Evidence: ' + str(EVIDENCE.relative_to(ROOT)))
    print('Track B write stage complete; restoration and GO remain separately gated.')
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run', action='store_true', help='requires separate owner tape-write approval')
    args = parser.parse_args(argv)
    if not args.run:
        print('No media operation. --run requires explicit new BTA102 write authorization.')
        return 0
    try:
        return operation()
    except (Halt, OSError, ValueError, RuntimeError, UnicodeError) as exc:
        detail = str(exc) if isinstance(exc, Halt) else type(exc).__name__
        print('TA.1B WRITE HALTED: ' + detail, file=sys.stderr)
        print('Preserve media, dataset and receipts; do not retry, remount, overwrite or restore.',
              file=sys.stderr)
        if EVIDENCE.is_dir() and not EVIDENCE.is_symlink():
            print('Evidence: ' + str(EVIDENCE.relative_to(ROOT)), file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
