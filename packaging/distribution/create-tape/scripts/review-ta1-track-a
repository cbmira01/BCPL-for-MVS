#!/usr/bin/env python3
"""Read-only TA.1 Track A acceptance review of retained JES and HETMAP evidence.

Never submits JES, changes media, mounts a device or modifies datasets.
Reports bounded results only; rejects unexpected or missing MVS evidence.
"""
from __future__ import annotations

import argparse
import hashlib
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[4]
WRITE = ROOT / 'workarea/ta1-operations/BTA101-track-a-execution-20261118T010626Z-5215'
READ = ROOT / 'workarea/ta1-operations/BTA101-track-a-readback-20261118T020430Z-5920'
IMAGE = ROOT / 'mvs-state/tape/bcpl-ta1-a-20261117-01.aws'
SHA = 'd5900cbccaaa2f7eb1bcc59ae30847540e6911c577dafa5e131c0b3a9c8e3fe2'
MEMBERS = {'COMPILE', 'DATASETS', 'INSTALL', 'LICENSE', 'README', 'RELEASE', 'VERIFY'}
JOBS = {'TA1AWRIT': (9076, ('BOOTSTRP', 'UNLOAD')),
        'TA1AR001': (9084, ('RESTORE',)),
        'TA1AR002': (9086, ('RESTORE',)),
        'TA1ACOMP': (9089, ('CMPFB', 'CMPPDS'))}


class InvalidEvidence(RuntimeError):
    pass


def need(ok: bool, message: str) -> None:
    if not ok:
        raise InvalidEvidence(message)


def plain(root: Path, name: str) -> str:
    need(root.is_dir() and not root.is_symlink(), 'missing or unsafe evidence directory')
    f = root / name
    need(f.is_file() and not f.is_symlink() and f.stat().st_size <= 32 * 1024 * 1024,
         f'missing/unsafe evidence: {name}')
    return f.read_text(encoding='utf-8', errors='replace')


def summary(text: str, name: str, job: int, steps: tuple[str, ...]) -> None:
    need(re.search(rf'(?m)^JOB\s+{job}\s+{name}\s*$', text) is not None,
         f'{name}: wrong JES job identity')
    need('JOB RESULT: SUCCESS' in text and 'HIGHEST RC: 0000' in text,
         f'{name}: missing successful job summary')
    found = re.findall(r'(?m)^([A-Z0-9]{1,8})\s+([A-Z0-9]+)\s+RC=(\d{4})\s*$', text)
    need(tuple(row[0] for row in found) == steps and all(row[2] == '0000' for row in found),
         f'{name}: step identities or return codes differ')
    need(not any(x in text for x in ('ABEND:', 'JCL ERROR:', 'BYPASSED:')),
         f'{name}: unexpected failure flags')


def file_layout(text: str) -> list[int]:
    """Read real Hercules hetmap -f/-a physical-file groups (not logical labels)."""
    matches = list(re.finditer(r'(?m)^File\s+#\s*:\s*(\d+)\s*$', text))
    result = []
    for i, match in enumerate(matches):
        end = matches[i + 1].start() if i + 1 < len(matches) else len(text)
        group = text[match.end():end]
        count = re.search(r'(?m)^Blocks\s*:\s*(\d+)\s*$', group)
        need(count is not None, f'physical file {match.group(1)} has no block count')
        need(int(match.group(1)) == i + 1, 'physical file numbering is not contiguous')
        result.append(int(count.group(1)))
    need(len(result) == 7, f'expected 7 physical tape files, observed {len(result)}')
    need(result[0] == 3 and result[2] == 2 and result[3] == 2 and
         result[5] == 2 and result[6] == 0,
         f'unexpected header/trailer/terminal file structure: {result}')
    need(result[1] > 0 and result[4] > 0, 'one or both data files are empty')
    return result


def verify_labels(text: str) -> None:
    need(text.count("Label               : 'VOL1'") == 1 and
         "Volume Serial       : 'BTA101'" in text,
         'VOL1/VOLSER not uniquely confirmed')
    for i, dsn in enumerate(('BCPL.BT0001', 'BCPL.BT0002'), 1):
        need(text.count("Dataset ID          : '" + dsn) == 2 and
             text.count(f"Dataset Sequence    : '{i:04d}'") == 2,
             f'{dsn}: header/trailer or dataset sequence mismatch')
    for tag in ('HDR1', 'HDR2', 'EOF1', 'EOF2'):
        need(text.count("Label               : '" + tag + "'") == 2,
             f'expected two {tag} label groups')


def review() -> dict[str, object]:
    need(IMAGE.is_file() and not IMAGE.is_symlink(), 'original AWS image missing/unsafe')
    with IMAGE.open('rb') as stream:
        digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    need(digest == SHA, 'BTA101 image checksum changed')
    receipt = plain(WRITE, 'sha256.txt').strip()
    need(receipt == f'{SHA}  mvs-state/tape/{IMAGE.name}', 'write checksum receipt mismatch')
    for name, (job, steps) in JOBS.items():
        src = WRITE if name == 'TA1AWRIT' else READ
        file = 'summary.txt' if name == 'TA1AWRIT' else f'summary-{name}.txt'
        summary(plain(src, file), name, job, steps)
        submit = plain(src, 'submit.txt' if name == 'TA1AWRIT' else f'submit-{name}.txt')
        need(f'{name}: JES JOB {job} returned accepted RC=0' in submit,
             f'{name}: submission receipt disagrees')
    verify_labels(plain(WRITE, 'labels-final.txt'))
    f = file_layout(plain(WRITE, 'files-final.txt'))
    a = file_layout(plain(WRITE, 'map-final.txt'))
    need(f == a, 'hetmap --files and --all physical file counts disagree')
    for org, dsn in (('PS', 'HERC02.BCPL.TA1A.FBREST'),
                     ('PO', 'HERC02.BCPL.TA1A.PDSREST')):
        attrs = ' '.join(plain(READ, f'stat-{org}.txt').upper().split())
        need(dsn in attrs and all(f'{key}:{v}' in attrs for key, v in
             [('DSORG', org), ('RECFM', 'FB'), ('LRECL', '80'), ('BLKSIZE', '800')]),
             f'{dsn}: restored DCB/DSN mismatch')
    listing = plain(READ, 'members-restored.txt')
    members = set(re.findall(r'(?m)^\s{4}([A-Z0-9@$#]{1,8})\s*$', listing))
    need(members == MEMBERS, 'restored seven-member PDS inventory disagrees')
    need(not (WRITE / 'failure.txt').exists() and not (READ / 'failure.txt').exists(),
         'failure marker present')
    return {'sha256': digest, 'physical_files': f, 'jobs': JOBS}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.parse_args(argv)
    try:
        result = review()
    except (InvalidEvidence, OSError, ValueError) as exc:
        print('TA.1 TRACK A EVIDENCE REVIEW INCOMPLETE: ' + str(exc), file=sys.stderr)
        print('No tape operation or JES submission performed.', file=sys.stderr)
        return 2
    print('TA.1 TRACK A: saved MVS evidence PASS (qualified)')
    print('JOBS 9076 / 9084 / 9086 / 9089: required steps RC=0000')
    print('Hercules physical-file blocks: ' + ', '.join(map(str, result['physical_files'])))
    print('Logical standard-label datasets: BCPL.BT0001, BCPL.BT0002')
    print('Restored PS/PO FB80 attributes and 7 PDS members verified')
    print('Unchanged BTA101 SHA-256: ' + str(result['sha256']))
    print('No tape catalog operation or new MVS job performed')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
