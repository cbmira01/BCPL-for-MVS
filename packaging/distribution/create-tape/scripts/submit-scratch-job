#!/usr/bin/env python3
"""Preview or explicitly submit one reviewed scratch-PDS tape experiment job."""
from __future__ import annotations

import argparse
import importlib.util
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[4]
JCL_DIR = ROOT / "packaging" / "distribution" / "create-tape" / "jcl"
CORE_PATH = ROOT / "tools" / "datasets" / "dspal-core.py"
TAPE_IMAGE = ROOT / "mvs-state" / "tape" / "bcpl-pdstest-20261108-01.aws"
OBJECT_TAPE_IMAGE = ROOT / "mvs-state" / "tape" / "bcpl-objtest-20261108-01.aws"
JOBS = ("TP01PRE", "TP02UNLD", "TP03REST", "TP04COMP",
        "TO01PRE", "TO02UNLD", "TO03REST", "TO04COMP")


def load_core():
    spec = importlib.util.spec_from_file_location("dspal_core_tape", CORE_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load dspal-core.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def read_body(job: str) -> str:
    if job not in JOBS:
        raise ValueError("unknown scratch tape job")
    path = JCL_DIR / (job + ".jcl")
    if path.is_symlink():
        raise ValueError(f"JCL body must not be a symbolic link: {path}")
    body = path.read_text(encoding="ascii")
    if not body.endswith("/*\n//\n"):
        raise ValueError(f"{path}: missing JCL end marker")
    if re.search(r"(?m)^//[^\s*/]+\s+JOB\b", body, re.IGNORECASE):
        raise ValueError(f"{path}: JOB card must be supplied by dspal")
    for number, line in enumerate(body.splitlines(), 1):
        if len(line) > 80 or "\t" in line:
            raise ValueError(f"{path}:{number}: invalid 80-column JCL card")
    return body


def make_deck(core, config, job: str, body: str, *, redact: bool) -> str:
    cards = core.authenticated_job_card(
        config, job, "BCPL TAPE SCRATCH", redact_password=redact
    )
    return "\n".join(cards) + "\n" + body


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        description=("Preview by default; --run submits exactly one "
                     "scratch tape JCL body through JES.")
    )
    parser.add_argument("job", choices=JOBS, help="one scratch tape job")
    parser.add_argument("--run", action="store_true",
                        help="submit after exact interactive confirmation")
    args = parser.parse_args(argv)

    try:
        body = read_body(args.job)
        core = load_core()
        config = core.load_config()
        if str(config["mvs"]["hlq"]).upper() != "HERC02":
            raise ValueError("effective MVS HLQ is not HERC02; JCL uses HERC02")
        if not args.run:
            sys.stdout.write(make_deck(core, config, args.job, body, redact=True))
            return 0
        if args.job in ("TP02UNLD", "TP03REST", "TO02UNLD", "TO03REST"):
            image = TAPE_IMAGE if args.job.startswith("TP") else OBJECT_TAPE_IMAGE
            if image.is_symlink() or not image.is_file():
                raise ValueError(f"scratch tape image is absent or unsafe: {image}")
        if not sys.stdin.isatty():
            raise ValueError("--run requires an interactive terminal")
        word = f"SUBMIT {args.job}"
        print(f"This submits {args.job} to live MVS and may change scratch media/datasets.")
        answer = input(f"Type {word} to authorize this one job: ")
        if answer.strip() != word:
            print("Submission cancelled; no job sent.")
            return 2
        deck = make_deck(core, config, args.job, body, redact=False)
        job_number, summary = core.submit_and_wait(config, deck, max_rc=0)
        print(f"{args.job}: JES JOB {job_number} finished with accepted RC=0")
        print(summary)
        return 0
    except (OSError, UnicodeError, ValueError, RuntimeError) as exc:
        print(f"submit-scratch-job: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
