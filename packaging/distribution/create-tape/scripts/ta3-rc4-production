#!/usr/bin/env python3
"""TA.3: guarded one-shot RC4 BT0001/BT0002 stage and standard-label tape write.

Only MVS IEBGENER/IEBCOPY stages/writes tape. Preserves immutable BC0003,
TA2R3S source PDSes and every accepted TA.2/TA.3 dataset and marker.
Default is offline inspection. --run needs one operator approval.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[4]
BASE = ROOT / "packaging/distribution"
WORK = ROOT / "workarea"
TAPES = ROOT / "mvs-state/tape"
SCRIPTS = BASE / "create-tape/scripts"
OUT = WORK / "ta3-rc4-production"
MARKER = OUT / "BC0004-one-shot-production.json"
IMAGE = TAPES / "bcpl-0.1.0-rc4-BC0004.aws"
ORIGINAL = TAPES / "bcpl-0.1.0-rc3-BC0003.aws"
ORIGINAL_SHA = "6c54c4df2b75020a698110061c4f8003b09adbe21f738848dcaed3da495d81e1"
VOL = "BC0004"
STAGE = "HERC02.BCPL.TA3R4S."
SOURCE = "HERC02.BCPL.TA2R3S."
DST = [STAGE + f"BT{i:04d}" for i in (1,2)]
MVS_STAGES = [("B0001","IEBGENER")] + [
    (f"M{i:04d}","IEBGENER") for i in range(1,9)]
MVS_WRITES = [("T0001","IEBGENER")] + [
    (f"T{i:04d}","IEBCOPY") for i in range(2,22)]


class Refusal(RuntimeError):
    pass


def need(ok, reason):
    if not ok:
        raise Refusal(reason)


def digest(path):
    need(path.is_file() and not path.is_symlink(),
         "accepted image absent/unsafe: "+path.name)
    with path.open("rb") as stream:
        return hashlib.file_digest(stream,"sha256").hexdigest()


def components():
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec, spec_from_loader
    def load(name, path):
        need(path.is_file() and not path.is_symlink(),
             "missing trusted source: "+path.name)
        loader=SourceFileLoader(name,str(path))
        spec=spec_from_loader(loader.name,loader)
        need(spec is not None and spec.loader is not None,
             "cannot import trusted source: "+name)
        module=module_from_spec(spec)
        spec.loader.exec_module(module)
        return module
    gen=load("ta3r4prodgen",SCRIPTS/"ta3-rc4-installer")
    rc3=load("ta3r4prodrc3",SCRIPTS/"ta2-rc3-consolidated")
    return gen,rc3,load


def original_guard():
    need(digest(ORIGINAL)==ORIGINAL_SHA,
         "immutable BC0003 original SHA-256 differs")


def cards_and_identity(gen):
    m,sizes=gen.load()
    bt1,members,stage,write=gen.plan()
    need(m["release"]["candidate_id"]=="BCPL-0.1.0-rc4" and
         m["volume"]["volser"]==VOL and
         len(members)==8 and
         stage.count("//SYSUT1 DD DATA,DLM=Z9")==9 and
         stage.count("DISP=(NEW,CATLG,DELETE)")==2 and
         write.count(" SELECT MEMBER=")==150 and
         write.count("LABEL=(")==21 and
         write.count("DSN=BCPL.BT")==21,
         "RC4 plan identity/21-position payload selection changed")
    need(re.findall(r"(?m)^//([A-Z][0-9]{4}) EXEC PGM=(IEBGENER|IEBCOPY)",
                    stage)==MVS_STAGES and
         re.findall(r"(?m)^//([A-Z][0-9]{4}) EXEC PGM=(IEBGENER|IEBCOPY)",
                    write)==MVS_WRITES,
         "RC4 source job step order differs")
    return m,members,stage,write


def source_rows(m):
    rows=[]
    for n in range(3,22):
        row=m["datasets"][n-1]
        dcb=row["target_dcb"]
        rows.append((SOURCE+f"BT{n:04d}",dcb))
    need(len(rows)==19 and len(set(x[0] for x in rows))==19,
         "accepted RC3 19-source mapping changed")
    return rows


def report_catalog(gen,rc3,core,cfg,folder,phase,source,targets):
    """Require MVS LISTDS source DCBs and exact new-target catalog state."""
    dsns=[x[0] for x in source]+targets
    deck=core.stat_deck(cfg,dsns)
    origtemp,origenv=tempfile.tempdir,os.environ.get("TMPDIR")
    try:
        tempfile.tempdir=str(folder)
        os.environ["TMPDIR"]=str(folder)
        job,summary=core.submit_and_wait(
            cfg,deck,max_rc=8 if phase=="preflight" else 0,
            cursor_file=folder/(phase+"-cursor.json"))
        rc3.artifact(folder,phase+"-summary.txt",summary)
        report=core.job_report(job,cursor_file=folder/(phase+"-cursor.json"))
        rc3.artifact(folder,phase+"-report.txt",report)
    finally:
        tempfile.tempdir=origtemp
        if origenv is None:
            os.environ.pop("TMPDIR",None)
        else:
            os.environ["TMPDIR"]=origenv
    need(re.search(rf"(?m)^JOB\s+{job}\s+DSPALST\s*$",summary) and
         "JOB RESULT: SUCCESS" in summary,
         "MVS LISTDS job identity or completion differs")
    for dsn,dcb in source:
        need(not core.dataset_missing(report,dsn),
             "accepted source PDS absent on MVS: "+dsn)
        block=core.extract_listds_block(report,dsn)
        actual=core.parse_listds(block) if block else {}
        expected={"volume":"TSO002","dsorg":dcb["dsorg"],
                  "recfm":dcb["recfm"],"lrecl":str(dcb["lrecl"]),
                  "blksize":str(dcb["blksize"])}
        need(all(actual.get(k)==v for k,v in expected.items()),
             "accepted source MVS DCB differs: "+dsn)
    for dsn in targets:
        if phase=="preflight":
            need(core.dataset_missing(report,dsn),
                 "new RC4 stage target already exists: "+dsn)
            block=core.extract_listds_block(report,dsn)
            need(not block or not core.parse_listds(block),
                 "ambiguous existing RC4 stage dataset: "+dsn)
        else:
            need(not core.dataset_missing(report,dsn),
                 "new RC4 stage PDS absent after stage: "+dsn)
            block=core.extract_listds_block(report,dsn)
            actual=core.parse_listds(block) if block else {}
            want={"volume":"TSO002","dsorg":"PS" if dsn.endswith("BT0001") else "PO",
                  "recfm":"FB","lrecl":"80","blksize":"800"}
            need(all(actual.get(k)==v for k,v in want.items()),
                 "staged RC4 DCB differs: "+dsn)
    return job


def installed_members(rc3,core,cfg,ls,folder,expected):
    """Read MVS PDS directory, never infer successful writing from JES alone."""
    body=ls.list_members_deck(cfg,[STAGE+"BT0002"])
    origtemp,origenv=tempfile.tempdir,os.environ.get("TMPDIR")
    try:
        tempfile.tempdir=str(folder)
        os.environ["TMPDIR"]=str(folder)
        job,summary=core.submit_and_wait(
            cfg,body,max_rc=0,cursor_file=folder/"members-cursor.json")
        rc3.artifact(folder,"members-summary.txt",summary)
        report=core.job_report(job,cursor_file=folder/"members-cursor.json")
        rc3.artifact(folder,"members-report.txt",report)
    finally:
        tempfile.tempdir=origtemp
        if origenv is None:
            os.environ.pop("TMPDIR",None)
        else:
            os.environ["TMPDIR"]=origenv
    need("JOB RESULT: SUCCESS" in summary and
         "HIGHEST RC: 0000" in summary and
         re.search(rf"(?m)^JOB\s+{job}\s+DSPALLS\s*$",summary),
         "MVS installer PDS directory inquiry failed")
    blocks=ls.member_blocks(report,[STAGE+"BT0002"])
    need(set(blocks)=={STAGE+"BT0002"},
         "staged RC4 installer directory was not returned by MVS")
    actual=ls.parse_members(blocks[STAGE+"BT0002"])
    need(len(actual)==len(set(actual))==len(expected) and
         set(actual)==set(expected),
         "RC4 BT0002 MVS installer member inventory differs")
    return job


def media_scan(rc3,prod,folder):
    need(TAPES.is_dir() and not TAPES.is_symlink() and
         not IMAGE.exists() and not IMAGE.is_symlink(),
         "new BC0004 image already exists or tape directory unsafe")
    entries=sorted(TAPES.iterdir())
    need(len(entries)<=64,"unexpectedly large existing tape inventory")
    for i,p in enumerate(entries):
        if p.name==".gitkeep":
            continue
        need(p.is_file() and not p.is_symlink() and
             p.suffix.lower() in (".aws",".het"),
             "unexpected tape-directory entry: "+p.name)
        report=rc3.run_command(folder,f"pre-media-{i:03d}",
            ["docker","exec","mvs38j","hetmap","-l",
             "/tk5/tape/"+p.name])
        need(prod.volser_from_hetmap(report)!=VOL,
             "BC0004 VOLSER collision with existing tape: "+p.name)
    return len(entries)


def drive_empty(rc3,media,folder,key):
    h=rc3.run_command(folder,key+"-hercules",
        ["tools/mvs/mvs-console","tape","status","480"])
    m=rc3.run_command(folder,key+"-mvs",
        ["tools/mvs/mvs-console","mvs","tapes"])
    matches=re.findall(r"\bHHC02279I\s+(?:[0-9A-Fa-f]+:)?0480\s+3420\s+(.*)",h)
    need(len(matches)==1 and
         re.match(r"\*\s",matches[0]) is not None and
         "busy" not in matches[0].lower() and
         media.parse_mvs(m)=="O-NRD",
         "MVS/Hercules tape 0480 not empty/idle")
    return True


def confirm_new_mount(rc3,media,folder,key):
    h=rc3.run_command(folder,key+"-hercules",
        ["tools/mvs/mvs-console","tape","status","480"])
    m=rc3.run_command(folder,key+"-mvs",
        ["tools/mvs/mvs-console","mvs","tapes"])
    matches=re.findall(r"\bHHC02279I\s+(?:[0-9A-Fa-f]+:)?0480\s+3420\s+(.*)",h)
    need(len(matches)==1 and IMAGE.name in matches[0] and
         "busy" not in matches[0].lower() and
         media.parse_mvs(m)=="O",
         "drive does not hold only the new BC0004 tape")
    return True


def execute():
    rc3=None
    folder=None
    marked=False
    try:
        gen,rc3,load=components()
        m,members,stage,writer=cards_and_identity(gen)
        original_guard()
        need(sys.stdin.isatty(),"stateful RC4 tape write requires one operator approval")
        rc3.check_git()
        need(WORK.is_dir() and not WORK.is_symlink() and
             not OUT.is_symlink() and
             not MARKER.exists() and not MARKER.is_symlink(),
             "RC4 production one-shot already consumed or unsafe workarea")
        OUT.mkdir(mode=0o700,exist_ok=True)
        folder=OUT/(datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")+
                    "-"+str(os.getpid()))
        folder.mkdir(mode=0o700,exist_ok=False)
        core=load("ta3r4core",ROOT/"tools/datasets/dspal-core.py")
        prod=load("ta3r4prod",SCRIPTS/"ta2-rc2-produce-once")
        media=load("ta3r4media",SCRIPTS/"ta2-rc2-media-preflight")
        ls=load("ta3r4ls",ROOT/"tools/datasets/dspal-ls.py")
        aws=load("ta3r4aws",SCRIPTS/"ta2-rc2-aws-review")
        cfg=core.load_config()
        need(cfg["mvs"]["hlq"]=="HERC02",
             "MVS operator HLQ differs from verified RC3 site")
        core.require_reader_ready(cfg)
        prod.check_docker(folder)
        media_scan(rc3,prod,folder)
        drive_empty(rc3,media,folder,"preflight")
        pre=report_catalog(gen,rc3,core,cfg,folder,"preflight",
                           source_rows(m),DST)
        drive_empty(rc3,media,folder,"post-preflight")
        original_guard()
        need(not IMAGE.exists() and not IMAGE.is_symlink(),
             "new AWS image appeared during MVS preflight")
        print(f"TA.3 RC4 PREFLIGHT PASS: JOB {pre}; 19 accepted RC3 sources; "
              "2 new stage targets absent; BC0004 unused; drive empty.")
        if input("Stage 2 new PDSes and write new BC0004 tape ONCE? [y/N]: ").strip().upper()!="Y":
            rc3.artifact(folder,"result.json",json.dumps({
                "status":"DECLINED_NO_STAGE_OR_MEDIA_WRITE"})+"\n")
            rc3.seal(folder)
            print("TA.3 RC4 declined: no dataset allocation or tape write.")
            return 0
        rc3.exclusive(MARKER,(json.dumps({
            "status":"OWNER_APPROVED_TA3_RC4_STAGE_AND_WRITE_NO_RETRY",
            "candidate":"BCPL-0.1.0-rc4","volser":VOL,
            "original_bc0003_sha256":ORIGINAL_SHA,
            "source_rc3_staging":SOURCE,"new_rc4_staging":STAGE,
            "new_image":IMAGE.name,
            "evidence":folder.relative_to(ROOT).as_posix(),
            "overwrite_existing":False,"publication_authorized":False},
            sort_keys=True)+"\n").encode("ascii"))
        marked=True
        staged,stage_report,_=rc3.mvs_job(core,cfg,folder,"stage",
                           "TA3R4STG",stage,MVS_STAGES)
        need(re.search(r"(?m)^IEF142I\s+TA3R4STG\s+A0002\s+-\s+"
                       r"STEP WAS EXECUTED\s+-\s+COND CODE 0000\s*$",
                       stage_report),
             "MVS IEFBR14 PDS allocation A0002 RC0000 missing")
        cat=report_catalog(gen,rc3,core,cfg,folder,"staged",
                            source_rows(m),DST)
        directory=installed_members(rc3,core,cfg,ls,folder,members)
        print(f"TA.3 RC4 STAGING PASS: JOB {staged}; new BT0001/BT0002; "
              f"DCB JOB {cat}; 8 installer members JOB {directory}.")
        original_guard()
        drive_empty(rc3,media,folder,"pre-image")
        need(not IMAGE.exists() and not IMAGE.is_symlink(),
             "new AWS appeared before guarded initialization")
        rc3.exclusive(IMAGE,b"")
        rc3.run_command(folder,"initialize",
            ["docker","exec","--user",f"{os.getuid()}:{os.getgid()}",
             "mvs38j","hetinit","-d","-i","/tk5/tape/"+IMAGE.name,VOL])
        rc3.run_command(folder,"mount",
            ["tools/mvs/mvs-console","--yes","tape","mount","480",IMAGE.name])
        confirm_new_mount(rc3,media,folder,"mounted")
        wrote,_,_=rc3.mvs_job(core,cfg,folder,"write",
                               "TA3R4WRT",writer,MVS_WRITES)
        labels=rc3.run_command(folder,"aws-labels",
            ["docker","exec","mvs38j","hetmap","-l","/tk5/tape/"+IMAGE.name])
        files=rc3.run_command(folder,"aws-files",
            ["docker","exec","mvs38j","hetmap","-f","/tk5/tape/"+IMAGE.name])
        aws.VOLSER=VOL
        structure=aws.evaluate(labels,files)
        need(structure["logical_datasets"]==21 and
             structure["physical_files"]==64,
             "RC4 MVS-written AWS standard-label structure differs")
        tape_sha=digest(IMAGE)
        original_guard()
        rc3.artifact(folder,"result.json",json.dumps({
            "status":"TA3_RC4_MVS_TWO_DATASET_STAGE_AND_21_DATASET_SL_AWS_WRITE_PASS",
            "candidate":"BCPL-0.1.0-rc4","volser":VOL,
            "image":IMAGE.relative_to(ROOT).as_posix(),
            "sha256":tape_sha,"original_bc0003_sha256":ORIGINAL_SHA,
            "mvs_jobs":{"preflight":pre,"stage":staged,"staged_catalog":cat,
                        "installer_directory":directory,"tape_write":wrote},
            "new_stage_datasets":2,"installer_members":8,
            "unchanged_rc3_payload_datasets":19,"logical_datasets":21,
            "aws_physical_files":64,"tape_review":structure,
            "independent_mvs_restoration":False,
            "publication_authorized":False},indent=2)+"\n")
        rc3.seal(folder)
        print(f"TA.3 RC4 TAPE PASS: MVS JOB {wrote}; 21 SL datasets; "
              f"64 physical files; SHA256 {tape_sha}.")
        print("Evidence: "+folder.relative_to(ROOT).as_posix())
        return 0
    except Exception as exc:
        if rc3 is not None and folder is not None:
            try:
                rc3.artifact(folder,"failure.json",json.dumps({
                    "status":"STATEFUL_NO_RETRY" if marked else "PREFLIGHT_HALTED",
                    "reason":str(exc)},indent=2)+"\n")
                rc3.seal(folder)
            except Exception:
                pass
        print("TA.3 RC4 PRODUCTION HALTED: "+str(exc),file=sys.stderr)
        if folder is not None:
            print("Evidence: "+folder.relative_to(ROOT).as_posix(),file=sys.stderr)
        if marked:
            print("NO RETRY: preserve any partial BT0001/BT0002, BC0004, "
                  "JES reports and original BC0003.",file=sys.stderr)
        return 2


def main(argv=None):
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--run",action="store_true",
                        help="single guarded MVS stage and new BC0004 tape write")
    args=parser.parse_args(argv)
    if args.run:
        return execute()
    try:
        gen,rc3,_=components()
        cards_and_identity(gen)
        original_guard()
        print("TA.3 RC4 OFFLINE PLAN PASS: 2 new stage datasets, "
              "19 accepted RC3 payload PDSes, 21 tape positions, "
              "8 installer members. NO JES OR TAPE WRITE.")
        return 0
    except Exception as exc:
        print("TA.3 RC4 OFFLINE PLAN REFUSED: "+str(exc),file=sys.stderr)
        return 2


if __name__=="__main__":
    raise SystemExit(main())
