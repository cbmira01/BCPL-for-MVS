#!/usr/bin/env python3
"""Read-only TA.1 Track B MVS/Hercules source/catalog/media preflight.

--live submits only TSO LISTDS-based stat/ls inquiries through existing
project dspal and Hercules devlist/hetmap. It NEVER mounts, initializes,
submits TA1BWRIT/TA1BREST/TA1BGO, or changes MVS datasets.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[4]
WORK = ROOT / 'workarea'
TAPES = ROOT / 'mvs-state/tape'
EVIDENCE = WORK / 'ta1b-operations'
IMAGE = 'bcpl-ta1-b-20261117-01.aws'
SRC = 'HERC02.BCPL.MR10KIT.LOAD'
DST = 'HERC02.BCPL.TA1B.LOAD'


class Refusal(RuntimeError):
    pass


def need(ok: bool, message: str) -> None:
    if not ok:
        raise Refusal(message)


def contract_module():
    path = ROOT / 'packaging/distribution/create-tape/scripts/ta1b-contract'
    loader = importlib.machinery.SourceFileLoader('ta1b_static_contract', str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    need(spec is not None and spec.loader is not None, 'cannot load TA.1B contract')
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def run(argv: list[str], name: str, folder: Path | None) -> tuple[int, str]:
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1', TMPDIR=str(WORK),
               TEMP=str(WORK), TMP=str(WORK))
    try:
        p = subprocess.run(argv, cwd=ROOT, env=env, text=True, capture_output=True,
                           check=False, timeout=180)
        rc, output = p.returncode, p.stdout + p.stderr
    except (OSError, subprocess.TimeoutExpired) as exc:
        rc, output = 127, type(exc).__name__ + ': ' + str(exc) + '\n'
    if folder is not None:
        destination = folder / (name + '.txt')
        with destination.open('x', encoding='utf-8') as stream:
            os.fchmod(stream.fileno(), 0o600)
            stream.write(f'RC={rc}\n')
            stream.write(output)
    return rc, output


def checked(argv: list[str], name: str, folder: Path) -> str:
    rc, output = run(argv, name, folder)
    need(rc == 0, f'{name} failed RC={rc}; inspect retained evidence, do not assume PASS')
    return output


def parse_source_stat(text: str) -> str:
    upper = text.upper()
    need('DATASET:   ' + SRC in upper and
         all(re.search(r'\b' + attr + r'\s*:\s*' + val + r'\b', upper)
             for attr, val in [('DSORG', 'PO'), ('RECFM', 'U'),
                               ('LRECL', '0'), ('BLKSIZE', '6144')]),
         'MR10_LOAD source is not verified PO/U/0/6144')
    match = re.search(r'\bVOLUME\s*:\s*([A-Z0-9]{1,6})\b', upper)
    need(match is not None, 'missing source DASD volume serial')
    return match.group(1)


def parse_members(text: str) -> None:
    need(re.search(r'(?m)^' + re.escape(SRC) + r':\s*$', text) is not None,
         'MR10_LOAD member list does not identify source PDS')
    members = re.findall(r'(?m)^    ([A-Z0-9@$#]{1,8})\s*$', text)
    need(members == ['ICINT19'], 'source library must have one selected nonalias ICINT19')


def absent(rc: int, text: str, dsn: str) -> None:
    need(rc == 2 and ('dspal: data set not found: ' + dsn) in text,
         dsn + ' is cataloged or catalog inquiry ambiguous')


def parse_volser(text: str) -> str:
    need(text.count("Label               : 'VOL1'") == 1,
         'existing image did not produce one VOL1')
    match = re.search(r"(?m)^Volume Serial\s+:\s+'([A-Z0-9]{1,6})'\s*$", text)
    need(match is not None, 'cannot read existing AWS/HET volume serial')
    return match.group(1)


def verify_image_inventory(folder: Path) -> int:
    need(TAPES.is_dir() and not TAPES.is_symlink() and
         (ROOT / 'mvs-state').is_dir() and
         not (ROOT / 'mvs-state').is_symlink(),
         'missing or linked mvs-state/tape root')
    requested = TAPES / IMAGE
    need(not requested.exists() and not requested.is_symlink(),
         'proposed BTA102 image already exists; NEVER overwrite/retry')
    count = 0
    for path in sorted(TAPES.iterdir()):
        if path.name == '.gitkeep':
            continue
        need(path.is_file() and not path.is_symlink() and
             path.suffix.lower() in ('.aws', '.het'),
             f'unknown tape entry {path.name}; cannot prove VOLSER uniqueness')
        safe_name = f'hetmap-{count:03d}'
        output = checked(['docker', 'exec', 'mvs38j', 'hetmap', '-l',
                          '/tk5/tape/' + path.name], safe_name, folder)
        serial = parse_volser(output)
        need(serial != 'BTA102', 'BTA102 already present in ' + path.name)
        count += 1
    return count


def inspect_unit(folder: Path) -> str:
    listing = checked(['tools/mvs/mvs-console', 'tape', 'status', '0480'],
                      'hercules-0480', folder)
    rows = [line for line in listing.splitlines()
            if re.search(r'\b0:0480\s+3420\s+', line)]
    need(len(rows) == 1 and 'busy' not in rows[0].lower(),
         'Hercules device 0480 absent/busy/ambiguous')
    state = 'EMPTY' if re.search(r'\b3420\s+\*\s', rows[0]) else 'OCCUPIED'
    mvs = checked(['tools/mvs/mvs-console', 'mvs', 'D U,TAPE'],
                  'mvs-tape-unit', folder)
    need(re.search(r'\b480\s+3400\s+O(?:-NRD)?\b', mvs) is not None,
         'MVS tape unit 480 unavailable or status unrecognized')
    return state


def live(contract, folder: Path) -> tuple[str, str, int]:
    checked(['git', 'branch', '--show-current'], 'git-branch', folder)
    status = checked(['git', 'status', '--porcelain', '--untracked-files=no', '--',
                      'packaging/distribution/create-tape/jcl/TA1BWRIT.jcl',
                      'packaging/distribution/create-tape/jcl/TA1BREST.jcl',
                      'packaging/distribution/create-tape/scripts/ta1b-contract',
                      'packaging/distribution/create-tape/scripts/ta1b-preflight'],
                     'git-guard', folder)
    need(not status.strip(), 'reviewed tracked files locally modified')
    branch = (folder / 'git-branch.txt').read_text()
    need('main' in branch.splitlines(), 'not on main branch')
    docker = checked(['docker', 'inspect', '-f', '{{.State.Running}}', 'mvs38j'],
                     'docker-running', folder)
    need(docker.strip() == 'true', 'MVS Docker not running')
    binding = checked(['docker', 'inspect', '-f',
                       '{{range .Mounts}}{{if eq .Destination "/tk5/tape"}}'
                       '{{.Source}}{{end}}{{end}}', 'mvs38j'],
                      'docker-tape-bind', folder)
    need(Path(binding.strip()).resolve() == TAPES.resolve(),
         'Docker tape bind is not repository mvs-state/tape')
    srcvol = parse_source_stat(checked(['tools/datasets/dspal', 'stat', 'MR10_LOAD'],
                                       'source-stat', folder))
    parse_members(checked(['tools/datasets/dspal', 'ls', 'MR10_LOAD'],
                          'source-members', folder))
    for i, dsn in enumerate((DST, 'BCPL.BT0001'), 1):
        rc, output = run(['tools/datasets/dspal', 'stat', dsn],
                         f'absent-{i}', folder)
        absent(rc, output, dsn)
    candidates = verify_image_inventory(folder)
    state = inspect_unit(folder)
    contract.directory_body(SRC, srcvol, 'SYSDA')
    return srcvol, state, candidates


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--live', action='store_true',
                        help='read-only MVS catalog, Hercules and existing tape inspection')
    args = parser.parse_args(argv)
    folder = None
    try:
        contract = contract_module()
        contract.validate_static()
        if not args.live:
            print('TA.1 TRACK B STATIC PASS; NO MVS/TAPE OPERATION')
            return 0
        need(WORK.is_dir() and not WORK.is_symlink(), 'workarea missing/unsafe')
        need(not EVIDENCE.is_symlink(), 'unsafe TA.1B operations path')
        EVIDENCE.mkdir(mode=0o700, exist_ok=True)
        name = ('BTA102-readonly-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
                + '-' + str(os.getpid()))
        folder = EVIDENCE / name
        folder.mkdir(mode=0o700, exist_ok=False)
        volser, state, count = live(contract, folder)
        print('TA.1 TRACK B LIVE READ-ONLY PREFLIGHT PASS')
        print(f'MR10_LOAD: PO/U/0/6144; ICINT19; DASD volume {volser}')
        print(f'BTA102 absent from {count} inspected existing images; new path absent')
        print(f'Hercules 0480: {state}; MVS unit reported')
        print('Uncataloged tape DSN and new DASD target absent in catalog')
        print('Evidence: ' + str(folder.relative_to(ROOT)))
        print('NO tape initialized/mounted, no Track B production JCL submitted')
        return 0
    except (Refusal, OSError, ValueError, RuntimeError) as exc:
        print('TA.1B PREFLIGHT REFUSED: ' + str(exc), file=sys.stderr)
        if folder is not None:
            print('Private evidence: ' + str(folder.relative_to(ROOT)), file=sys.stderr)
        print('No Track B media or target allocation operation attempted.', file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
