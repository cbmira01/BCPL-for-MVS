//* TA.3 DISPLAY FOUR RESTORED BT0002 MEMBERS; READ ONLY.
//* ADD JOB CARD; SUBSTITUTE <HLQ>; NO BCPL REQUIRED.
//V0001 EXEC PGM=IEBGENER,REGION=256K
//SYSPRINT DD SYSOUT=*
//SYSIN DD DUMMY
//SYSUT1 DD DSN=<HLQ>.BCPL.DIST.INST(INSTALL),DISP=SHR
//SYSUT2 DD SYSOUT=*
//V0002 EXEC PGM=IEBGENER,REGION=256K,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN DD DUMMY
//SYSUT1 DD DSN=<HLQ>.BCPL.DIST.INST(DATASETS),DISP=SHR
//SYSUT2 DD SYSOUT=*
//V0003 EXEC PGM=IEBGENER,REGION=256K,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN DD DUMMY
//SYSUT1 DD DSN=<HLQ>.BCPL.DIST.INST(RELEASE),DISP=SHR
//SYSUT2 DD SYSOUT=*
//V0004 EXEC PGM=IEBGENER,REGION=256K,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN DD DUMMY
//SYSUT1 DD DSN=<HLQ>.BCPL.DIST.INST(RESTORE),DISP=SHR
//SYSUT2 DD SYSOUT=*
//
