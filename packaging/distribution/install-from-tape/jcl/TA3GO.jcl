//* TA.3 RECIPIENT INSTALLED MR10 - SCALVEC DEMONSTRATION.
//* ADD JOB CARD; <INST> IS THE RECIPIENT PREFIX BEFORE MR10KIT.
//* EIGHT MVS STEPS: STAGE 5 INTCODE, COMPILE, GENERATE, RUN.
//* SOURCE: CANONICAL MRREGRES; NO HOST/BCPL REQUIRED TO RUN.
//SSYNI    EXEC PGM=IEBGENER
//SYSPRINT DD  DUMMY
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=<INST>.MR10KIT.SOURCE(SYNI),
//             DISP=SHR
//SYSUT2   DD  DSN=&&SYNI,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//STRNI    EXEC PGM=IEBGENER
//SYSPRINT DD  DUMMY
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=<INST>.MR10KIT.SOURCE(TRNI),
//             DISP=SHR
//SYSUT2   DD  DSN=&&TRNI,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//SCGI     EXEC PGM=IEBGENER
//SYSPRINT DD  DUMMY
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=<INST>.MR10KIT.SOURCE(CGI),
//             DISP=SHR
//SYSUT2   DD  DSN=&&CGI,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//SBLIBI   EXEC PGM=IEBGENER
//SYSPRINT DD  DUMMY
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=<INST>.MR10KIT.SOURCE(BLIBI),
//             DISP=SHR
//SYSUT2   DD  DSN=&&BLIBI,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//SICLIB   EXEC PGM=IEBGENER
//SYSPRINT DD  DUMMY
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=<INST>.MR10KIT.SOURCE(ICLIB),
//             DISP=SHR
//SYSUT2   DD  DSN=&&ICLIB,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//* PHASE 1: COMPILE AND GENERATE ALL REGRESSION CASES
//*
//* CASE 01: scalar-vector
//* C01A COMPILE SCALVEC
//*
//C01A     EXEC PGM=ICINT19,REGION=1024K,COND=(4,LT)
//STEPLIB  DD  DSN=<INST>.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&SYNI,DISP=(OLD,PASS)
//         DD  DSN=&&TRNI,DISP=(OLD,PASS)
//         DD  DSN=&&BLIBI,DISP=(OLD,PASS)
//         DD  DSN=&&ICLIB,DISP=(OLD,PASS)
//SYSIN    DD  DSN=<INST>.MR10KIT.TESTS(SCALVEC),
//             DISP=SHR
//OCODE    DD  DSN=&&O01A,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  DUMMY
//*
//* G01A GENERATE SCALVEC
//*
//G01A     EXEC PGM=ICINT19,REGION=1024K,COND=(4,LT)
//STEPLIB  DD  DSN=<INST>.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&CGI,DISP=(OLD,PASS)
//         DD  DSN=&&BLIBI,DISP=(OLD,PASS)
//         DD  DSN=&&ICLIB,DISP=(OLD,PASS)
//INTCODE  DD  DSN=&&I01A,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSIN    DD  DSN=&&O01A,DISP=(OLD,DELETE)
//SYSUDUMP DD  DUMMY
//*
//* CASE 02: bytes
//* C02A COMPILE BYTES
//*
//R01      EXEC PGM=ICINT19,REGION=1024K,COND=(4,LT)
//STEPLIB  DD  DSN=<INST>.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&I01A,DISP=(OLD,DELETE)
//         DD  DSN=&&BLIBI,DISP=(OLD,PASS)
//         DD  DSN=&&ICLIB,DISP=(OLD,PASS)
//SYSUDUMP DD  DUMMY
//*
//* EXECUTE CASE 02: bytes
//*
//
