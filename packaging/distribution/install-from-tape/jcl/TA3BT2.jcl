//* TA.3 RESTORE BC0003 BT0002 INSTALLER PDS.
//* ADD JOB CARD; SUBSTITUTE <HLQ> <TAPE> <DASD> <DVOL>.
//* OUTPUT MUST BE ABSENT; NO OVERWRITE OR RETRY.
//BT2REST EXEC PGM=IEBCOPY,REGION=512K
//SYSPRINT DD SYSOUT=*
//INTAPE DD DSN=BCPL.BT0002,UNIT=<TAPE>,
//            VOL=(PRIVATE,RETAIN,SER=BC0003),
//            LABEL=(2,SL),DISP=OLD
//OUTPDS DD DSN=<HLQ>.BCPL.DIST.INST,
//            DISP=(NEW,CATLG,DELETE),UNIT=<DASD>,
//            VOL=SER=<DVOL>,SPACE=(TRK,(20,5,10)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSUT3 DD UNIT=SYSDA,SPACE=(TRK,(10,5))
//SYSUT4 DD UNIT=SYSDA,SPACE=(TRK,(10,5))
//SYSIN DD *
 COPY OUTDD=OUTPDS,INDD=INTAPE
/*
//
