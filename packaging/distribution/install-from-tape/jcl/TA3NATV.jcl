//* TA.3 BCPL-0.1.0-rc3 / BC0003 MVS-ONLY RESTORE.
//* PROFILE TA3NATV; 10 NEW TARGET PDSES.
//* ADD JOB CARD; SUBSTITUTE <HLQ> <TAPE> <DASD> <DVOL>.
//* ONLY ABSENT TARGET DSNS; NO OVERWRITE, RESTART OR RETRY.
//* MVS LABEL=(N,SL) IS LOGICAL DATASET NUMBER, NOT AWS FILE.
//R0003 EXEC PGM=IEBCOPY,REGION=512K
//SYSPRINT DD SYSOUT=*
//INTAPE DD DSN=BCPL.BT0003,UNIT=<TAPE>,
//            VOL=(PRIVATE,RETAIN,SER=BC0003),
//            LABEL=(3,SL),DISP=OLD
//OUTPDS DD DSN=<HLQ>.BCPL.DIST.DOCS,
//            DISP=(NEW,CATLG,DELETE),UNIT=<DASD>,
//            VOL=SER=<DVOL>,
//            SPACE=(TRK,(9,2,7)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSUT3 DD UNIT=SYSDA,SPACE=(TRK,(10,5))
//SYSUT4 DD UNIT=SYSDA,SPACE=(TRK,(10,5))
//SYSIN DD *
 COPY OUTDD=OUTPDS,INDD=INTAPE
