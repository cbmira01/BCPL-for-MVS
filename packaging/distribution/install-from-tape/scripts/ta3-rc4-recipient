#!/usr/bin/env python3
"""TA.3 BC0004: one guarded MVS-native recipient trial of on-tape profile JCL.

Three fresh isolated namespaces. Reads actual restored BT0002(MR10/NATIVE/
COMBINED) using IEBGENER to MVS SYSOUT, reconstructs/checks every JCL card
against the frozen RC4 candidate source, and executes the read-back deck.
No RC4 tape write, no accepted prior dataset allocation or job replay.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import os
import re
import sys

import yaml

sys.dont_write_bytecode=True
ROOT=Path(__file__).resolve().parents[4]
BASE=ROOT/"packaging/distribution"
WORK=ROOT/"workarea"
OUT=WORK/"ta3-rc4-recipient"
MARKER=OUT/"BC0004-recipient-one-shot.json"
AWS=ROOT/"mvs-state/tape/bcpl-0.1.0-rc4-BC0004.aws"
IMAGE_SHA="7cc5a1d61882bf88469fd9f9e38512f1976ef1a775e3095e12e3988600c57af1"
ORIGINAL=ROOT/"mvs-state/tape/bcpl-0.1.0-rc3-BC0003.aws"
ORIGINAL_SHA="6c54c4df2b75020a698110061c4f8003b09adbe21f738848dcaed3da495d81e1"
PROD=WORK/"ta3-rc4-production"
PROD_MARKER=PROD/"BC0004-one-shot-production.json"
PROFILES={
    "MR10":("R4MR","T3R4MR",tuple(range(3,13)),94),
    "NATIVE":("R4NT","T3R4NT",(3,*range(13,22)),71),
    "COMBINED":("R4CB","T3R4CB",tuple(range(3,22)),150),
}
SITE="HERC02.BCPL."
VOL="BC0004"
VOLUME="TSO002"
TAPE_UNIT="480"


class Refusal(RuntimeError):pass


def need(ok,why):
    if not ok:raise Refusal(why)


def hashfile(path):
    need(path.is_file() and not path.is_symlink(),
         "missing/unsafe accepted media: "+path.name)
    with path.open("rb") as f:
        return hashlib.file_digest(f,"sha256").hexdigest()


def tools():
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec,spec_from_loader
    def load(key,path):
        need(path.is_file() and not path.is_symlink(),
             "missing source-controlled tool "+path.name)
        loader=SourceFileLoader(key,str(path))
        spec=spec_from_loader(key,loader)
        need(spec is not None and spec.loader is not None,
             "cannot import tool "+key)
        mod=module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    ref=load("ta4ref",BASE/"install-from-tape/scripts/ta3-rc3-recipient")
    rem=load("ta4rem",BASE/"install-from-tape/scripts/ta3-rc3-remaining-profiles")
    gen=load("ta4gen",BASE/"create-tape/scripts/ta3-rc4-installer")
    rc3=ref.load_module()
    return ref,rem,gen,rc3,load


def production_receipt():
    """Validate unchanged local accepted RC4 one-shot production seal."""
    need(PROD_MARKER.is_file() and not PROD_MARKER.is_symlink(),
         "BC0004 successful production marker absent")
    marker=json.loads(PROD_MARKER.read_text("utf-8"))
    need(marker.get("status")=="OWNER_APPROVED_TA3_RC4_STAGE_AND_WRITE_NO_RETRY" and
         marker.get("candidate")=="BCPL-0.1.0-rc4" and
         marker.get("volser")==VOL and
         marker.get("original_bc0003_sha256")==ORIGINAL_SHA and
         marker.get("overwrite_existing") is False and
         marker.get("publication_authorized") is False,
         "accepted production marker identity differs")
    rel=marker.get("evidence","")
    need(isinstance(rel,str) and
         re.fullmatch(r"workarea/ta3-rc4-production/\d{8}T\d{6}Z-\d+",rel),
         "unsafe/incorrect production receipt location")
    folder=ROOT/rel
    need(folder.is_dir() and not folder.is_symlink() and
         folder.resolve().is_relative_to(PROD.resolve()),
         "accepted production evidence directory absent/unsafe")
    seal=folder/"SHA256SUMS"
    need(seal.is_file() and not seal.is_symlink(),
         "accepted production evidence SHA256SUMS missing")
    seen=set()
    for line in seal.read_text("ascii").splitlines():
        m=re.fullmatch(r"([0-9a-f]{64})  ([A-Za-z0-9_.-]+)",line)
        need(m is not None,"accepted production seal has invalid entry")
        digest,name=m.groups()
        p=folder/name
        need(name not in seen and p.is_file() and not p.is_symlink() and
             hashlib.sha256(p.read_bytes()).hexdigest()==digest,
             "accepted MVS production evidence changed: "+name)
        seen.add(name)
    need({p.name for p in folder.iterdir()}==seen|{"SHA256SUMS"} and
         {"result.json","stage-report.txt","write-report.txt",
          "aws-labels.txt","aws-files.txt","members-report.txt"}<=seen,
         "accepted MVS production evidence inventory differs")
    result=json.loads((folder/"result.json").read_text("utf-8"))
    need(result.get("status")==
         "TA3_RC4_MVS_TWO_DATASET_STAGE_AND_21_DATASET_SL_AWS_WRITE_PASS" and
         result.get("volser")==VOL and
         result.get("sha256")==IMAGE_SHA and
         result.get("original_bc0003_sha256")==ORIGINAL_SHA and
         result.get("mvs_jobs")=={
             "preflight":9393,"stage":9394,"staged_catalog":9395,
             "installer_directory":9396,"tape_write":9397} and
         result.get("installer_members")==8 and
         result.get("logical_datasets")==21 and
         result.get("aws_physical_files")==64,
         "accepted BC0004 source production receipt differs")
    return rel


def selection(manifest,gen):
    need(manifest["release"]["candidate_id"]=="BCPL-0.1.0-rc4" and
         manifest["release"]["native_compiler"]=="absent" and
         manifest["volume"]["volser"]==VOL,
         "RC4 release scope/identity changed")
    data=manifest["datasets"]
    need(len(data)==21 and
         [x["sequence"] for x in data]==list(range(1,22)) and
         data[1]["members"]==list(gen.MEMBERS),
         "RC4 tape/installer inventory changed")
    result={}
    for label,(site,job,positions,count) in PROFILES.items():
        prefix=SITE+site
        rows=[(2,prefix+".DIST.INST",list(gen.MEMBERS))]
        for n in positions:
            record=data[n-1]
            template=record["target_dsn_template"]
            expected_group=("common" if n==3 else
                 "mr10" if 4<=n<=12 else
                 "native" if 13<=n<=20 else "cambridge-source")
            need(record["group"]==expected_group and
                 template.startswith("{HLQ}.BCPL."),
                 label+": target group/DSN template differs")
            dsn=prefix+"."+template[len("{HLQ}.BCPL."):]
            need(len(dsn)<=44,"recipient target DSN too long "+dsn)
            rows.append((n,dsn,record["members"],record["target_dcb"]))
        need(sum(len(r[2]) for r in rows)==count and
             len(rows)==len(positions)+1,
             label+": selected recipient member count differs")
        result[label]=(prefix,job,positions,rows,count)
    names=[r[1] for _,_,_,rows,_ in result.values() for r in rows]
    need(len(names)==42 and len(set(names))==42,
         "recipient namespace isolation/42 PDSes differs")
    return result


def boot_and_installer(ref,prefix,vol=VOL):
    """Only bootstrap extraction JCL is external; profile itself is on tape."""
    import_text={}
    for name in ("TA3BOOT","TA3BT2"):
        path=BASE/"install-from-tape/jcl"/(name+".jcl")
        need(path.is_file() and not path.is_symlink(),
             "missing external MVS bootstrap "+name)
        body=path.read_text("ascii").replace("BC0003",vol)
        body=(body.replace("<HLQ>.BCPL.",prefix+".")
                  .replace("<TAPE>",TAPE_UNIT)
                  .replace("<DASD>","SYSDA")
                  .replace("<DVOL>",VOLUME))
        need(body.endswith("//\n") and
             "BC0003" not in body and
             all(len(l)<=71 for l in body.splitlines()
                 if l.startswith("//") and not l.startswith("//*")),
             name+": original MVS bootstrap JCL drift")
        import_text[name]=body
    need("LABEL=(1,SL)" in import_text["TA3BOOT"] and
         "LABEL=(2,SL)" in import_text["TA3BT2"] and
         f"DSN={prefix}.DIST.INST," in import_text["TA3BT2"],
         "new BC0004 bootstrap/installer destination differs")
    return import_text


def readback_deck(prefix,member):
    need(member in PROFILES,"unexpected requested on-tape profile")
    name=prefix+".DIST.INST"
    steps=[("P0001",member),("P0002","COPY")]
    lines=["//* MVS IEBGENER READS ACTUAL RC4 TAPE-RESTORED JCL DATA."]
    for step,item in steps:
        lines.extend([
            f"//{step} EXEC PGM=IEBGENER,REGION=512K",
            "//SYSPRINT DD SYSOUT=*",
            "//SYSIN DD DUMMY",
            f"//SYSUT1 DD DSN={name}({item}),",
            "//            DISP=SHR",
            "//SYSUT2 DD SYSOUT=*",
        ])
    lines.append("//")
    need(all(len(line)<=71 for line in lines
             if line.startswith("//") and not line.startswith("//*")),
         "MVS on-tape profile SYSOUT readback JCL over column 71")
    return "\n".join(lines)+"\n"


def extract_profile(report,canonical):
    """Extract exact profile JCL cards, in order, from printed MVS SYSOUT.

    Non-card JES/PAGE records may precede or interrupt profile source.
    Accept only verbatim card text with optional printer-prefix bytes;
    never execute an unverified/partially reconstructed JCL body.
    """
    lines=canonical.splitlines()
    need(lines and lines[-1]=="//","canonical on-tape profile termination missing")
    extracted=[]
    index=0
    for physical in report.splitlines():
        if index==len(lines):break
        expected=lines[index]
        candidate=physical.rstrip(" \r\n")
        if candidate.endswith(expected):
            extracted.append(candidate[len(candidate)-len(expected):])
            index+=1
    need(index==len(lines) and extracted==lines,
         f"MVS SYSOUT printed only {index}/{len(lines)} "
         "canonical on-tape profile records (no unsafe submission)")
    return "\n".join(extracted)+"\n"


def tape_status(rc3,media,folder,key):
    h=rc3.run_command(folder,key+"-hercules",
                      ["tools/mvs/mvs-console","tape","status","480"])
    m=rc3.run_command(folder,key+"-mvs",
                      ["tools/mvs/mvs-console","mvs","tapes"])
    matches=re.findall(r"\bHHC02279I\s+(?:[0-9A-Fa-f]+:)?0480\s+3420\s+(.*)",h)
    need(len(matches)==1 and "busy" not in matches[0].lower(),
         "MVS/Hercules drive 0480 missing, ambiguous or busy")
    detail=matches[0]
    guest=media.parse_mvs(m)
    if re.match(r"\*\s",detail):
        need(guest=="O-NRD","MVS tape not empty/idle")
        return "EMPTY"
    if AWS.name in detail:
        need(guest=="O","BC0004 image mounted but MVS tape not online")
        return "RC4"
    if ORIGINAL.name in detail:
        need(guest=="O","BC0003 image mounted but MVS tape not online")
        need(hashfile(ORIGINAL)==ORIGINAL_SHA,"original BC0003 changed")
        return "RC3"
    raise Refusal("tape 0480 has foreign medium; refusing to displace")


def ensure_rc4(rc3,media,folder,key):
    state=tape_status(rc3,media,folder,key)
    if state=="RC3":
        rc3.run_command(folder,key+"-unmount-rc3",
            ["tools/mvs/mvs-console","--yes","tape","unmount",TAPE_UNIT])
        need(tape_status(rc3,media,folder,key+"-released")=="EMPTY",
             "original BC0003 tape not safely released")
    if state!="RC4":
        rc3.run_command(folder,key+"-mount-rc4",
            ["tools/mvs/mvs-console","--yes","tape","mount",TAPE_UNIT,AWS.name])
    need(tape_status(rc3,media,folder,key+"-ready")=="RC4",
         "BC0004 not mounted on MVS tape 0480")
    need(hashfile(AWS)==IMAGE_SHA,"BC0004 changed while preparing tape")


def profile_result(name,report,summary,positions):
    """Check actual MVS/IEBCOPY procedure steps, regardless of JES PROC prefix."""
    need("JOB RESULT: SUCCESS" in summary and
         "HIGHEST RC: 0000" in summary and
         re.search(r"\b(?:ABEND|IEF450I|IEF472I|IEA995I)\b",report,re.I) is None,
         "MVS tape-resident procedure failed or abended: "+name)
    entries=re.findall(
        rf"(?m)^IEF142I\s+{name}\s+(.+?)\s+-\s+"
        r"STEP WAS EXECUTED\s+-\s+COND CODE (\d{4})\s*$",report)
    steps=[(field.split()[-1],rc) for field,rc in entries]
    need(steps==[(f"R{n:04d}","0000") for n in positions],
         "actual IEF142I tape-resident PROC step list/RC differs: "+name)
    need(len(re.findall(r"\bIEBCOPY\b",summary))>=len(positions),
         "MVS job summary lacks installed IEBCOPY procedure steps")
    return len(steps)


def run(live=False):
    rc3=None
    folder=None
    marked=False
    try:
        ref,rem,gen,rc3,load=tools()
        import yaml
        m=yaml.safe_load((BASE/"manifest/releases/BCPL-0.1.0-rc4.yaml").read_bytes())
        gen.load()
        _,source_members,_,_=gen.plan()
        selected=selection(m,gen)
        need(source_members["COPY"]==" COPY OUTDD=OUTPDS,INDD=INTAPE\n",
             "BC0004 COPY control card changed")
        need(hashfile(AWS)==IMAGE_SHA and hashfile(ORIGINAL)==ORIGINAL_SHA,
             "accepted BC0004 or BC0003 image SHA mismatch")
        source_go=rem.render("TA3GO",SITE+"R4CB",ref)
        need("HERC02.BCPL.R4CB.MR10KIT.TESTS(SCALVEC)" in source_go and
             source_go.count("DSN=HERC02.BCPL.R4CB.MR10KIT.LOAD")==3,
             "installed scalar/vector GO source prefix differs")
        for label,(prefix,job,positions,rows,count) in selected.items():
            boot_and_installer(ref,prefix)
            need(gen.profile(m,gen.load()[1],label)==source_members[label],
                 label+": candidate installer profile drift")
            need(len(readback_deck(prefix,label).splitlines())<=20,
                 "unbounded MVS readback job")
        if not live:
            print("TA.3 RC4 RECIPIENT OFFLINE PLAN PASS: 3 isolated on-tape "
                  "JCL profiles; 42 PDSes, 315 members; no MVS operation.")
            return 0
        need(sys.stdin.isatty(),"MVS recipient install needs operator terminal")
        rc3.check_git()
        receipt=production_receipt()
        need(WORK.is_dir() and not WORK.is_symlink() and not OUT.is_symlink() and
             not MARKER.exists() and not MARKER.is_symlink(),
             "TA.3 BC0004 recipient already attempted/unsafe (NO RETRY)")
        OUT.mkdir(mode=0o700,exist_ok=True)
        folder=OUT/(datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")+
                    "-"+str(os.getpid()))
        folder.mkdir(mode=0o700,exist_ok=False)
        core=load("ta4core",ROOT/"tools/datasets/dspal-core.py")
        ls=load("ta4ls",ROOT/"tools/datasets/dspal-ls.py")
        prod=load("ta4prod",BASE/"create-tape/scripts/ta2-rc2-produce-once")
        media=load("ta4media",BASE/"create-tape/scripts/ta2-rc2-media-preflight")
        installed=load("ta4installed",BASE/"create-tape/scripts/ta2-rc3-installed-mr10-continuation")
        reviewer=load("ta4review",BASE/"install-from-tape/scripts/ta2-rc2-mr10-review")
        cfg=core.load_config()
        need(cfg["mvs"]["hlq"]=="HERC02","MVS recipient site differs")
        core.require_reader_ready(cfg)
        tape_before=tape_status(rc3,media,folder,"preflight")
        dsns=[row[1] for _,_,_,rows,_ in selected.values() for row in rows]
        body=ref.deck_without_stat(core.stat_deck(cfg,dsns))
        pre,report,_=ref.mvs_job(rc3,core,cfg,folder,"absence",
                  "DSPALST",body,None,max_rc=8)
        need(ref.absent(core,report,dsns),
             "MVS recipient target collision or ambiguous LISTDS")
        need(tape_status(rc3,media,folder,"post-preflight")==tape_before and
             hashfile(AWS)==IMAGE_SHA and hashfile(ORIGINAL)==ORIGINAL_SHA,
             "MVS media state altered during recipient preflight")
        print(f"TA.3 RC4 RECIPIENT PREFLIGHT PASS: JOB {pre}; "
              f"42 absent PDSes; BC0004 verified; drive {tape_before}.")
        if input("Install 3 BC0004 tape-resident profiles ONCE? [y/N]: ").strip().upper()!="Y":
            rc3.artifact(folder,"result.json",json.dumps({
                "status":"DECLINED_NO_RECIPIENT_INSTALL"})+"\n")
            rc3.seal(folder)
            print("RC4 MVS installation declined; no stateful operation.")
            return 0
        rc3.exclusive(MARKER,(json.dumps({
            "status":"OWNER_APPROVED_TA3_BC0004_TAPE_RESIDENT_PROFILES_NO_RETRY",
            "candidate":"BCPL-0.1.0-rc4","volser":VOL,
            "aws_sha256":IMAGE_SHA,"previous_production_evidence":receipt,
            "destinations":[x[0] for x in selected.values()],
            "evidence":folder.relative_to(ROOT).as_posix(),
            "no_tape_write":True,"no_overwrite":True,
            "publication_authorized":False},sort_keys=True)+"\n").encode("ascii"))
        marked=True
        ensure_rc4(rc3,media,folder,"boot")
        boot,boot_report,_=ref.mvs_job(
            rc3,core,cfg,folder,"boot","T3R4BO",
            boot_and_installer(ref,SITE+"R4MR")["TA3BOOT"],
            [("BOOTREAD","IEBGENER")])
        need("CANDIDATE BCPL-0.1.0-rc4" in boot_report and
             "BC0004" in boot_report and
             "NATIVE CAMBRIDGE COMPILER ABSENT" in boot_report,
             "new BC0004 MVS bootstrap text differs")
        results={}
        for label,(prefix,jobname,positions,rows,count) in selected.items():
            report_result={"prefix":prefix}
            ensure_rc4(rc3,media,folder,label.lower()+"-installer-tape")
            bt2,_,_=ref.mvs_job(
                rc3,core,cfg,folder,label.lower()+"-bt2","T3R4BT",
                boot_and_installer(ref,prefix)["TA3BT2"],
                [("BT2REST","IEBCOPY")])
            report_result["installer_job"]=bt2
            # The submitted profile MUST originate from MVS spool readback
            # of the newly tape-restored BT0002 member, not local JCL.
            view,report,_=ref.mvs_job(
                rc3,core,cfg,folder,label.lower()+"-readback",
                "T3R4PR",readback_deck(prefix,label),
                [("P0001","IEBGENER"),("P0002","IEBGENER")])
            deck=extract_profile(report,source_members[label])
            need("COPY OUTDD=OUTPDS,INDD=INTAPE" in report,
                 label+": on-tape BT0002(COPY) unavailable in MVS SYSOUT")
            rc3.artifact(folder,label.lower()+"-on-tape-profile.jcl",deck)
            report_result["readback_job"]=view
            ensure_rc4(rc3,media,folder,label.lower()+"-profile-tape")
            restored,restored_report,restored_summary=ref.mvs_job(
                rc3,core,cfg,folder,label.lower()+"-restore",
                jobname,deck,None)
            steps=profile_result(jobname,restored_report,restored_summary,positions)
            report_result["restore_job"]=restored
            report_result["executed_iecopy_steps"]=steps
            cat,directory,total=rem.verify(
                rc3,ref,core,cfg,installed,ls,folder,label.lower(),rows)
            need(total==count,label+": MVS profile member count differs")
            report_result.update({
                "catalog_job":cat,"directory_job":directory,
                "restored_pds":len(rows),"verified_members":total})
            if label=="COMBINED":
                go,go_report,_=ref.mvs_job(
                    rc3,core,cfg,folder,"combined-go",
                    "T3R4GO",source_go,ref.GO_STEPS)
                ref.go_semantics(rc3,folder,go_report,reviewer)
                report_result["installed_bcpl_go"]=go
            rc3.artifact(folder,label.lower()+"-checkpoint.json",
                         json.dumps(report_result,indent=2)+"\n")
            results[label]=report_result
            print(f"TA.3 RC4 {label} TAPE-RESIDENT PASS: "
                  f"{len(rows)} PDSes; {total} members; "
                  f"{steps} MVS IEBCOPY steps."
                  +(" Installed SCALVEC TEST/EXP/RP/CODE PASS."
                    if label=="COMBINED" else ""))
        need(hashfile(AWS)==IMAGE_SHA and
             hashfile(ORIGINAL)==ORIGINAL_SHA,
             "accepted AWS content changed after RC4 recipient trial")
        rc3.artifact(folder,"result.json",json.dumps({
            "status":"TA3_RC4_TAPE_RESIDENT_THREE_PROFILE_INSTALL_AND_GO_PASS",
            "candidate":"BCPL-0.1.0-rc4","volser":VOL,
            "aws_sha256":IMAGE_SHA,"original_bc0003_sha256":ORIGINAL_SHA,
            "production_evidence":receipt,
            "preflight_job":pre,"bootstrap_job":boot,
            "profile_results":results,"restored_pds":42,
            "verified_members":315,"native_compiler":"absent",
            "independent_system":False,"publication_authorized":False
        },indent=2)+"\n")
        rc3.seal(folder)
        print("TA.3 RC4 ON-TAPE PROFILES PASS: MR10/NATIVE/COMBINED; "
              "actual MVS installed SCALVEC; BC0004 unchanged.")
        print("Evidence: "+folder.relative_to(ROOT).as_posix())
        return 0
    except Exception as exc:
        if rc3 is not None and folder is not None:
            try:
                rc3.artifact(folder,"failure.json",json.dumps({
                    "status":"STATEFUL_NO_RETRY" if marked else "PREFLIGHT_HALTED",
                    "reason":str(exc)},indent=2)+"\n")
                rc3.seal(folder)
            except Exception:pass
        print("TA.3 RC4 RECIPIENT HALTED: "+str(exc),file=sys.stderr)
        if folder is not None:
            print("Evidence: "+folder.relative_to(ROOT).as_posix(),file=sys.stderr)
        if marked:
            print("NO RETRY: preserve BC0004, partial recipient PDSes "
                  "and all MVS reports.",file=sys.stderr)
        return 2


def main(argv=None):
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--run",action="store_true",
                        help="one-shot actual MVS BC0004 tape-resident installation")
    return run(parser.parse_args(argv).run)


if __name__=="__main__":
    raise SystemExit(main())
