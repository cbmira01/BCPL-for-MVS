#!/usr/bin/env python3
"""TA.3 RC4: read-only MVS 3.8J in-stream PROC/symbolic-PDS proof.

Uses the already accepted TA3N1 installer member. No tape mount, write,
recipient allocation, restart, or accepted TA.2/TA.3 job replay.
"""
from __future__ import annotations
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import sys
import tempfile

sys.dont_write_bytecode=True
ROOT=Path(__file__).resolve().parents[4]
BASE=ROOT/'packaging/distribution'
OUT=ROOT/'workarea/ta3-rc4-proc-probe'
JCL=[
    '//* READ ONLY MVS PROC SYMBOL/PDS MEMBER TEST; NO DATASET WRITES.',
    '//* RC4 PROFILE DESIGN REQUIRES MVS 3.8 IN-STREAM PROC SUPPORT.',
    '//R4PROBE PROC HLQ=HERC02,SITE=TA3N1',
    '//PRINT EXEC PGM=IEBGENER,REGION=512K',
    '//SYSPRINT DD SYSOUT=*',
    '//SYSIN DD DUMMY',
    '//SYSUT1 DD DSN=&HLQ..BCPL.&SITE..DIST.INST(INSTALL),',
    '//            DISP=SHR',
    '//SYSUT2 DD SYSOUT=*',
    '// PEND',
    '//GO EXEC R4PROBE',
    '//',
]


def run():
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec,spec_from_loader
    generator=BASE/'create-tape/scripts/ta3-rc4-installer'
    loader=SourceFileLoader('ta3rc4_probe_source',str(generator))
    spec=spec_from_loader(loader.name,loader)
    if spec is None or spec.loader is None:
        raise ValueError('RC4 generator unavailable')
    new=module_from_spec(spec)
    spec.loader.exec_module(new)
    new.plan()  # full offline RC4 profile/manifest/registry gate
    body=new.cards(JCL,jcl=True)
    corepath=ROOT/'tools/datasets/dspal-core.py'
    loader=SourceFileLoader('ta3r4_probe_core',str(corepath))
    spec=spec_from_loader(loader.name,loader)
    if spec is None or spec.loader is None:
        raise ValueError('MVS submit utility unavailable')
    core=module_from_spec(spec)
    spec.loader.exec_module(core)
    cfg=core.load_config()
    if cfg['mvs']['hlq']!='HERC02':
        raise ValueError('MVS site identity differs from accepted TA3N1')
    core.require_reader_ready(cfg)
    if not OUT.parent.is_dir() or OUT.is_symlink():
        raise ValueError('unsafe repository workarea')
    OUT.mkdir(mode=0o700,exist_ok=True)
    folder=OUT/(datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')+
                '-'+str(os.getpid()))
    folder.mkdir(mode=0o700,exist_ok=False)
    try:
        card=core.authenticated_job_card(cfg,'TA3PPRB','TA3 RC4 PROC PROBE',False)
        deck='\n'.join(card)+'\n'+body
        if any(len(line)>80 for line in deck.splitlines()):
            raise ValueError('MVS JCL card exceeds FB80')
        (folder/'job-body.jcl').write_text(body,encoding='ascii')
        temp,env=tempfile.tempdir,os.environ.get('TMPDIR')
        try:
            tempfile.tempdir=str(folder)
            os.environ['TMPDIR']=str(folder)
            job,summary=core.submit_and_wait(cfg,deck,max_rc=0,
                cursor_file=folder/'job-cursor.json')
            (folder/'job-summary.txt').write_text(summary,encoding='utf-8')
            report=core.job_report(job,cursor_file=folder/'job-cursor.json')
            (folder/'job-report.txt').write_text(report,encoding='utf-8')
        finally:
            tempfile.tempdir=temp
            if env is None:os.environ.pop('TMPDIR',None)
            else:os.environ['TMPDIR']=env
        if not (re.search(rf'(?m)^JOB\s+{job}\s+TA3PPRB\s*$',summary) and
                'JOB RESULT: SUCCESS' in summary and
                'HIGHEST RC: 0000' in summary and
                'MVS-ONLY BCPL INSTALLATION' in report and
                re.search(r'(?m)^IEF142I\s+TA3PPRB\b.*'
                          r'STEP WAS EXECUTED\s+-\s+COND CODE 0000\s*$',report)):
            raise ValueError('actual MVS PROC expansion or PDS read not proven')
        (folder/'result.json').write_text(json.dumps({
            'status':'TA3_RC4_READONLY_MVS_PROC_AND_PDS_SYMBOLIC_PASS',
            'job':job,'read_dsn':'HERC02.BCPL.TA3N1.DIST.INST(INSTALL)',
            'candidate':'BCPL-0.1.0-rc4',
            'media_written':False,'new_datasets':0},indent=2)+'\n')
        print(f'TA.3 RC4 MVS PROC PASS: JOB {job}; symbolic PDS member read RC0000.')
        print('Evidence: '+folder.relative_to(ROOT).as_posix())
        return 0
    except Exception as exc:
        (folder/'failure.json').write_text(json.dumps({'error':str(exc)},indent=2)+'\n')
        print('Evidence: '+folder.relative_to(ROOT).as_posix(),file=sys.stderr)
        raise


def main():
    try:return run()
    except Exception as exc:
        print('TA.3 RC4 MVS PROC PROBE HALTED: '+str(exc),file=sys.stderr)
        return 2


if __name__=='__main__':
    raise SystemExit(main())
