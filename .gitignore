# Build products
build/
dist/
workarea/
*.o
*.obj
*.bin
*.lst
*.log

# Local Compose configuration
compose.override.yaml
compose.override.yml
.env
.env.*
!.env.example

# Local dspal configuration
config/dspal.local.yaml

# Python cache
__pycache__/
*.py[cod]

# Local virtual environments
.venv/
venv/

# Tool caches, if used
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ignore everything under mvs-state, but allow Git to traverse 
#   the directory structure and keep the structural placeholders
mvs-state/**
!mvs-state/**/
!mvs-state/**/.gitkeep
