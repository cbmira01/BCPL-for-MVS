// R.5 NATIVE BCPL REGRESSION 153.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          DEMOSVC:203 $)
LET START() BE
$(1
    LET VALUES = VEC 3
    VALUES!0 := 777
    VALUES!3 := 999
    IF DEMOSVC(1,0,3) NE -3 DO STOP(8)
    IF DEMOSVC(1,VALUES,-1) NE -3 DO STOP(8)
    IF VALUES!0 NE 777 | VALUES!3 NE 999 DO STOP(8)
    WRITES("R5 EXT 153 PASS")
    NEWLINE()
    FINISH
$)1
