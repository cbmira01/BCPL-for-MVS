// R.5 NATIVE BCPL REGRESSION 155.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          DEMOSVC:203 $)
LET START() BE
$(1
    LET INFO = VEC 6
    LET VALUES = VEC 3
    VALUES!3 := 777
    IF DEMOSVC(0,0,0) NE 6 DO STOP(8)
    IF DEMOSVC(1,VALUES,3) NE 3 DO STOP(8)
    IF VALUES!0 NE 10 | VALUES!2 NE 30 DO STOP(8)
    IF DEMOSVC(0,INFO,6) NE 6 DO STOP(8)
    IF INFO!0 NE 1 | INFO!3 NE 6 DO STOP(8)
    IF DEMOSVC(1,VALUES,3) NE 3 DO STOP(8)
    IF VALUES!1 NE 20 | VALUES!3 NE 777 DO STOP(8)
    WRITES("R5 EXT 155 PASS")
    NEWLINE()
    FINISH
$)1
