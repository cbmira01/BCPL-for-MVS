// T.1 159: full BCPLTIME direct-call contract, no BCPLDEMO.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          TIMESVC:201 $)
LET START() BE
$(1
    LET INFO = VEC 6
    LET CLOCK = VEC 3
    LET MVS = VEC 2
    INFO!0 := 707
    INFO!6 := 909
    IF TIMESVC(0,0,0) NE 6 DO STOP(8)
    IF TIMESVC(0,INFO,5) NE -1 DO STOP(8)
    IF INFO!0 NE 707 | INFO!6 NE 909 DO STOP(8)
    IF TIMESVC(0,0,6) NE -3 DO STOP(8)
    IF TIMESVC(0,INFO,6) NE 6 DO STOP(8)
    IF INFO!0 NE 1 | INFO!1 NE 1 DO STOP(8)
    IF INFO!2 NE 0 | INFO!3 NE 6 DO STOP(8)
    IF INFO!4 NE 3 | INFO!5 NE 0 DO STOP(8)
    IF TIMESVC(99,0,0) NE -2 DO STOP(8)
    CLOCK!0 := 707
    CLOCK!1 := 808
    CLOCK!2 := 909
    CLOCK!3 := 1001
    IF TIMESVC(1,CLOCK,2) NE -1 DO STOP(8)
    IF CLOCK!0 NE 707 | CLOCK!1 NE 808 DO STOP(8)
    IF CLOCK!2 NE 909 | CLOCK!3 NE 1001 DO STOP(8)
    IF TIMESVC(1,0,3) NE -3 DO STOP(8)
    IF TIMESVC(1,CLOCK,3) NE 3 DO STOP(8)
    IF CLOCK!2 < 0 | CLOCK!2 > 3 DO STOP(8)
    MVS!0 := 707
    MVS!1 := 808
    MVS!2 := 909
    IF TIMESVC(2,MVS,1) NE -1 DO STOP(8)
    IF MVS!0 NE 707 | MVS!1 NE 808 DO STOP(8)
    IF MVS!2 NE 909 DO STOP(8)
    IF TIMESVC(2,0,2) NE -3 DO STOP(8)
    IF TIMESVC(2,MVS,2) NE 2 DO STOP(8)
    WRITES("T1 TIME 159 PASS")
    NEWLINE()
    FINISH
$)1
