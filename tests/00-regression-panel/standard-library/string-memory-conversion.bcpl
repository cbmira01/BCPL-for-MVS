// Regression: string, memory, and numeric-conversion modules.
GLOBAL $(
START:1
WRITEF:76
GETBYTE:85
STRLEN:107; STRCMP:108; STRCPY:109; STRCAT:110; STRCHR:111
MEMCPY:112; MEMSET:113; MEMCMP:114; VECCOPY:115; VECCLEAR:116
ATOI:117; ITOA:118; HEXTOI:119; ITOHEX:120
$)

LET START() BE
$( LET S = VEC 10
   AND T = VEC 10
   AND U = VEC 10
   AND A = VEC 3
   AND B = VEC 3

   STRCPY(S, "HELLO")
   STRCAT(S, " BCPL")
   STRCPY(T, S)
   WRITEF("RP: STRING %S %N %N %N*N", S, STRLEN(S), STRCMP(S,T), STRCHR(S,'B'))

   MEMCPY(U, S, STRLEN(S)+1)
   WRITEF("RP: MEM %N %N*N", MEMCMP(S,U,STRLEN(S)+1), GETBYTE(U,1))
   MEMSET(U, 'X', 3)
   WRITEF("RP: SET %N %N %N*N", GETBYTE(U,0), GETBYTE(U,1), GETBYTE(U,2))

   A!0:=11; A!1:=22; A!2:=33; A!3:=44
   VECCOPY(B,A,4)
   WRITEF("RP: VEC %N %N %N %N*N", B!0,B!1,B!2,B!3)
   VECCLEAR(B,4)
   WRITEF("RP: CLEAR %N %N*N", B!0,B!3)

   ITOA(-12345,T)
   ITOHEX(48879,U)
   WRITEF("RP: CONV %N %S %N %S*N", ATOI("-321"), T, HEXTOI("BEEF"), U)
   FINISH
$)
