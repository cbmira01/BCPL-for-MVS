// M1 dynamic FINDINPUT 12 simultaneously live DD descriptors.
// Candidate-only compiled Cambridge BCPL stress regression.
GLOBAL $( START:1; SELECTINPUT:11; RDCH:13; WRCH:14;
          UNRDCH:15; INPUT:16; STOP:30; FINDINPUT:42;
          ENDREAD:46; WRITES:60 $)

LET START() BE
$(1
    LET S = VEC 11

    // Open every DD before reading or closing any stream.
    S!0 := FINDINPUT("DD01")
    S!1 := FINDINPUT("DD02")
    S!2 := FINDINPUT("DD03")
    S!3 := FINDINPUT("DD04")
    S!4 := FINDINPUT("DD05")
    S!5 := FINDINPUT("DD06")
    S!6 := FINDINPUT("DD07")
    S!7 := FINDINPUT("DD08")
    S!8 := FINDINPUT("DD09")
    S!9 := FINDINPUT("DD10")
    S!10 := FINDINPUT("DD11")
    S!11 := FINDINPUT("DD12")

    // All twelve descriptors must exist and have distinct handles.
    IF S!0=0 DO STOP(8)
    IF S!1=0 DO STOP(8)
    IF S!2=0 DO STOP(8)
    IF S!3=0 DO STOP(8)
    IF S!4=0 DO STOP(8)
    IF S!5=0 DO STOP(8)
    IF S!6=0 DO STOP(8)
    IF S!7=0 DO STOP(8)
    IF S!8=0 DO STOP(8)
    IF S!9=0 DO STOP(8)
    IF S!10=0 DO STOP(8)
    IF S!11=0 DO STOP(8)
    IF S!0=S!1 DO STOP(8)
    IF S!0=S!2 DO STOP(8)
    IF S!0=S!3 DO STOP(8)
    IF S!0=S!4 DO STOP(8)
    IF S!0=S!5 DO STOP(8)
    IF S!0=S!6 DO STOP(8)
    IF S!0=S!7 DO STOP(8)
    IF S!0=S!8 DO STOP(8)
    IF S!0=S!9 DO STOP(8)
    IF S!0=S!10 DO STOP(8)
    IF S!0=S!11 DO STOP(8)
    IF S!1=S!2 DO STOP(8)
    IF S!1=S!3 DO STOP(8)
    IF S!1=S!4 DO STOP(8)
    IF S!1=S!5 DO STOP(8)
    IF S!1=S!6 DO STOP(8)
    IF S!1=S!7 DO STOP(8)
    IF S!1=S!8 DO STOP(8)
    IF S!1=S!9 DO STOP(8)
    IF S!1=S!10 DO STOP(8)
    IF S!1=S!11 DO STOP(8)
    IF S!2=S!3 DO STOP(8)
    IF S!2=S!4 DO STOP(8)
    IF S!2=S!5 DO STOP(8)
    IF S!2=S!6 DO STOP(8)
    IF S!2=S!7 DO STOP(8)
    IF S!2=S!8 DO STOP(8)
    IF S!2=S!9 DO STOP(8)
    IF S!2=S!10 DO STOP(8)
    IF S!2=S!11 DO STOP(8)
    IF S!3=S!4 DO STOP(8)
    IF S!3=S!5 DO STOP(8)
    IF S!3=S!6 DO STOP(8)
    IF S!3=S!7 DO STOP(8)
    IF S!3=S!8 DO STOP(8)
    IF S!3=S!9 DO STOP(8)
    IF S!3=S!10 DO STOP(8)
    IF S!3=S!11 DO STOP(8)
    IF S!4=S!5 DO STOP(8)
    IF S!4=S!6 DO STOP(8)
    IF S!4=S!7 DO STOP(8)
    IF S!4=S!8 DO STOP(8)
    IF S!4=S!9 DO STOP(8)
    IF S!4=S!10 DO STOP(8)
    IF S!4=S!11 DO STOP(8)
    IF S!5=S!6 DO STOP(8)
    IF S!5=S!7 DO STOP(8)
    IF S!5=S!8 DO STOP(8)
    IF S!5=S!9 DO STOP(8)
    IF S!5=S!10 DO STOP(8)
    IF S!5=S!11 DO STOP(8)
    IF S!6=S!7 DO STOP(8)
    IF S!6=S!8 DO STOP(8)
    IF S!6=S!9 DO STOP(8)
    IF S!6=S!10 DO STOP(8)
    IF S!6=S!11 DO STOP(8)
    IF S!7=S!8 DO STOP(8)
    IF S!7=S!9 DO STOP(8)
    IF S!7=S!10 DO STOP(8)
    IF S!7=S!11 DO STOP(8)
    IF S!8=S!9 DO STOP(8)
    IF S!8=S!10 DO STOP(8)
    IF S!8=S!11 DO STOP(8)
    IF S!9=S!10 DO STOP(8)
    IF S!9=S!11 DO STOP(8)
    IF S!10=S!11 DO STOP(8)

    // Round one: alternate streams, reading only first records.
    SELECTINPUT(S!0)
    IF INPUT() NE S!0 DO STOP(8)
    IF RDCH() NE 'A' DO STOP(8)
    UNRDCH()
    IF RDCH() NE 'A' DO STOP(8)
    SELECTINPUT(S!1)
    IF INPUT() NE S!1 DO STOP(8)
    IF RDCH() NE 'B' DO STOP(8)
    SELECTINPUT(S!2)
    IF INPUT() NE S!2 DO STOP(8)
    IF RDCH() NE 'C' DO STOP(8)
    SELECTINPUT(S!3)
    IF INPUT() NE S!3 DO STOP(8)
    IF RDCH() NE 'D' DO STOP(8)
    SELECTINPUT(S!4)
    IF INPUT() NE S!4 DO STOP(8)
    IF RDCH() NE 'E' DO STOP(8)
    SELECTINPUT(S!5)
    IF INPUT() NE S!5 DO STOP(8)
    IF RDCH() NE 'F' DO STOP(8)
    SELECTINPUT(S!6)
    IF INPUT() NE S!6 DO STOP(8)
    IF RDCH() NE 'G' DO STOP(8)
    SELECTINPUT(S!7)
    IF INPUT() NE S!7 DO STOP(8)
    IF RDCH() NE 'H' DO STOP(8)
    SELECTINPUT(S!8)
    IF INPUT() NE S!8 DO STOP(8)
    IF RDCH() NE 'I' DO STOP(8)
    SELECTINPUT(S!9)
    IF INPUT() NE S!9 DO STOP(8)
    IF RDCH() NE 'J' DO STOP(8)
    SELECTINPUT(S!10)
    IF INPUT() NE S!10 DO STOP(8)
    IF RDCH() NE 'K' DO STOP(8)
    SELECTINPUT(S!11)
    IF INPUT() NE S!11 DO STOP(8)
    IF RDCH() NE 'L' DO STOP(8)

    // Round two: each stream retained its own record cursor.
    SELECTINPUT(S!0)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'M' DO STOP(8)
    SELECTINPUT(S!1)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'N' DO STOP(8)
    SELECTINPUT(S!2)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'O' DO STOP(8)
    SELECTINPUT(S!3)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'P' DO STOP(8)
    SELECTINPUT(S!4)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'Q' DO STOP(8)
    SELECTINPUT(S!5)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'R' DO STOP(8)
    SELECTINPUT(S!6)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'S' DO STOP(8)
    SELECTINPUT(S!7)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'T' DO STOP(8)
    SELECTINPUT(S!8)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'U' DO STOP(8)
    SELECTINPUT(S!9)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'V' DO STOP(8)
    SELECTINPUT(S!10)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'W' DO STOP(8)
    SELECTINPUT(S!11)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'X' DO STOP(8)

    // Round three: independent newline and EOF state.
    SELECTINPUT(S!0)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!1)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!2)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!3)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!4)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    UNRDCH()
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!5)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!6)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!7)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!8)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!9)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!10)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!11)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)

    // Reverse closure catches descriptor-list unlinking mistakes.
    SELECTINPUT(S!11)
    IF INPUT() NE S!11 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!11)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!10)
    IF INPUT() NE S!10 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!10)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!9)
    IF INPUT() NE S!9 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!9)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!8)
    IF INPUT() NE S!8 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!8)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!7)
    IF INPUT() NE S!7 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!7)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!6)
    IF INPUT() NE S!6 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!6)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!5)
    IF INPUT() NE S!5 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!5)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!4)
    IF INPUT() NE S!4 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!4)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!3)
    IF INPUT() NE S!3 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!3)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!2)
    IF INPUT() NE S!2 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!2)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!1)
    IF INPUT() NE S!1 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!1)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!0)
    IF INPUT() NE S!0 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!0)
    IF INPUT() NE 0 DO STOP(8)

    WRITES("BCPL TWELVE INPUT OK")
    WRCH(10)
    FINISH
$)1
