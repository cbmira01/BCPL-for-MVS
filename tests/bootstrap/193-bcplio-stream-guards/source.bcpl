GLOBAL $( START:1; SELECTINPUT:11; SELECTOUTPUT:12
 RDCH:13; WRCH:14; INPUT:16; OUTPUT:17; STOP:30
 FINDOUTPUT:41; FINDINPUT:42; ENDREAD:46; ENDWRITE:47
 WRITES:60 $)

LET START() BE
$( LET P = OUTPUT()
   LET A = FINDINPUT("BCPIN")
   LET B = FINDINPUT("BCPINB")
   LET D = FINDINPUT("DD01")
   LET O = FINDOUTPUT("REPORT")
   LET S = FINDOUTPUT("BCPALT")
   LET BAD = FALSE

   IF P=0 | A=0 | B=0 | D=0 | O=0 | S=0 DO STOP(8)
   SELECTINPUT(D)
   SELECTOUTPUT(O)
   IF INPUT() NE D | OUTPUT() NE O DO STOP(8)
   IF RDCH() NE 'E' DO STOP(8)

   SELECTOUTPUT(D)
   BAD := OUTPUT() NE O
   SELECTOUTPUT(O)
   IF BAD DO STOP(8)
   SELECTINPUT(O)
   BAD := INPUT() NE D
   SELECTINPUT(D)
   IF BAD DO STOP(8)
   IF RDCH() NE 'F' DO STOP(8)

   SELECTINPUT(A)
   IF RDCH() NE 'A' DO STOP(8)
   IF FINDINPUT("bCpIn") NE A DO STOP(8)
   IF INPUT() NE A | RDCH() NE 'B' DO STOP(8)
   ENDREAD()
   IF INPUT() NE 0 DO STOP(8)
   SELECTINPUT(D)
   SELECTINPUT(A)
   BAD := INPUT() NE D
   SELECTINPUT(D)
   IF BAD DO STOP(8)

   SELECTINPUT(B)
   IF RDCH() NE 'C' DO STOP(8)
   IF FINDINPUT("bcpinb") NE B DO STOP(8)
   IF INPUT() NE B | RDCH() NE 'D' DO STOP(8)
   ENDREAD()
   IF INPUT() NE 0 DO STOP(8)
   SELECTINPUT(B)
   BAD := INPUT() NE 0
   SELECTINPUT(D)
   IF BAD DO STOP(8)
   IF RDCH() NE 10 DO STOP(8)
   ENDREAD()

   IF FINDOUTPUT("sysprint") NE P DO STOP(8)
   IF FINDOUTPUT("bCpAlT") NE S DO STOP(8)
   IF OUTPUT() NE O DO STOP(8)
   WRITES("GUARD REPORT")
   WRCH(10)
   ENDWRITE()
   IF OUTPUT() NE P DO STOP(8)
   SELECTOUTPUT(S)
   WRITES("GUARD ALT")
   WRCH(10)
   ENDWRITE()
   IF OUTPUT() NE P DO STOP(8)
   SELECTOUTPUT(S)
   IF OUTPUT() NE P DO STOP(8)
   ENDWRITE()
   IF OUTPUT() NE P DO STOP(8)
   WRITES("BCPLIO STREAM GUARDS OK")
   WRCH(10)
   FINISH
$)
