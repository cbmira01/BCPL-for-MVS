GLOBAL $( START:1; SELECTINPUT:11; SELECTOUTPUT:12
 RDCH:13; WRCH:14; UNRDCH:15; FINDOUTPUT:41
 FINDINPUT:42; ENDREAD:46; ENDWRITE:47 $)
LET START() BE
$(1
 LET D=FINDOUTPUT("SYSPRINT")
 LET S=FINDOUTPUT("BCPALT")
 SELECTOUTPUT(D)
 WRCH('A')
 SELECTOUTPUT(S)
 WRCH('1')
 WRCH(10)
 SELECTOUTPUT(D)
 WRCH('B')
 WRCH(10)
 SELECTOUTPUT(S)
 WRCH('2')
 SELECTOUTPUT(D)
 WRCH('C')
 FINISH
$)1
