// M4.1 isolated test-only fault on second buffer/DCB GETMAIN 268.
GLOBAL $( START:1; SELECTINPUT:11; RDCH:13; WRCH:14;
          INPUT:16; STOP:30; FINDINPUT:42; ENDREAD:46;
          WRITES:60; NATIVEADD:151 $)

LET START() BE
$(1
    LET A = FINDINPUT("DD01")
    LET B = 0
    IF A=0 DO STOP(8)

    SELECTINPUT(A)
    IF INPUT() NE A DO STOP(8)
    IF RDCH() NE 'A' DO STOP(8)

    // Second site visit is injected as failed GETMAIN.
    B := FINDINPUT("DD02")
    IF B NE 0 DO STOP(8)
    // M4.3: check all counters after synthetic denial.
    IF NATIVEADD(0) NE 2 DO STOP(8)
    IF NATIVEADD(1) NE 1 DO STOP(8)
    IF NATIVEADD(2) NE 1 DO STOP(8)
    IF NATIVEADD(3) NE 0 DO STOP(8)
    IF NATIVEADD(4) NE 1 DO STOP(8)
    IF NATIVEADD(5) NE 0 DO STOP(8)
    IF NATIVEADD(6) NE 1 DO STOP(8)
    IF NATIVEADD(7) NE 1 DO STOP(8)
    IF NATIVEADD(8) NE 0 DO STOP(8)
    IF NATIVEADD(9) NE 0 DO STOP(8)

    IF INPUT() NE A DO STOP(8)

    // The live stream's cursor must remain undisturbed.
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'B' DO STOP(8)

    // Third visit uses real GETMAIN and must succeed.
    B := FINDINPUT("DD02")
    IF B=0 DO STOP(8)
    IF B=A DO STOP(8)

    SELECTINPUT(B)
    IF INPUT() NE B DO STOP(8)
    IF RDCH() NE 'Q' DO STOP(8)
    IF RDCH() NE 'R' DO STOP(8)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)

    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)

    SELECTINPUT(A)
    IF INPUT() NE A DO STOP(8)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    ENDREAD()

    // M4.3 after both closes: private counters 0..9, each asserted exactly.
    IF NATIVEADD(0) NE 3 DO STOP(8)
    IF NATIVEADD(1) NE 3 DO STOP(8)
    IF NATIVEADD(2) NE 2 DO STOP(8)
    IF NATIVEADD(3) NE 2 DO STOP(8)
    IF NATIVEADD(4) NE 2 DO STOP(8)
    IF NATIVEADD(5) NE 0 DO STOP(8)
    IF NATIVEADD(6) NE 2 DO STOP(8)
    IF NATIVEADD(7) NE 2 DO STOP(8)
    IF NATIVEADD(8) NE 2 DO STOP(8)
    IF NATIVEADD(9) NE 2 DO STOP(8)

    WRITES("BCPL FAULT 268 OK")
    WRCH(10)
    FINISH
$)1
