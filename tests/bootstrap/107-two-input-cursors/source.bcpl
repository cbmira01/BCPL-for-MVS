GLOBAL $( START:1; SELECTINPUT:11; RDCH:13
 WRCH:14; INPUT:16; FINDINPUT:42 $)
LET START() BE
$(1
 LET A = FINDINPUT("BCPIN")
 LET B = FINDINPUT("BCPINB")
 IF A=0 | B=0 DO FINISH
 SELECTINPUT(A)
 TEST RDCH()='A' THEN WRCH('A') ELSE WRCH('?')
 SELECTINPUT(B)
 TEST INPUT()=B THEN WRCH('Y') ELSE WRCH('?')
 TEST RDCH()='1' THEN WRCH('1') ELSE WRCH('?')
 SELECTINPUT(A)
 TEST RDCH()='B' THEN WRCH('B') ELSE WRCH('?')
 SELECTINPUT(B)
 TEST RDCH()='2' THEN WRCH('2') ELSE WRCH('?')
 FINISH
$)1
