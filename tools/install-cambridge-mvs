#!/usr/bin/env python3
"""Install the interpreted Cambridge compiler as persistent MVS build state.

The resulting resident toolchain is:

  HERC02.BCPL.ASM(ICINT19)       ICINT V19 assembler source
  HERC02.BCPL.LOAD(ICINT19)      assembled/link-edited interpreter
  HERC02.BCPL.SOURCE(*)          demoted Cambridge sources/headers/options
  HERC02.BCPL.INTCODE(*)         compiled Cambridge INTCODE units

The Cambridge compiler is still interpreted INTCODE.  This installer removes
the expensive per-regression bootstrap by compiling those INTCODE units once
and leaving them on MVS.
"""

from __future__ import annotations

import argparse
import importlib.util
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
DSPAL_CORE = ROOT / "tools" / "dspal-core.py"
BOOT = ROOT / "native-compiler" / "bootstrap-cambridge"
BOOT_WORK = ROOT / "workarea" / "bootstrap-cambridge"


def load_dspal_core():
    spec = importlib.util.spec_from_file_location("dspal_core", DSPAL_CORE)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {DSPAL_CORE}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


core = load_dspal_core()


SOURCE_MEMBERS = [
    ("BCPL", BOOT_WORK / "demoted" / "bcpl"),
    ("SYN", BOOT_WORK / "demoted" / "syn"),
    ("LEX", BOOT_WORK / "demoted" / "lex"),
    ("TRNA", BOOT_WORK / "demoted" / "trna"),
    ("TRNB", BOOT_WORK / "demoted" / "trnb"),
    ("CGA", BOOT_WORK / "demoted" / "cga"),
    ("CGB", BOOT_WORK / "demoted" / "cgb"),
    ("CGC", BOOT_WORK / "demoted" / "cgc"),
    ("CGD", BOOT_WORK / "demoted" / "cgd"),
    ("CGE", BOOT_WORK / "demoted" / "cge"),
    ("BOOTHOST", BOOT / "bootstrap-host.bcpl"),
    ("OPTIONS", BOOT / "options-large-tree.txt"),
    ("CAMBPARM", BOOT / "cambridge-options.txt"),
    ("LIBHDR", ROOT / "richards-bcpltape" / "sys3" / "bcpl" / "libhdr"),
    ("SYNHDR", ROOT / "richards-bcpltape" / "bcplib" / "bcpl" / "synhdr"),
    ("TRNHDR", ROOT / "richards-bcpltape" / "bcplib" / "bcpl" / "trnhdr"),
    ("CGHDR", ROOT / "richards-bcpltape" / "bcplib" / "bcpl" / "cghdr"),
]

BASE_INTCODE = [
    ("SYNI", ROOT / "intcode" / "syni.int"),
    ("CGI", ROOT / "intcode" / "cgi.int"),
    ("BLIBI", ROOT / "intcode" / "blibi.int"),
    ("ICLIB", ROOT / "intcode" / "iclib.int"),
]

CAMBRIDGE_UNITS = [
    ("BCPL", "BCPL"),
    ("SYN", "SYN"),
    ("LEX", "LEX"),
    ("TRNA", "TRNA"),
    ("TRNB", "TRNB"),
    ("CGA", "CGA"),
    ("CGB", "CGB"),
    ("CGC", "CGC"),
    ("CGD", "CGD"),
    ("CGE", "CGE"),
    ("BOOTHOST", "BOOTHOST"),
]


def rebuild_bootstrap() -> Path:
    subprocess.run([sys.executable, str(BOOT / "make-demoted.py")], check=True)
    trni = BOOT_WORK / "trni-large-names.int"
    if not trni.is_file():
        subprocess.run(
            ["bash", str(BOOT / "build-mr10-trni-large-names.sh")],
            check=True,
        )
    return trni


def records(path: Path) -> list[str]:
    text = path.read_text(encoding="utf-8").replace("\r\n", "\n").replace("\r", "\n")
    result = text.split("\n")
    if result and result[-1] == "":
        result.pop()
    for number, line in enumerate(result, 1):
        line.encode("ascii")
        if len(line) > 80:
            raise ValueError(f"{path}:{number}: record exceeds 80 columns")
        if line.startswith("Z9"):
            raise ValueError(f"{path}:{number}: reserved JCL delimiter prefix Z9")
    return result


def put_member(step: str, dsn: str, member: str, path: Path) -> list[str]:
    lines = [
        f"//* INSTALL {path.relative_to(ROOT)} AS {dsn}({member})",
        f"//{step:<8} EXEC PGM=IEBGENER",
        "//SYSPRINT DD  SYSOUT=*",
        "//SYSIN    DD  DUMMY",
        f"//SYSUT2   DD  DSN={dsn}({member}),DISP=SHR",
        "//SYSUT1   DD  DATA,DLM=Z9",
    ]
    lines.extend(records(path))
    lines.append("Z9")
    return lines


def runtime_common(step: str, load: str) -> list[str]:
    return [
        f"//{step:<8} EXEC PGM=ICINT19,REGION=256K,TIME=(,30)",
        f"//STEPLIB  DD  DSN={load},DISP=SHR",
        "//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)",
        "//SYSUDUMP DD  DUMMY",
    ]


def build_deck(config, trni: Path, redact_password: bool) -> str:
    source = core.full_dsn(config, config["datasets"]["SOURCE"])
    asm = core.full_dsn(config, config["datasets"]["ASM"])
    intcode = core.full_dsn(config, config["datasets"]["INTCODE"])
    load = core.full_dsn(config, config["datasets"]["LOAD"])

    lines = core.authenticated_job_card(
        config,
        "CAMBINST",
        "CAMBRIDGE INSTALL",
        redact_password=redact_password,
    )
    lines.extend([
        "//* ONE-TIME RESIDENT CAMBRIDGE COMPILER INSTALLATION",
        "//* CAMBRIDGE REMAINS INTCODE EXECUTED BY ICINT V19.",
        "//* GIT/HOST SOURCES ARE COPIED TO HERC02.BCPL.SOURCE.",
    ])

    n = 0
    for member, path in SOURCE_MEMBERS:
        n += 1
        lines.extend(put_member(f"S{n:03d}", source, member, path))

    n += 1
    lines.extend(put_member(f"S{n:03d}", asm, "ICINT19", ROOT / "asm" / "icintv19.asm"))

    for member, path in BASE_INTCODE:
        n += 1
        lines.extend(put_member(f"S{n:03d}", intcode, member, path))

    n += 1
    lines.extend(put_member(f"S{n:03d}", intcode, "TRNILRG", trni))

    lines.extend([
        "//* ASSEMBLE ICINT V19 ONCE",
        "//ASM      EXEC PGM=IFOX00,",
        "//             PARM='OBJECT,NODECK,NOLIST,NOXREF',REGION=256K",
        "//SYSLIB   DD  DSN=SYS1.MACLIB,DISP=SHR",
        "//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))",
        "//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))",
        "//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))",
        "//SYSPRINT DD  SYSOUT=*",
        "//SYSPUNCH DD  DUMMY",
        "//SYSGO    DD  DSN=&&ICOBJ,UNIT=SYSDA,SPACE=(80,(300,100)),",
        "//             DISP=(NEW,PASS)",
        f"//SYSIN    DD  DSN={asm}(ICINT19),DISP=SHR",
        "//* LINK ICINT V19 INTO THE PERSISTENT PROJECT LOAD LIBRARY",
        "//LKED     EXEC PGM=IEWL,PARM='LET,NCAL',REGION=256K,",
        "//             COND=(4,LT,ASM)",
        "//SYSLIN   DD  DSN=&&ICOBJ,DISP=(OLD,DELETE)",
        "//         DD  *",
        "  ENTRY ICINT",
        "  NAME ICINT19(R)",
        "/*",
        f"//SYSLMOD  DD  DSN={load},DISP=SHR",
        "//SYSUT1   DD  UNIT=SYSDA,SPACE=(1024,(50,20))",
        "//SYSPRINT DD  SYSOUT=*",
    ])

    for index, (src_member, out_member) in enumerate(CAMBRIDGE_UNITS, 1):
        oc = f"&&OC{index:02d}"
        comp = f"C{index:02d}CMP"
        cg = f"C{index:02d}CG"
        lines.extend([
            f"//* COMPILE {source}({src_member}) TO OCODE",
            *runtime_common(comp, load),
            f"//INTIN    DD  DSN={intcode}(SYNI),DISP=SHR",
            f"//         DD  DSN={intcode}(TRNILRG),DISP=SHR",
            f"//         DD  DSN={intcode}(BLIBI),DISP=SHR",
            f"//         DD  DSN={intcode}(ICLIB),DISP=SHR",
            f"//SYSIN    DD  DSN={source}({src_member}),DISP=SHR",
            f"//OPTIONS  DD  DSN={source}(OPTIONS),DISP=SHR",
            f"//LIBHDR   DD  DSN={source}(LIBHDR),DISP=SHR",
            f"//SYNHDR   DD  DSN={source}(SYNHDR),DISP=SHR",
            f"//TRNHDR   DD  DSN={source}(TRNHDR),DISP=SHR",
            f"//CGHDR    DD  DSN={source}(CGHDR),DISP=SHR",
            f"//OCODE    DD  DSN={oc},UNIT=SYSDA,",
            "//             SPACE=(80,(1000,500)),",
            "//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),",
            "//             DISP=(NEW,PASS)",
            f"//* CONVERT {oc} TO PERSISTENT CAMBRIDGE INTCODE {out_member}",
            *runtime_common(cg, load),
            f"//INTIN    DD  DSN={intcode}(CGI),DISP=SHR",
            f"//         DD  DSN={intcode}(BLIBI),DISP=SHR",
            f"//         DD  DSN={intcode}(ICLIB),DISP=SHR",
            f"//SYSIN    DD  DSN={oc},DISP=(OLD,DELETE)",
            f"//INTCODE  DD  DSN={intcode}({out_member}),DISP=SHR",
        ])

    return "\n".join(lines) + "\n"


def execution_codes(report: str) -> list[int]:
    pattern = re.compile(r"EXECUTION CYCLES\s*=\s*\d+,\s*CODE\s*=\s*(-?\d+)")
    return [int(m.group(1)) for m in pattern.finditer(report.replace("\f", ""))]


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Install the persistent MVS-resident interpreted Cambridge compiler."
    )
    p.add_argument(
        "--show-jcl",
        action="store_true",
        help="print the complete generated installation JCL with password redacted",
    )
    return p


def main() -> int:
    args = parser().parse_args()
    try:
        trni = rebuild_bootstrap()
        config = core.load_config()
        deck = build_deck(config, trni, redact_password=args.show_jcl)

        if args.show_jcl:
            sys.stdout.write(deck)
            return 0

        core.require_reader_ready(config)
        job, summary = core.submit_and_wait(config, deck, max_rc=4)
        report = core.job_report(job)
        codes = execution_codes(report)
        expected = len(CAMBRIDGE_UNITS) * 2
        if len(codes) != expected:
            raise RuntimeError(
                f"JOB {job}: found {len(codes)} ICINT completion codes; expected {expected}"
            )
        bad = [(i + 1, code) for i, code in enumerate(codes) if code != 0]
        if bad:
            raise RuntimeError(f"JOB {job}: nonzero ICINT completion codes: {bad}")

        print(summary.rstrip())
        print(f"Cambridge resident installation completed as JOB {job}")
        print("  LOAD(ICINT19) installed")
        print(f"  {len(CAMBRIDGE_UNITS)} Cambridge INTCODE members installed")
        return 0
    except (core.DspalError, RuntimeError, ValueError, OSError, subprocess.CalledProcessError) as exc:
        print(f"install-cambridge-mvs: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
