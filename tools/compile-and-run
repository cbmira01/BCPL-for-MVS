#!/usr/bin/env python3
"""Operational wrapper for compile-and-run.

Keeps the historical compile-and-run implementation intact while applying
MVS execution policy to every RUNMOD step:

  * TIME=(,30) by default.
  * SYSUDUMP is discarded by default.
  * --dump restores SYSUDUMP SYSOUT=* for explicit dump collection.
"""

from __future__ import annotations

import argparse
import importlib.util
from pathlib import Path
import sys

CORE = Path(__file__).with_name("compile-and-run-core.py")
RUNMOD_TIME = "(,30)"
_dump_enabled = False


def load_core():
    spec = importlib.util.spec_from_file_location("compile_and_run_core", CORE)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {CORE}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


class DumpAction(argparse.Action):
    def __init__(self, option_strings, dest, **kwargs):
        super().__init__(option_strings, dest, nargs=0, **kwargs)

    def __call__(self, parser, namespace, values, option_string=None):
        global _dump_enabled
        _dump_enabled = True
        setattr(namespace, self.dest, True)


def main() -> int:
    core = load_core()
    original_make_parser = core.make_parser
    original_runtime_step = core.runtime_step

    def make_parser():
        parser = original_make_parser()
        parser.add_argument(
            "--dump",
            action=DumpAction,
            default=False,
            help="enable SYSUDUMP for RUNMOD steps (default: discard dumps)",
        )
        return parser

    def runtime_step(*args, **kwargs):
        text = original_runtime_step(*args, **kwargs)
        text = text.replace(
            "EXEC PGM=RUNMOD,REGION=256K,COND=(4,LT)",
            f"EXEC PGM=RUNMOD,REGION=256K,TIME={RUNMOD_TIME},COND=(4,LT)",
        )
        dump_mode = "SYSOUT=*" if _dump_enabled else "DUMMY"
        text = text.replace(
            "//SYSUDUMP DD  SYSOUT=*\n",
            f"//SYSUDUMP DD  {dump_mode}\n",
        )
        step = args[0] if args else kwargs.get("step", "RUNMOD")
        policy = (
            f"//*  {step} POLICY: CPU LIMIT 30 SEC; SYSUDUMP {dump_mode}\n"
        )
        exec_prefix = f"//{step:<8} EXEC PGM=RUNMOD"
        text = text.replace(exec_prefix, policy + exec_prefix, 1)
        return text

    core.make_parser = make_parser
    core.runtime_step = runtime_step
    return core.main()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (RuntimeError, OSError) as exc:
        print(f"compile-and-run: {exc}", file=sys.stderr)
        sys.exit(2)
