#!/usr/bin/env python3
"""Operational wrapper for compile-and-run.

Keeps the historical compile-and-run implementation intact while applying
MVS execution policy to every RUNMOD step:

  * TIME=(,30) by default.
  * SYSUDUMP is discarded by default.
  * --dump restores SYSUDUMP SYSOUT=* for explicit dump collection.
  * Both legacy and combined ICINT startup banners are recognized.
"""

from __future__ import annotations

import argparse
import importlib.util
from pathlib import Path
import re
import sys

CORE = Path(__file__).with_name("compile-and-run-core.py")
RUNMOD_TIME = "(,30)"
_dump_enabled = False


def load_core():
    spec = importlib.util.spec_from_file_location("compile_and_run_core", CORE)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {CORE}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


class DumpAction(argparse.Action):
    def __init__(self, option_strings, dest, **kwargs):
        super().__init__(option_strings, dest, nargs=0, **kwargs)

    def __call__(self, parser, namespace, values, option_string=None):
        global _dump_enabled
        _dump_enabled = True
        setattr(namespace, self.dest, True)


def main() -> int:
    core = load_core()
    original_make_parser = core.make_parser
    original_runtime_step = core.runtime_step

    def make_parser():
        parser = original_make_parser()
        parser.add_argument(
            "--dump",
            action=DumpAction,
            default=False,
            help="enable SYSUDUMP for RUNMOD steps (default: discard dumps)",
        )
        return parser

    def runtime_step(*args, **kwargs):
        text = original_runtime_step(*args, **kwargs)
        text = text.replace(
            "EXEC PGM=RUNMOD,REGION=256K,COND=(4,LT)",
            f"EXEC PGM=RUNMOD,REGION=256K,TIME={RUNMOD_TIME},COND=(4,LT)",
        )
        dump_mode = "SYSOUT=*" if _dump_enabled else "DUMMY"
        text = text.replace(
            "//SYSUDUMP DD  SYSOUT=*\n",
            f"//SYSUDUMP DD  {dump_mode}\n",
        )
        step = args[0] if args else kwargs.get("step", "RUNMOD")
        policy = (
            f"//*  {step} POLICY: CPU LIMIT 30 SEC; SYSUDUMP {dump_mode}\n"
        )
        exec_prefix = f"//{step:<8} EXEC PGM=RUNMOD"
        text = text.replace(exec_prefix, policy + exec_prefix, 1)
        return text

    def icint_starts(lines):
        return [
            index
            for index, line in enumerate(lines)
            if line.strip().startswith("INTCODE SYSTEM ENTERED")
        ]

    def interpreted_execution_codes(job_report: str):
        lines = [line.replace("\f", "") for line in job_report.splitlines()]
        starts = icint_starts(lines)
        codes = []
        code_pattern = re.compile(
            r"EXECUTION CYCLES\s*=\s*\d+,\s*CODE\s*=\s*(-?\d+)"
        )
        for position, start in enumerate(starts):
            stop = starts[position + 1] if position + 1 < len(starts) else len(lines)
            code = None
            for line in lines[start:stop]:
                match = code_pattern.search(line)
                if match is not None:
                    code = int(match.group(1))
                    break
            codes.append(code)
        return codes

    def extract_final_results(job_report: str, module_count: int) -> str:
        lines = [line.replace("\f", "") for line in job_report.splitlines()]
        starts = icint_starts(lines)
        expected = module_count * 2 + 1
        if len(starts) < expected:
            raise RuntimeError(
                "compiler pipeline did not reach final RUN step "
                f"(found {len(starts)} ICINT execution(s), expected {expected})"
            )

        start = starts[-1]
        execution_end = None
        mapstore_end = None
        for index in range(start, len(lines)):
            stripped = lines[index].strip()
            if stripped.startswith("EXECUTION CYCLES ="):
                execution_end = index
            if stripped == "*** END MAPSTORE ***":
                mapstore_end = index
                break

        if mapstore_end is not None:
            end = mapstore_end
        elif execution_end is not None:
            end = execution_end
        else:
            raise RuntimeError("final RUN output has no execution-completion record")

        return "\n".join(lines[start:end + 1]).strip("\r\n") + "\n"

    core.make_parser = make_parser
    core.runtime_step = runtime_step
    core.interpreted_execution_codes = interpreted_execution_codes
    core.extract_final_results = extract_final_results
    return core.main()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (RuntimeError, OSError) as exc:
        print(f"compile-and-run: {exc}", file=sys.stderr)
        sys.exit(2)
