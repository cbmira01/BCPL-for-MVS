#!/usr/bin/env python3
"""Read-only clean-room reconstruction preflight and exact operation preview."""
from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[2]
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from contract import (ScopeError, OPERATIONS, command_manifest, canonical_digest,
                      dataset_inventory, tracked_logicals, validate_jcl, workarea_scope)

REQUIRED_BUILD_MEMBERS = {
    'MR10_JCL': ('IC19BLD',),
    'BOOT_JCL': ('CAMBBLD', 'BLDBMAIN', 'BLIBBLD', 'BCPLDEMO', 'BCPLTIME', 'BCPLQSAM'),
}
REQUIRED_TOOLS = ('tools/clean-workarea', 'tools/datasets/dspal',
                  'tools/bootstrap/prepare-bootstrap', 'tools/mr10/compile-and-run',
                  'tools/bootstrap/compile-mvs', 'tools/mvs/job-summary',
                  'tools/mvs/dump-report-for-job')


def public_config_digest(config: dict) -> str:
    def scrub(value):
        if isinstance(value, dict):
            return {str(k): '[REDACTED]' if re.search(r'password|secret|token|credential', str(k), re.I)
                    else scrub(v) for k, v in value.items()}
        if isinstance(value, list):
            return [scrub(x) for x in value]
        return value
    return canonical_digest(scrub(config))


def run_git(root: Path, *args: str) -> str:
    p = subprocess.run(['git', '-C', str(root), *args],
                       capture_output=True, text=True, timeout=10, check=False)
    if p.returncode:
        raise RuntimeError(f'git {args[0]} failed (RC={p.returncode})')
    return p.stdout.strip()


def load_dspal_core(root: Path):
    path = root / 'tools/datasets/dspal-core.py'
    spec = importlib.util.spec_from_file_location('reconstruction_dspal_core', path)
    if spec is None or spec.loader is None:
        raise RuntimeError('cannot load dspal core')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def inspect_manifest(root: Path, cfg: dict, core):
    errors: list[str] = []
    tracked: list[tuple[str, str, str]] = []
    generated: list[tuple[str, str, str]] = []
    try:
        datasets = dataset_inventory(cfg, core.full_dsn,
                                     expected_logicals=tracked_logicals(root, core))
    except (KeyError, TypeError, ScopeError) as exc:
        return (), (), (), [str(exc)]
    for logical, spec in cfg['datasets'].items():
        for key, into in (('members', tracked), ('generated_members', generated)):
            members = spec.get(key, {})
            if not isinstance(members, dict):
                errors.append(f'Invalid mapping {logical}.{key}')
                continue
            for member, value in members.items():
                source = str(value)
                p = Path(source)
                if (not source or p.is_absolute() or '..' in p.parts or p == Path('.') or
                    p.parts[0] == '.git'):
                    errors.append(f'Unsafe source path {logical}({member})')
                    continue
                if key == 'generated_members' and not source.startswith('workarea/'):
                    errors.append(f'Generated input escapes workarea: {source}')
                if key == 'members':
                    file = root / p
                    relative = file
                    contains_link = False
                    while relative != root and relative != relative.parent:
                        if relative.is_symlink():
                            contains_link = True
                            break
                        relative = relative.parent
                    if contains_link or not file.is_file():
                        errors.append(f'Missing/unsafe tracked source: {source}')
                into.append((logical, str(member), source))
    for logical, members in REQUIRED_BUILD_MEMBERS.items():
        existing = cfg['datasets'][logical].get('members', {})
        for member in members:
            if member not in existing:
                errors.append(f'Required build JCL absent: {logical}({member})')
            else:
                file = root / existing[member]
                if file.is_file() and not file.is_symlink():
                    try:
                        validate_jcl(file.read_text(encoding='utf-8'), inventory=datasets)
                    except (UnicodeError, OSError, ScopeError) as exc:
                        errors.append(f'Unapproved JCL targets {logical}({member}): {exc}')
    return datasets, tracked, generated, errors


def inspect_workarea(root: Path):
    errors: list[str] = []
    try:
        scope = workarea_scope(root / 'workarea')
    except (OSError, ScopeError) as exc:
        errors.append(str(exc))
        scope = None
    try:
        tracked = run_git(root, 'ls-files', '--', 'workarea/').splitlines()
        if tracked != ['workarea/.gitignore']:
            errors.append('Unexpected tracked files in workarea')
    except RuntimeError as exc:
        errors.append(str(exc))
    return scope, errors


def prepare(root: Path, core, probe: bool = False) -> tuple[str, list[str]]:
    errors: list[str] = []
    try:
        git_root = run_git(root, 'rev-parse', '--show-toplevel')
        sha = run_git(root, 'rev-parse', 'HEAD')
        branch = run_git(root, 'symbolic-ref', '--short', 'HEAD')
        dirty = run_git(root, 'status', '--porcelain', '--untracked-files=normal')
        if Path(git_root).resolve() != root.resolve():
            errors.append('Project root differs from Git checkout')
        if branch != 'main':
            errors.append('Expected branch main')
        if dirty:
            errors.append('Git checkout has uncommitted or untracked changes')
    except (OSError, RuntimeError) as exc:
        errors.append(str(exc))
        sha, branch = 'UNKNOWN', 'UNKNOWN'
    try:
        cfg = core.load_config()
        inventory, tracked, generated, manifest_errors = inspect_manifest(root, cfg, core)
        errors.extend(manifest_errors)
    except Exception as exc:
        errors.append('Effective dspal configuration unavailable: ' + type(exc).__name__)
        cfg, inventory, tracked, generated = None, (), (), (),
    for path in REQUIRED_TOOLS:
        if not (root / path).is_file():
            errors.append(f'Missing reconstruction prerequisite: {path}')
    scope, work_errors = inspect_workarea(root)
    errors.extend(work_errors)
    ops_manifest = command_manifest(inventory)
    ops_digest = canonical_digest(ops_manifest)
    config_digest = public_config_digest(cfg) if cfg is not None else 'UNAVAILABLE'
    lines = [
        'CLEAN-ROOM RECONSTRUCTION — READ-ONLY PREFLIGHT / DRY-RUN',
        'No changes will be made; no JES jobs submitted; no approval requested.',
        f'Git: {sha} (branch {branch})', f'Checkout: {root}',
    ]
    if cfg is not None:
        mvs = cfg['mvs']
        lines += [
            f"Target: HLQ={str(mvs.get('hlq', '?')).upper()} batch-user={str(mvs.get('batch_user', '?')).upper()}",
            f'Effective non-secret config SHA-256: {config_digest}',
            f"Authentication: {'configured' if mvs.get('batch_password') else 'NOT configured'} (secret redacted)",
            f'Approved dataset count: {len(inventory)}',
        ]
        if not mvs.get('batch_password'):
            errors.append('MVS authentication unavailable')
    lines.append('Exact operation contract SHA-256: ' + ops_digest)
    if scope:
        lines.extend([
            f'Host cleanup scope SHA-256: {scope.fingerprint}',
            f'HOST CLEANUP: {root / "workarea"}; '
            f'{len([x for x in scope.entries if "/" not in x[0]])} top-level entries',
        ])
        for row in scope.entries:
            lines.append('  disposable: ' + json.dumps(row[0], ensure_ascii=True))
    lines.append('MANAGED MVS DATASETS TO DELETE AND RECREATE:')
    for logical, dsn in inventory:
        lines.append(f'  managed: {logical} {dsn}')
    lines.append('TRACKED SOURCE-TO-PDS MEMBER WRITES:')
    for logical, member, source in tracked:
        lines.append(f'  tracked: {logical}({member}) <- {source}')
    lines.append('GENERATED SOURCE-TO-PDS MEMBER WRITES (second population):')
    for logical, member, source in generated:
        lines.append(f'  generated: {logical}({member}) <- {source}')
    lines.append('RECONSTRUCTION OPERATIONS — EXACT ORDER / COMMAND / WRITE SCOPE:')
    for i, op in enumerate(OPERATIONS, 1):
        lines.append(f'  [{i:02d}] Guide {op.guide}: {op.name}')
        lines.append('       command: ' + ' '.join(op.command))
        lines.append('       verify: ' + op.check)
        for scope_name in op.writes:
            lines.append('       writes: ' + scope_name)
    lines += [
        'Post-submit verification: tools/mvs/job-summary PAYLOAD_JOB',
        'Post-submit verification: tools/mvs/dump-report-for-job PAYLOAD_JOB',
        'Persistent evidence writes: mvs-state/reconstruction-evidence/<new-attempt>/ (outside workarea; no secrets).',
        'Read-only pre-destructive commands: dspal purgebcpl --show-jcl; dspal initbcpl --show-jcl.',
        'Expected writes: exactly the managed MVS datasets and listed host-generated files.',
        'Excluded: regression suites, native Cambridge compiler, tape/release, Git tags, resume.',
    ]
    if probe and cfg is not None:
        try:
            for name, (ok, info) in core.cheap_status(cfg).items():
                lines.append(f"Connectivity {name}: {'READY' if ok else 'UNAVAILABLE'} ({info})")
                if not ok:
                    errors.append(f'Connectivity unavailable: {name}')
        except (OSError, ValueError, TypeError) as exc:
            errors.append('Connectivity probe failed: ' + type(exc).__name__)
    if errors:
        lines.append('BLOCKED — preflight issues:')
        lines += ['  - ' + item for item in errors]
    else:
        lines.append('READY — read-only preflight passed; no authorization or execution performed.')
    return '\n'.join(lines) + '\n', errors


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--probe', action='store_true')
    opts = parser.parse_args()
    try:
        report, errors = prepare(ROOT, load_dspal_core(ROOT), opts.probe)
        print(report, end='')
        return 2 if errors else 0
    except (OSError, RuntimeError) as exc:
        print('BLOCKED — preflight failed: ' + str(exc), file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
