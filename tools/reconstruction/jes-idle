#!/usr/bin/env python3
"""Read-only MVS 3.8J JES2 $DA idle observation; not reconstruction approval.

The live mode sends two fixed inquiry commands via the existing mvs-console
transport. No JES submission, MVS dataset writes, or runner activation.
"""
from __future__ import annotations

import argparse
from dataclasses import dataclass
import importlib.machinery
import importlib.util
from pathlib import Path
import re
import subprocess
import sys
from typing import Callable

ROOT = Path(__file__).resolve().parents[2]
MVS_CONSOLE = ROOT / "tools/mvs/mvs-console"
COMMAND = "/$DA"

# The running TK5/MVS 3.8J console on 2026-11-05 emitted the single line
#   15:20:00 /16.19.59           $HASP000 NO ACTIVE JOBS
# after /$DA. Its response is not accompanied by a separate command echo.
# The 2026-11-05 02:44:01 live guard diagnostic also observed " / 3.44.01"
# (one ASCII space after the slash) with the same exact double echo pair.
# Accept zero or one ASCII space; never generic whitespace or extra lines.
# Require precisely this time-stamped Hercules/MVS envelope and message text;
# generic $HASP000 (which is used for other JES2 command responses) is unsafe.
# Later JES2 uses $HASP612 with a separate $DA echo; retain that strict form.
# Do not infer inactivity from HTTP 200 or silence.
CLEAR = re.compile(r"\$HASP612\s+NO\s+ACTIVE\s+JOBS\s*$", re.I)
TK5_CLEAR = re.compile(
    r"^\d{2}:\d{2}:\d{2}\s+/ ?\d{1,2}\.\d{2}\.\d{2}\s+"
    r"\$HASP000\s+NO ACTIVE JOBS\s*$", re.I
)
# Hercules/TK5 was observed to repeat the identical pair of lines twice:
#   16:36:36 HHC00013I '/' input entered for console 0:0009: "$DA"
#   16:36:36 $DA
# They precede precisely one timestamped $HASP000 idle reply.
# Recognize only these fixed command echoes; never ignore arbitrary output.
TK5_TYPED_ECHO = re.compile(r"(?P<time>\d{2}:\d{2}:\d{2})\s+/?\$DA", re.I)
TK5_HERCULES_ECHO = re.compile(
    r"(?P<time>\d{2}:\d{2}:\d{2}) HHC00013I '/' input entered for console "
    r'(?P<console>[0-9A-Fa-f]+:[0-9A-Fa-f]{4}): "\$DA"', re.I
)
INCOMPLETE = re.compile(r"\$HASP611\b", re.I)
ACTIVE = re.compile(r"\$HASP(?:608|890)\b|\bJOB\s*\d{1,5}\b", re.I)
ACTIVITY = re.compile(r"\$HASP(?:100|373|395)\b", re.I)
HASP = re.compile(r"\$HASP\d{3}\b", re.I)
CMD_ECHO = re.compile(r"(?<![A-Z0-9])/?\$D\s*A\s*$", re.I)
ERROR = re.compile(r"(?:COMMAND\s+REJECTED|INVALID\s+COMMAND|UNKNOWN\s+COMMAND|NOT\s+AUTHORIZED|NOT\s+RECOGNIZED)", re.I)


@dataclass(frozen=True)
class Observation:
    state: str  # CLEAR, ACTIVE, or UNKNOWN
    reason: str
    evidence: tuple[str, ...]


def _one_second_after(before: str, after: str) -> bool:
    """Accept precisely a one-second echo timestamp shift, including midnight."""
    def seconds(value: str) -> int | None:
        try:
            hour, minute, second = map(int, value.split(':'))
        except ValueError:
            return None
        if not (0 <= hour < 24 and 0 <= minute < 60 and 0 <= second < 60):
            return None
        return hour * 3600 + minute * 60 + second

    first, second = seconds(before), seconds(after)
    return first is not None and second is not None and (second - first) % 86400 == 1


def recognized_tk5_echoes(before: list[str]) -> bool:
    """Recognize zero, one or two exact Hercules/console $DA echo pairs.

    A real TK5 capture (2026-11-06) showed two identical HHC00013I
    envelopes with the second typed $DA echoed one second later.
    Permit only that bounded rollover; never ignore unrelated lines.
    """
    if not before:
        return True
    if len(before) == 1:
        return TK5_TYPED_ECHO.fullmatch(before[0]) is not None
    if len(before) not in (2, 4):
        return False

    pairs = []
    for i in range(0, len(before), 2):
        sent = TK5_HERCULES_ECHO.fullmatch(before[i])
        echoed = TK5_TYPED_ECHO.fullmatch(before[i + 1])
        if not sent or not echoed:
            return False
        pairs.append((sent, echoed))

    first_sent, first_echo = pairs[0]
    if first_sent.group('time') != first_echo.group('time'):
        return False
    if len(pairs) == 1:
        return True

    second_sent, second_echo = pairs[1]
    if before[0] != before[2]:  # exact command, console and Hercules timestamp
        return False
    first_time = first_echo.group('time')
    second_time = second_echo.group('time')
    return (second_time == first_time or
            _one_second_after(first_time, second_time))


def parse_delta(delta: str, transport_rc: int = 0) -> Observation:
    """Classify only a *fresh* delta returned by mvs-console.capture('/$DA').

    This parser intentionally recognizes very little. An unfamiliar console
    format is a BLOCKED result, not permission to perform destructive work.
    """
    if transport_rc != 0:
        return Observation("UNKNOWN", "console transport failed", ())
    lines = [line.strip() for line in delta.splitlines() if line.strip()]
    messages = tuple(line for line in lines if HASP.search(line))
    if not lines:
        return Observation("UNKNOWN", "no console messages captured", ())
    if any(INCOMPLETE.search(line) for line in lines):
        return Observation("UNKNOWN", "JES2 reported an incomplete active-job list", messages)
    if any(ERROR.search(line) for line in lines):
        return Observation("UNKNOWN", "console inquiry was rejected or unrecognized", messages)
    if any(ACTIVITY.search(line) for line in lines):
        return Observation("UNKNOWN", "concurrent JES2 job activity observed", messages)
    if any(ACTIVE.search(line) for line in lines):
        return Observation("ACTIVE", "active batch job reported", messages)
    hasp = [line for line in lines if HASP.search(line)]
    clear = [line for line in hasp if CLEAR.search(line)]
    # The response may be preceded by one typed command echo, or by one
    # or two identical Hercules/console echo pairs. Anything else blocks.
    tk5 = [(i, line) for i, line in enumerate(lines) if TK5_CLEAR.fullmatch(line)]
    if len(hasp) == 1 and len(tk5) == 1:
        reply_index, _ = tk5[0]
        if reply_index == len(lines) - 1 and recognized_tk5_echoes(lines[:reply_index]):
            return Observation("CLEAR", "fresh TK5 $HASP000 NO ACTIVE JOBS response", messages)
        return Observation(
            "UNKNOWN",
            f"TK5 idle reply accompanied by unrecognized console line(s) "
            f"({len(lines) - 1} non-reply line(s))",
            messages,
        )
    if len(hasp) != 1 or len(clear) != 1:
        return Observation(
            "UNKNOWN",
            f"missing or ambiguous $DA idle response ({len(lines)} console line(s), "
            f"{len(hasp)} $HASP message(s))",
            messages,
        )
    # For $HASP612 retain the stronger explicit command-echo requirement.
    first_reply = next(i for i, line in enumerate(lines) if CLEAR.search(line))
    if not any(CMD_ECHO.search(line) for line in lines[:first_reply]):
        return Observation("UNKNOWN", "no correlated preceding $DA command echo", messages)
    return Observation("CLEAR", "fresh $HASP612 NO ACTIVE JOBS response", messages)


def load_mvs_console(path: Path = MVS_CONSOLE):
    """Reuse the existing fixed-command Hercules console transport."""
    loader = importlib.machinery.SourceFileLoader("reconstruction_jes_console", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError("cannot load mvs-console transport")
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    before = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        loader.exec_module(module)
    finally:
        sys.dont_write_bytecode = before
    return module


def check_twice(capture: Callable[[str], tuple[int, str]]) -> tuple[bool, list[Observation]]:
    """Point-in-time inquiry only; no lock on incoming JES submissions."""
    observations = []
    for _ in range(2):
        rc, delta = capture(COMMAND)
        result = parse_delta(delta, rc)
        observations.append(result)
        if result.state != "CLEAR":
            return False, observations
    return True, observations


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--live", action="store_true", help="send two fixed, read-only $DA console inquiries")
    mode.add_argument("--parse-file", type=Path, help="inspect a saved fresh console response offline")
    parser.add_argument(
        "--diagnose", action="store_true",
        help="on a blocked --live check, print escaped raw console deltas; "
             "may include sensitive console contents, review before sharing",
    )
    opts = parser.parse_args(argv)
    raw_deltas: list[str] = []
    try:
        if opts.parse_file:
            obs = parse_delta(opts.parse_file.read_text(encoding="utf-8"))
            print(f"{obs.state}: {obs.reason}")
            for evidence in obs.evidence:
                print("  " + evidence)
            print("Offline transcript parsing is not a live JES-idle verification.")
            return 0 if obs.state == "CLEAR" else 2
        mod = load_mvs_console()
        def capture_sample(cmd: str) -> tuple[int, str]:
            rc, delta = mod.capture(cmd, timeout=10.0, settle=2.0)
            raw_deltas.append(delta)
            return rc, delta

        ok, observations = check_twice(capture_sample)
        for i, obs in enumerate(observations, 1):
            print(f"JES2 $DA sample {i}/2: {obs.state} — {obs.reason}")
            for evidence in obs.evidence:
                print("  " + evidence)
        if ok:
            print("Two fresh idle responses observed; this is not exclusive control of JES submissions.")
            print("This idle result alone does not authorize reconstruction; --run requires a fresh interactive scoped approval.")
            return 0
        if opts.diagnose:
            print("DIAGNOSTIC ONLY — raw console content may contain sensitive data.")
            for i, delta in enumerate(raw_deltas, 1):
                print(f"Raw JES2 $DA sample {i}: {delta!r}")
        print("BLOCKED: active/unknown JES2 state; no reconstruction actions performed.", file=sys.stderr)
        return 2
    except (OSError, RuntimeError, ValueError, UnicodeError, subprocess.TimeoutExpired) as exc:
        # Transport exceptions may include credentials or connection secrets.
        print("BLOCKED: JES2 inquiry failed: " + type(exc).__name__, file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
