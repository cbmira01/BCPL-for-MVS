#!/usr/bin/env bash
# Run the clean-room rebuild guide from the beginning. No resume support.
# This script does not run regression suites or inspect the JES console.
# --unattended explicitly authorizes cleanup/purge and skips all checkpoints.
set +e
set +u
set +o pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
if [ -z "$ROOT" ] || ! cd "$ROOT"; then
    printf 'BLOCKED: cannot enter repository root.\n' >&2
    exit 2
fi

UNATTENDED=0
BATCH_POPULATE=0

run() {
    printf '\n> '
    printf '%q ' "$@"
    printf '\n'
    local start_seconds=$SECONDS
    "$@"
    local rc=$?
    printf 'Command RC=%s; elapsed=%ss\n' "$rc" "$((SECONDS - start_seconds))"
    return "$rc"
}

# Both first-pass operations report RC=2 when precisely 12 generated
# members are absent. Do not mistake another RC=2 (e.g. an error) for success.
first_population() {
    local mode="$1" log missing rc
    local -a statuses
    log=$(mktemp "${TMPDIR:-/tmp}/bcpl-first-populate.XXXXXXXX") || return 2
    local -a options=()
    if [ "$mode" = dry-run ]; then
        options+=(--dry-run)
    elif [ "$BATCH_POPULATE" -eq 1 ]; then
        options+=(--batch)
    fi
    run tools/datasets/dspal populate all "${options[@]}" 2>&1 | tee "$log"
    statuses=("${PIPESTATUS[@]}")
    rc=${statuses[0]}
    if [ "${statuses[1]}" -ne 0 ]; then
        printf 'ERROR: failed to retain population output.\n' >&2
        rc=2
    elif [ "$rc" -eq 2 ]; then
        missing=$(grep -c '^  MISSING GENERATED: ' "$log")
        if [ "$missing" -eq 12 ] &&
           grep -q '^dspal: 12 generated member(s) unavailable;' "$log" &&
           { if [ "$mode" = dry-run ]; then
                 grep -Eq '^Dry run: [1-9][0-9]* ready member\(s\) would be written\.$' "$log"
             else
                 grep -Eq '^populate completed: [1-9][0-9]* ready member\(s\) written$' "$log"
             fi; }; then
            printf 'Expected first-pass RC=2: 12 generated members missing; ready members %s.\n' \
                "$([ "$mode" = dry-run ] && printf 'planned' || printf 'written')"
            rc=0
        else
            printf 'ERROR: first-pass RC=2 did not match expected missing-generated evidence.\n' >&2
        fi
    fi
    rm -f -- "$log"
    return "$rc"
}

confirm() {
    local reply
    printf '\n%s\n' "$1"
    if [ "$UNATTENDED" -eq 1 ]; then
        printf 'UNATTENDED: checkpoint acknowledged by --unattended.\n'
        return 0
    fi
    printf '%s' 'hit ENTER to continue, Ctrl-C to stop: '
    IFS= read -r reply || return 1
    [ -z "$reply" ]
}

step0() {
    run git status --short || return $?
    run git pull --ff-only || return $?
    run git rev-parse HEAD || return $?
    run tools/mvs/start-tk5 --detached || return $?
    run tools/datasets/dspal status --probe || return $?
    run tools/datasets/dspal info || return $?
    run tools/bootstrap/prepare-bootstrap --check-inputs || return $?
}

step1() {
    if [ "$UNATTENDED" -eq 1 ]; then
        run tools/clean-workarea --yes || return $?
    else
        run tools/clean-workarea || return $?
    fi
    run git status --short || return $?
}

step2() {
    run tools/datasets/dspal purgebcpl --show-jcl || return $?
    if [ "$UNATTENDED" -eq 1 ]; then
        run tools/datasets/dspal purgebcpl --yes || return $?
    else
        run tools/datasets/dspal purgebcpl || return $?
    fi
    run tools/datasets/dspal initbcpl --show-jcl || return $?
    run tools/datasets/dspal initbcpl || return $?
    run tools/datasets/dspal stat || return $?
    first_population dry-run || return $?
    first_population install || return $?
    # One JES inventory replaces nine separate member-listing jobs.
    run tools/datasets/dspal ls || return $?
}

step3() {
    run tools/datasets/dspal submit MR10_JCL IC19BLD || return $?
    run tools/datasets/dspal ls MR10_LOAD || return $?
    run tools/datasets/dspal ls MR10_OBJ || return $?
    run tools/mr10/compile-and-run --installed-icint MR10_LOAD --results \
        mr10-kit-compiler/tests/00-regression-panel/data-movement/scalar-vector.bcpl || return $?
}

step5() {
    run tools/bootstrap/prepare-bootstrap --with-trnilrg || return $?
    run cat workarea/bootstrap-cambridge/prepare-bootstrap-manifest.json || return $?
    run tools/datasets/dspal populate all --generated-only --dry-run || return $?
    local -a options=(--generated-only)
    if [ "$BATCH_POPULATE" -eq 1 ]; then
        options+=(--batch)
    fi
    run tools/datasets/dspal populate all "${options[@]}" || return $?
    run tools/datasets/dspal ls BOOT_SOURCE || return $?
    run tools/datasets/dspal ls BOOT_INTCODE || return $?
}

step6() {
    run tools/datasets/dspal submit BOOT_JCL CAMBBLD || return $?
    run tools/datasets/dspal ls BOOT_INTCODE || return $?
    run tools/bootstrap/compile-mvs \
        tests/bootstrap/00-most-degenerate-bcpl-program/source.bcpl \
        --output workarea/m3-clean-smoke.s370.asm || return $?
    run test -s workarea/m3-clean-smoke.s370.asm || return $?
}

step7() {
    run tools/datasets/dspal ls BOOT_ASM || return $?
    run tools/datasets/dspal ls BOOT_JCL || return $?
    run tools/datasets/dspal ls BOOT_OBJ || return $?
    run tools/datasets/dspal submit BOOT_JCL BLDBMAIN || return $?
    run tools/datasets/dspal ls BOOT_OBJ || return $?
}

step8() {
    run tools/datasets/dspal submit BOOT_JCL BLIBBLD || return $?
    run tools/datasets/dspal ls BOOT_OBJ || return $?
    run tools/datasets/dspal ls BOOT_DEVOBJ || return $?
}

step9() {
    local name
    # Preserve installed-object visibility with one consolidated inventory.
    run tools/datasets/dspal ls || return $?
    for name in BCPLDEMO BCPLTIME BCPLQSAM; do
        run tools/datasets/dspal submit BOOT_JCL "$name" || return $?
        confirm "Inspect $name payload JES job (RC, IFOX severity, IEBCOMPR) before another installation." || return 3
    done
    run tools/datasets/dspal ls EXT_OBJ || return $?
}

main() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            --unattended)
                if [ "$UNATTENDED" -eq 1 ]; then
                    printf 'ERROR: duplicate --unattended option.\n' >&2
                    return 2
                fi
                UNATTENDED=1
                ;;
            --batch-populate)
                if [ "$BATCH_POPULATE" -eq 1 ]; then
                    printf 'ERROR: duplicate --batch-populate option.\n' >&2
                    return 2
                fi
                BATCH_POPULATE=1
                ;;
            *)
                printf 'Usage: tools/reconstruction/rebuild-from-source [--unattended] [--batch-populate] (always starts at Step 0)\n' >&2
                return 2
                ;;
        esac
    done
    if [ "$UNATTENDED" -eq 0 ] && [ ! -t 0 ]; then
        printf 'BLOCKED: an interactive terminal is required for operator confirmations.\n' >&2
        return 2
    fi
    printf 'CLEAN-ROOM REBUILD: always starts at Step 0; rerun means another full purge/rebuild.\n'
    printf 'No resume, script-wide approval, JES console probe, or regression suites.\n'
    if [ "$BATCH_POPULATE" -eq 1 ]; then
        printf 'POPULATION MODE: bounded per-PDS IEBGENER batching (opt-in).\n'
        printf 'This option does not authorize a rebuild, certify release, or change regressions.\n'
    else
        printf 'POPULATION MODE: one JES job per member (default).\n'
    fi
    if [ "$UNATTENDED" -eq 1 ]; then
        printf 'UNATTENDED: workarea cleanup and managed-dataset deletion are explicitly authorized.\n'
        printf 'No confirmation prompts; any command failure still stops the rebuild.\n'
    else
        printf 'Existing tools will ask for DELETE and YES where appropriate.\n'
    fi
    local id rc step_start
    for id in 0 1 2 3 5 6 7 8 9; do
        confirm "Guide Step $id — begin?" || {
            printf 'STOPPED before Guide Step %s.\n' "$id"
            return 3
        }
        step_start=$SECONDS
        "step$id"
        rc=$?
        printf 'Guide Step %s elapsed=%ss; RC=%s\n' \
            "$id" "$((SECONDS - step_start))" "$rc"
        if [ "$rc" -ne 0 ]; then
            printf 'STOPPED: Guide Step %s returned RC=%s. Rerun starts at Step 0.\n' "$id" "$rc" >&2
            return "$rc"
        fi
        printf '\nGuide Step %s commands completed. Inspect output before continuing.\n' "$id"
    done
    printf '\nREBUILD COMMANDS COMPLETED. Save build evidence separately.\n'
    printf 'No regression acceptance claimed; run regression workflow separately.\n'
}

main "$@"
