#!/usr/bin/env python3
"""Interactive, in-memory reconstruction approval gate; no execution path.

The eventual runner must call request_approval() in its own process and
verify_approval() before starting approved destructive operations. This
standalone command only exercises the prompt and discards its result.
"""
from __future__ import annotations

import argparse
from dataclasses import dataclass
import hashlib
import importlib.machinery
from pathlib import Path
import re
import sys
from typing import Callable, TextIO

ROOT = Path(__file__).resolve().parents[2]
PLAN_PATH = ROOT / "tools/reconstruction/plan"


@dataclass(frozen=True)
class ApprovedPlan:
    """Ephemeral grant for one displayed plan within the current process."""
    digest: str
    git_sha: str
    hlq: str


class ApprovalError(RuntimeError):
    """Approval refused. Code 2 means blocked, 3 means declined."""
    def __init__(self, message: str, code: int = 2):
        super().__init__(message)
        self.code = code


def digest_report(report: str) -> str:
    return hashlib.sha256(report.encode("utf-8")).hexdigest()


def identity(report: str) -> tuple[str, str]:
    if not report.startswith("CLEAN-ROOM RECONSTRUCTION — READ-ONLY PREFLIGHT / DRY-RUN\n"):
        raise ApprovalError("preview header not recognized")
    if "\nREADY — read-only preflight passed; no authorization or execution performed.\n" not in report:
        raise ApprovalError("preview does not contain a successful preflight result")
    match_git = re.search(r"^Git: ([0-9a-f]{40}) \(branch main\)$", report, re.M)
    match_target = re.search(r"^Target: HLQ=([A-Z@$#][A-Z0-9@$#]{0,7}) batch-user=", report, re.M)
    match_config = re.search(r"^Effective non-secret config SHA-256: ([0-9a-f]{64})$", report, re.M)
    if not match_git or not match_target or not match_config:
        raise ApprovalError("preview lacks verified Git, target or configuration identity")
    return match_git.group(1), match_target.group(1)


def verify_approval(approval: ApprovedPlan,
                    planner: Callable[[], tuple[str, list[str]]]) -> None:
    """Refuse a stale approval. Call immediately before destructive execution."""
    report, errors = planner()
    if errors:
        raise ApprovalError("preflight changed to BLOCKED after acknowledgment")
    sha, hlq = identity(report)
    if (digest_report(report), sha, hlq) != (approval.digest, approval.git_sha, approval.hlq):
        raise ApprovalError("reconstruction scope changed since acknowledgment; review again")


def request_approval(planner: Callable[[], tuple[str, list[str]]],
                     *, output: TextIO,
                     read_line: Callable[[str], str],
                     interactive: bool) -> ApprovedPlan:
    """Preview, ask once, recheck scope, and return an in-memory grant only."""
    report, errors = planner()
    output.write(report)
    output.flush()
    if errors:
        raise ApprovalError("preflight BLOCKED; no acknowledgment requested")
    sha, hlq = identity(report)
    if not interactive:
        raise ApprovalError("interactive WSL terminal required; piped approval refused")

    fingerprint = digest_report(report)
    phrase = f"REBUILD {hlq} {fingerprint[:12]}"
    output.write("\nONE-RUN SCOPE ACKNOWLEDGMENT\n")
    output.write("This acknowledgment is specific to the displayed plan, target and Git revision.\n")
    output.write("It is not saved and cannot be used by a separate process.\n")
    output.write(f"Type exactly: {phrase}\n")
    output.flush()
    try:
        response = read_line("Acknowledgment (or Enter to cancel): ")
    except (EOFError, KeyboardInterrupt):
        raise ApprovalError("operator acknowledgment cancelled", code=3) from None
    if response != phrase:
        raise ApprovalError("operator acknowledgment not exact; cancelled", code=3)

    approval = ApprovedPlan(fingerprint, sha, hlq)
    verify_approval(approval, planner)
    return approval


def load_plan():
    """Load the extensionless planner without writing Python bytecode."""
    old = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        loader = importlib.machinery.SourceFileLoader("reconstruction_plan", str(PLAN_PATH))
        import types
        module = types.ModuleType(loader.name)
        module.__file__ = str(PLAN_PATH)
        loader.exec_module(module)
        return module
    finally:
        sys.dont_write_bytecode = old


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--probe", action="store_true", help="read-only Docker/TCP readiness checks")
    args = parser.parse_args()
    print("APPROVAL PROMPT EXERCISE ONLY — execution is not implemented.", flush=True)
    try:
        plan = load_plan()
        core = plan.load_dspal_core(ROOT)
        planner = lambda: plan.prepare(ROOT, core, probe=args.probe)
        request_approval(planner, output=sys.stdout,
                         read_line=input, interactive=sys.stdin.isatty())
    except ApprovalError as exc:
        print(f"NOT APPROVED: {exc}", file=sys.stderr)
        return exc.code
    except (OSError, RuntimeError) as exc:
        print(f"NOT APPROVED: preflight error: {type(exc).__name__}", file=sys.stderr)
        return 2
    print("ACKNOWLEDGMENT VERIFIED (exercise only).", flush=True)
    print("No approval persisted; no reconstruction was authorized or executed.", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
