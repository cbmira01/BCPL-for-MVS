#!/usr/bin/env python3
"""One-shot, scope-authorized reconstruction stage engine.

No resume/checkpoints, regression, or release side effects. Live MVS
mutation requires a fresh interactive review and exact one-run approval.
"""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys
from typing import Callable
from functools import wraps

ROOT = Path(__file__).resolve().parents[2]
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from contract import (ScopeError, OPERATIONS, command_manifest, canonical_digest,
                      dataset_inventory, tracked_logicals, validate_jcl, workarea_scope)
from evidence import EvidenceLog
from verify import (VerificationError, parse_submission, verify_payload,
                    inventory_members, required_inventory, CODE_RECORD)
sys.path.insert(0, str(ROOT / 'tools/mvs'))
from jes_submission_gate import controller_window, child_pass_fds


class ReconstructionError(RuntimeError):
    pass


def assert_source(root: Path, plan, grant, core, *, first=False):
    """Validate immutable source/configuration/operations before each operation."""
    if plan.run_git(root, 'rev-parse', 'HEAD') != grant.git_sha:
        raise ReconstructionError('Git revision changed after approval')
    if plan.run_git(root, 'symbolic-ref', '--short', 'HEAD') != 'main':
        raise ReconstructionError('not on main')
    if plan.run_git(root, 'status', '--porcelain', '--untracked-files=normal'):
        raise ReconstructionError('working tree changed after approval')
    cfg = core.load_config()
    if plan.public_config_digest(cfg) != grant.config_digest:
        raise ReconstructionError('effective non-secret configuration changed')
    inv = dataset_inventory(cfg, core.full_dsn,
                            expected_logicals=tracked_logicals(root, core))
    if inv != grant.managed_dsns:
        raise ReconstructionError('managed dataset inventory changed after approval')
    if canonical_digest(command_manifest(inv)) != grant.operation_digest:
        raise ReconstructionError('reconstruction operation contract changed after approval')
    if first and not cfg['mvs'].get('batch_password'):
        raise ReconstructionError('MVS authentication not configured')
    return cfg


def require_jes_clear(guard) -> None:
    """Only exact two-observation, verified CLEAR is acceptable.

    bool, integer RC, None and accidental truthy results are never sufficient.
    The guard must return the existing jes-idle.check_twice() result shape.
    """
    try:
        result = guard()
    except Exception as exc:
        raise ReconstructionError('JES idle safeguard failed') from exc
    if (not isinstance(result, tuple) or len(result) != 2 or
        result[0] is not True or not isinstance(result[1], list) or
        len(result[1]) != 2 or
        any(getattr(obs, 'state', None) != 'CLEAR' for obs in result[1])):
        raise ReconstructionError('JES idle safeguard did not verify two CLEAR observations')


def _rc0(rc: int, name: str):
    if type(rc) is not int or rc != 0:
        raise ReconstructionError(f'{name}: required subprocess RC=0, got {rc!r}')


def _payload_number_from_output(output: str) -> int | None:
    nums = re.findall(r'^Payload:\s*JOB\s+(\d+)\s*$', output, re.M)
    return int(nums[0]) if len(nums) == 1 else None


class Runner:
    def __init__(self, root: Path, *, run_command: Callable[[list[str]], tuple[int, str]],
                 emit: Callable[[str], None], plan, core, approval, grant,
                 planner: Callable[[], tuple[str, list[str]]], evidence: EvidenceLog):
        self.root = root
        self.command = run_command
        self.emit = emit
        self.plan = plan
        self.core = core
        self.approval = approval
        self.grant = grant
        self.planner = planner
        self.evidence = evidence

    def read_only_preview(self, mode: str) -> str:
        command = ['tools/datasets/dspal', mode, '--show-jcl']
        rc, output = self.command(command)
        self.evidence.detail(0, f'{mode}-preview', output)
        _rc0(rc, f'{mode} JCL preview')
        return output

    def verify_destructive_deck(self, mode: str):
        preview = self.read_only_preview(mode)
        approved = {dsn for _, dsn in self.grant.managed_dsns}
        if mode == 'purgebcpl':
            dsns = re.findall(r"^ DELETE '([A-Z0-9.$@#]+)'$", preview, re.M)
            if len(dsns) != len(approved) or set(dsns) != approved:
                raise ReconstructionError('purge JCL does not match the exact approved DSNs')
        elif mode == 'initbcpl':
            dsns = re.findall(r'^//D\d{3}\s+DD\s+DSN=([A-Z0-9.$@#]+),\s*$', preview, re.M)
            if len(dsns) != len(approved) or set(dsns) != approved:
                raise ReconstructionError('init JCL does not match the exact approved DSNs')
        else:
            raise ReconstructionError('unknown destructive deck')

    def verify_bootstrap(self, config: dict):
        manifest = self.root / 'workarea/bootstrap-cambridge/prepare-bootstrap-manifest.json'
        if not manifest.is_file():
            raise ReconstructionError('bootstrap manifest not generated')
        data = json.loads(manifest.read_text(encoding='utf-8'))
        if data.get('trnilrg_rebuilt') is not True:
            raise ReconstructionError('TRNILRG was not rebuilt in this attempt')
        if not ((self.root / 'workarea/bootstrap-cambridge/trni-large-names.int').is_file() and
                (self.root / 'workarea/bootstrap-cambridge/trni-large-names.int').stat().st_size > 0):
            raise ReconstructionError('TRNILRG image is missing')
        # The exact generated-source map remains in dspal.yaml.  Cross-check
        # all files and their content against the manifest's SHA-256 inventory.
        files = data.get('outputs')
        inputs = data.get('inputs')
        if not isinstance(files, dict) or not isinstance(inputs, dict) or data.get('format') != 1:
            raise ReconstructionError('bootstrap SHA-256 input/output inventory is missing')
        for source, sha in inputs.items():
            if (not isinstance(source, str) or Path(source).is_absolute() or '..' in Path(source).parts or
                not isinstance(sha, str) or not re.fullmatch(r'[0-9a-f]{64}', sha)):
                raise ReconstructionError('bootstrap input manifest has an unsafe path or hash')
            path = self.root / source
            if (not path.is_file() or path.is_symlink() or
                hashlib.sha256(path.read_bytes()).hexdigest() != sha):
                raise ReconstructionError(f'bootstrap input hash mismatch: {source}')
        for rel, sha in files.items():
            if (not isinstance(rel, str) or not rel.startswith('workarea/bootstrap-cambridge/') or
                Path(rel).is_absolute() or '..' in Path(rel).parts or
                not isinstance(sha, str) or not re.fullmatch(r'[0-9a-f]{64}', sha)):
                raise ReconstructionError('bootstrap output manifest contains invalid path or digest')
            path = self.root / rel
            if (path.is_symlink() or not path.is_file() or not path.stat().st_size or
                hashlib.sha256(path.read_bytes()).hexdigest() != sha):
                raise ReconstructionError(f'bootstrap generated output invalid: {rel}')
        for spec in config['datasets'].values():
            if not spec.get('populate', False):
                continue
            for source in spec.get('generated_members', {}).values():
                rel = str(source)
                file = self.root / rel
                if not file.is_file() or file.is_symlink() or not file.stat().st_size:
                    raise ReconstructionError(f'generated input absent: {rel}')
                expected = files.get(rel)
                if expected != hashlib.sha256(file.read_bytes()).hexdigest():
                    raise ReconstructionError(f'generated source hash is not verified: {rel}')

    def validate(self, index: int, op, rc: int, output: str,
                 *, config: dict) -> tuple[int | None, int | None]:
        if op.check == 'first-populate':
            generated = {
                f'{logical}({member}) <- {source}'
                for logical, spec in config['datasets'].items()
                if spec.get('populate', False)
                for member, source in spec.get('generated_members', {}).items()
            }
            tracked = sum(len(spec.get('members', {})) for spec in config['datasets'].values()
                          if spec.get('populate', False))
            missing = set(re.findall(r'^\s*MISSING GENERATED:\s*(.+)$', output, re.M))
            if (rc != 2 or missing != generated or not re.search(
                rf'populate completed:\s*{tracked}\s+ready member\(s\) written', output)):
                raise ReconstructionError('first population did not match exact generated-missing contract')
            return None, None
        _rc0(rc, op.name)
        if op.check == 'cleanup':
            if workarea_scope(self.root / 'workarea').entries:
                raise ReconstructionError('workarea cleanup left generated host files')
        elif op.check == 'allocated-inventory':
            found = re.findall(r'^Dataset:\s+([A-Z0-9.$@#]+) \(([A-Z0-9_]+)\)\s*$', output, re.M)
            if (len(found) != len(self.grant.managed_dsns) or
                set((logical, dsn) for dsn, logical in found) != set(self.grant.managed_dsns)):
                raise ReconstructionError('post-init managed inventory is incomplete or ambiguous')
            for logical, dsn in self.grant.managed_dsns:
                expected = config['datasets'][logical]
                block = re.search(r'^Dataset:\s+' + re.escape(dsn) + r' \(' + re.escape(logical) +
                                  r'\)\s*\n([^\n]+)', output, re.M)
                if block is None or 'Missing' in block.group(1):
                    raise ReconstructionError(f'allocated dataset missing: {dsn}')
                for key in ('dsorg', 'recfm', 'lrecl', 'blksize'):
                    value = str(expected.get(key, ''))
                    if not value or re.search(r'\b' + key.upper() + r':' + re.escape(value.upper()) + r'\b', block.group(1)) is None:
                        raise ReconstructionError(f'allocated dataset attribute mismatch: {dsn} {key}')
        elif op.check in ('purge', 'init'):
            # The approved full inventory is validated just before each job.
            pass
        elif op.check == 'bootstrap':
            self.verify_bootstrap(config)
        elif op.check == 'generated-populate':
            generated = sum(len(spec.get('generated_members', {})) for spec in config['datasets'].values()
                            if spec.get('populate', False))
            if not re.search(rf'populate completed:\s*{generated}\s+ready member\(s\) written', output):
                raise ReconstructionError('generated-only population count not verified')
        elif op.check in ('icint-members', 'trni-members', 'cambridge-members',
                          'runtime-members', 'extensions-members',
                          'devobj-empty', 'extension-empty'):
            logical = op.command[-1]
            dsn = dict(self.grant.managed_dsns)[logical]
            members = inventory_members(output, dsn)
            key = {'icint-members': logical,
                   'trni-members': 'BOOT_INTCODE_TRNI',
                   'cambridge-members': 'BOOT_INTCODE_COMPLETE',
                   'runtime-members': 'BOOT_OBJ',
                   'extensions-members': 'EXT_OBJ',
                   'devobj-empty': 'BOOT_DEVOBJ',
                   'extension-empty': 'BOOT_DEVOBJ'}[op.check]
            if op.check == 'extension-empty':
                if members:
                    raise ReconstructionError('EXT_OBJ was not empty after fresh population')
            else:
                required_inventory(key, members)
        elif op.check in ('code-zero', 'asm-smoke'):
            if len(CODE_RECORD.findall(output)) != 1:
                raise ReconstructionError('expected exactly one interpreter CODE=0')
            if op.check == 'asm-smoke':
                asm = self.root / 'workarea/m3-clean-smoke.s370.asm'
                if not asm.is_file() or not asm.stat().st_size:
                    raise ReconstructionError('CAMBCOMP smoke did not generate assembler')
                source = asm.read_text(encoding='ascii', errors='replace')
                for token in ('CSECT', 'EXTRN BCPLMAIN', 'END'):
                    if token not in source:
                        raise ReconstructionError(f'assembler output lacks {token}')
        if op.check in ('icint', 'cambridge', 'runtime', 'blib',
                        'bcpldemo', 'bcpltime', 'bcplqsam'):
            member = op.command[-1]
            launcher, payload = parse_submission(output, member=member)
            s_rc, summary = self.command(['tools/mvs/job-summary', str(payload), '--max-rc', '0'])
            self.evidence.detail(index, 'payload-summary', summary)
            _rc0(s_rc, 'payload job-summary')
            d_rc, detail = self.command(['tools/mvs/dump-report-for-job', str(payload)])
            self.evidence.detail(index, 'payload-report', detail)
            _rc0(d_rc, 'payload full report')
            verify_payload(member, payload, launcher, summary, detail)
            return launcher, payload
        return None, None

    def run(self):
        """Callable only with an in-process grant and an accepted JES guard."""
        try:
            self.approval.verify_approval(self.grant, self.planner)
            assert_source(self.root, self.plan, self.grant, self.core, first=True)
            for i, op in enumerate(OPERATIONS, 1):
                cfg = assert_source(self.root, self.plan, self.grant, self.core)
                self.emit(f'[{i:02d}/{len(OPERATIONS)}] Guide {op.guide}: {op.name}')
                output = ''
                rc = None
                launcher = payload = None
                try:
                    if op.check == 'cleanup':
                        current = workarea_scope(self.root / 'workarea')
                        if current.fingerprint != self.grant.cleanup_digest:
                            raise ReconstructionError('host-cleanup scope changed after acknowledgment')
                    if op.check == 'purge':
                        self.verify_destructive_deck('purgebcpl')
                    if op.check == 'init':
                        self.verify_destructive_deck('initbcpl')
                    cmd = list(op.command)
                    if op.check == 'cleanup':
                        cmd += ['--reconstruction-scope', self.grant.cleanup_digest]
                    rc, output = self.command(cmd)
                    if op.check in ('icint', 'cambridge', 'runtime', 'blib',
                                    'bcpldemo', 'bcpltime', 'bcplqsam'):
                        candidates = re.findall(r'^Launcher:\s*JOB\s+(\d+)\s*$', output, re.M)
                        if len(candidates) == 1:
                            launcher = int(candidates[0])
                        payload = _payload_number_from_output(output)
                    launcher, payload = self.validate(i, op, rc, output, config=cfg)
                except BaseException as exc:
                    self.evidence.record(i, op.name, op.command, rc, output,
                                         launcher=launcher, payload=payload,
                                         result='FAIL', diagnostic=str(exc))
                    raise
                else:
                    self.evidence.record(i, op.name, op.command, rc, output,
                                         launcher=launcher, payload=payload, result='PASS')
                    self.emit(f'  PASS RC={rc}' + (f' PAYLOAD JOB {payload}' if payload is not None else ''))
            self.evidence.finish('SUCCESS')
        except (KeyboardInterrupt, SystemExit):
            self.evidence.finish('INTERRUPTED', 'operator/system interruption')
            raise
        except Exception as exc:
            self.evidence.finish('FAILED' if self.evidence.operations else 'BLOCKED',
                                 type(exc).__name__ + ': ' + str(exc))
            raise


def _exclusive_controller(function):
    @wraps(function)
    def wrapped(root, *args, **kwargs):
        with controller_window(root):
            return function(root, *args, **kwargs)
    return wrapped


def execute_project_command(root: Path, command: list[str]) -> tuple[int, str]:
    """Pass the controller lease through the first subprocess boundary."""
    result = subprocess.run(command, cwd=root, text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            check=False, pass_fds=child_pass_fds(root))
    return result.returncode, result.stdout


@_exclusive_controller
def authorized_run(root, plan, approval, core, run_command, emit,
                   *, prompt=input, terminal: bool, jes_idle_guard):
    """Offline-testable controller. There is NO public --run route to it."""
    planner = lambda: plan.prepare(root, core, probe=True)
    grant = approval.request_approval(planner, output=sys.stdout,
                                      read_line=prompt, interactive=terminal)
    config = core.load_config()
    evidence = EvidenceLog(root, git_sha=grant.git_sha, plan_sha256=grant.digest,
                           inventory=grant.managed_dsns,
                           secrets=(str(config['mvs'].get('batch_password') or ''),))
    try:
        require_jes_clear(jes_idle_guard)
        approval.verify_approval(grant, planner)
        Runner(root, run_command=run_command, emit=emit, plan=plan, core=core,
               approval=approval, grant=grant, planner=planner,
               evidence=evidence).run()
    except (KeyboardInterrupt, SystemExit):
        if evidence.state == 'IN_PROGRESS':
            evidence.finish('INTERRUPTED', 'operator/system interruption')
        raise
    except Exception as exc:
        if evidence.state == 'IN_PROGRESS':
            evidence.finish('BLOCKED', type(exc).__name__ + ': ' + str(exc))
        raise



def check_live_guard(root: Path, *, observe=None, emit=None) -> int:
    """Observe real JES under the project lock, but NEVER enter reconstruction.

    This is an independent diagnostic safety path. It does not request
    reconstruction approval, instantiate Runner, or invoke project commands.
    Even a CLEAR observation exits without any cleanup or dataset mutation.
    """
    from live_entry import observe_jes
    observe = observe_jes if observe is None else observe
    emit = (lambda line: print(line, flush=True)) if emit is None else emit
    emit('LIVE GUARD CHECK ONLY: no reconstruction approval or build operations.')
    emit('This lock controls cooperating project submitters, not external JES clients.')
    try:
        with controller_window(root):
            result = observe(root, emit)
            require_jes_clear(lambda: result)
    except (KeyboardInterrupt, EOFError):
        emit('INTERRUPTED: guard check cancelled; no reconstruction attempted.')
        return 130
    except Exception as exc:
        # Do not expose exception details: they could contain MVS credentials.
        emit(f'BLOCKED: live guard check failed ({type(exc).__name__}); '
             'no reconstruction attempted.')
        return 2
    emit('CLEAR: two JES-idle observations passed; '
         'no reconstruction attempted or authorized.')
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument('--list', action='store_true', help='show canonical operation sequence, read-only')
    modes.add_argument('--check-live-guard', action='store_true',
                       help='read-only JES2 guard observation under exclusive project lock; never reconstructs')
    modes.add_argument('--run', action='store_true', help='request a fresh interactive, scoped reconstruction attempt')
    options = parser.parse_args()
    if options.list:
        for op in OPERATIONS:
            print(f'Guide {op.guide}: {op.name}: {" ".join(op.command)}')
        print('No regressions, native Cambridge compiler, tags, releases, or resume.')
        return 0
    if options.check_live_guard:
        return check_live_guard(ROOT)
    if options.run:
        from live_entry import run_live
        return run_live(ROOT, authorized_run, execute_project_command)
    parser.print_help()
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
