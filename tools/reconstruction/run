#!/usr/bin/env python3
"""One-shot clean-room reconstruction orchestrator; no resume or regression suite.

--run is deliberately blocked until the JES-idle check is independently
validated on MVS 3.8J. The stage engine and validations are testable offline.
"""
from __future__ import annotations

import argparse
from dataclasses import dataclass
import hashlib
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import Callable

ROOT = Path(__file__).resolve().parents[2]
DSPAL = "tools/datasets/dspal"
BOOTSTRAP = "tools/bootstrap/prepare-bootstrap"


class ReconstructionError(RuntimeError):
    pass


@dataclass(frozen=True)
class Step:
    guide: str
    name: str
    command: tuple[str, ...]
    check: str = "zero"


STEPS = (
    Step("1", "Remove generated host workarea", ("tools/clean-workarea",), "cleanup"),
    Step("2", "Purge managed BCPL datasets", (DSPAL, "purgebcpl", "--yes")),
    Step("2", "Recreate managed datasets", (DSPAL, "initbcpl")),
    Step("2", "Populate Git-backed members", (DSPAL, "populate", "all"), "first-populate"),
    Step("3", "Build ICINT19", (DSPAL, "submit", "MR10_JCL", "IC19BLD"), "submit"),
    Step("3", "Check MR10 interpreter load library", (DSPAL, "ls", "MR10_LOAD"), "icint-members"),
    Step("3", "Check MR10 interpreter object library", (DSPAL, "ls", "MR10_OBJ"), "icint-members"),
    Step("3", "Smoke-test installed interpreter", (
        "tools/mr10/compile-and-run", "--installed-icint", "MR10_LOAD", "--results",
        "mr10-kit-compiler/tests/00-regression-panel/data-movement/scalar-vector.bcpl"
    ), "code-zero"),
    Step("5", "Generate bootstrap and TRNILRG", (BOOTSTRAP, "--with-trnilrg"), "bootstrap"),
    Step("5", "Populate generated-only members", (DSPAL, "populate", "all", "--generated-only")),
    Step("6", "Build CAMBCOMP", (DSPAL, "submit", "BOOT_JCL", "CAMBBLD"), "cambridge"),
    Step("6", "Smoke-test assembler output", (
        "tools/bootstrap/compile-mvs",
        "bootstrap-toolchain/regression/00-most-degenerate-bcpl-program/source.bcpl",
        "--output", "workarea/m3-clean-smoke.s370.asm"
    ), "asm-smoke"),
    Step("7", "Build Core Runtime", (DSPAL, "submit", "BOOT_JCL", "BLDBMAIN"), "submit"),
    Step("8", "Build BLIB", (DSPAL, "submit", "BOOT_JCL", "BLIBBLD"), "blib"),
    Step("8", "Verify Core Runtime and BLIB members", (DSPAL, "ls", "BOOT_OBJ"), "runtime-members"),
    Step("9", "Install BCPLDEMO", (DSPAL, "submit", "BOOT_JCL", "BCPLDEMO"), "submit"),
    Step("9", "Install BCPLTIME", (DSPAL, "submit", "BOOT_JCL", "BCPLTIME"), "submit"),
    Step("9", "Install BCPLQSAM", (DSPAL, "submit", "BOOT_JCL", "BCPLQSAM"), "submit"),
    Step("9", "Verify System Extensions", (DSPAL, "ls", "EXT_OBJ"), "extensions-members"),
)

RUNTIME_MEMBERS = frozenset((
    "BCPLMAIN", "BCPLMEM", "BCPLBYTE", "BCPLAPT", "BCPLIO", "BCPLRGS", "BCPLREG", "BLIB"
))
EXTENSION_MEMBERS = frozenset(("BCPLDEMO", "BCPLTIME", "BCPLQSAM"))


def load_extensionless(path: Path, name: str):
    old = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        loader = importlib.machinery.SourceFileLoader(name, str(path))
        spec = importlib.util.spec_from_loader(name, loader)
        if spec is None:
            raise ReconstructionError(f"cannot load {path}")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[name] = mod
        loader.exec_module(mod)
        return mod
    finally:
        sys.dont_write_bytecode = old


def scope_snapshot(root: Path) -> str:
    """Digest exactly the top-level entries in approved workarea cleanup."""
    work = root / "workarea"
    if work.is_symlink() or not work.is_dir():
        raise ReconstructionError("workarea is missing or a symlink")
    marker = work / ".gitignore"
    if marker.is_symlink() or not marker.is_file():
        raise ReconstructionError("workarea/.gitignore is unsafe")
    names = sorted((os.fsencode(x.name) for x in work.iterdir() if x.name != ".gitignore"))
    return hashlib.sha256(b"".join(name + b"\0" for name in names)).hexdigest()


def assert_source(root: Path, plan, config_hash: str, sha: str, *, first: bool = False) -> None:
    """Reject changed sources/configuration after approval; ignored output is allowed."""
    if plan.run_git(root, "rev-parse", "HEAD") != sha:
        raise ReconstructionError("Git revision changed after approval")
    if plan.run_git(root, "symbolic-ref", "--short", "HEAD") != "main":
        raise ReconstructionError("Not on main")
    if plan.run_git(root, "status", "--porcelain", "--untracked-files=normal"):
        raise ReconstructionError("Working tree changed after approval")
    core = plan.load_dspal_core(root)
    cfg = core.load_config()
    if plan.public_config_digest(cfg) != config_hash:
        raise ReconstructionError("Effective dspal configuration changed after approval")
    if first and not cfg["mvs"].get("batch_password"):
        raise ReconstructionError("MVS batch authentication is not configured")


def inventory_members(output: str) -> set[str]:
    """Parse the strict single-PDS output of dspal ls (not raw JES text)."""
    lines = output.splitlines()
    if not lines or not re.fullmatch(r"[A-Z0-9@$#.]+:", lines[0]):
        raise ReconstructionError("unrecognized dspal ls inventory")
    found = []
    for line in lines[1:]:
        if line.strip() == "(empty)":
            return set()
        if not re.fullmatch(r"    [A-Z@$#][A-Z0-9@$#]{0,7}", line):
            raise ReconstructionError("unrecognized dspal ls member row")
        found.append(line.strip())
    return set(found)


def check_result(step: Step, rc: int, output: str, *, expected_tracked: int = 0,
                 expected_generated: set[str] | None = None) -> int | None:
    """Check adapter evidence, not merely process exit codes. Returns payload JOB if present."""
    if step.check == "first-populate":
        missing = set(re.findall(r"^\s*MISSING GENERATED:\s*(.+)$", output, re.M))
        expected = expected_generated or set()
        if rc != 2 or missing != expected or not re.search(
            rf"populate completed:\s*{expected_tracked}\s+ready member\(s\) written", output
        ):
            raise ReconstructionError("first population did not match its exact expected RC=2/missing-generated contract")
        return None
    if rc != 0:
        raise ReconstructionError(f"{step.name}: subprocess RC={rc}")
    if step.check == "submit" or step.check in ("cambridge", "blib"):
        launcher = re.search(r"^Launcher:\s*JOB\s+(\d+)\s*$", output, re.M)
        payload = re.search(r"^Payload:\s*JOB\s+(\d+)\s*$", output, re.M)
        if not launcher or not payload or "JOB RESULT: SUCCESS" not in output or "HIGHEST RC: 0000" not in output:
            raise ReconstructionError(f"{step.name}: launcher/payload or success evidence missing")
        return int(payload.group(1))
    if step.check == "icint-members":
        if "ICINT19" not in inventory_members(output):
            raise ReconstructionError("ICINT19 missing from installed library")
    elif step.check == "runtime-members":
        if inventory_members(output) != RUNTIME_MEMBERS:
            raise ReconstructionError("BOOT_OBJ must have exactly the eight accepted runtime/BLIB members")
    elif step.check == "extensions-members":
        if inventory_members(output) != EXTENSION_MEMBERS:
            raise ReconstructionError("EXT_OBJ must have exactly the three supported System Extensions")
    elif step.check == "code-zero":
        if not re.search(r"\bCODE\s*=\s*0\b", output):
            raise ReconstructionError("installed interpreter smoke did not establish CODE=0")
    elif step.check == "bootstrap":
        if "No MVS datasets changed." in output:
            # This message only describes the bootstrap generator's own local behavior.
            pass
        if "TRNILRG INTCODE not rebuilt" in output:
            raise ReconstructionError("TRNILRG generation not performed")
    elif step.check == "asm-smoke":
        if not re.search(r"\bCODE\s*=\s*0\b", output):
            raise ReconstructionError("compiler smoke lacks interpreted CODE=0")
    return None


class Runner:
    def __init__(self, root: Path, *, run_command: Callable[[list[str]], tuple[int, str]],
                 emit: Callable[[str], None], plan, approval, planner, config_hash: str):
        self.root, self.command, self.emit = root, run_command, emit
        self.plan, self.approval, self.planner, self.config_hash = plan, approval, planner, config_hash

    def run(self, config: dict) -> None:
        """Invoked only by a live controller after approved scope and idle-JES guard."""
        # Approval replay must be rejected if any host-cleanup entries changed.
        self.approval.verify_approval(self._approval_grant, self.planner)
        sha = self._approval_grant.git_sha
        assert_source(self.root, self.plan, self.config_hash, sha, first=True)
        expected_generated = {
            f"{logical}({member}) <- {src}"
            for logical, spec in config["datasets"].items()
            for member, src in spec.get("generated_members", {}).items()
            if spec.get("populate", False)
        }
        expected_tracked = sum(
            len(spec.get("members", {})) for spec in config["datasets"].values()
            if spec.get("populate", False)
        )
        for i, step in enumerate(STEPS, 1):
            assert_source(self.root, self.plan, self.config_hash, sha)
            cmd = list(step.command)
            if step.check == "cleanup":
                # The existing standalone tool retains its interactive behavior.
                cmd.extend(("--reconstruction-scope", scope_snapshot(self.root)))
            self.emit(f"[{i:02d}/{len(STEPS)}] Guide {step.guide}: {step.name}")
            rc, output = self.command(cmd)
            self.emit(f"  RC={rc}")
            payload = check_result(step, rc, output,
                                   expected_tracked=expected_tracked,
                                   expected_generated=expected_generated)
            if payload is not None:
                self.emit(f"  Payload JOB {payload}")
            if step.check == "cleanup":
                if any(x.name != ".gitignore" for x in (self.root / "workarea").iterdir()):
                    raise ReconstructionError("generated workarea cleanup left prior-run files behind")
            if step.check == "asm-smoke":
                asm = self.root / "workarea/m3-clean-smoke.s370.asm"
                if not asm.is_file() or not asm.stat().st_size:
                    raise ReconstructionError("CAMBCOMP did not create nonempty assembler output")
                text = asm.read_text(encoding="ascii", errors="replace")
                for token in ("CSECT", "EXTRN BCPLMAIN", "END"):
                    if token not in text:
                        raise ReconstructionError(f"assembler output missing {token}")
            self.emit("  PASS")

    def set_approval(self, grant) -> None:
        self._approval_grant = grant


def authorized_run(root: Path, plan, approval, core, run_command, emit,
                   *, prompt=input, terminal: bool, jes_idle_guard) -> None:
    """Integrate the Step 2 gate into one process, then run approved stages.

    A verified JES-idle guard is required; no default / bypass is supplied.
    This interface is internal until the target-specific guard has been tested.
    """
    planner = lambda: plan.prepare(root, core, probe=True)
    grant = approval.request_approval(planner, output=sys.stdout,
                                      read_line=prompt, interactive=terminal)
    jes_idle_guard()  # Must fail closed if earlier writers may still be active.
    config = core.load_config()
    engine = Runner(root, run_command=run_command, emit=emit, plan=plan,
                    approval=approval, planner=planner,
                    config_hash=plan.public_config_digest(config))
    engine.set_approval(grant)
    engine.run(config)


def blocked_live() -> int:
    print("LIVE RECONSTRUCTION DISABLED: no verified read-only JES-idle guard for MVS 3.8J yet.",
          file=sys.stderr)
    print("The stage sequence is implemented and testable with simulated commands; real purge/JES will not run.",
          file=sys.stderr)
    return 2


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--list", action="store_true", help="list planned commands, perform no work")
    parser.add_argument("--run", action="store_true", help="reserved until live JES-idle guard is verified")
    opts = parser.parse_args()
    if opts.list:
        for item in STEPS:
            print(f"Guide {item.guide}: {item.name}: {' '.join(item.command)}")
        print("Regression tests and release are NOT part of reconstruction.")
        return 0
    if opts.run:
        return blocked_live()
    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
