#!/usr/bin/env python3
"""
Assemble ICINT, run an INTCODE program, and optionally print its results.

Typical use:

    tools/run-intcode asm/icintv13.asm intcode/factorial.int

Append additional INTCODE modules explicitly, in load order:

    tools/run-intcode asm/icintv13.asm intcode/syni.int \
        +intcode/trni.int +intcode/blibi.int +intcode/iclib.int

Supply runtime standard input from a host text file:

    tools/run-intcode --sysin tests/input.txt \
        asm/icintv13.asm intcode/program.int \
        +intcode/blibi.int +intcode/iclib.int

Also wait for completion and print the ICINT run results:

    tools/run-intcode --results \
        asm/icintv13.asm intcode/factorial.int \
        +intcode/blibi.int +intcode/iclib.int

The generated JCL contains IFOX assemble, IEWL link-edit, and GO steps.
INTIN contains the primary program followed by every +module in the exact
order supplied. If --sysin is supplied, each host text line becomes one
in-stream SYSIN record. Without --sysin, no SYSIN DD statement is generated.
"""

from __future__ import annotations

import argparse
import importlib.util
from pathlib import Path
import re
import socket
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
MAKE_ASM = ROOT / "tools" / "make-asm-job.py"
PRINTER = ROOT / "mvs-state" / "prt" / "prt00e.txt"
WORKAREA = ROOT / "workarea"
DEFAULT_READER_HOST = "127.0.0.1"
DEFAULT_READER_PORT = 3505
DEFAULT_TIMEOUT = 120.0
DEFAULT_POLL = 0.25
MVS_NAME = re.compile(r"[A-Z@#$][A-Z0-9@#$]{0,7}\Z")


def load_make_asm():
    spec = importlib.util.spec_from_file_location("make_asm_job", MAKE_ASM)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {MAKE_ASM}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def resolve_repo_path(text: str) -> Path:
    path = Path(text)
    if not path.is_absolute():
        path = ROOT / path
    return path.resolve()


def read_ascii(path: Path, description: str) -> str:
    if not path.is_file():
        raise ValueError(f"{description} does not exist: {path}")
    try:
        text = path.read_text(encoding="ascii")
    except (OSError, UnicodeError) as exc:
        raise ValueError(f"cannot read ASCII {description} {path}: {exc}") from exc
    if not text.strip():
        raise ValueError(f"{description} is empty: {path}")
    return text.rstrip("\r\n") + "\n"


def read_sysin(path: Path) -> str:
    """Read ASCII SYSIN text, preserving one host line per MVS record."""
    if not path.is_file():
        raise ValueError(f"SYSIN file does not exist: {path}")
    try:
        text = path.read_text(encoding="ascii")
    except (OSError, UnicodeError) as exc:
        raise ValueError(f"cannot read ASCII SYSIN file {path}: {exc}") from exc

    records = text.splitlines()
    for number, record in enumerate(records, 1):
        if len(record) > 80:
            raise ValueError(
                f"SYSIN record {number} is {len(record)} characters; maximum is 80"
            )
        if record == "/*":
            raise ValueError(
                f"SYSIN record {number} is '/*', which would terminate in-stream JCL data"
            )
    return "".join(record + "\n" for record in records)


def parse_modules(tokens):
    modules = []
    for token in tokens:
        if not token.startswith("+") or token == "+":
            raise ValueError(
                f"additional INTCODE module must use +PATH syntax: {token}"
            )
        modules.append(resolve_repo_path(token[1:]))
    return modules


def make_intin(program_path, module_paths):
    paths = [program_path, *module_paths]
    parts = [read_ascii(program_path, "INTCODE program")]
    for module in module_paths:
        parts.append(read_ascii(module, "INTCODE module"))
    return "".join(parts), paths


def derive_job_name(program: Path) -> str:
    stem = re.sub(r"[^A-Z0-9]", "", program.stem.upper())
    job = "IC" + stem[:6]
    if not MVS_NAME.fullmatch(job):
        raise ValueError(f"cannot derive a valid MVS job name from {program.name}")
    return job


def build_deck(interpreter, intin, sysin, job_name, listing):
    make_asm = load_make_asm()
    source = make_asm.check_source(interpreter)
    entry = (make_asm.source_entry(source) or "ICINT").upper()
    if not MVS_NAME.fullmatch(entry):
        raise ValueError(f"cannot infer valid interpreter entry point from {interpreter}")
    deck = make_asm.make_deck(
        source=source,
        name=interpreter.stem,
        entry=entry,
        job=job_name,
        listing=listing,
        parm=None,
    )
    marker = (
        "//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)\n"
        "//SYSUDUMP DD  SYSOUT=*\n//\n"
    )
    if deck.count(marker) != 1:
        raise RuntimeError("unexpected make-asm-job GO-step layout")
    runtime_dds = (
        "//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)\n"
        "//INTIN    DD  *\n" + intin + "/*\n"
    )
    if sysin is not None:
        runtime_dds += "//SYSIN    DD  *\n" + sysin + "/*\n"
    runtime_dds += "//SYSUDUMP DD  SYSOUT=*\n//\n"
    return deck.replace(marker, runtime_dds, 1)


def read_printer():
    if not PRINTER.is_file():
        return ""
    try:
        return PRINTER.read_text(encoding="latin-1", errors="replace")
    except OSError as exc:
        raise RuntimeError(f"cannot read printer report {PRINTER}: {exc}") from exc


def printer_offset():
    if not PRINTER.exists():
        return 0
    try:
        return PRINTER.stat().st_size
    except OSError as exc:
        raise RuntimeError(f"cannot stat printer report {PRINTER}: {exc}") from exc


def submit_job(jcl_path, reader_host, reader_port):
    before = printer_offset()
    try:
        deck = jcl_path.read_bytes()
    except OSError as exc:
        raise RuntimeError(f"cannot read JCL deck {jcl_path}: {exc}") from exc
    if not deck.endswith(b"\n"):
        deck += b"\n"
    try:
        with socket.create_connection((reader_host, reader_port), timeout=10.0) as sock:
            sock.sendall(deck)
    except OSError as exc:
        raise RuntimeError(
            f"cannot submit JCL to {reader_host}:{reader_port}: {exc}"
        ) from exc
    return before


def find_new_job_number(job_name, start_offset):
    if not PRINTER.is_file():
        return None
    try:
        with PRINTER.open("rb") as stream:
            stream.seek(start_offset)
            data = stream.read()
    except OSError as exc:
        raise RuntimeError(f"cannot read printer report {PRINTER}: {exc}") from exc
    text = data.decode("latin-1", errors="replace")
    escaped = re.escape(job_name)
    patterns = (
        re.compile(rf"\bJOB\s+([0-9]+)\b.*\b{escaped}\b"),
        re.compile(rf"\b{escaped}\b.*\bJOB\s+([0-9]+)\b"),
    )
    for line in text.splitlines():
        if "****A  START" not in line:
            continue
        for pattern in patterns:
            match = pattern.search(line)
            if match is not None:
                return int(match.group(1))
    return None


def wait_for_new_job(job_name, start_offset, timeout, poll):
    deadline = time.monotonic() + timeout
    while True:
        number = find_new_job_number(job_name, start_offset)
        if number is not None:
            return number
        if time.monotonic() >= deadline:
            raise TimeoutError(
                f"could not find JES job number for {job_name} within {timeout:g} seconds"
            )
        time.sleep(poll)


def job_banner(job_number):
    return f"JOB {job_number:4d}"


def extract_complete_job(report, job_number):
    wanted = job_banner(job_number)
    lines = report.splitlines()
    start = None
    for index, line in enumerate(lines):
        if "****A  START" in line and wanted in line:
            start = index + 1
            break
    if start is None:
        return None
    for index in range(start, len(lines)):
        if "****A   END" in lines[index] and wanted in lines[index]:
            return "\n".join(lines[start:index]) + "\n"
    return None


def wait_for_job_report(job_number, timeout, poll):
    deadline = time.monotonic() + timeout
    while True:
        job = extract_complete_job(read_printer(), job_number)
        if job is not None:
            return job
        if time.monotonic() >= deadline:
            raise TimeoutError(
                f"job {job_number} did not complete within {timeout:g} seconds"
            )
        time.sleep(poll)


def clean_printer_line(line):
    return line.replace("\f", "")


def extract_icint_results(job_report):
    lines = [clean_printer_line(line) for line in job_report.splitlines()]
    start = None
    for index, line in enumerate(lines):
        if "INTCODE SYSTEM ENTERED" in line:
            start = index
            break
    if start is None:
        raise RuntimeError("job completed, but ICINT runtime output was not found")
    execution_end = None
    mapstore_end = None
    for index in range(start, len(lines)):
        stripped = lines[index].strip()
        if stripped.startswith("EXECUTION CYCLES ="):
            execution_end = index
        if stripped == "*** END MAPSTORE ***":
            mapstore_end = index
            break
    if mapstore_end is not None:
        end = mapstore_end
    elif execution_end is not None:
        end = execution_end
    else:
        end = len(lines) - 1
        for index in range(start + 1, len(lines)):
            stripped = lines[index].lstrip()
            if (
                stripped.startswith("IEF")
                or stripped.startswith("$HASP")
                or "****A   END" in lines[index]
            ):
                end = index - 1
                break
    return "\n".join(lines[start:end + 1]).strip("\r\n") + "\n"


def make_parser():
    parser = argparse.ArgumentParser(
        prog="run-intcode",
        description=(
            "Assemble an ICINT interpreter, run an INTCODE program plus optional "
            "+modules, and optionally print its runtime results."
        ),
        epilog=(
            "Example: tools/run-intcode --results asm/icintv13.asm "
            "intcode/syni.int +intcode/trni.int +intcode/blibi.int +intcode/iclib.int"
        ),
    )
    parser.add_argument(
        "interpreter", help="IFOX ICINT assembler source (normally under asm/)"
    )
    parser.add_argument(
        "program", help="primary INTCODE program (normally under intcode/)"
    )
    parser.add_argument(
        "modules",
        nargs="*",
        metavar="+MODULE",
        help="additional INTCODE module appended to INTIN; repeat in desired load order",
    )
    parser.add_argument(
        "--sysin",
        metavar="PATH",
        help="ASCII runtime input file; each line becomes one SYSIN record (maximum 80 characters)",
    )
    parser.add_argument(
        "--results",
        action="store_true",
        help="wait for the JES job to finish and print only the ICINT runtime results",
    )
    parser.add_argument(
        "--jcl",
        metavar="PATH",
        help="generated JCL deck (default: workarea/run-intcode-PROGRAM.jcl)",
    )
    parser.add_argument(
        "--job-name", metavar="NAME", help="override the generated MVS JOB name"
    )
    parser.add_argument(
        "--listing",
        choices=("light", "medium", "heavy"),
        default="light",
        help="assembler/linker listing profile (default: light)",
    )
    parser.add_argument(
        "--reader-host",
        default=DEFAULT_READER_HOST,
        metavar="HOST",
        help=f"Hercules socket-reader host (default: {DEFAULT_READER_HOST})",
    )
    parser.add_argument(
        "--reader-port",
        type=int,
        default=DEFAULT_READER_PORT,
        metavar="PORT",
        help=f"Hercules socket-reader port (default: {DEFAULT_READER_PORT})",
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=DEFAULT_TIMEOUT,
        metavar="SECONDS",
        help=f"maximum wait for JES assignment or --results (default: {DEFAULT_TIMEOUT:g})",
    )
    parser.add_argument(
        "--poll",
        type=float,
        default=DEFAULT_POLL,
        metavar="SECONDS",
        help=f"printer-report polling interval (default: {DEFAULT_POLL:g})",
    )
    return parser


def main(argv=None):
    parser = make_parser()
    args = parser.parse_args(argv)
    try:
        interpreter = resolve_repo_path(args.interpreter)
        program = resolve_repo_path(args.program)
        modules = parse_modules(args.modules)
        if not interpreter.is_file():
            raise ValueError(f"interpreter does not exist: {interpreter}")
        if not program.is_file():
            raise ValueError(f"INTCODE program does not exist: {program}")
        for module in modules:
            if not module.is_file():
                raise ValueError(f"INTCODE module does not exist: {module}")
        if not 1 <= args.reader_port <= 65535:
            raise ValueError("--reader-port must be between 1 and 65535")
        if args.timeout <= 0:
            raise ValueError("--timeout must be greater than zero")
        if args.poll <= 0:
            raise ValueError("--poll must be greater than zero")

        intin, components = make_intin(program, modules)
        sysin_path = resolve_repo_path(args.sysin) if args.sysin is not None else None
        sysin = read_sysin(sysin_path) if sysin_path is not None else None

        job_name = args.job_name.upper() if args.job_name else derive_job_name(program)
        if not MVS_NAME.fullmatch(job_name):
            raise ValueError("--job-name must be a valid MVS name of at most 8 characters")

        deck = build_deck(interpreter, intin, sysin, job_name, args.listing)
        jcl_path = (
            resolve_repo_path(args.jcl)
            if args.jcl
            else WORKAREA / f"run-intcode-{program.stem}.jcl"
        )
        jcl_path.parent.mkdir(parents=True, exist_ok=True)
        try:
            jcl_path.write_text(deck, encoding="ascii", newline="\n")
        except (OSError, UnicodeError) as exc:
            raise RuntimeError(f"cannot write JCL deck {jcl_path}: {exc}") from exc

        def shown(path):
            try:
                return path.relative_to(ROOT)
            except ValueError:
                return path

        print(f"INTERPRETER {shown(interpreter)}")
        print(f"PROGRAM     {shown(program)}")
        for module in components[1:]:
            print(f"MODULE      {shown(module)}")
        if sysin_path is not None:
            print(f"SYSIN       {shown(sysin_path)}")
        print(f"JCL         {shown(jcl_path)}")
        print(f"READER      {args.reader_host}:{args.reader_port}")

        start_offset = submit_job(jcl_path, args.reader_host, args.reader_port)
        job_number = wait_for_new_job(job_name, start_offset, args.timeout, args.poll)
        print(f"JOB {job_number}")
        if args.results:
            report = wait_for_job_report(job_number, args.timeout, args.poll)
            print()
            print(extract_icint_results(report), end="")
        return 0
    except (ValueError, RuntimeError, TimeoutError, OSError) as exc:
        print(f"run-intcode: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
