#!/usr/bin/env python3
"""Generate a first-flight JCL deck for the Cambridge S/370 BCPL compiler.

The deck:
  1. assembles and link-edits a capacity-expanded copy of ICINT v17;
  2. stages the preserved MR10 SYNI/TRNI/CGI/BLIBI/ICLIB components;
  3. compiles the Cambridge BCPL, SYN, TRN, CG and COMPBLIB sections to
     INTCODE with the interpreted MR10 compiler pipeline;
  4. runs those Cambridge sections plus COMPBLIB and the low-level ICLIB host
     services under ICINT, compiling a small BCPL input with the Cambridge
     in-memory TRN -> CG370 handoff; and
  5. attempts to assemble the emitted CODE stream with IFOX00.

This is intentionally a deck generator, not a submitter.  The generated JCL is
an inspectable experiment and should be submitted with tools/submit-jcl.
"""

from __future__ import annotations

import argparse
import importlib.util
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[1]
CORE_PATH = ROOT / "tools" / "compile-and-run-core.py"
CAM = ROOT / "native-compiler" / "cambridge-bcpl"
LIBHDR = ROOT / "richards-bcpltape" / "sys3" / "bcpl" / "libhdr"
DEFAULT_ICINT = ROOT / "asm" / "icintv17.asm"
DEFAULT_TEST = ROOT / "native-compiler" / "acceptance" / "a0-finish.bcpl"
DEFAULT_OUTPUT = ROOT / "workarea" / "cambridge-bootstrap.jcl"
EXPANDED = ROOT / "workarea" / "cambridge-bootstrap-src"

MODULES = (
    ("bcpl", CAM / "bcpl.bcpl"),
    ("syn", CAM / "syn.bcpl"),
    ("trn", CAM / "trn.bcpl"),
    ("cg", CAM / "cg.bcpl"),
    ("compblib", CAM / "blib.bcpl"),
)
HEADERS = {
    "SYNHDR": CAM / "synhdr.bcpl",
    "TRNHDR": CAM / "trnhdr.bcpl",
    "CGHDR": CAM / "cghdr.bcpl",
}


def load_core():
    spec = importlib.util.spec_from_file_location("compile_and_run_core", CORE_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {CORE_PATH}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def read_ascii(path: Path) -> str:
    try:
        return path.read_text(encoding="ascii")
    except (OSError, UnicodeError) as exc:
        raise RuntimeError(f"cannot read ASCII file {path}: {exc}") from exc


def normalize_records(text: str, what: str) -> str:
    out = []
    for number, line in enumerate(text.splitlines(), 1):
        if len(line) > 80:
            raise RuntimeError(f"{what}:{number}: {len(line)} columns exceeds 80")
        if line == "/*":
            raise RuntimeError(f"{what}:{number}: bare /* would terminate JCL input")
        out.append(line)
    return "\n".join(out) + "\n"


def replace_once(text: str, old: str, new: str, what: str) -> str:
    if text.count(old) != 1:
        raise RuntimeError(f"cannot patch {what}: expected one occurrence")
    return text.replace(old, new, 1)


def expand_gets(source: str, *, compblib: bool = False) -> str:
    """Expand the Cambridge GETs on the host side for ICINT bootstrap use.

    Native MVS BCPL used HEADERS as a PDS and FINDINPUT understood member
    syntax.  ICINT v17 deliberately discovers ordinary DDNAME streams only,
    so the bootstrap deck removes that unrelated host dependency.
    """
    libhdr = read_ascii(LIBHDR).rstrip("\n")
    if compblib:
        # Historical MAKEOBJ built COMPBLIB with one extra declaration after
        # the standard LIBHDR, moving ABORT from G3 to G112.
        libhdr += "\nGLOBAL $( ABORT : 112 $)"

    result = source.replace('GET "LIBHDR"', libhdr)
    for name, path in HEADERS.items():
        hdr = read_ascii(path)
        # Header members can themselves include LIBHDR.
        hdr = hdr.replace('GET "LIBHDR"', read_ascii(LIBHDR).rstrip("\n"))
        result = result.replace(f'GET "HEADERS({name})"', hdr.rstrip("\n"))

    unresolved = re.findall(r'^\s*GET\s+"([^"]+)"', result, flags=re.MULTILINE)
    if unresolved:
        raise RuntimeError("unexpanded GET(s): " + ", ".join(sorted(set(unresolved))))
    return result


def prepare_sources() -> list[Path]:
    EXPANDED.mkdir(parents=True, exist_ok=True)
    paths: list[Path] = []
    for name, original in MODULES:
        text = expand_gets(read_ascii(original), compblib=(name == "compblib"))
        path = EXPANDED / f"{name}.bcpl"
        path.write_text(normalize_records(text, str(original)), encoding="ascii")
        paths.append(path)

    # ICINT's MR10 runtime does not provide G39/FINDPARM.  Supply the smallest
    # interpreted host shim: expose an ordinary //OPTIONS DD as FINDPARM().
    shim = expand_gets(
        'SECTION "MVSHOST"\nGET "LIBHDR"\n\nLET FINDPARM() = FINDINPUT("OPTIONS")\n'
    )
    shim_path = EXPANDED / "mvshost.bcpl"
    shim_path.write_text(normalize_records(shim, "generated MVSHOST"), encoding="ascii")
    paths.append(shim_path)
    return paths


def prepare_interpreter(source: Path, globals_count: int, labels: int, progwords: int) -> Path:
    """Make a bootstrap-only, capacity-expanded ICINT without growing its CSECT."""
    text = read_ascii(source)
    substitutions = (
        (r"^LABVCNT\s+EQU\s+\d+\s*$", f"LABVCNT  EQU   {labels}"),
        (r"^GLOBCNT\s+EQU\s+\d+\s*$", f"GLOBCNT  EQU   {globals_count}"),
        (r"^PROGCNT\s+EQU\s+\d+\s*$", f"PROGCNT  EQU   {progwords}"),
    )
    for pattern, replacement in substitutions:
        text, count = re.subn(pattern, replacement, text, count=1, flags=re.MULTILINE)
        if count != 1:
            raise RuntimeError(f"could not patch interpreter constant: {pattern}")

    # LABV, G and the program vector are obtained dynamically by GETMAIN, so
    # their capacities can grow without enlarging the ICINT CSECT.  GUSED is
    # different: it is a static diagnostic bitmap.  Growing it from 401 bytes
    # pushed V17 beyond its three 4K USING regions and made the literal pool
    # unaddressable to IFOX.  Keep GUSED at 401 entries and simply stop marking
    # diagnostic usage for globals above 400.  The actual global vector still
    # contains every requested entry, including Cambridge globals through 699.
    text = replace_once(
        text,
        "CASEG    BAL   R14,RCH\n"
        "         BAL   R14,RDN\n"
        "         LR    R3,R0\n"
        "         LA    R5,GUSED\n"
        "         AR    R5,R3\n"
        "         MVI   0(R5),1\n"
        "         L     R2,G",
        "CASEG    BAL   R14,RCH\n"
        "         BAL   R14,RDN\n"
        "         LR    R3,R0\n"
        "         C     R3,=F'400'\n"
        "         BH    CAGUSKIP\n"
        "         LA    R5,GUSED\n"
        "         AR    R5,R3\n"
        "         MVI   0(R5),1\n"
        "CAGUSKIP L     R2,G",
        "CASEG GUSED guard",
    )
    text = replace_once(text, "ACLRTST  C     R4,=F'500'", f"ACLRTST  C     R4,=F'{labels - 1}'", "label clear bound")
    text = replace_once(text, "AZTEST   C     R8,=F'500'", f"AZTEST   C     R8,=F'{labels - 1}'", "label check bound")
    text = replace_once(text, "         A     R3,=F'20000'", f"         A     R3,=F'{progwords - 1}'", "OP1 program bound")
    text = replace_once(text, "         A     R3,=F'400'\n         CR    R2,R3", f"         A     R3,=F'{globals_count - 1}'\n         CR    R2,R3", "OP1 global bound")

    EXPANDED.mkdir(parents=True, exist_ok=True)
    path = EXPANDED / source.name
    path.write_text(text, encoding="ascii")
    return path


def inline_dd(ddname: str, text: str) -> str:
    # DD DATA, unlike DD *, permits input records beginning with //.
    # That matters for ordinary BCPL source because // is its line-comment
    # syntax.  normalize_records() already rejects a bare /* terminator.
    return f"//{ddname:<8} DD  DATA\n" + normalize_records(text, ddname) + "/*\n"


def code_output_dd() -> str:
    return (
        "//CODE     DD  DSN=&&NATIVE,UNIT=SYSDA,\n"
        "//             SPACE=(80,(3000,1000)),\n"
        "//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),\n"
        "//             DISP=(NEW,PASS)\n"
    )


def expand_runtime_regions(deck: str) -> str:
    """Give every interpreted RUNMOD phase room for the expanded ICINT vectors."""
    old = "EXEC PGM=RUNMOD,REGION=256K,COND=(4,LT)"
    new = "EXEC PGM=RUNMOD,REGION=1024K,TIME=(1,0),COND=(4,LT)"
    count = deck.count(old)
    if count < 1:
        raise RuntimeError("cannot locate RUNMOD execution steps to expand")
    return deck.replace(old, new)


def patch_final_run(deck: str, test_source: str, options: str) -> str:
    marker = "//RUN      EXEC PGM=RUNMOD,REGION=1024K,TIME=(1,0),COND=(4,LT)\n"
    pos = deck.rfind(marker)
    if pos < 0:
        raise RuntimeError("cannot locate final RUN step in generated deck")

    # compile-and-run normally appends BLIBI + ICLIB to every final execution.
    # Here COMPBLIB is itself one of the generated Cambridge modules, so loading
    # MR10 BLIBI afterward would overwrite overlapping globals.  Keep ICLIB for
    # the ICINT X-operation host services, but remove BLIBI from this RUN only.
    tail = deck[pos:]
    blibi_dd = "//         DD  DSN=&&BLIBI,DISP=(OLD,DELETE)\n"
    if blibi_dd not in tail:
        raise RuntimeError("cannot locate final RUN BLIBI concatenation")
    tail = tail.replace(blibi_dd, "", 1)
    deck = deck[:pos] + tail

    sysudump = "//SYSUDUMP DD  SYSOUT=*\n"
    pos = deck.rfind(sysudump)
    if pos < 0:
        raise RuntimeError("cannot locate final RUN SYSUDUMP DD")
    additions = (
        inline_dd("OPTIONS", options)
        + inline_dd("SYSIN", test_source)
        + code_output_dd()
    )
    deck = deck[:pos] + additions + deck[pos:]
    return deck


def append_ifox(deck: str) -> str:
    if deck.endswith("//\n"):
        deck = deck[:-3]
    deck += (
        "//*\n"
        "//*------------------------------------------------------------------*\n"
        "//* CAMBRIDGE FIRST-FLIGHT ENDPOINT: ASSEMBLE CG370 CODE WITH IFOX00  *\n"
        "//*------------------------------------------------------------------*\n"
        "//ASM370   EXEC PGM=IFOX00,COND=(4,LT),REGION=256K,\n"
        "//             PARM='OBJECT,NODECK,LIST,XREF(SHORT)'\n"
        "//SYSLIB   DD  DSN=SYS1.MACLIB,DISP=SHR\n"
        "//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))\n"
        "//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))\n"
        "//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))\n"
        "//SYSPRINT DD  SYSOUT=*\n"
        "//SYSPUNCH DD  DUMMY\n"
        "//SYSGO    DD  DUMMY\n"
        "//SYSIN    DD  DSN=&&NATIVE,DISP=(OLD,DELETE)\n"
        "//\n"
    )
    return deck


def main() -> int:
    parser = argparse.ArgumentParser(
        description="generate the Cambridge BCPL compiler bootstrap JCL deck"
    )
    parser.add_argument("--interpreter", default=str(DEFAULT_ICINT.relative_to(ROOT)))
    parser.add_argument("--test", default=str(DEFAULT_TEST.relative_to(ROOT)))
    parser.add_argument("--output", default=str(DEFAULT_OUTPUT.relative_to(ROOT)))
    parser.add_argument("--listing", choices=("light", "medium", "heavy"), default="heavy")
    parser.add_argument("--job-name", default="CAMBCPL")
    parser.add_argument("--globals", type=int, default=1001)
    parser.add_argument("--labels", type=int, default=4001)
    parser.add_argument("--progwords", type=int, default=100001)
    args = parser.parse_args()

    core = load_core()
    interpreter = (ROOT / args.interpreter).resolve()
    test = (ROOT / args.test).resolve()
    output = (ROOT / args.output).resolve()

    if not interpreter.is_file():
        raise RuntimeError(f"interpreter not found: {interpreter}")
    if not test.is_file():
        raise RuntimeError(f"test source not found: {test}")
    if not core.MVS_NAME.fullmatch(args.job_name.upper()):
        raise RuntimeError(f"invalid MVS job name: {args.job_name}")
    if args.globals < 701:
        raise RuntimeError("--globals must be at least 701 for Cambridge TOPGLOB")
    if args.labels < 501:
        raise RuntimeError("--labels must be at least 501")
    if args.progwords < 20001:
        raise RuntimeError("--progwords must be at least 20001")

    prepared_icint = prepare_interpreter(
        interpreter, args.globals, args.labels, args.progwords
    )
    sources = prepare_sources()

    deck = core.build_deck(
        prepared_icint,
        sources,
        args.job_name.upper(),
        args.listing,
        named_dds=[],
        save_ocode=False,
        save_intcode=False,
    )
    deck = expand_runtime_regions(deck)

    # Empty compiler-option field, then N code-generator option: keep the
    # in-memory OCODE path and suppress the historical binary object deck.
    deck = patch_final_run(deck, read_ascii(test), "/N\n")
    deck = append_ifox(deck)

    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(deck, encoding="ascii")
    print(output)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, OSError, ValueError) as exc:
        print(f"make-cambridge-bootstrap-job: {exc}", file=sys.stderr)
        raise SystemExit(2)