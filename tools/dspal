#!/usr/bin/env python3
"""Front-end dispatcher for dspal."""

from pathlib import Path
import os
import sys

ROOT = Path(__file__).resolve().parents[1]
CORE = ROOT / "tools" / "dspal-core.py"
IO = ROOT / "tools" / "dspal-io.py"
READ = ROOT / "tools" / "dspal-read.py"
CORE_COMMANDS = {"info", "status", "stat", "initbcpl"}
READ_COMMANDS = {"cat", "get"}


def exec_script(path: Path, argv: list[str]) -> None:
    os.execv(sys.executable, [sys.executable, str(path), *argv])


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {"-h", "--help", "help"}:
        exec_script(IO, args if args else ["help"])
    if args[0] in CORE_COMMANDS:
        exec_script(CORE, args)
    if args[0] in READ_COMMANDS:
        exec_script(READ, args)
    exec_script(IO, args)
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
