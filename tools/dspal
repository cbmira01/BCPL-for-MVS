#!/usr/bin/env python3
"""Front-end dispatcher for dspal."""

from pathlib import Path
import os
import sys

ROOT = Path(__file__).resolve().parents[1]
CORE = ROOT / "tools" / "dspal-core.py"
IO = ROOT / "tools" / "dspal-io.py"
READ = ROOT / "tools" / "dspal-read.py"
MAINT = ROOT / "tools" / "dspal-maint.py"
LS = ROOT / "tools" / "dspal-ls.py"
POPULATE = ROOT / "tools" / "dspal-populate.py"
PURGE = ROOT / "tools" / "dspal-purge.py"

CORE_COMMANDS = {"info", "status", "stat", "initbcpl"}
READ_COMMANDS = {"cat", "get"}
MAINT_COMMANDS = {"rm", "compress"}
LS_COMMANDS = {"ls"}
POPULATE_COMMANDS = {"populate"}
PURGE_COMMANDS = {"purgebcpl"}


def exec_script(path: Path, argv: list[str]) -> None:
    os.execv(sys.executable, [sys.executable, str(path), *argv])


def print_help() -> None:
    print("usage: dspal COMMAND [options]")
    print()
    print("Manage BCPL project datasets on MVS/TK5.")
    print()
    print("Commands:")
    rows = [
        ("help [COMMAND]", "show this help or command-specific help"),
        ("info", "show effective dspal configuration"),
        ("status", "check local MVS/TK5 readiness"),
        ("stat [DATASET]", "show MVS dataset attributes; no operand means all managed datasets"),
        ("list", "list managed datasets from the manifest"),
        ("ls [DATASET]", "list PDS members; no operand inventories all managed PDSes"),
        ("cat DATASET MEMBER", "write a text member to stdout"),
        ("get DATASET MEMBER FILE", "copy a text member to a host file; FILE may be -"),
        ("put DATASET MEMBER FILE", "replace/create a text member; FILE may be -"),
        ("rm DATASET MEMBER", "remove exactly one PDS member"),
        ("compress DATASET", "compress one PDS in place with IEBCOPY"),
        ("populate TARGET", "populate one managed source PDS or all from Git mappings"),
        ("initbcpl", "create missing managed datasets after attribute preflight"),
        ("purgebcpl", "delete only the explicit managed dataset set"),
    ]
    for name, description in rows:
        print(f"  {name:<27} {description}")
    print()
    print("Use: dspal help COMMAND")


def route_help(topic: str) -> None:
    topic = topic.lower()
    if topic in CORE_COMMANDS:
        exec_script(CORE, [topic, "--help"])
    if topic in READ_COMMANDS:
        exec_script(READ, [topic, "--help"])
    if topic in MAINT_COMMANDS:
        exec_script(MAINT, [topic, "--help"])
    if topic in LS_COMMANDS:
        exec_script(LS, ["--help"])
    if topic in POPULATE_COMMANDS:
        exec_script(POPULATE, ["--help"])
    if topic in PURGE_COMMANDS:
        exec_script(PURGE, ["--help"])
    exec_script(IO, ["help", topic])


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {"-h", "--help"}:
        print_help()
        return 0
    if args[0] == "help":
        if len(args) == 1:
            print_help()
            return 0
        if len(args) != 2:
            print("dspal: usage: dspal help [COMMAND]", file=sys.stderr)
            return 2
        route_help(args[1])
    if args[0] in CORE_COMMANDS:
        exec_script(CORE, args)
    if args[0] in READ_COMMANDS:
        exec_script(READ, args)
    if args[0] in MAINT_COMMANDS:
        exec_script(MAINT, args)
    if args[0] in LS_COMMANDS:
        exec_script(LS, args[1:])
    if args[0] in POPULATE_COMMANDS:
        exec_script(POPULATE, args[1:])
    if args[0] in PURGE_COMMANDS:
        exec_script(PURGE, args[1:])
    exec_script(IO, args)
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
