#!/usr/bin/env python3
"""Public JES submit interface; the existing Bash helper runs under admission.

The existing submit-jcl implementation is preserved as submit-jcl-core.sh.
Holding a shared admission lock until its JOB start/reject result closes the
reader-start race. A reconstruction child can inherit its controller's kernel
exclusive lease; no other project submission will be admitted meanwhile.
"""
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(Path(__file__).resolve().parent))
from jes_submission_gate import SubmissionDenied, admit, child_pass_fds


def main(argv):
    helper = ROOT / 'tools/mvs/submit-jcl-core.sh'
    if not helper.is_file() or helper.is_symlink():
        print('JES submission denied: internal submit helper missing', file=sys.stderr)
        return 77
    # Help is read-only and must work even without the TK5 state directory.
    if argv in (['--help'], ['-h']):
        return subprocess.run(['bash', str(helper), *argv], check=False).returncode
    try:
        with admit(ROOT):
            return subprocess.run(['bash', str(helper), *argv],
                                  pass_fds=child_pass_fds(ROOT), check=False).returncode
    except (SubmissionDenied, OSError) as exc:
        print('JES submission denied: ' + str(exc), file=sys.stderr)
        return 77


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
