#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: tools/mvs/submit-jcl [--timeout SECONDS] [--cursor-file FILE] JCL

Submit a JCL deck to the local TK5 socket reader and print the JES job
number on stdout. Progress and errors are written to stderr.

Options:
  --timeout SECONDS    Maximum time to wait for JES to start the job.
                       Default: 120 seconds.
  --cursor-file FILE   Opt-in: save pre-submission printer identity and byte offset.
                       Poll only the new printer window; invalid cursor fails.
  -h, --help           Show this help.
USAGE
}

timeout=120
cursor_file=""

while (( $# )); do
    case "$1" in
        --timeout)
            [[ $# -ge 2 ]] || { usage >&2; exit 64; }
            timeout=$2
            shift 2
            ;;
        --cursor-file)
            [[ $# -ge 2 && -n $2 ]] || { usage >&2; exit 64; }
            cursor_file=$2
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo >&2 "unknown option: $1"
            usage >&2
            exit 64
            ;;
        *)
            break
            ;;
    esac
done

[[ $# -eq 1 ]] || { usage >&2; exit 64; }

jcl=$1

[[ -r "$jcl" ]] || {
    echo >&2 "cannot read JCL: $jcl"
    exit 66
}

[[ "$timeout" =~ ^[0-9]+$ ]] || {
    echo >&2 "--timeout must be an integer"
    exit 64
}

# Locate the repository root relative to this script.
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd -- "$script_dir/../.." && pwd)"

# Fixed TK5 configuration for this repository.
reader_port=3505
printer="$root/mvs-state/prt/prt00e.txt"

[[ -e "$printer" ]] || {
    echo >&2 "printer log not found: $printer"
    exit 66
}

command -v nc >/dev/null 2>&1 || {
    echo >&2 "nc is required"
    exit 69
}

command -v timeout >/dev/null 2>&1 || {
    echo >&2 "timeout is required"
    exit 69
}

# Extract the job name from the JOB statement.
jobname=$(
    awk '
        /^\/\/[^*][^[:space:]]*[[:space:]]+JOB([[:space:],]|$)/ {
            name=$1
            sub(/^\/\//, "", name)
            print toupper(name)
            exit
        }
    ' "$jcl"
)

[[ -n "$jobname" ]] || {
    echo >&2 "unable to identify JOB name in $jcl"
    exit 65
}

# Capture a guarded cursor before writing to the JES reader socket.
if [[ -n $cursor_file ]]; then
    if ! python3 "$root/tools/mvs/printer-window.py" capture \
            --printer "$printer" --cursor-file "$cursor_file"; then
        echo >&2 "could not capture a safe printer cursor; no JCL was submitted"
        exit 75
    fi
else
    start_line=$(wc -l < "$printer")
fi

printf 'submitting %s as %s through reader port %s\n' \
    "$jcl" "$jobname" "$reader_port" >&2

set +e
timeout 5s nc -N 127.0.0.1 "$reader_port" < "$jcl"
nc_rc=$?
set -e

if (( nc_rc != 0 && nc_rc != 124 )); then
    echo >&2 "socket-reader submission failed with rc=$nc_rc"
    exit 74
fi

if (( nc_rc == 124 )); then
    echo >&2 "socket-reader connection did not close after EOF; continuing to watch JES"
fi

deadline=$((SECONDS + timeout))

while (( SECONDS <= deadline )); do
    if [[ -n $cursor_file ]]; then
        window=$(python3 "$root/tools/mvs/printer-window.py" read \
            --printer "$printer" --cursor-file "$cursor_file") || {
            echo >&2 "printer cursor invalid during JES submission; inspect printer/JES before retry"
            exit 75
        }
    else
        window=$(tail -n "+$((start_line + 1))" "$printer") || exit 75
    fi
    # JES printer START JOB banners carry both the job name and number.
    # Accept one emitted after this submission, even if $HASP373 is absent.
    banner=$(
        printf '%s\n' "$window" |
            grep -m1 -E "\*+A[[:space:]]+START[[:space:]]+JOB[[:space:]]+[0-9]+[[:space:]]+${jobname}([[:space:]]|$)" || true
    )
    if [[ -n "$banner" ]]; then
        job=$(sed -nE 's/^.*\*+A[[:space:]]+START[[:space:]]+JOB[[:space:]]+([0-9]+)[[:space:]]+.*/\1/p' <<<"$banner")
        if [[ "$job" =~ ^[0-9]+$ ]]; then
            printf 'JOB %s\n' "$job"
            exit 0
        fi
    fi
    match=$(
        printf '%s\n' "$window" |
            grep -m1 -E "\\\$HASP373[[:space:]]+${jobname}([[:space:]]|$)" || true
    )

    if [[ -n "$match" ]]; then
        job=$(awk '{print $3}' <<<"$match")

        if [[ "$job" =~ ^[0-9]+$ ]]; then
            printf 'JOB %s\n' "$job"
            exit 0
        fi

        # Wait for a numbered START JOB banner; do not invent a job number.
    fi

    # JES may reject invalid JCL before emitting $HASP373.
    rejected=$(
        printf '%s\n' "$window" |
            grep -m1 -E "IEF452I[[:space:]]+${jobname}[[:space:]]+JOB NOT RUN" || true
    )
    if [[ -n "$rejected" ]]; then
        echo >&2 "JES rejected the submitted job before execution:"
        echo >&2 "$rejected"
        exit 76
    fi

    sleep 0.5
done

echo >&2 "timed out after ${timeout}s waiting for job-start evidence for ${jobname}"
echo >&2 "the submitted job may still be queued or running; inspect $printer"
exit 75


