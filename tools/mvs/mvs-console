    print("  devices             static IBM hardware model directory (offline)")


def display_devices(delta: str, category: str) -> int:
    """Filter a fresh Hercules DEVLIST by model; preserve its original device lines."""
    if "HHC01603I devlist" not in delta:
        print("DEVLIST response not captured; device inventory unverified.", file=sys.stderr)
        return 1
    models = DEVICE_GROUPS[device_category(category)]
    rows = [row[2] for row in device_rows(delta).values()
            if row[0].split("-", 1)[0] in models]
    if not rows:
        print(f"No {category} devices found in captured DEVLIST response.")
    else:
        print("\n".join(rows))
    return 0


def replay_filter(output: str, command: str | None = None) -> str:
    """Remove exact consecutive Hercules command-response replays, not guest messages.

    Repeated asynchronous JES/MVS records are never collapsed; only a complete,
    byte-for-byte identical Hercules panel response with a matching echo is.
    """
    lines = output.splitlines(keepends=True)
    anchors = []
    for index, line in enumerate(lines):
        echo = re.search(r"\bHHC01603I\s+(.+?)\s*$", line)
        if echo:
            anchors.append((index, echo.group(1).strip()))
    for i in range(len(anchors) - 2, -1, -1):
        start, first = anchors[i]
        mid, second = anchors[i + 1]
        width = mid - start
        if first != second:
            continue
        if command is not None and first.casefold() != command.strip().casefold():
            continue
        if width >= 1 and lines[start:mid] == lines[mid:mid + width]:
            del lines[mid:mid + width]
    return "".join(lines)


def capture(command: str, *, timeout: float, settle: float) -> tuple[int, str]:
    """Return transport result and the appended console log.

    An HTTP 200 alone is not proof of guest command completion.
    """
    if not docker_running():
        raise RuntimeError("Docker container mvs38j is not running")
    before = log_offset()
    p = subprocess.run(["docker", "exec", "-i", CONTAINER, "curl", "--silent", "--show-error",
                        "--get", "--connect-timeout", "3", "--max-time", str(max(1, int(timeout))),
                        "--data-urlencode", "cmd=" + command, "--output", "/dev/null",
                        "--write-out", "%{http_code}", URL], capture_output=True, text=True,
                       check=False, timeout=timeout + 5)
    if settle > 0:
        time.sleep(settle)
    delta = read_delta(before)
    if p.returncode or p.stdout.strip() != "200":
        print(f"Transport failure: curl RC={p.returncode}, HTTP={p.stdout.strip()}; {p.stderr.strip()}", file=sys.stderr)
        print("Delivery uncertain: do not blindly retry state-changing commands.", file=sys.stderr)
        return 1, delta
    return 0, delta


def display_tapes(delta: str, address: str | None = None) -> int:
    if "HHC01603I devlist" not in delta:
        print("No DEVLIST response captured; tape inventory is unverified.", file=sys.stderr)
        return 1
    found = tape_rows(delta)
    if address:
        address = address.upper().zfill(4)
        if address not in found:
            print(f"{address}: not found as a tape drive in the current DEVLIST response.", file=sys.stderr)
            return 1
        print(found[address][2])
    elif not found:
        print("No tape drives found in DEVLIST response.")
    else:
        for row in found.values():
            print(row[2])
    return 0


def dispatch(command: str, *, timeout: float = 10.0, settle: float = 0.8,
             tape_only: bool = False, tape_address: str | None = None,
             device_filter: str | None = None) -> int:
    rc, delta = capture(command, timeout=timeout, settle=settle)
    if rc:
        # Preserve visible output and transport warnings even after a failure.
        if delta:
            print(delta, end="" if delta.endswith("\n") else "\n")
        return rc
    if tape_only:
        return display_tapes(delta, tape_address)
    if device_filter is not None:
        return display_devices(delta, device_filter)
    delta = replay_filter(delta, command) if not command.startswith("/") else delta
    if delta:
        print(delta, end="" if delta.endswith("\n") else "\n")
    else:
        print("No console messages captured in observation window (command may still be processing).")
    if not delta and not rc:
        print("HTTP accepted the request; this is not proof the guest command completed.")
    return rc


def verify_tape_address(address: str, *, timeout: float, settle: float) -> bool:
    """Fail closed unless a fresh inventory proves this is an idle tape drive."""
    rc, delta = capture("devlist", timeout=timeout, settle=settle)
    if rc or "HHC01603I devlist" not in delta:
        print("Tape safety check failed: no verified DEVLIST response.", file=sys.stderr)
        return False
    row = device_rows(delta).get(address.upper().zfill(4))
    if row is None or row[0] not in TAPE_TYPES:
        print(f"Tape safety check refused {address}: not a recognized tape drive.", file=sys.stderr)
        return False
    if re.search(r"\bbusy\b", row[1], flags=re.I):
        print(f"Tape safety check refused {address}: device reports busy.", file=sys.stderr)
        return False
    print("Verified tape device: " + row[2])
    return True


def confirm(risk: str, displayed: str, *, yes: bool, allow_disruptive: bool, dry_run: bool) -> bool:
    if dry_run or risk == "inquiry":
        return True
    if risk == "disruptive" and not allow_disruptive:
        print("Refused disruptive command. Re-run with --allow-disruptive and confirm interactively.", file=sys.stderr)
        return False
    if risk == "operational" and yes:
        return True
    if not sys.stdin.isatty():
        print("Confirmation required from a terminal. --yes permits operational (not disruptive) commands.", file=sys.stderr)
        return False
    print(f"{risk.upper()} command: {displayed}")
    return input("Type YES to send: ").strip() == "YES"


def execute(args: list[str], opts: argparse.Namespace) -> int:
    if not args:
        show_help()
        return 0
    verb, *words = args
    verb = verb.lower()
    if verb in ("quit", "exit"):
        return 99
    if verb in ("help", "?"):
        # Accept optional trailing question mark and nested Hercules device help.
        topics = words[:-1] if words and words[-1] == "?" else words
        if len(topics) == 2 and [w.lower() for w in topics] == ["hercules", "devices"]:
            show_device_help()
            return 0
        if len(topics) > 1:
            raise ValueError("usage: help [TOPIC]")
        show_help(None if not topics else topics[0].lower())
        return 0
    if verb == "devices":
        if not words:
            show_devices()
        elif len(words) == 1 and words[0].lower() in ("help", "?"):
            print("devices: static IBM device model directory. Use hercules devices for live inventory.")
        else:
            raise ValueError("usage: devices [help|?]")
        return 0
    if verb in ("mvs", "jes2", "hercules", "tape") and words and words[0].lower() in ("help", "?"):
        if len(words) != 1:
            raise ValueError(f"usage: {verb} [help|?]")
        show_help(verb)
        return 0
    if verb == "commands":
        if len(words) > 1:
            raise ValueError("usage: commands [DOMAIN|?]")
        show_catalog(None if not words or words[0] == "?" else words[0].lower())
        return 0
    if verb == "explain" and (not words or words == ["?"]):
        print("usage: explain DOMAIN NAME-OR-COMMAND")
        return 0
    if verb == "explain":
        if len(words) < 2:
            raise ValueError("usage: explain DOMAIN NAME-OR-COMMAND")
        d = words[0].lower()
        if d == "tape":
            show_help("tape")
        elif d in CATALOG:
            command, alias = resolved(d, words[1:])
            info = CATALOG[d].get(words[1].lower()) if len(words) == 2 else None
            print((info[1] if info else "Raw console command") + f"\nUnderlying: {normalize(d, command)}")
            print("Classification: " + classify(d, command, alias))
            print("Commands may change system state; inspect exact syntax before sending.")
        else:
            raise ValueError("unknown console domain")
        return 0
    if verb == "status":
        print("Hercules/TK5 Docker container: " + ("running" if docker_running() else "stopped"))
        print("Console log: " + str(LOG) + (" (present)" if LOG.is_file() else " (missing)"))
        return 0
    if verb == "tape" and words and words[0].lower() == "files":
        if len(words) != 1:
            raise ValueError("usage: tape files")
        if not TAPES.is_dir():
            raise RuntimeError(f"tape directory does not exist: {TAPES}")
        for p in sorted(TAPES.iterdir()):
            if p.is_file():
                print(f"{p.name}\t{p.stat().st_size} bytes")
        return 0
    if verb == "tape" and (not words or words[0].lower() == "help"):
        show_help("tape")
        return 0
    device_filter = None
    if verb == "tape":
        d, command, alias = tape_command(words)
        risk = "operational" if words[0].lower() in ("mount", "unmount") else "inquiry"
    elif verb == "hercules" and words and words[0].lower() == "devices":
        if len(words) == 2 and words[1].lower() in ("?", "help"):
            show_device_help()
            return 0
        if len(words) > 2:
            raise ValueError("usage: hercules devices [CATEGORY|?|help]")
        device_filter = device_category(words[1]) if len(words) == 2 else None
        d, command, alias = "hercules", "devlist", True
        risk = "inquiry"
    elif verb in CATALOG:
        d = verb
        command, alias = resolved(d, words)
        risk = classify(d, command, alias)
    else:
        raise ValueError(f"unknown command '{verb}' (try 'help')")
    wire = normalize(d, command)
    print(f"[{d} / {risk}] {wire}")
    if opts.dry_run:
        print("DRY RUN: no console command issued")
        return 0
    if verb == "tape" and words[0].lower() in ("mount", "unmount"):
        # Never change media without a fresh, independently parsed tape inventory.
        # Dry-runs above deliberately skip all console communication.
        if not verify_tape_address(words[1], timeout=opts.timeout, settle=opts.settle):
            return 3
    if not confirm(risk, wire, yes=opts.yes, allow_disruptive=opts.allow_disruptive, dry_run=False):
        return 3
    tape_action = words[0].lower() if verb == "tape" else ""
    return dispatch(wire, timeout=opts.timeout, settle=opts.settle,
                    tape_only=tape_action in ("list", "devices", "status"),
                    tape_address=words[1] if tape_action == "status" else None,
                    device_filter=device_filter)


def repl(opts: argparse.Namespace) -> int:
    print("TK5 console — 'help' for commands, 'quit' to leave. Commands run against real MVS/Hercules.")
    history: list[str] = []
    readline.clear_history()  # No history file; only the current session.
    while True:
        try:
            line = input("mvs> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if not line:
            continue
        if line == "history":
            for i, item in enumerate(history, 1):
                print(f"{i:3} {item}")
            continue
        history.append(line)
        readline.add_history(line)
        try:
            rc = execute(shlex.split(line), opts)
            if rc == 99:
                return 0
            if rc:
                print(f"Command status: {rc}")
        except (ValueError, RuntimeError, OSError, subprocess.TimeoutExpired) as e:
            print(f"Error: {e}", file=sys.stderr)


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(description=__doc__, add_help=True)
    p.add_argument("--dry-run", action="store_true", help="show exact command without sending")
    p.add_argument("--yes", action="store_true", help="allow noninteractive operational commands")
    p.add_argument("--allow-disruptive", action="store_true", help="allow disruptive commands with typed confirmation")
    p.add_argument("--timeout", type=float, default=10, help="HTTP transport timeout in seconds (default 10)")
    p.add_argument("--settle", type=float, default=0.8, help="seconds to observe messages after HTTP (default 0.8)")
    p.add_argument("args", nargs=argparse.REMAINDER)
    opts = p.parse_args(argv)
    if opts.timeout <= 0 or opts.settle < 0:
        p.error("--timeout must be positive and --settle nonnegative")
    try:
        if not opts.args:
            return repl(opts)
        return max(0, execute(opts.args, opts))
    except (ValueError, RuntimeError, OSError, subprocess.TimeoutExpired) as e:
        print(f"Error: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
