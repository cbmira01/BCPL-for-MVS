def classify(domain: str, command: str, alias: bool = False) -> str:
    """Conservatively classify only well-known read/display forms as inquiries."""
    s = command.strip()
    if alias and domain in CATALOG and any(s == v[0] for v in CATALOG[domain].values()):
        return "inquiry"
    if domain == "mvs" and re.fullmatch(r"D(?:ISPLAY)?\s+(?:A,L|U,(?:DASD|TAPE)(?:,ONLINE)?)", s, re.I):
        return "inquiry"
    if domain == "jes2" and re.fullmatch(r"\$D\s+(?:U,(?:PRTS|PUNS)|I)", s, re.I):
        return "inquiry"
    if domain == "hercules" and re.fullmatch(r"(?:devlist(?:\s+[0-9a-fA-F]{3,4})?|help(?:\s+[a-zA-Z0-9_-]+)?)", s, re.I):
        return "inquiry"
    if domain == "hercules" and re.match(r"^(?:quit|exit|ipl|stop|start|detach|attach|devinit|shut|sysreset|store|loadcore)\b", s, re.I):
        return "disruptive"
    if domain == "jes2" and re.match(r"^\$(?:P|S|C|Z|H|R|E)\b", s, re.I):
        return "disruptive"
    if domain == "mvs" and re.match(r"^(?:C(?:ANCEL)?|P(?:\s|$)|V\s|M\s|S\s|HALT|Z\s|REPLY\s)\b", s, re.I):
        return "disruptive"
    return "operational"


def normalize(domain: str, command: str) -> str:
    if not command or any(ord(c) < 32 or ord(c) == 127 for c in command):
        raise ValueError("command must be a nonempty single line without control characters")
    command = command.strip()
    if not command or len(command) > 240:
        raise ValueError("command must be 1–240 characters")
    if domain == "hercules":
        if command.startswith("/"):
            raise ValueError("Hercules commands must not begin with '/' (reserved for MVS)")
        return command
    if domain == "jes2":
        if command.startswith("/"):
            command = command[1:]
        if not command.startswith("$"):
            raise ValueError("JES2 command must start with '$'; use 'jes2 printers' for an alias")
    if command.startswith("/"):
        command = command[1:]
    return "/" + command


def resolved(domain: str, words: list[str]) -> tuple[str, bool]:
    if not words:
        raise ValueError(f"missing {domain} command; try 'commands {domain}'")
    if len(words) == 1 and words[0].lower() in CATALOG.get(domain, {}):
        return CATALOG[domain][words[0].lower()][0], True
    return " ".join(words), False


def tape_command(args: list[str]) -> tuple[str, str, bool] | None:
    """Return (domain, command, alias) for tape operations; read-only actions handled by caller."""
    action = args[0].lower() if args else "help"
    if action in ("list", "devices"):
        if len(args) != 1:
            raise ValueError("usage: tape list")
        return ("hercules", "devlist", True)
    if action == "status":
        if len(args) != 2 or not re.fullmatch(r"[0-9A-Fa-f]{3,4}", args[1]):
            raise ValueError("usage: tape status ADDRESS (3 or 4 hexadecimal digits)")
        return ("hercules", "devlist", True)  # filter full inventory locally
    if action in ("mount", "unmount"):
        expected = 3 if action == "mount" else 2
        if len(args) != expected or not re.fullmatch(r"[0-9A-Fa-f]{3,4}", args[1]):
            raise ValueError(f"usage: tape {action} ADDRESS" + (" FILENAME" if action == "mount" else ""))
        addr = args[1].upper()
        if action == "unmount":
            return ("hercules", f"devinit {addr} *", False)
        name = args[2]
        if name != Path(name).name or not re.fullmatch(r"[A-Za-z0-9_.-]+", name) or name in (".", ".."):
            raise ValueError("mount accepts a single filename from mvs-state/tape (no paths/spaces)")
        target = TAPES / name
        if not target.is_file() or target.is_symlink():
            raise ValueError(f"not an ordinary tape file: {target}")
        return ("hercules", f"devinit {addr} /tk5/tape/{name}", False)
    raise ValueError("tape commands: list, files, status ADDRESS, mount ADDRESS FILENAME, unmount ADDRESS")


def show_catalog(domain: str | None = None) -> None:
    domains = (domain,) if domain else tuple(CATALOG)
    for d in domains:
        if d == "tape":
            print("tape list | tape files | tape status ADDRESS | tape mount ADDRESS FILENAME | tape unmount ADDRESS")
        elif d in CATALOG:
            print(f"{d}:")
            for key, (raw, description) in CATALOG[d].items():
                print(f"  {key:<12} {description}  [{raw}]")
        else:
            raise ValueError(f"unknown catalog '{d}'")


def show_help(topic: str | None = None) -> None:
    if not topic:
        print("mvs-console — one-shot commands or interactive operator console\n")
        print("  mvs-console [--dry-run] [--yes] mvs|jes2|hercules COMMAND")
        print("  mvs-console [--dry-run] [--yes] tape ACTION ...")
        print("  mvs-console                 interactive REPL")
        print("  mvs-console status          inspect Docker/TK5 without console commands")
        print("  mvs-console devices         list IBM device models (offline)")
        print("  mvs-console commands [DOMAIN] | help [TOPIC] | explain DOMAIN COMMAND")
        print("  mvs-console --help          full CLI options\n")
        print("Help topics: " + ", ".join(TOPICS))
        print("In the REPL: help or ?, commands, devices, explain, history, quit.")
        print("Use DOMAIN ? or hercules devices ? for local help. Quote commands containing spaces.")
        print("Operational commands require confirmation; disruptive commands need --allow-disruptive plus confirmation.")
    elif topic in TOPICS:
        print(f"{topic}: {TOPICS[topic]}")
    elif topic in CATALOG or topic == "tape":
        show_catalog(topic)
    else:
        raise ValueError(f"unknown help topic '{topic}'")


def docker_running() -> bool:
    p = subprocess.run(["docker", "inspect", "--format", "{{.State.Running}}", CONTAINER],
                       capture_output=True, text=True, timeout=10, check=False)
    if p.returncode:
        raise RuntimeError("Docker container mvs38j is unavailable: " + p.stderr.strip())
    return p.stdout.strip() == "true"


def log_offset() -> int:
    if not LOG.is_file():
        raise RuntimeError(f"missing Hercules log: {LOG}")
    return LOG.stat().st_size


def read_delta(start: int) -> str:
    with LOG.open("rb") as f:
        if f.seek(0, os.SEEK_END) < start:
            raise RuntimeError("Hercules console log rotated/truncated during command")
        f.seek(start)
        return f.read().decode("utf-8", "replace")


def device_rows(output: str) -> dict[str, tuple[str, str, str]]:
    """Parse Hercules DEVLIST, retaining just the first report of each device."""
    rows: dict[str, tuple[str, str, str]] = {}
    for line in output.splitlines():
        m = DEVICE_LINE.search(line)
        if m:
            addr = m.group("address").upper()
            rows.setdefault(addr, (m.group("type"), m.group("detail"), line))
    return rows


def tape_rows(output: str) -> dict[str, tuple[str, str, str]]:
    return {address: row for address, row in device_rows(output).items()
            if row[0] in TAPE_TYPES}



# Local devlist categories: these filter emulator output, never issue a new command.
DEVICE_GROUPS = {
    "dasd": {"2305", "2311", "2314", "3330", "3340", "3350", "3375", "3380", "3390", "9345"},
    "tape": set(TAPE_TYPES),
    "printer": {"1403", "3211", "3287"},
    "card": {"1442", "2501", "2540", "3505", "3525"},
    "terminal": {"1052", "3215", "3270"},
    "communications": {"2703", "3705"},
}
DEVICE_ALIASES = {
    "disks": "dasd", "disk": "dasd", "tapes": "tape",
    "printers": "printer", "cards": "card", "terminals": "terminal",
    "comms": "communications",
}


def device_category(name: str) -> str:
    category = DEVICE_ALIASES.get(name.lower(), name.lower())
    if category not in DEVICE_GROUPS:
        raise ValueError(
            f"unknown device category '{name}'. Use: dasd, tape, printer, "
            "card, terminal, communications")
    return category


def show_device_help() -> None:
    print("hercules devices [dasd|tape|printer|card|terminal|communications]")
    print("  No category: full Hercules devlist; category: local filtered inquiry.")
    print("  hercules devices ?   display this help")
