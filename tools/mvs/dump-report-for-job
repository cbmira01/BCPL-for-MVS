#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 && $# -ne 3 ]] || [[ ! $1 =~ ^[0-9]+$ ]]; then
    echo "Usage: $(basename "$0") JOB_NUMBER [--cursor-file FILE]" >&2
    exit 2
fi

JOB_NUMBER=$1
cursor_file=""
if (( $# == 3 )); then
    if [[ $2 != --cursor-file || -z $3 ]]; then
        echo "Usage: $(basename "$0") JOB_NUMBER [--cursor-file FILE]" >&2
        exit 2
    fi
    cursor_file=$3
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
REPORT="$ROOT/mvs-state/prt/prt00e.txt"

if [[ ! -f "$REPORT" ]]; then
    echo "$(basename "$0"): Printer output file does not exist: $REPORT" >&2
    exit 1
fi

# Preserve the existing full-file path unless the caller explicitly opted in.
# A bad cursor makes the entire pipeline fail; it cannot fall back to old JES data.
awk_program='
BEGIN {
    pattern = sprintf("JOB %4d", job)
    in_job = 0
    found = 0
    completed = 0
    n = 0
}
# Every START resets the buffer: JES numbers can wrap and be reused.
index($0, "****A  START") && index($0, pattern) {
    in_job = 1
    found = 1
    completed = 0
    n = 0
    next
}
in_job && index($0, "****A   END") && index($0, pattern) {
    in_job = 0
    completed = 1
    next
}
in_job {
    gsub(/\f/, "\r\n")
    buffer[++n] = $0
}
END {
    if (!found) {
        print "Job " job " not found in printer output." > "/dev/stderr"
        exit 1
    }
    if (!completed) {
        print "Job " job " has no END JOB banner." > "/dev/stderr"
        exit 1
    }
    for (i = 1; i <= n; i++) print buffer[i]
}
'
if [[ -n $cursor_file ]]; then
    python3 "$ROOT/tools/mvs/printer-window.py" read \
        --printer "$REPORT" --cursor-file "$cursor_file" |
        LC_ALL=C awk -v job="$JOB_NUMBER" "$awk_program"
else
    LC_ALL=C awk -v job="$JOB_NUMBER" "$awk_program" "$REPORT"
fi
