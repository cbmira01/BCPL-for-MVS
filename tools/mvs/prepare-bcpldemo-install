#!/usr/bin/env python3
"""Prepare the private, authenticated R.5 BCPLDEMO install JCL.

This tool does not submit jobs or write MVS datasets. The resulting deck
contains site credentials and must stay in the ignored workarea.
"""
from __future__ import annotations

import importlib.util
import os
from pathlib import Path
import tempfile


ROOT = Path(__file__).resolve().parents[2]
CORE = ROOT / "tools/datasets/dspal-core.py"
SOURCE = ROOT / "bootstrap-toolchain/extensions/bcpldemo/install-bcpldemo.jcl"
OUTPUT = ROOT / "workarea/runtime-extensions-r5/install-bcpldemo.jcl"


def load_core():
    spec = importlib.util.spec_from_file_location("r5_dspal_core", CORE)
    if spec is None or spec.loader is None:
        raise ValueError("cannot load dspal configuration support")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def make_deck(core, config: dict, source: str) -> str:
    """Use the configured identity; refuse site-specific DSN mismatches."""
    for alias in ("EXT_ASM", "EXT_OBJ"):
        dsn = core.full_dsn(config, config["datasets"][alias])
        operand = f"DSN={dsn}(BCPLDEMO)"
        if operand not in source:
            raise ValueError(
                f"install JCL does not target the configured {alias}: {dsn}"
            )
    if any(" JOB " in line for line in source.splitlines()
           if line.startswith("//") and not line.startswith("//*")):
        raise ValueError("installation body must not contain a JOB card")
    card = core.authenticated_job_card(
        config, "R5DINST", "R5 BCPLDEMO", False
    )
    deck = "\n".join(card) + "\n" + source
    if any(not line.isascii() or len(line) > 80
           for line in deck.splitlines()):
        raise ValueError("JCL contains non-ASCII or overlength FB80 record")
    return deck


def write_private_deck(deck: str, output: Path) -> None:
    """Replace the ignored workarea deck atomically, with mode 0600."""
    output.parent.mkdir(parents=True, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix=".bcpldemo-", dir=output.parent)
    try:
        with os.fdopen(fd, "w", encoding="ascii", newline="\n") as handle:
            handle.write(deck)
        os.chmod(temp, 0o600)
        os.replace(temp, output)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def main() -> int:
    core = load_core()
    config = core.load_config()
    source = SOURCE.read_text(encoding="ascii")
    deck = make_deck(core, config, source)
    write_private_deck(deck, OUTPUT)
    print(f"Prepared private install deck: {OUTPUT.relative_to(ROOT)}")
    print("Not submitted; inspect and approve the MVS installation separately.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        raise SystemExit(f"BCPLDEMO install preparation failed: {error}")
