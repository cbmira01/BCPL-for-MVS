#!/usr/bin/env python3
"""Regenerate disposable MR10/Cambridge bootstrap inputs from Git sources.

No dspal calls or PDS population occurs here. The --with-trnilrg
option runs resident MR10 jobs through the installed ICINT19 interpreter;
it therefore requires a completed interpreter rebuild.
"""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[2]
BASE = ROOT / "workarea/bootstrap-cambridge"
DEMOTED = ("blib", "bcpl", "syn", "lex", "trna", "trnb",
           "cga", "cgb", "cgc", "cgd", "cge")
DIAG = ("cga", "cgb", "cgc", "cgd", "cge")
MR10 = ("trnhdr", "trn0", "trn1", "trn2", "trn3", "trn4", "trn5", "trn6")
INPUTS = (
    "bootstrap-toolchain/bootstrap-cambridge/make-demoted.py",
    "bootstrap-toolchain/bootstrap-cambridge/make-mr10-trn-large-names.py",
    "bootstrap-toolchain/bootstrap-cambridge/build-mr10-trni-large-names.sh",
    "bootstrap-toolchain/bootstrap-cambridge/source/syn",
    "bootstrap-toolchain/bootstrap-cambridge/source/trn",
    "bootstrap-toolchain/bootstrap-cambridge/bootstrap-host.bcpl",
    "richards-bcpltape/bcplib/bcpl/bcpl",
    "richards-bcpltape/bcplib/bcpl/blib",
    "richards-bcpltape/bcplib/bcpl/cg",
    "richards-bcpltape/mr10/bcplkit/trn",
    "richards-bcpltape/sys3/bcpl/libhdr",
    "bootstrap-toolchain/bootstrap-cambridge/options-large-tree.txt",
    "mr10-kit-compiler/asm/icintv19.asm",
    "tools/mr10/compile-and-run",
    "mr10-kit-compiler/source/syni.int",
    "mr10-kit-compiler/source/cgi.int",
    "mr10-kit-compiler/source/blibi.int",
    "mr10-kit-compiler/source/iclib.int",
)


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def outputs(include_intcode: bool) -> list[Path]:
    files = ([BASE / "demoted" / x for x in DEMOTED]
             + [BASE / "demoted-diag" / x for x in DIAG]
             + [BASE / "mr10-trn-large-names" / x for x in MR10])
    if include_intcode:
        files.append(BASE / "trni-large-names.int")
    return files


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check-inputs", action="store_true",
                        help="check tracked source paths; write nothing")
    parser.add_argument("--with-trnilrg", action="store_true",
                        help="also rebuild TRNILRG via live compile-and-run; MVS required")
    args = parser.parse_args()
    missing = [name for name in INPUTS if not (ROOT / name).is_file()]
    if missing:
        for name in missing:
            print(f"MISSING INPUT: {name}", file=sys.stderr)
        return 2
    if args.check_inputs:
        print(f"READY: {len(INPUTS)} repository input paths present; no files written")
        return 0

    BASE.mkdir(parents=True, exist_ok=True)
    manifest = BASE / "prepare-bootstrap-manifest.json"
    # A failed regeneration must never leave an old manifest looking current.
    manifest.unlink(missing_ok=True)
    commands = [
        [sys.executable, "bootstrap-toolchain/bootstrap-cambridge/make-demoted.py"],
    ]
    if args.with_trnilrg:
        # The build script regenerates MR10 translator sections itself.
        commands.append(["bash", "bootstrap-toolchain/bootstrap-cambridge/build-mr10-trni-large-names.sh"])
    else:
        commands.append([sys.executable, "bootstrap-toolchain/bootstrap-cambridge/make-mr10-trn-large-names.py"])
    for cmd in commands:
        print("+", " ".join(cmd), flush=True)
        subprocess.run(cmd, cwd=ROOT, check=True)

    files = outputs(args.with_trnilrg)
    missing = [str(p.relative_to(ROOT)) for p in files if not p.is_file()]
    if missing:
        for name in missing:
            print(f"MISSING OUTPUT: {name}", file=sys.stderr)
        return 3
    data = {
        "format": 1,
        "generator": "tools/bootstrap/prepare-bootstrap",
        "trnilrg_rebuilt": args.with_trnilrg,
        "inputs": {p: digest(ROOT / p) for p in INPUTS},
        "outputs": {str(p.relative_to(ROOT)): digest(p) for p in files},
    }
    manifest.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(f"READY: {len(files)} generated outputs; SHA-256 inventory: {manifest.relative_to(ROOT)}")
    if not args.with_trnilrg:
        print("TRNILRG INTCODE not rebuilt; use --with-trnilrg explicitly when MVS is ready")
    print("No MVS datasets changed.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as exc:
        print(f"FAILED: generator returned {exc.returncode}; no manifest refreshed", file=sys.stderr)
        sys.exit(exc.returncode or 1)
