#!/usr/bin/env python3
"""Run the complete currently executable R.1 evidence campaign on TK5.

One execution compiles the BCPL callers, generates safe temporary-object
JCL, runs independent registration/ownership/lifecycle jobs, then runs the
existing native regression suite using the opt-in temporary R.1 overlay.
No ZIP/installer, commit, push, or persistent MVS object-library writes.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[2]
PROBES = ROOT / 'bootstrap-toolchain/probes/r1-registration'
GENERATED = ROOT / 'workarea/runtime-extensions-r1'
REC = GENERATED / 'acceptance'


def call(*args: str, env=None, timeout=240, allow_error=False):
    cmd = [str(a) for a in args]
    p = subprocess.run(cmd, cwd=ROOT, env=env, text=True, encoding='utf-8',
                       errors='replace', stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT, timeout=timeout)
    if p.returncode and not allow_error:
        raise RuntimeError(f'command failed rc={p.returncode}: '
                           f'{" ".join(cmd)}\n{p.stdout[-3000:]}')
    return p.returncode, p.stdout


def case_spec():
    items = [
        ('empty', 'R1EMPTY', 0, [], ['R1 EMPTY BCPLREG PASS']),
        ('selected', 'R1SELECT', 0, [], ['R1 SELECTED BCPLREG PASS']),
    ]
    items.extend((f'neg-{n}', f'R1N{n}', 8 if n == 2001 else 12,
                  [f'BCPLREG {n}'],
                  ['R1 SELECTED BCPLREG PASS'] if n == 2001 else [])
                 for n in (*range(1001, 1015), 2001))
    items.extend((f'owner-{profile}', job, 12, ['BCPLREG 1009'], [])
                 for profile, (_, job) in {
                     'app': (1, 'R1OAPP'), 'blib': (76, 'R1OBLIB'),
                     'core': (30, 'R1OCORE'),
                 }.items())
    for name, job, rc, trace in (
        ('life-finish', 'R1LFIN', 0,
         ['R1 TRACE FINA FINISH', 'R1 TRACE FINB FINISH']),
        ('life-stop', 'R1LSTOP', 7,
         ['R1 TRACE FINA STOP', 'R1 TRACE FINB STOP']),
        ('life-finish-error', 'R1LFERR', 8,
         ['R1 TRACE FINA FINISH', 'BCPLREG 2001',
          'R1 TRACE FINB FINISH']),
        ('life-stop-error', 'R1LSERR', 7,
         ['R1 TRACE FINA STOP', 'BCPLREG 2001',
          'R1 TRACE FINB STOP']),
    ):
        items.append((name, job, rc, trace,
                      ['R1 LIFECYCLE START'] if 'stop' in name else
                      ['R1 SELECTED BCPLREG PASS']))
    return items


def fixture_path(name: str, run: Path) -> Path:
    if name.startswith('neg-'):
        return run / 'jcl' / f'r1-neg-{name[4:]}.jcl'
    if name.startswith('owner-'):
        return run / 'jcl' / f'r1-owner-{name[6:]}.jcl'
    if name.startswith('life-'):
        return run / 'jcl' / f'r1-life-{name[5:]}.jcl'
    return run / 'jcl' / f'r1-{name}.jcl'


def preflight():
    commands = (
        ('python3', '-m', 'unittest', 'discover', '-s', 'tools/checks',
         '-p', 'test_r1*.py', '-v'),
        ('python3', str(PROBES/'make-negative-jobs.py'), 'all', '--check'),
        ('python3', str(PROBES/'make-owner-jobs.py'), 'all', '--check'),
        ('python3', str(PROBES/'make-lifecycle-jobs.py'), 'all', '--check'),
        ('python3', str(PROBES/'make-jobs.py'), 'empty', '--check'),
        ('python3', str(PROBES/'make-jobs.py'), 'selected', '--check'),
        ('python3', 'tools/checks/r1_prepare_candidate.py', '--check'),
    )
    for c in commands:
        call(*c, timeout=120)
        print(f'PREFLIGHT PASS: {" ".join(c)}', flush=True)
    return len(commands)


def compile_callers(run: Path):
    for source, job, out in (
        ('empty.bcpl', 'R1ECOMP', 'empty.s370.asm'),
        ('selected.bcpl', 'R1SCOMP', 'selected.s370.asm'),
        ('lifecycle-stop.bcpl', 'R1LCOMP', 'lifecycle-stop.s370.asm'),
    ):
        call('tools/bootstrap/compile-mvs', PROBES/source,
             '--job-name', job, '--output', run/'generated'/out, timeout=300)
        if not (run/'generated'/out).is_file():
            raise RuntimeError(f'compiler generated source missing: {out}')
        print(f"COMPILED {source} -> {run / 'generated' / out}", flush=True)


def generate(run: Path):
    env = os.environ.copy()
    env['R1_CAMPAIGN_STAGE'] = str(run/'jcl')
    for profile in ('empty', 'selected'):
        call('python3', PROBES/'make-jobs.py', profile,
             '--generated', run/'generated'/f'{profile}.s370.asm', env=env)
    for path in ('make-negative-jobs.py', 'make-owner-jobs.py'):
        call('python3', PROBES/path, 'all', '--generated',
             run/'generated'/'selected.s370.asm', env=env)
    call('python3', PROBES/'make-lifecycle-jobs.py', 'all',
         '--generated-finish', run/'generated'/'selected.s370.asm',
         '--generated-stop', run/'generated'/'lifecycle-stop.s370.asm', env=env)
    for name, *_ in case_spec():
        deck = fixture_path(name, run)
        if not deck.is_file() or not deck.stat().st_size:
            raise RuntimeError(f'missing JCL deck: {deck}')


def wait_result(job: int, timeout: int):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        rc, out = call('tools/mvs/job-summary', '--max-rc', '12',
                       str(job), timeout=30, allow_error=True)
        if rc in (0, 1) and 'JOB RESULT:' in out:
            return out
        time.sleep(2)
    raise RuntimeError(f'JOB {job} has no completed JES report')


def go_section(report: str, jobname: str) -> str:
    """Use live GO messages, not the IFOX listing of WTO macro text."""
    start = re.search(r'(?m)^IEF236I ALLOC\. FOR '+re.escape(jobname)+
                      r' GO\s*$', report)
    if not start:
        raise ValueError('missing GO allocation section')
    end = re.search(r'(?m)^IEF142I '+re.escape(jobname)+r' GO ',
                    report[start.end():])
    if not end:
        raise ValueError('missing GO completion line')
    return report[start.end():start.end()+end.start()]


def verify_case(spec, summary: str, report: str):
    name, jobname, wanted_rc, wto, markers = spec
    errors = []
    if f'  {jobname}\n' not in summary.split('\n', 1)[0]+'\n':
        errors.append('wrong JES job name')
    if 'ABEND:' in summary or 'JCL ERROR:' in summary or 'BYPASSED:' in summary:
        errors.append('abend, JCL error or bypassed step')
    steps = dict((s, int(rc)) for s, rc in re.findall(
        r'^([A-Z][A-Z0-9]*)\s+\S+\s+RC=(\d{4})$', summary, re.M))
    if not steps or not any(k.startswith('ASM') for k in steps):
        errors.append('missing assembly results')
    for key, value in steps.items():
        if (key.startswith('ASM') or key == 'LKED') and value != 0:
            errors.append(f'{key} RC={value:04d}')
    if steps.get('LKED') != 0:
        errors.append('link-edit did not pass')
    if steps.get('GO') != wanted_rc:
        errors.append(f'GO {steps.get("GO")} instead of {wanted_rc}')
    try:
        executed = go_section(report, jobname)
    except ValueError as exc:
        errors.append(str(exc))
        executed = ''
    last = -1
    for marker in wto:
        matches = list(re.finditer(r'(?m)^\+?'+re.escape(marker)+
                                   r'(?:\s+.*)?$', executed))
        if len(matches) != 1:
            errors.append(f'expected exactly one live marker {marker}: {len(matches)}')
        elif matches[0].start() <= last:
            errors.append(f'out-of-order marker {marker}')
        else:
            last = matches[0].start()
    # Application SYSPRINT is a distinct JES SYSOUT data set; in the
    # combined job report it appears *after* the GO completion record.
    # Only seek clean standalone records after GO allocation, not in
    # source text from earlier assembler listings.
    go_anchor = re.search(r'(?m)^IEF236I ALLOC\. FOR '+
                          re.escape(jobname)+r' GO\s*$', report)
    output_tail = report[go_anchor.end():] if go_anchor else ''
    for marker in markers:
        count = len(re.findall(r'(?m)^'+re.escape(marker)+r'\s*$',
                               output_tail))
        if count != 1:
            errors.append(f'expected one START output {marker}: {count}')
    rejection = (name.startswith('owner-') or
                 (name.startswith('neg-') and name != 'neg-2001'))
    if rejection:
        if re.search(r'(?m)^R1 SELECTED BCPLREG PASS\s*$', output_tail):
            errors.append('rejected job executed START')
        if 'R1 NEGATIVE PARTIAL GLOBAL PUBLICATION' in executed:
            errors.append('transactional publication failure')
    # Confirm the IEWL MAP owns the entry symbols the source-provenance
    # checker accepted. The full MAP/XREF is preserved for owner review.
    required = [('BCPLMAIN','BCPLMAIN'),('RGINIT','RGINIT'),
                ('BCRGBEG','BCPLREG'),('BLIB','BLIB')]
    if name != 'empty':
        required.append(('R1DISP','R1DISP'))
    if name.startswith('life-'):
        required.extend((('R1FINA','R1FINA'),('R1FINB','R1FINB')))
    for symbol,owner in required:
        if not re.search(r'\b'+re.escape(symbol)+r'\s+'+
                         re.escape(owner)+r'\b',report):
            errors.append(f'IEWL MAP lacks {symbol} owner {owner}')
    if 'BAD PARAMETER' in executed:
        errors.append('invalid finalizer ABI parameter')
    if name.startswith('life-'):
        if len(re.findall(r'^\+?R1 TRACE FIN[AB] ', executed, re.M)) != 2:
            errors.append('finalizer once/count failure')
    return 'PASS' if not errors else 'FAIL', errors


def run_jobs(run: Path, timeout: int):
    results = []
    for spec in case_spec():
        name, jobname, *_ = spec
        deck = fixture_path(name, run)
        saved = deck
        if saved.resolve().parent != (run/'jcl').resolve():
            raise RuntimeError('unexpected JCL outside run directory')
        saved.chmod(0o600)
        result = {'case': name, 'jobname': jobname, 'job': None,
                  'result': 'BLOCKED', 'issues': []}
        try:
            _, out = call('bash', 'tools/mvs/submit-jcl', saved, timeout=160)
            match = re.search(r'^JOB\s+(\d+)\s*$', out, re.M)
            if not match:
                raise RuntimeError(f'cannot parse JES number: {out[-600:]}')
            job = int(match.group(1))
            result['job'] = job
            with (run/'jobs.tsv').open('a') as stream:
                stream.write(f'{name}\t{jobname}\t{job}\n')
            summary = wait_result(job, timeout)
            (run/'summaries'/f'{name}.txt').write_text(summary)
            _, report = call('tools/mvs/dump-report-for-job', str(job),
                             timeout=180)
            (run/'reports'/f'{name}.txt').write_text(report)
            verdict, issues = verify_case(spec, summary, report)
            result.update(result=verdict, issues=issues)
        except (RuntimeError, OSError, subprocess.TimeoutExpired) as exc:
            result.update(result='FAIL', issues=[str(exc)])
        results.append(result)
        print(f'{result["result"]:7} {name:19} JOB {result["job"] or "-"} '
              f'{"; ".join(result["issues"])[:180]}', flush=True)
        (run/'results.json').write_text(json.dumps(results, indent=2)+'\n')
    return results


def regression_progress(line: str) -> str | None:
    """Emit just the native panel's case progress, not the full JES listing."""
    line = line.rstrip('\r\n')
    if re.match(r'^(?:RUN|PASS|FAIL|SKIP)\s+\d{2,3}\b', line):
        return 'REGRESSION ' + line
    if line.startswith(('NATIVE REGRESSION COMPLETE',
                        'NATIVE REGRESSION  ',
                        'NATIVE PRODUCTION REGRESSION:')):
        return line
    return None


def stream_native_run(command: list[str], env: dict, transcript: Path,
                      timeout: int, *, poll_seconds: float = 1.0,
                      heartbeat_seconds: float = 30.0) -> int:
    """Watch a child-managed transcript and keep the console informative.

    A separate process group lets a timed-out campaign stop its entire
    native-regression subprocess tree, not just the parent Python process.
    The transcript and case logs stay in this campaign's unique run folder.
    """
    with transcript.open('w', encoding='utf-8') as output:
        proc = subprocess.Popen(command, cwd=ROOT, env=env, stdout=output,
                                stderr=subprocess.STDOUT,
                                start_new_session=True)
        start = time.monotonic()
        last_heartbeat = start
        last_case = '(starting)'
        partial = ''
        def consume(chunk: str):
            nonlocal partial, last_case
            partial += chunk
            while '\n' in partial:
                line, partial = partial.split('\n', 1)
                message = regression_progress(line)
                if message:
                    print(message, flush=True)
                    if message.startswith('REGRESSION RUN '):
                        last_case = line.strip()
        try:
            with transcript.open('r', encoding='utf-8', errors='replace') as watch:
                while True:
                    consume(watch.read())
                    if proc.poll() is not None:
                        consume(watch.read())
                        if partial:
                            message = regression_progress(partial)
                            if message:
                                print(message, flush=True)
                        break
                    now = time.monotonic()
                    if now - start >= timeout:
                        raise subprocess.TimeoutExpired(command, timeout)
                    if now - last_heartbeat >= heartbeat_seconds:
                        elapsed = int(now - start)
                        print(f'REGRESSION ACTIVE {elapsed}s; {last_case}',
                              flush=True)
                        last_heartbeat = now
                    time.sleep(poll_seconds)
        finally:
            if proc.poll() is None:
                # A timeout or interruption must not orphan the JES runner.
                os.killpg(proc.pid, signal.SIGTERM)
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(proc.pid, signal.SIGKILL)
                    proc.wait()
        return proc.returncode


def regress(run: Path, timeout: int):
    env = os.environ.copy()
    env['R1_ACCEPTANCE'] = '1'
    env['R1_REGRESSION_LOG_DIR'] = str(run/'regression-logs')
    env['R1_ACCEPTANCE_WORKDIR'] = str(run/'regression-cases')
    env['PYTHONUNBUFFERED'] = '1'
    transcript = run/'regression-transcript.txt'
    print('REGRESSION PHASE: native 00..145; '
          f'full transcript at {transcript}', flush=True)
    process_rc = stream_native_run(
        ['bash', 'tools/bootstrap/run-production-regression'], env,
        transcript, timeout)
    text = transcript.read_text(errors='replace')
    values = dict(re.findall(r'(?m)^(PASS|FAIL|SKIP|TOTAL)\s+(\d+)\s*$', text))
    verdict = ('PASS' if process_rc == 0 and values.get('PASS') == '145'
               and values.get('FAIL') == '0' and values.get('SKIP') == '1'
               and values.get('TOTAL') == '146' else 'FAIL')
    return {'case': 'candidate-native-regression', 'result': verdict,
            'values': values, 'process_rc': process_rc,
            'issues': [] if verdict == 'PASS' else
            ['expected 145 fresh PASS, zero FAIL, one expected SKIP 083']}


def write_summary(run: Path, results: list[dict], incidents=None,
                  *, regression_required=True):
    incidents = incidents or []
    by_name = {item['case']:item for item in results}
    all_specs = case_spec()
    def group(names):
        seen=[by_name.get(name,{}).get('result') for name in names]
        if 'FAIL' in seen:
            return 'FAIL'
        return 'PASS' if seen and all(x=='PASS' for x in seen) else 'BLOCKED'
    all_integrated=[s[0] for s in all_specs]
    registration=group(['empty','selected']+[f'neg-{n}' for n in range(1001,1015)])
    owners=group([f'owner-{x}' for x in ('app','blib','core')])
    finalizers=group(['neg-2001','life-finish','life-stop',
                      'life-finish-error','life-stop-error'])
    provenance=group(all_integrated)  # each PASS requires IEWL MAP owner check
    baseline=group(['candidate-native-regression']) if regression_required else 'BLOCKED'
    gates=[
        ('registration-and-diagnostics',registration,
         'Real empty/selected BCRG, 1001..1014, transactional witness'),
        ('effective-owner-ledger',owners,
         'Actual application/BLIB/Core writer-tag witnesses'),
        ('finalizer-lifecycle',finalizers,
         'Reverse order; once; FINISH/STOP; nonzero status policy'),
        ('source-trust-and-linker-provenance',provenance,
         'Build-time A(SYMBOL)/ENTRY checks and live IEWL MAP ownership'),
        ('candidate-native-regression',baseline,
         'Fresh 145 PASS, 0 FAIL, one expected SKIP 083'),
    ]
    rows=['# R.1 — consolidated MVS acceptance evidence', '',
          f'Run: `{run.name}`', '',
          '| Gate | Status | Basis |','|---|---|---|']
    for name,status,reason in gates:
        rows.append(f'| {name} | {status} | {reason} |')
    rows.extend(['','| Case | JES job | Status | Issue |',
                 '|---|---:|---|---|'])
    for x in results:
        detail='; '.join(x.get('issues',[]))[:150].replace('|','/')
        rows.append(f'| {x["case"]} | {x.get("job") or "—"} | '
                    f'{x["result"]} | {detail} |')
    for incident in incidents:
        rows.append('| campaign-preparation | — | FAIL | '+
                    str(incident)[:150].replace('|','/')+' |')
    ready=not incidents and all(status=='PASS' for _,status,_ in gates)
    rows.extend(['',
        '**Gate disposition: '+('READY FOR OWNER REVIEW' if ready else
          'NOT READY — examine FAIL/BLOCKED entries')+'**.',
        'The campaign is evidence, not automatic R.1 closure or R.2 start.',
        'The owner must inspect the actual MVS evidence and authorize closure.',
        'No BOOT_OBJ/BOOT_DEVOBJ installation or promotion was performed.',
        'IEWL maps, JCL, reports and regression logs remain in this run.',
        'G!150 FORMTREE/DEBUGINT remains separately unresolved.',
        'Source trust is a controlled link-preparation guarantee, not '
        'arbitrary runtime executable-memory protection.',
        ''])
    (run/'SUMMARY.md').write_text('\n'.join(rows))
    print(f'R.1 evidence summary: {run/"SUMMARY.md"}', flush=True)
    return not ready


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--execute', action='store_true',
                   help='compile/submit integrated jobs and run native panel')
    p.add_argument('--skip-regression', action='store_true',
                   help='diagnostics only; never full R.1 acceptance')
    p.add_argument('--job-timeout', type=int, default=240)
    p.add_argument('--regression-timeout', type=int, default=10800)
    a = p.parse_args()
    preflight()
    if not a.execute:
        print('PREPARE-ONLY: no MVS jobs submitted or files written')
        print('For full campaign use --execute')
        return 0
    # Never overwrite a previous run: unique directories and exclusive mode.
    REC.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')
    run = REC/stamp
    for folder in ('jcl', 'generated', 'summaries', 'reports',
                   'regression-logs', 'regression-cases'):
        (run/folder).mkdir(parents=True, exist_ok=False)
    (run/'jobs.tsv').write_text('case\tjobname\tjes_number\n')
    results, incidents = [], []
    try:
        compile_callers(run)
        generate(run)
        results = run_jobs(run, a.job_timeout)
        if not a.skip_regression:
            try:
                result = regress(run, a.regression_timeout)
            except (RuntimeError, OSError, subprocess.TimeoutExpired) as exc:
                result = {'case': 'candidate-native-regression',
                          'result': 'FAIL', 'issues': [str(exc)]}
            results.append(result)
            (run/'results.json').write_text(json.dumps(results, indent=2)+'\n')
            print(f'{result["result"]} candidate-native-regression', flush=True)
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as exc:
        incidents.append(str(exc))
        print(f'CAMPAIGN PREPARATION FAILED: {exc}', file=sys.stderr, flush=True)
    failed = write_summary(run, results, incidents,
                           regression_required=not a.skip_regression)
    return 1 if failed else 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as exc:
        print(f'R.1 campaign preflight FAILED: {exc}', file=sys.stderr)
        sys.exit(2)
