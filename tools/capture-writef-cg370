#!/usr/bin/env python3
"""Capture baseline and instrumented CG370 assembler without executing target code.

This is deliberately an observational tool. It does not rebuild or install BLIB.
"""
from __future__ import annotations

import argparse
import datetime
import re
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
COMPILER = ROOT / "tools/cambridge-compile-mvs"
CHECK = ROOT / "native-compiler/bootstrap-cambridge/check-cg370-diagnostic.py"
CASE_ROOT = ROOT / "native-compiler/regression"
BLIB_SOURCE = ROOT / "workarea/bootstrap-cambridge/demoted/blib"


def run(argv: list[str], log: Path) -> None:
    result = subprocess.run(argv, cwd=ROOT, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, check=False)
    log.write_text(result.stdout, encoding="utf-8")
    print(f"{' '.join(argv[-5:])}: exit {result.returncode} (log {log})")
    if result.returncode:
        print(result.stdout[-4000:], file=sys.stderr)
        jobs = re.findall(r"^JOB ([0-9]+)\\s*$", result.stdout, re.MULTILINE)
        if jobs:
            job = jobs[-1]
            report_path = log.with_name(log.stem + ".job-report.txt")
            report = subprocess.run(
                ["bash", str(ROOT / "tools/dump-report-for-job"), job],
                cwd=ROOT, text=True, stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT, check=False,
            )
            report_path.write_text(report.stdout, encoding="utf-8")
            print(f"Failed compiler JOB {job}: report {report_path} "
                  f"(report tool exit {report.returncode})", file=sys.stderr)
        raise RuntimeError(f"failed: {' '.join(argv)}")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--cases", nargs="+", type=int, default=[75, 76, 81])
    ap.add_argument("--include-blib", action="store_true",
                    help="also compile demoted historical BLIB via both generators")
    ap.add_argument("--output-dir", type=Path,
                    help="evidence directory (defaults to timestamped workarea folder)")
    args = ap.parse_args()
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    out = args.output_dir or ROOT / "workarea/writef-cg370-evidence" / stamp
    if not out.is_absolute():
        out = ROOT / out
    out.mkdir(parents=True, exist_ok=True)
    sources: list[tuple[str, Path]] = []
    for n in args.cases:
        matches = sorted(CASE_ROOT.glob(f"{n:03d}-*/source.bcpl"))
        if len(matches) != 1:
            raise RuntimeError(f"test {n}: expected exactly one source, found {len(matches)}")
        sources.append((f"reg{n:03d}", matches[0]))
    if args.include_blib:
        if not BLIB_SOURCE.is_file():
            raise RuntimeError(
                f"missing {BLIB_SOURCE}; run "
                "python3 native-compiler/bootstrap-cambridge/make-demoted.py --blib-only"
            )
        sources.append(("historical-blib", BLIB_SOURCE))
    manifest = [
        "WRITEF CG370 capture: independent baseline + diagnostic compilations",
        "Instrumented image: HERC02.BCPL.INTCODE(CG370D)",
        "Baseline image: HERC02.BCPL.INTCODE(CAMBCOMP)",
        "Check: strip * CG370-DIAG: lines; remaining ASM must match byte-for-byte",
        "NOTE: PDS member contents must correspond to checked-in source/build.",
        "NOTE: This capture does not prove installed OBJ(BLIB) corresponds to this source.",
    ]
    for i, (label, source) in enumerate(sources):
        print(f"=== {label}: {source.relative_to(ROOT)} ===", flush=True)
        baseline = out / f"{label}.baseline.s370.asm"
        diag = out / f"{label}.cg370d.s370.asm"
        job_base = f"WF{i:02d}"
        for image, dest, suffix in [
            ("CAMBCOMP", baseline, "B"),
            ("CG370D", diag, "D"),
        ]:
            run([
                sys.executable, str(COMPILER), str(source),
                "--compiler-image", image,
                "--job-name", job_base + suffix,
                "--output", str(dest)
            ], out / f"{label}.{image}.compile.log")
        run([sys.executable, str(CHECK), str(baseline), str(diag)],
            out / f"{label}.equivalence.log")
        diagnostics = [line for line in diag.read_text(encoding="latin-1").splitlines()
                       if line.startswith("* CG370-DIAG:")]
        (out / f"{label}.diagnostics.txt").write_text(
            "\n".join(diagnostics) + "\n", encoding="latin-1")
        manifest.append(f"{label}: {source.relative_to(ROOT)}; "
                        f"{len(diagnostics)} diagnostic comments; equivalence PASS")
    (out / "MANIFEST.txt").write_text("\n".join(manifest) + "\n", encoding="utf-8")
    print(f"Evidence saved: {out}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError) as exc:
        print(f"capture-writef-cg370: {exc}", file=sys.stderr)
        raise SystemExit(1)
