def sealed_evidence(rel, expected):
    need(isinstance(rel,str) and Path(rel).parts[:1]==('workarea',) and '..' not in Path(rel).parts,
         'evidence must be an existing relative workarea directory')
    p=ROOT/rel
    need(p.is_dir() and not p.is_symlink() and p.resolve().is_relative_to(WORK.resolve()),'unsafe evidence directory')
    seal=p/'SHA256SUMS'
    need(SHA.fullmatch(expected) and digest(seal)==expected,'input evidence seal differs')
    names=set()
    for line in seal.read_text('ascii').splitlines():
        match=re.fullmatch(r'([a-f0-9]{64})  ([A-Za-z0-9_.-]+)',line)
        need(match and match[2] not in names and match[2] not in ('.','..','SHA256SUMS'),'invalid evidence seal')
        names.add(match[2]); need(digest(p/match[2])==match[1],'input evidence member differs')
    need(names and names=={x.name for x in p.iterdir()}-{'SHA256SUMS'},'evidence seal incomplete')


