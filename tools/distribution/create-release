    base=base_manifest()
    expected=deepcopy(base); expected['release'].update(candidate_id=cid,version=cid[5:],source_commit=manifest['release']['source_commit'])
    expected['volume'].update(volser=vol,registry_reservation=cid)
    expected['producer_inputs']=manifest['producer_inputs']
    need(manifest==expected,'unsupported candidate manifest change')
    need(rows==base['datasets'] and manifest['profiles']==base['profiles'] and
         manifest['release']['native_compiler']=='absent' and manifest['release']['cambridge_source']=='included',
         'only the accepted RC4 selection and three profiles are supported')
    serial=vol[2:]; stage=f'{HLQ}.BCPL.R{serial}ST.'
