    bind=cmd('docker-tape-bind','docker','inspect','-f',
             '{{range .Mounts}}{{if eq .Destination "/tk5/tape"}}{{.Source}}{{end}}{{end}}','mvs38j').strip()
    need(bind and Path(bind).resolve()==TAPES.resolve(),'Docker tape bind differs')
    cp=subprocess.run(['docker','inspect','-f','{{json .Config.Env}}','mvs38j'],cwd=ROOT,capture_output=True,text=True,timeout=30)
    need(cp.returncode==0,'Docker identity unavailable')
    env=dict(x.split('=',1) for x in json.loads(cp.stdout) if '=' in x)
    need(env.get('MVS_UID')==str(os.getuid()) and env.get('MVS_GID')==str(os.getgid()),'Docker tape UID/GID mismatch')
    helptext=cmd('hetinit-help','docker','exec','mvs38j','hetinit','-h')
    need('-d' in helptext and '-i' in helptext,'HETINIT options differ')



def valid_plan(cid):
    need(cid.startswith('BCPL-') and VERSION.fullmatch(cid[5:]),'invalid candidate name')
    path=MANIFESTS/(cid+'.yaml'); git('ls-files','--error-unmatch',str(path.relative_to(ROOT)))
    data=path.read_bytes(); manifest=r.read_manifest(path)
    need(manifest['release']['candidate_id']==cid,'candidate/file mismatch')
    vol=check_reservation(read_registry(),manifest,data)
    check_inputs(manifest['producer_inputs'])
    plan=materials(manifest)
    cp=subprocess.run([sys.executable,'-B',str(ROOT/'tools/distribution/validate-manifest.py'),'--manifest',str(path)],
                      cwd=ROOT,capture_output=True,text=True,timeout=60)
    need(cp.returncode==0,'canonical manifest structural validation failed: '+cp.stderr.strip())
    return path,data,manifest,vol,plan


def run(candidate):
    head=clean_main()
    path,data,manifest,vol,plan=valid_plan(candidate)
    image=TAPES/f'bcpl-{manifest["release"]["version"]}-{vol}.aws'
    marker=OUT/(vol+'-no-retry.json')
    need(not marker.exists() and not marker.is_symlink() and not image.exists() and not image.is_symlink(),'consumed intent/image; NO RETRY')
    need(TAPES.is_dir() and not TAPES.is_symlink(),'unsafe tape directory')
    originals()
    core=load(ROOT/'tools/datasets/dspal-core.py'); ls=load(ROOT/'tools/datasets/dspal-ls.py')
    vtoc=load(DIST/'create-tape/scripts/ta2-target-review')
    cfg=core.load_config()
    need(cfg['mvs']['hlq']==HLQ and cfg['mvs']['batch_user']==HLQ,'unexpected MVS site/user')
    need(all(cfg['runtime'].get(k)==v for k,v in {'docker_container':'mvs38j','reader_host':'127.0.0.1','reader_port':3505,
          'hercules_host':'127.0.0.1','hercules_port':8038,'printer':'mvs-state/prt/prt00e.txt'}.items()),'unexpected MVS transport')
    core.require_reader_ready(cfg)
    cases=r.read_mr10_panel(ROOT,ROOT/'mr10-kit-compiler/tests/00-regression-panel/manifest.tsv',ROOT/'mr10-kit-compiler/jcl/run-regression-tests.jcl')
    suite_sources={member:(ROOT/'mr10-kit-compiler/jcl'/filename).read_text('ascii') for _,member,filename,_,_ in SUITES}
    for label,(prefix,_,rows,_) in plan['profiles'].items():
        if label!='NATIVE':
            for _,member,_,count,_ in SUITES: mvs.suite_deck(suite_sources[member],prefix,count,{row[1] for row in rows})
    stage=mvs.stage_deck(plan['boot'],plan['members'],stage=plan['stage'],dasd=DASD); docjcl=docs_deck(plan)
    # Verify package inputs are available before any write.
    notices={name:(ROOT/name).read_bytes() for name in NOTICE_FILES}
    folder=OUT/(datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')+'-'+str(os.getpid()))
    folder.mkdir(mode=0o700)
    marked=False
    def save(key,value): mvs.artifact(folder,key+'.json',json.dumps(value,indent=2)+'\n')
    def job(key,name,body,steps,max_rc=0): return mvs.submit_job(core,cfg,folder,key,name,body,steps,max_rc=max_rc)
    def cmd(key,*args): return mvs.run_command(folder,key,list(args))
    def drive(key):
        h=cmd(key+'-hercules','tools/mvs/mvs-console','tape','status',UNIT)
        g=cmd(key+'-mvs','tools/mvs/mvs-console','mvs','tapes')
        return mvs.drive_state(h,g,[image.name])
    def mount(key):
        state=drive(key+'-before'); need(state in ('EMPTY',image.name),'foreign media')
        if state=='EMPTY': cmd(key+'-mount','tools/mvs/mvs-console','--yes','tape','mount',UNIT,image.name)
        need(drive(key+'-ready')==image.name,'test tape not mounted')
    def inventory(label,rows): return mvs.verify_inventory(core,cfg,ls,folder,label,rows,volume=DASD)
    def absent(names):
        body=mvs.deck_without_job(core.stat_deck(cfg,names),'DSPALST')
        jid,report,_=job('absence','DSPALST',body,None,8)
        for name in names:
            need(core.dataset_missing(report,name),'target absence not established: '+name)
            block=core.extract_listds_block(report,name)
            need(not block or not core.parse_listds(block),'ambiguous target: '+name)
        return jid
    def check_dcb(key,dsn,dcb):
        body=mvs.deck_without_job(core.stat_deck(cfg,[dsn]),'DSPALST')
        jid,report,_=job(key,'DSPALST',body,[('STAT','IKJEFT01')]); actual,_=mvs.exact_listds(core,report,dsn)
        need(actual==dict(volume=DASD,dsorg=dcb['dsorg'],recfm=dcb['recfm'],lrecl=str(dcb['lrecl']),blksize=str(dcb['blksize'])) or
             all(actual.get(k)==v for k,v in dict(volume=DASD,dsorg=dcb['dsorg'],recfm=dcb['recfm'],lrecl=str(dcb['lrecl']),blksize=str(dcb['blksize'])).items()),'staged DCB mismatch')
        return jid
    def read_member(key,dsn,name):
        body=r.checked_lines(['//READJCL EXEC PGM=IEBGENER,REGION=512K','//SYSPRINT DD SYSOUT=*','//SYSIN DD DUMMY',
                             f'//SYSUT1 DD DSN={dsn}({name}),','//            DISP=SHR','//SYSUT2 DD SYSOUT=*','//'])
        return job(key,'CRREAD',body,[('READJCL','IEBGENER')])
    try:
        mvs.artifact(folder,path.name,data); mvs.artifact(folder,'writer.jcl',plan['writer']); mvs.artifact(folder,'producer-head.txt',head+'\n')
        check_docker(cmd)
        # Never unmount or displace accepted media; the operator must begin with an empty drive.
        need(drive('initial')=='EMPTY','unit 480 must be empty')
        for i,p in enumerate(sorted(TAPES.iterdir())):
            if p.name=='.gitkeep': continue
            need(p.is_file() and not p.is_symlink() and p.suffix.lower() in ('.aws','.het'),'unknown tape directory entry')
            labels=cmd(f'media-{i:03d}','docker','exec','mvs38j','hetmap','-l','/tk5/tape/'+p.name)
            need(mvs.volser_from_hetmap(labels)!=vol,'VOLSER already present')
        rows=plan['manifest']['datasets']; sources=[(x['sequence'],x['producer_source_dsn'],x['members'],x['target_dcb']) for x in rows[3:]]
        source_catalog,source_directory,total=inventory('source',sources)
        need(total==135,'prepared payload member count differs')
        ajob=absent(plan['targets']+[f'BCPL.BT{n:04d}' for n in range(1,22)])
        vbody=r.checked_lines(['//VTOC EXEC PGM=IEHLIST','//SYSPRINT DD SYSOUT=*',f'//VOL DD UNIT=SYSDA,VOL=SER={DASD},DISP=SHR',
                               '//SYSIN DD *',f' LISTVTOC FORMAT,VOL=SYSDA={DASD}','/*','//'])
        vjob,report,_=job('vtoc','CRVTOC',vbody,[('VTOC','IEHLIST')]); space=vtoc.inspect_vtoc(report,DASD,plan['targets'])
        free=space['iehlist_reported_free_total_tracks']; need(free is not None and free>=2*plan['tracks'],'insufficient reported DASD free space')
        save('preflight',dict(source_catalog=source_catalog,source_directory=source_directory,absence=ajob,vtoc=vjob,space=space,targets=plan['targets']))
        print(f'PREFLIGHT PASS: {len(plan["targets"])} absent targets; {free} free tracks; {total} prepared members.')
        if not confirm(f'Create {candidate} / {vol}, install and verify all profiles ONCE?'):
            save('result',{'status':'DECLINED_NO_WRITE'}); mvs.seal(folder); return 0
        need(clean_main()==head and drive('authorized')=='EMPTY','checkout or drive changed after preflight')
        originals(); need(not image.exists() and not image.is_symlink(),'image appeared')
        mvs.exclusive(marker,(json.dumps(dict(candidate=candidate,volser=vol,head=head,evidence=str(folder.relative_to(ROOT)),publication_authorized=False))+'\n').encode()); marked=True
        stagejob,_,_=job('stage','CRSTAGE',stage,[('B0001','IEBGENER'),('A0002','IEFBR14')]+[(f'M{i:04d}','IEBGENER') for i in range(1,9)])
        docjob,_,_=job('docs','CRDOCS',docjcl,[('A0003','IEFBR14')]+[(f'D{i:04d}','IEBGENER') for i in range(1,8)])
        check_dcb('bootstrap-dcb',plan['stage']+'BT0001',rows[0]['target_dcb'])
        inventory('staged',[(2,plan['stage']+'BT0002',list(mvs.MEMBERS)),(3,plan['stage']+'BT0003',list(DOC_MEMBERS),rows[2]['target_dcb'])])
        # Check exact printed generated documentation before it enters the tape.
        for name,body in plan['docs'].items():
            _,report,_=read_member('stage-doc-'+name,plan['stage']+'BT0003',name)
            mvs.read_cards(report,body)
        need(drive('before-init')=='EMPTY','drive changed'); originals()
        mvs.exclusive(image,b'')
        cmd('initialize','docker','exec','--user',f'{os.getuid()}:{os.getgid()}','mvs38j','hetinit','-d','-i','/tk5/tape/'+image.name,vol)
        mount('writer'); wrote,_,_=job('write','CRWRITE',plan['writer'],[(f'T{n:04d}','IEBGENER' if n==1 else 'IEBCOPY') for n in range(1,22)])
        labels=cmd('aws-labels','docker','exec','mvs38j','hetmap','-l','/tk5/tape/'+image.name)
        files=cmd('aws-files','docker','exec','mvs38j','hetmap','-f','/tk5/tape/'+image.name)
        structure=r.evaluate_hetmap(labels,files,volser=vol,count=21); save('tape-review',structure)
        tape_sha=digest(image); originals(); print(f'TAPE PASS: JOB {wrote}; {vol}; SHA256 {tape_sha}')
        def ready(key):
            need(digest(image)==tape_sha,'new tape changed'); mount(key)
        boot,_=mvs.bootstrap_decks(plan['profiles']['MR10'][0],volser=vol,tape_unit=UNIT,dasd_unit='SYSDA',dasd_vol=DASD)
        ready('boot'); bootjob,report,_=job('boot','CRBOOT',boot,[('BOOTREAD','IEBGENER')]); mvs.read_cards(report,plan['boot'])
        results={}
        for label,(prefix,positions,rows,canonical) in plan['profiles'].items():
            key=label.lower(); _,bt2=mvs.bootstrap_decks(prefix,volser=vol,tape_unit=UNIT,dasd_unit='SYSDA',dasd_vol=DASD)
            ready(key+'-bt2'); bt,_,_=job(key+'-bt2','CRBT2',bt2,[('BT2REST','IEBCOPY')])
            view,report,_=job(key+'-view','CRVIEW',mvs.readback_deck(prefix,label),[('P0001','IEBGENER'),('P0002','IEBGENER')])
            deck=mvs.extract_profile(report,canonical); need('COPY OUTDD=OUTPDS,INDD=INTAPE' in report,'COPY member missing')
            ready(key+'-restore'); restored,report,summary=job(key+'-restore','CRREST',deck,None)
            mvs.profile_result('CRREST',report,summary,positions)
            cat,directory,total=inventory(key,rows)
            for name,body in plan['docs'].items():
                _,report,_=read_member(key+'-doc-'+name,prefix+'.DIST.DOCS',name); mvs.read_cards(report,body)
            detail=dict(installer=bt,readback=view,restore=restored,catalog=cat,directory=directory,pdses=len(rows),members=total,functional={})
            print(f'{label} INSTALL PASS: {len(rows)} PDSes/{total} members; JOB {restored}.')
            if label!='NATIVE':
                allowed={row[1] for row in rows}
                for suite,member,_,count,selection in SUITES:
                    tag=key+'-'+suite; readjob,report,_=read_member(tag+'-read',prefix+'.MR10KIT.JCL',member)
                    body,steps=mvs.suite_deck(mvs.read_cards(report,suite_sources[member]),prefix,count,allowed)
                    jid,report,_=job(tag,'CR'+member[:6],body,steps)
                    if suite=='regression':
                        result=r.inspect_mr10(report,cases); need(result['exp_contract_met'] and result['golden_rp_and_code_match'],'MR10 regression mismatch'); n=len(cases)
                    else: result=mvs.verify_demos(report,selection,steps); n=len(selection)
                    save(tag+'-semantics',result); detail['functional'][suite]=dict(job=jid,readback_job=readjob,cases=n)
                    print(f'{label} {member} PASS: {n} cases; JOB {jid}.')
            results[label]=detail; save(key+'-checkpoint',detail)
        need(sum(x['pdses'] for x in results.values())==42 and sum(x['members'] for x in results.values())==315 and
             sum(s['cases'] for x in results.values() for s in x['functional'].values())==80,'acceptance count mismatch')
        if drive('final')==image.name: cmd('unmount','tools/mvs/mvs-console','--yes','tape','unmount',UNIT)
        need(drive('released')=='EMPTY' and digest(image)==tape_sha,'final tape state differs'); originals()
        result=dict(status='PRIVATE_CANDIDATE_VERIFIED_QUALIFIED',candidate=candidate,volser=vol,source_commit=manifest['release']['source_commit'],
                    producer_commit=head,aws_sha256=tape_sha,stage_job=stagejob,docs_job=docjob,write_job=wrote,boot_job=bootjob,
                    profiles=results,publication_authorized=False,independent_mvs_system=False,native_compiler='absent')
        archive,archive_sha=package(folder,path,data,image,result,notices)
        result.update(archive=archive.name,archive_sha256=archive_sha); save('result',result)
        save('proposed-lifecycle',dict(candidate_id=candidate,technical_state='verified-qualified-pending-owner-review',volser=vol,
             aws_sha256=tape_sha,archive_sha256=archive_sha,private_evidence=str(folder.relative_to(ROOT)),publication_authorized=False))
        mvs.seal(folder)
        print(f'RELEASE CANDIDATE VERIFIED (QUALIFIED): {archive.name}\nArchive SHA256: {archive_sha}\nPublication requires separate approval.')
        return 0
    except (Exception,KeyboardInterrupt) as exc:
        reason=str(exc)
        try:
            secret=core.batch_password(cfg)
            if secret: reason=reason.replace(secret,'[REDACTED]')
        except Exception: pass
        try: save('failure',dict(reason=reason,no_retry=marked)); mvs.seal(folder)
        except Exception: pass
        print('HALTED: '+reason+(' (NO RETRY)' if marked else ''),file=sys.stderr); return 2
    finally: print('Evidence: '+str(folder.relative_to(ROOT)))


def package(folder,path,data,image,result,notices):
    cid=result['candidate']; vol=result['volser']; sha=result['aws_sha256']
    guide=(f'# Cambridge BCPL Programming System for MVS 3.8J\n\n'
           f'Candidate {cid} / {vol}. AWS SHA-256 `{sha}`.\n\n'
           f'Frozen program source: `{result["source_commit"]}`. See the accompanying manifest.\n\n'
           'MR10 Kit Compiler is included; native components and historical Cambridge sources are work in progress. '
           'The native-running Cambridge Compiler is absent. Three fresh namespaces passed installation; MR10 and COMBINED '
           'passed 80 functional cases total. Native functional acceptance, source rebuild, full record-byte identity and independent IPL are not claimed.\n\n'
           'Install on MVS 3.8J using an authorized JOB card and an empty target namespace. Mount the AWS read-only. '
           'Use BOOT.jcl to read BT0001, and BT2.jcl (adapt the destination, units and volume) to restore DIST.INST. '
           'Submit the selected tape-resident MR10, NATIVE or COMBINED member after reviewing HLQ, SITE, TU, DU and DV defaults. '
           'Do not overwrite existing datasets or retry an ambiguous failure. Verify PDS members and DCBs against the manifest. '
           'MR10KIT.JCL members MRLANGDM, MRBCDEMO and MRREGRES require the installed site prefix; preserve FB80 card columns. '
           'Check zero return codes and TEST/EXP/RP/CODE against independent goldens.\n\n'
           'Original work is MIT licensed unless marked otherwise. Historical material is not relicensed; rights remain unresolved. '
           'Keep the complete LICENSE, THIRD-PARTY-NOTICES, original archival notes and INDEX with the tape. '
           'Hercules, TK5 and MVS are not distributed. This is a private candidate, pending separate publication approval.\n')
    boot,bt2=mvs.bootstrap_decks(f'{HLQ}.BCPL.R{vol[2:]}MR',volser=vol,tape_unit=UNIT,dasd_unit='SYSDA',dasd_vol=DASD)
    entries={image.name:image.read_bytes(),path.name:data,'README.md':guide.encode(), 'BOOT.jcl':boot.encode(),'BT2.jcl':bt2.encode(),
             'VERIFICATION.json':(json.dumps(result,indent=2)+'\n').encode()}
    for name,content in notices.items(): entries[Path(name).name]=content
    need(hashlib.sha256(entries[image.name]).hexdigest()==sha,'image changed before packaging')
    entries['SHA256SUMS']=''.join(f'{hashlib.sha256(b).hexdigest()}  {n}\n' for n,b in sorted(entries.items())).encode('ascii')
    archive=folder/(cid+'-'+vol+'.zip')
    with ZipFile(archive,'x',compression=ZIP_DEFLATED) as z:
        for name,content in sorted(entries.items()): z.writestr(name,content)
    with ZipFile(archive) as z:
        need(set(z.namelist())==set(entries) and z.testzip() is None and all(z.read(n)==b for n,b in entries.items()),'archive verification failed')
    archive_sha=digest(archive); mvs.artifact(folder,'ARCHIVE.sha256',f'{archive_sha}  {archive.name}\n')
    return archive,archive_sha



def record(folder):
    """Apply a sealed successful private result as a Git-reviewable lifecycle annotation."""
    head=clean_main()
    need(folder.is_dir() and not folder.is_symlink() and folder.resolve().parent==OUT.resolve(), 'invalid evidence folder')
    rel=str(folder.resolve().relative_to(ROOT)); sealed_evidence(rel,digest(folder/'SHA256SUMS'))
    result=json.loads((folder/'result.json').read_text()); proposed=json.loads((folder/'proposed-lifecycle.json').read_text())
    cid=result['candidate']; vol=result['volser']
    need(cid.startswith('BCPL-') and VERSION.fullmatch(cid[5:]) and r.VOLSER.fullmatch(vol),'invalid result identity')
    path=MANIFESTS/(cid+'.yaml'); manifest=r.read_manifest(path)
    need(check_reservation(read_registry(),manifest,path.read_bytes())==vol,'result reservation mismatch')
    need(result['status']=='PRIVATE_CANDIDATE_VERIFIED_QUALIFIED' and result['publication_authorized'] is False and
         result['source_commit']==manifest['release']['source_commit'],'unexpected acceptance result')
    profiles=result['profiles']
    need([(profiles[k]['pdses'],profiles[k]['members']) for k in ('MR10','NATIVE','COMBINED')]==[(11,94),(11,71),(20,150)] and
         all([profiles[k]['functional'][s]['cases'] for s in ('language','bcpl','regression')]==[11,17,12] for k in ('MR10','COMBINED')) and
         profiles['NATIVE']['functional']=={},'acceptance counts differ')
    marker=OUT/(vol+'-no-retry.json')
    need(marker.is_file() and not marker.is_symlink(),'missing or linked intent marker')
    intent=json.loads(marker.read_text()); need(intent['candidate']==cid and intent['evidence']==rel and intent['head']==result['producer_commit'], 'intent mismatch')
    image=TAPES/f'bcpl-{manifest["release"]["version"]}-{vol}.aws'; archive=folder/(cid+'-'+vol+'.zip')
    need(digest(image)==result['aws_sha256'] and digest(archive)==result['archive_sha256'] and result['archive']==archive.name,'artifact digests differ')
    entry={'technical_state':'verified-qualified-pending-owner-review','volser':vol,'aws_sha256':result['aws_sha256'],
           'archive_sha256':result['archive_sha256'],'private_evidence':rel,'publication_authorized':False}
    need(proposed==dict(candidate_id=cid,**entry),'proposed lifecycle differs')
    old=REGISTRY.read_text('utf-8'); mark='\n# Private, non-publication tool verification volumes.'
    need(old.count(mark)==1,'registry lifecycle layout changed')
    lines=yaml.safe_dump({cid:entry},sort_keys=False).splitlines()
    update=old.replace(mark,''.join('  '+line+'\n' for line in lines)+mark,1)
    want=yaml.safe_load(old); want['lifecycle'][cid]=entry
    need(yaml.safe_load(update)==want,'lifecycle update changed previous records')
    if not confirm(f'Record {cid} / {vol} as privately verified, qualified and not published?'):
        print('DECLINED: registry unchanged'); return
    need(clean_main()==head and REGISTRY.read_text('utf-8')==old,'checkout changed after confirmation')
    temp=REGISTRY.with_name('.releases.yaml.pending'); mvs.exclusive(temp,update.encode('utf-8'))
    temp.chmod(REGISTRY.stat().st_mode & 0o777); os.replace(temp,REGISTRY)
    print('Private verification recorded locally. Review and commit registry separately. No publication.')


def main(argv=None):
    p=argparse.ArgumentParser(description=__doc__)
    action=p.add_mutually_exclusive_group(); action.add_argument('--prepare',action='store_true'); action.add_argument('--run',metavar='CANDIDATE'); action.add_argument('--reserve',type=Path,metavar='DRAFT'); action.add_argument('--record',type=Path,metavar='EVIDENCE')
    p.add_argument('--version'); p.add_argument('--reuse-rc4',action='store_true'); p.add_argument('--inputs',type=Path)
    a=p.parse_args(argv)
    need(a.prepare or not (a.reuse_rc4 or a.inputs),'input selection is only for --prepare')
    need(not ((a.run or a.reserve or a.record) and a.version),'--version is only for plan/prepare')
    if not (a.prepare or a.run or a.reserve or a.record):
        cid,vol=next_identity(read_registry(),a.version); print(f'NEXT PROPOSED: {cid} / {vol} (NOT RESERVED)')
        print('Prepare with --prepare --reuse-rc4 or --prepare --inputs FILE. No MVS operations.'); return 0
    need(WORK.is_dir() and not WORK.is_symlink() and not OUT.is_symlink(),'unsafe or missing workarea')
    OUT.mkdir(mode=0o700,exist_ok=True)
    lock=OUT/'operator.lock'
    fd=os.open(lock,os.O_CREAT|os.O_RDWR|getattr(os,'O_NOFOLLOW',0),0o600)
    with os.fdopen(fd,'r+') as handle:
        fcntl.flock(handle,fcntl.LOCK_EX|fcntl.LOCK_NB)
        if a.prepare: prepare(a); return 0
        if a.reserve: reserve(a.reserve); return 0
        if a.record: record(a.record); return 0
        need(sys.stdin.isatty(),'operator terminal required'); return run(a.run)


if __name__=='__main__':
    try: raise SystemExit(main())
    except (Exception,KeyboardInterrupt) as exc:
        print('REFUSED: '+str(exc),file=sys.stderr); raise SystemExit(2)
