def check_inputs(inputs, *, check_evidence=True):
    need(set(inputs)=={'mode','source_commit','sources','allocations','evidence','evidence_seal_sha256'}, 'unexpected input receipt fields')
    need(inputs.get('mode') in ('reuse-rc4','prepared') and GIT_SHA.fullmatch(inputs['source_commit']), 'invalid payload source commit/mode')
    src=inputs['sources']; sizes=inputs['allocations']
    need(set(src)=={str(n) for n in range(4,22)} and len(set(src.values()))==18 and
         all(r.safe_dsn(x) and x.startswith(HLQ+'.BCPL.') for x in src.values()),'require 18 explicit prepared project PDSes')
    need(set(sizes)=={str(n) for n in range(3,22)} and all(isinstance(v,list) and len(v)==3 and
         all(type(x) is int and 0<x<=10000 for x in v) for v in sizes.values()),'invalid allocation map')
    if inputs['mode']=='reuse-rc4':
        need(inputs['source_commit']==base_manifest()['release']['source_commit'] and
             src=={str(n):f'HERC02.BCPL.TA2R3S.BT{n:04d}' for n in range(4,22)} and
             sizes==allocation_budget() and inputs['evidence']=='workarea/ta3-rc4-production/20261123T130731Z-36363',
             'RC4 reuse input contract changed')
    if check_evidence:
        sealed_evidence(inputs['evidence'],inputs['evidence_seal_sha256'])
        if inputs['mode']=='prepared':
            receipt=ROOT/inputs['evidence']/'prepared-inputs.json'
            need(receipt.is_file() and json.loads(receipt.read_text('utf-8'))=={k:inputs[k] for k in ('mode','source_commit','sources','allocations')},
                 'sealed preparation receipt does not bind input mapping')
        git('merge-base','--is-ancestor',inputs['source_commit'],'HEAD')
        # All MR10 reference sources, canonical suite decks and goldens must match the frozen payload revision.
        need(git('rev-parse',inputs['source_commit']+':mr10-kit-compiler')==git('rev-parse','HEAD:mr10-kit-compiler'),
             'MR10 verification sources differ from frozen input revision')


def build_manifest(reg, inputs, version=None):
    cid,vol=next_identity(reg,version)
    manifest=deepcopy(base_manifest())
    manifest['release'].update(candidate_id=cid,version=cid[5:],source_commit=inputs['source_commit'])
    manifest['volume'].update(volser=vol,registry_reservation=cid)
    manifest['producer_inputs']=deepcopy(inputs)
    return manifest


def new_entry(manifest, data):
    cid,vol,_=r.identity(manifest)
    return dict(candidate_id=cid,version=manifest['release']['version'],source_commit=manifest['release']['source_commit'],
                volser=vol,manifest_sha256=hashlib.sha256(data).hexdigest(),state='reserved')


def append_reservation(text, entry):
    # Preserve existing registry records and comments byte-for-byte.
    marker='\n# Lifecycle annotations'
    need(text.count(marker)==1,'registry layout changed; review needed')
    block='  - '+ '\n    '.join(f'{k}: {v}' for k,v in entry.items())+'\n'
    out=text.replace(marker,block+marker,1)
    before=yaml.safe_load(text); after=yaml.safe_load(out)
    expected=deepcopy(before); expected['candidates'].append(entry)
    need(after==expected,'registry append changed prior records')
    registry_entries(after)
    return out


def check_reservation(reg, manifest, data):
    registry_entries(reg)
    cid,vol,_=r.identity(manifest)
    row=[e for e in reg['candidates'] if e['candidate_id']==cid]
    need(row==[new_entry(manifest,data)] and cid not in reg.get('lifecycle',{}),'candidate is not an unused committed reservation')
    need(manifest['release']['version']==cid[5:] and VERSION.fullmatch(cid[5:]),'candidate version mismatch')
    return vol


def fb80(*paragraphs):
    lines=[]
    for para in paragraphs:
        need(para.isascii(),'non-ASCII tape documentation')
        lines.extend(textwrap.wrap(para,width=76,break_long_words=False,break_on_hyphens=False) or [''])
    return r.checked_lines(lines)


