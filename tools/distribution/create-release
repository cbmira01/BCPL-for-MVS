def docs_deck(plan):
    dsn=plan['stage']+'BT0003'; p,s,b=plan['sizes'][3]
    lines=['//A0003 EXEC PGM=IEFBR14','//OUTPDS DD DSN='+dsn+',',
           '//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,',f'//            VOL=SER={DASD},SPACE=(TRK,({p},{s},{b})),',
           '//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=800)']
    for n,name in enumerate(DOC_MEMBERS,1):
        records=plan['docs'][name].splitlines()
        need(records and all(not x.startswith('Z9') for x in records),'documentation delimiter collision')
        lines.extend([f'//D{n:04d} EXEC PGM=IEBGENER,REGION=512K,COND=(0,NE)',
                      '//SYSPRINT DD SYSOUT=*','//SYSIN DD DUMMY','//SYSUT1 DD DATA,DLM=Z9',*records,'Z9',
                      f'//SYSUT2 DD DSN={dsn}({name}),','//            DISP=SHR'])
    lines.append('//'); mvs.jcl_control_cards(lines)
    return r.checked_lines(lines)


def confirm(prompt):
    need(sys.stdin.isatty(),'interactive operator terminal required')
    return input(prompt+' [y/N]: ').strip().lower()=='y'


def prepare(args):
    head=clean_main()
    need(bool(args.reuse_rc4)!=bool(args.inputs),'choose --reuse-rc4 or --inputs')
    inputs=reused_inputs() if args.reuse_rc4 else json.loads(args.inputs.read_text('utf-8'))
    check_inputs(inputs)
    text=REGISTRY.read_text('utf-8'); reg=yaml.safe_load(text)
    manifest=build_manifest(reg,inputs,args.version); cid,vol,_=r.identity(manifest)
    plan=materials(manifest); docs_deck(plan); mvs.stage_deck(plan['boot'],plan['members'],stage=plan['stage'],dasd=DASD)
    data=yaml.safe_dump(manifest,sort_keys=False).encode('utf-8')
    update=append_reservation(text,new_entry(manifest,data))
    # Draft only, no tracked file edits or registry mutation by this command.
    folder=OUT/(cid+'-'+vol+'-reservation')
    need(not folder.exists() and not folder.is_symlink(),'reservation draft exists; review it rather than overwrite')
    need(clean_main()==head,'main changed during planning')
    folder.mkdir(mode=0o700)
    mvs.artifact(folder,cid+'.yaml',data); mvs.artifact(folder,'releases.yaml',update)
    mvs.artifact(folder,'base-head.txt',head+'\n'); mvs.seal(folder)
    print(f'DRAFT {cid} / {vol}: {len(plan["targets"])} targets, {plan["tracks"]} planning tracks.')
    print('Review the draft, then use --reserve '+str(folder.relative_to(ROOT))+' to apply it locally.')
    print('Commit and push both reservation files together before --run.')
    print('Reservation draft: '+str(folder.relative_to(ROOT)))



def reserve(draft):
    """Apply an existing sealed reservation draft; never commit or push it."""
    head=clean_main()
    need(draft.is_dir() and not draft.is_symlink() and draft.resolve().parent==OUT.resolve(), 'reservation draft outside workarea')
    sealed_evidence(str(draft.resolve().relative_to(ROOT)),digest(draft/'SHA256SUMS'))
    need((draft/'base-head.txt').read_text().strip()==head,'draft base changed; regenerate with a new proposed identity')
    paths=[p for p in draft.iterdir() if p.suffix=='.yaml' and p.name!='releases.yaml']
    need(len(paths)==1,'invalid reservation draft manifest count')
    p=paths[0]; data=p.read_bytes(); manifest=r.read_manifest(p); cid,vol,_=r.identity(manifest)
    need(p.name==cid+'.yaml','draft manifest name differs')
    need(next_identity(read_registry(),manifest['release']['version'])==(cid,vol),'draft identity no longer available')
    check_inputs(manifest['producer_inputs']); materials(manifest)
    old=REGISTRY.read_text('utf-8'); proposed=append_reservation(old,new_entry(manifest,data))
    need((draft/'releases.yaml').read_text('utf-8')==proposed,'draft registry differs')
    target=MANIFESTS/p.name; need(not target.exists() and not target.is_symlink(),'manifest exists')
    if not confirm(f'Apply reservation {cid} / {vol} to the tracked checkout for separate commit?'):
        print('DECLINED: no reservation changes'); return
    need(clean_main()==head and REGISTRY.read_text('utf-8')==old,'checkout changed after confirmation')
    # A partial local edit is harmless: --run requires both files committed on main.
    mvs.exclusive(target,data)
    temp=REGISTRY.with_name('.releases.yaml.pending')
    mvs.exclusive(temp,proposed.encode('utf-8')); temp.chmod(REGISTRY.stat().st_mode & 0o777); os.replace(temp,REGISTRY)
    print('Reservation applied locally; NOT committed or pushed. Review both tracked files.')
    print(str(target.relative_to(ROOT))); print(str(REGISTRY.relative_to(ROOT)))


def protected_images(reg):
    """Protect all registry-tracked verified media as well as preexisting RC3."""
    registry_entries(reg)
    protected=dict(ORIGINALS)
    candidates={x['candidate_id']:x for x in reg['candidates']}
    def add(name, expected):
        need(re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]*\.aws',name) and SHA.fullmatch(expected), 'invalid protected image identity')
        need(name not in protected or protected[name]==expected,'conflicting accepted image hash')
        protected[name]=expected
    for cid,entry in reg.get('lifecycle',{}).items():
        if 'aws_sha256' in entry:
            need(cid in candidates and entry['volser']==candidates[cid]['volser'],'invalid lifecycle VOLSER')
            add(f'bcpl-{candidates[cid]["version"]}-{entry["volser"]}.aws',entry['aws_sha256'])
    for entry in reg.get('integration_tests',{}).values():
        if 'aws_sha256' in entry:
            add(entry['image'],entry['aws_sha256'])
    return protected


def originals():
    for name,expected in protected_images(read_registry()).items():
        need(digest(TAPES/name)==expected,'protected image changed or missing: '+name)


