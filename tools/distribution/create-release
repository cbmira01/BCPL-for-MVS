                         'Historical authors retain their rights; no blanket historical license is established.',
                         'Martin Richards authorship; Ken Yap archived the tape; Robert Nordier corrected character mappings.',
                         'Keep the complete LICENSE.md, THIRD-PARTY-NOTICES.md and original archival notes with this tape.')+
                    fb80(*[line for line in (ROOT/'LICENSE.md').read_text('utf-8').splitlines() if line.strip()])}
    members={'INSTALL':boot,'DATASETS':dataset_doc,'RELEASE':release_doc,'RESTORE':restore,
             'COPY':' COPY OUTDD=OUTPDS,INDD=INTAPE\n'}
