def digest(path):
    need(path.is_file() and not path.is_symlink(), f'missing or linked file: {path}')
    with path.open('rb') as f:
        return hashlib.file_digest(f, 'sha256').hexdigest()


def git(*args):
    cp = subprocess.run(['git','-C',str(ROOT),*args], capture_output=True, text=True, timeout=60)
    need(cp.returncode == 0, 'Git command failed: ' + ' '.join(args[:2]))
    return cp.stdout.strip()


def clean_main():
    need(git('symbolic-ref','--short','HEAD')=='main' and not git('status','--porcelain','--untracked-files=no'),
         'clean main required')
    head = git('rev-parse','HEAD')
    git('ls-files','--error-unmatch','tools/distribution/create-release','tools/distribution/mvs_release.py','tools/distribution/release.py','packaging/distribution/registry/releases.yaml')
    need(git('remote','get-url','origin') in ('https://github.com/cbmira01/BCPL-for-MVS',
         'https://github.com/cbmira01/BCPL-for-MVS.git','git@github.com:cbmira01/BCPL-for-MVS.git',
         'ssh://git@github.com/cbmira01/BCPL-for-MVS.git'),'origin is not the authoritative repository')
    need(git('ls-remote','--exit-code','origin','refs/heads/main').split()==[head,'refs/heads/main'],
         'local HEAD differs from authoritative origin/main')
    return head


def load(path):
    need(path.is_file() and not path.is_symlink(), f'missing helper: {path}')
    loader = SourceFileLoader('dist_' + path.name, str(path))
    spec = spec_from_loader(loader.name,loader)
    mod = module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def registry_entries(reg):
    need(reg.get('schema_version')==1 and isinstance(reg.get('candidates'),list) and
         isinstance(reg.get('integration_tests',{}),dict),'unsupported registry')
    ids, vols, versions = set(), set(), set()
    for e in reg['candidates']:
        cid,v,vol = e['candidate_id'],e['version'],e['volser']
        need(VERSION.fullmatch(v) and cid=='BCPL-'+v and cid not in ids and v not in versions,
             'duplicate or invalid candidate identity')
        need(isinstance(vol,str) and r.VOLSER.fullmatch(vol) and vol not in vols,'duplicate/invalid VOLSER')
        ids.add(cid); versions.add(v); vols.add(vol)
    for cid,e in reg.get('integration_tests',{}).items():
        vol=e['volser']
        need(cid not in ids and r.VOLSER.fullmatch(vol) and vol not in vols,'duplicate private-test identity/VOLSER')
        ids.add(cid); vols.add(vol)
    return ids,vols,versions


def next_identity(reg, version=None):
    ids,vols,versions=registry_entries(reg)
    if version is None:
        a,b,c,n=max((tuple(map(int,VERSION.fullmatch(v).groups())) for v in versions),default=(0,1,0,0))
        version=f'{a}.{b}.{c}-rc{n+1}'
    need(VERSION.fullmatch(version) and len(version)<=24 and 'BCPL-'+version not in ids,'invalid or previously assigned version')
    n=max((int(v[2:]) for v in vols),default=0)+1
    need(n<=9999,'production VOLSER space exhausted')
    return 'BCPL-'+version, f'BC{n:04d}'


