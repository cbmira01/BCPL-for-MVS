#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CURRENT_FILE="$REPO_ROOT/asm/CURRENT"

if [ ! -f "$CURRENT_FILE" ]
then
    echo "current-icint: missing $CURRENT_FILE" >&2
    exit 1
fi

NAME="$(tr -d '\r\n' < "$CURRENT_FILE")"

if [ -z "$NAME" ]
then
    echo "current-icint: $CURRENT_FILE is empty" >&2
    exit 1
fi

case "$NAME" in
    */*)
        echo "current-icint: $CURRENT_FILE must contain only an assembler filename" >&2
        exit 1
        ;;
esac

PATHNAME="$REPO_ROOT/asm/$NAME"

if [ ! -f "$PATHNAME" ]
then
    echo "current-icint: $PATHNAME does not exist" >&2
    exit 1
fi

printf '%s\n' "$PATHNAME"
