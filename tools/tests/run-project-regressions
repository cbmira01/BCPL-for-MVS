#!/usr/bin/env python3
"""Coordinate independent MR10 and native BCPL regression suites.

--list and --check are host-only. --run delegates to existing runners and
can submit JES jobs; no test engines, MVS objects or datasets are installed.
"""
from __future__ import annotations

import argparse
import csv
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parents[2]
NATIVE_SUITES = ("bootstrap", "runtime-extensions", "bcpltime", "bcplqsam")
SUITES = ("mr10", "mr10-probes", *NATIVE_SUITES)
NATIVE = ROOT / "tools/tests/run-suite"
MR10 = ROOT / "tools/mr10/run-regression-panel"
MR10_PROBES = ROOT / "tools/mr10/run-dev-probes"
MR10_PROBES_MANIFEST = ROOT / "mr10-kit-compiler/tests/dev-probes-manifest.tsv"
ACCEPTED_MR10_PROBES = (
    "04-module-test", "05-named-dd", "06-dynamic-streams",
    "07-many-streams", "09-multiple-assignment",
    "10-coroutines/compiler-probe", "10-coroutines/frame-layout-probe",
    "10-coroutines/fixed-stack-producer-consumer",
    "10-coroutines/resumeco-chain", "10-coroutines/create-delete-static-pool",
    "11-getvec-freevec",
)
MR10_MANIFEST = ROOT / "mr10-kit-compiler/tests/00-regression-panel/manifest.tsv"
NATIVE_MANIFESTS = ROOT / "tests/suites"
RUN_ROOT = ROOT / "workarea/project-regressions"
TOKEN = re.compile(r"^[a-z][a-z0-9-]*$")
PROGRESS_MR10 = re.compile(
    r"^(PASS|FAIL)\s+([a-z][a-z0-9-]*/[a-z][a-z0-9-]*)\s*$")
PROGRESS_PROBES = re.compile(
    r"^(PASS|FAIL|OBSERVED)\s+([a-z0-9-]+(?:/[a-z0-9-]+)?):")
PROGRESS_NATIVE = re.compile(
    r"^(PASS|FAIL|SKIP|BLOCKED)\s+(\d{2,3})\s+\2-([a-z0-9-]+):")


class VerificationError(ValueError):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise VerificationError(message)


def within_repo(value: str) -> Path:
    path = Path(value)
    require(not path.is_absolute() and ".." not in path.parts,
            f"unsafe manifest path: {value!r}")
    resolved = (ROOT / path).resolve()
    require(resolved.is_relative_to(ROOT.resolve()) and resolved.is_file(),
            f"missing/outside-repository manifest file: {value}")
    return resolved


def mr10_cases() -> list[str]:
    require(MR10_MANIFEST.is_file(), f"missing MR10 manifest: {MR10_MANIFEST}")
    cases = []
    with MR10_MANIFEST.open(encoding="utf-8", newline="") as handle:
        for lineno, record in enumerate(handle, 1):
            if not record.strip() or record.startswith("#"):
                continue
            row = next(csv.reader([record], delimiter="\t"))
            require(len(row) == 7, f"MR10 manifest line {lineno}: expected seven fields")
            name, category, source, extras, compile_args, expected, code = row
            require(bool(TOKEN.fullmatch(name) and TOKEN.fullmatch(category)),
                    f"MR10 manifest line {lineno}: invalid test identity")
            label = f"{category}/{name}"
            require(label not in cases, f"duplicate MR10 test identity: {label}")
            within_repo(source)
            within_repo(expected)
            try:
                int(code)
                extra_args = shlex.split(extras)
                compile_options = shlex.split(compile_args)
            except ValueError as exc:
                raise VerificationError(f"MR10 manifest line {lineno}: {exc}") from exc
            for argument in extra_args:
                if argument.startswith("+"):
                    within_repo(argument[1:])
            for index, argument in enumerate(compile_options):
                if argument == "--dd":
                    require(index + 1 < len(compile_options),
                            f"MR10 manifest line {lineno}: missing DD value")
                    binding = compile_options[index + 1]
                    require("=" in binding, f"invalid MR10 DD binding: {binding}")
                    within_repo(binding.split("=", 1)[1])
            cases.append(label)
    require(bool(cases), "empty MR10 regression panel")
    return cases


def inventory() -> dict[str, list[str]]:
    require(MR10.is_file(), f"missing MR10 runner: {MR10}")
    require(NATIVE.is_file(), f"missing native runner: {NATIVE}")
    require((ROOT / "tools/mr10/compile-and-run").is_file(),
            "missing MR10 compile-and-run")
    require(MR10_PROBES.is_file(), f"missing MR10 probe runner: {MR10_PROBES}")
    require(MR10_PROBES_MANIFEST.is_file(),
            f"missing MR10 probe manifest: {MR10_PROBES_MANIFEST}")
    probe_check = subprocess.run([str(MR10_PROBES), "--check"], cwd=ROOT,
                                 text=True, stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, check=False)
    require(probe_check.returncode == 0,
            "MR10 probe manifest check failed: " + probe_check.stdout.strip())
    with MR10_PROBES_MANIFEST.open(encoding="utf-8", newline="") as handle:
        probe_rows = list(csv.DictReader(handle, delimiter="\t"))
    accepted = [row["case_id"] for row in probe_rows
                if row.get("verification") == "ACCEPTED"]
    require(accepted == list(ACCEPTED_MR10_PROBES),
            "MR10 accepted probe identities changed; review before updating coordinator")
    selected = {"mr10": mr10_cases(), "mr10-probes": accepted}
    check = subprocess.run([str(NATIVE), "--check"], cwd=ROOT,
                           text=True, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, check=False)
    require(check.returncode == 0, "native manifest check failed: " + check.stdout.strip())
    for suite in NATIVE_SUITES:
        file = NATIVE_MANIFESTS / f"{suite}.tsv"
        with file.open(encoding="utf-8", newline="") as handle:
            rows = list(csv.DictReader(handle, delimiter="\t"))
        require(bool(rows), f"empty native suite manifest: {suite}")
        require(all(row.get("case_id") and row.get("directory") for row in rows),
                f"bad native manifest rows: {suite}")
        selected[suite] = [row["case_id"] for row in rows]
    return selected


def git_head() -> str:
    proc = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT,
                          text=True, capture_output=True, check=False)
    require(proc.returncode == 0 and bool(proc.stdout.strip()),
            "cannot determine Git HEAD")
    return proc.stdout.strip()


def parse_mr10(log: str, declared: list[str], rc: int) -> dict:
    reports = re.findall(
        r"(?m)^(PASS|FAIL)\s+([a-z][a-z0-9-]*/[a-z][a-z0-9-]*)\s*$", log)
    labels = [label for _, label in reports]
    footer = {}
    for key in ("PASS", "FAIL", "TOTAL"):
        matches = re.findall(rf"(?m)^{key}\s+(\d+)\s*$", log)
        require(len(matches) == 1, f"MR10 missing/ambiguous {key} count")
        footer[key] = int(matches[0])
    require(len(labels) == len(set(labels)) and set(labels) == set(declared),
            "MR10 reported cases differ from its manifest")
    require(footer["TOTAL"] == len(declared) and
            footer["PASS"] == sum(s == "PASS" for s, _ in reports) and
            footer["FAIL"] == sum(s == "FAIL" for s, _ in reports),
            "MR10 case counts disagree with output")
    require(rc == (1 if footer["FAIL"] else 0),
            f"MR10 unexpected runner RC={rc}")
    return {"status": "FAIL" if footer["FAIL"] else "PASS",
            "counts": {"PASS": footer["PASS"], "FAIL": footer["FAIL"],
                       "SKIP": None, "BLOCKED": None, "TOTAL": footer["TOTAL"]},
            "cases": [{"id": label, "status": state} for state, label in reports]}



def parse_mr10_probes(log: str, declared: list[str], rc: int) -> dict:
    matches = re.findall(r"(?m)^MR10 PROBE EVIDENCE: (.+)\s*$", log)
    require(len(matches) == 1, "MR10 probes: expected one evidence directory")
    evidence = Path(matches[0].strip()).resolve()
    parent = (ROOT / "workarea/mr10-probes").resolve()
    require(evidence.parent == parent and evidence.is_dir(),
            "MR10 probes: evidence directory outside probe run root")
    file = evidence / "summary.json"
    require(file.is_file(), "MR10 probes: missing summary")
    payload = json.loads(file.read_text(encoding="utf-8"))
    require(payload.get("suite") == "mr10-probes",
            "MR10 probes: evidence suite mismatch")
    cases = payload.get("cases")
    require(isinstance(cases, list) and len(cases) == len(declared),
            "MR10 probes: case count mismatch")
    require(payload.get("selected_cases") == declared and
            [row.get("id") for row in cases] == declared,
            "MR10 probes: selected IDs differ from the accepted case inventory")
    require(all(row.get("verification") == "ACCEPTED" for row in cases),
            "MR10 probes: unaccepted case selected")
    counts = {key: sum(row.get("status") == key for row in cases)
              for key in ("PASS", "FAIL", "OBSERVED", "NOT_RUN")}
    require(sum(counts.values()) == len(cases) and
            payload.get("counts") == counts,
            "MR10 probes: statuses or counts disagree with summary")
    expected_rc = 1 if counts["FAIL"] else (3 if counts["OBSERVED"] else 0)
    expected_status = ("FAIL" if counts["FAIL"] else
                       "UNVERIFIED" if counts["OBSERVED"] else "PASS")
    require(rc == expected_rc and payload.get("status") == expected_status,
            f"MR10 probes: runner RC/status disagree with summary (RC={rc})")
    require(not counts["NOT_RUN"] or counts["FAIL"],
            "MR10 probes: unexecuted cases without a reported failure")
    status = ("FAIL" if counts["FAIL"] else
              "BLOCKED" if counts["OBSERVED"] else "PASS")
    return {"status": status,
            "counts": {"PASS": counts["PASS"], "FAIL": counts["FAIL"],
                       "SKIP": 0, "BLOCKED": counts["OBSERVED"],
                       "TOTAL": len(cases)},
            "probe_evidence": str(evidence.relative_to(ROOT)),
            "cases": [{"id": row["id"], "status": row["status"]} for row in cases]}


def parse_native(log: str, suite: str, profile: str,
                 declared: list[str], rc: int) -> dict:
    matches = re.findall(r"(?m)^Evidence: (.+)\s*$", log)
    require(bool(matches), f"{suite}: native evidence location not reported")
    evidence = Path(matches[-1].strip()).resolve()
    parent = (ROOT / "workarea/test-suites").resolve()
    require(evidence.parent == parent and evidence.is_dir(),
            f"{suite}: evidence directory outside native run root")
    file = evidence / "summary.json"
    require(file.is_file(), f"{suite}: missing native summary")
    payload = json.loads(file.read_text(encoding="utf-8"))
    require(payload.get("suite") == suite and payload.get("profile") == profile,
            f"{suite}: native evidence identity/profile mismatch")
    cases = payload.get("cases")
    require(isinstance(cases, list) and len(cases) == len(declared),
            f"{suite}: native case count mismatch")
    ids = [row.get("id") for row in cases]
    require(len(ids) == len(set(ids)) and set(ids) == set(declared),
            f"{suite}: native case IDs differ from manifest")
    counts = {key: sum(row.get("status") == key for row in cases)
              for key in ("PASS", "FAIL", "SKIP", "BLOCKED")}
    require(all(row.get("status") in counts for row in cases) and
            payload.get("counts") == counts,
            f"{suite}: native outcome counts disagree with summary")
    expected_rc = 1 if counts["FAIL"] else (2 if counts["BLOCKED"] else 0)
    require(rc == expected_rc, f"{suite}: native runner RC={rc}, expected {expected_rc}")
    status = "FAIL" if counts["FAIL"] else (
        "BLOCKED" if counts["BLOCKED"] else "PASS")
    return {"status": status, "counts": {**counts, "TOTAL": len(cases)},
            "native_evidence": str(evidence.relative_to(ROOT)),
            "cases": [{"id": row["id"], "status": row["status"]} for row in cases]}


def save(path: Path, payload: dict) -> None:
    temp = path.with_suffix(".tmp")
    temp.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    temp.replace(path)


def progress_case(suite: str, line: str) -> str | None:
    if suite == "mr10":
        match = PROGRESS_MR10.fullmatch(line.rstrip("\r\n"))
    elif suite == "mr10-probes":
        match = PROGRESS_PROBES.match(line)
    else:
        match = PROGRESS_NATIVE.match(line)
    if match is None:
        return None
    if suite in ("mr10", "mr10-probes"):
        return f"{match.group(1):<7} {match.group(2)}"
    return f"{match.group(1):<7} {match.group(2)}  {match.group(3)}"


def suite_command(suite: str, cases: dict[str, list[str]],
                  profile: str | None, allow_device: bool) -> list[str]:
    if suite == "mr10":
        return [str(MR10)]
    if suite == "mr10-probes":
        command = [str(MR10_PROBES), "--run"]
        for ident in cases[suite]:
            command.extend(("--case", ident))
        return command
    command = [str(NATIVE), suite, "--run", "--profile", profile]
    if suite == "bcplqsam" and allow_device:
        command.append("--allow-device")
    return command


def run_logged(command: list[str], suite: str, log_path: Path,
               environment: dict[str, str], progress: bool) -> int:
    with log_path.open("w", encoding="utf-8") as handle:
        if not progress:
            return subprocess.run(command, cwd=ROOT, env=environment,
                                  stdout=handle, stderr=subprocess.STDOUT,
                                  check=False).returncode
        child_env = environment.copy()
        child_env["PYTHONUNBUFFERED"] = "1"
        with subprocess.Popen(command, cwd=ROOT, env=child_env,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              text=True, encoding="utf-8", errors="replace",
                              bufsize=1) as proc:
            assert proc.stdout is not None
            for line in proc.stdout:
                handle.write(line)
                item = progress_case(suite, line)
                if item is not None:
                    print(item, flush=True)
            return proc.wait()


def execute(args: argparse.Namespace, cases: dict[str, list[str]]) -> int:
    run_started = time.monotonic()
    os.umask(0o077)
    RUN_ROOT.mkdir(parents=True, exist_ok=True)
    now = datetime.now(timezone.utc)
    evidence = Path(tempfile.mkdtemp(
        prefix=f"{now:%Y%m%dT%H%M%SZ}-{os.getpid()}-", dir=RUN_ROOT))
    selected = [suite for suite in SUITES if suite in args.suite]
    summary = {
        "schema": 1, "git_head": git_head(), "started_utc": now.isoformat(),
        "selected_suites": selected,
        "native_profile": args.profile,
        "allow_device": args.allow_device,
        "progress": args.progress,
        "suites": [
            {"name": suite, "status": "NOT_RUN" if suite in selected else "NOT_SELECTED",
             "test_count": len(cases[suite])}
            for suite in SUITES
        ],
    }
    filename = evidence / "summary.json"
    save(filename, summary)
    print(f"PROJECT REGRESSION EVIDENCE: {evidence}", flush=True)
    environment = os.environ.copy()
    for key in ("Q4_PUNCH_RESUME", "R1_ACCEPTANCE", "R1_REGRESSION_LOG_DIR",
                "R1_ACCEPTANCE_WORKDIR"):
        environment.pop(key, None)

    for entry in summary["suites"]:
        suite = entry["name"]
        if suite not in selected:
            continue
        command = suite_command(suite, cases, args.profile, args.allow_device)
        log_path = evidence / f"{suite}.log"
        print(f"RUN {suite} ({len(cases[suite])} cases)", flush=True)
        try:
            rc = run_logged(command, suite, log_path, environment, args.progress)
            log = log_path.read_text(encoding="utf-8", errors="replace")
            details = (parse_mr10(log, cases[suite], rc)
                       if suite == "mr10" else
                       parse_mr10_probes(log, cases[suite], rc)
                       if suite == "mr10-probes" else
                       parse_native(log, suite, args.profile, cases[suite], rc))
            entry.update(details)
            entry["runner_rc"] = rc
        except (OSError, ValueError, json.JSONDecodeError) as exc:
            entry.update({"status": "FAIL", "error": str(exc)})
        entry["runner_log"] = str(log_path.relative_to(ROOT))
        save(filename, summary)
        print(f"{entry['status']} {suite}: {entry.get('counts', entry.get('error'))}", flush=True)
        if entry["status"] != "PASS":
            break  # Never launch further JES work after a failed or blocked suite.

    summary["finished_utc"] = datetime.now(timezone.utc).isoformat()
    states = {entry["status"] for entry in summary["suites"] if entry["name"] in selected}
    overall = ("FAIL" if "FAIL" in states else
               "BLOCKED" if "BLOCKED" in states else
               "INCOMPLETE" if "NOT_RUN" in states else "PASS")
    summary["status"] = overall
    summary["elapsed_seconds"] = round(time.monotonic() - run_started, 3)
    save(filename, summary)
    print(f"PROJECT REGRESSION RESULT: {overall}")
    print(f"SUMMARY: {filename}")
    return 0 if overall == "PASS" else (2 if overall == "BLOCKED" else 1)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    operations = parser.add_mutually_exclusive_group(required=True)
    operations.add_argument("--list", action="store_true", help="list suites without JES")
    operations.add_argument("--check", action="store_true", help="validate suite inputs without JES")
    operations.add_argument("--run", action="store_true", help="execute selected suites; may submit JES")
    parser.add_argument("--suite", action="append", choices=SUITES,
                        help="suite to run/list; repeat to combine suites")
    parser.add_argument("--allow-device", action="store_true",
                        help="authorize BCPLQSAM JES printer/punch cases (requires --run)")
    parser.add_argument("--progress", action="store_true",
                        help="stream concise case results to the console (requires --run)")
    parser.add_argument("--profile", choices=("production", "installed-r5-t1"),
                        help="required for native suites when running")
    args = parser.parse_args(argv)
    requested = args.suite or []
    if len(set(requested)) != len(requested):
        parser.error("duplicate --suite selection")
    native_requested = any(name in NATIVE_SUITES for name in requested)
    if args.progress and not args.run:
        parser.error("--progress requires --run")
    if args.allow_device and (not args.run or "bcplqsam" not in requested):
        parser.error("--allow-device requires --run and --suite bcplqsam")
    if args.run and not requested:
        parser.error("--run requires one or more explicit --suite options")
    if args.run and native_requested and not args.profile:
        parser.error("native --run requires an explicit --profile")
    if args.profile and (not args.run or not native_requested):
        parser.error("--profile applies only to native --run")
    try:
        cases = inventory()
        if args.run:
            return execute(args, cases)
        selected = [name for name in SUITES if not requested or name in requested]
        for name in selected:
            print(f"{name}\t{len(cases[name])}\t" +
                  ("interpreted MR10" if name == "mr10" else
                   "interpreted MR10 probes" if name == "mr10-probes" else
                   "native System/370"))
        print("PROJECT SUITE CHECK: PASS" if args.check else
              "PROJECT SUITE LIST: host-only")
        return 0
    except (VerificationError, OSError, csv.Error) as exc:
        print(f"run-project-regressions: {exc}", file=sys.stderr)
        return 2


def format_elapsed(seconds: float) -> str:
    elapsed = max(0, int(seconds))
    return f"{elapsed // 60}m {elapsed % 60:02d}s"


if __name__ == "__main__":
    invocation_started = time.monotonic()
    try:
        sys.exit(main())
    finally:
        print("TOTAL REGRESSION EXECUTION TIME: "
              + format_elapsed(time.monotonic() - invocation_started),
              flush=True)
