#!/usr/bin/env python3
"""Standalone MR10 development-probe runner with one accepted golden case.

--check/--list are host-only. --run submits JES through compile-and-run
or run-intcode. Six original BCPL probes have owner-accepted golden baselines;
the eleven newly executable historical probes remain UNVERIFIED.
No installed datasets are modified by the runner itself.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[2]
VALIDATOR = ROOT / "tools/checks/check-mr10-dev-probes-manifest.py"
COMPILE = ROOT / "tools/mr10/compile-and-run"
EVIDENCE_ROOT = ROOT / "workarea/mr10-probes"
CURRENT = ROOT / "mr10-kit-compiler/asm/CURRENT"

# Additional historical probes remain experimental until MVS evidence review.
EXTRA_PATH = Path(__file__).with_name("dev_probe_extras.py")
_extra_spec = importlib.util.spec_from_file_location("mr10_dev_probe_extras", EXTRA_PATH)
if _extra_spec is None or _extra_spec.loader is None:
    raise RuntimeError(f"cannot load MR10 extra contracts: {EXTRA_PATH}")
EXTRAS = importlib.util.module_from_spec(_extra_spec)
_extra_spec.loader.exec_module(EXTRAS)
JES_SUMMARY = ROOT / "tools/mvs/job-summary"
JES_DUMP = ROOT / "tools/mvs/dump-report-for-job"
PRINTER = ROOT / "mvs-state/prt/prt00e.txt"
ACCEPTED_CASE = "05-named-dd"
GOLDEN_PATH = "mr10-kit-compiler/tests/05-named-dd/05-named-dd.expected"
ACCEPTED_CASES = {
    ident: f"mr10-kit-compiler/tests/{ident}/{ident}.expected"
    for ident in (
        "04-module-test", "05-named-dd", "06-dynamic-streams",
        "07-many-streams", "09-multiple-assignment", "11-getvec-freevec"
    )
}
EXPECTED_STEPS = (
    ("ASM", "IFOX00"), ("LKED", "IEWL"),
    ("STGSYNI", "IEBGENER"), ("STGTRNI", "IEBGENER"),
    ("STGCGI", "IEBGENER"), ("STGBLIB", "IEBGENER"),
    ("STGICLIB", "IEBGENER"), ("COMP", "RUNMOD"),
    ("CG", "RUNMOD"), ("RUN", "RUNMOD"),
)
METADATA_RE = re.compile(
    r"^(?:PROGRAM SIZE|PROGVEC CAPACITY|FREE STACK/WORK|STACKBASE|"
    r"STACKEND|GLOBAL CAPACITY|GLOBALS USED|HIGHEST GLOBAL)\s*="
)
STEP_RE = re.compile(r"^([A-Z0-9]+)\s+([A-Z0-9]+)\s+RC=(\d{4})$")

# The initial, source-backed provisional assertions are *not* accepted
# golden outputs. Keep the remaining 11 contract cases out of --run.
PROVISIONAL = (
    "04-module-test",
    "05-named-dd",
    "06-dynamic-streams",
    "07-many-streams",
    "09-multiple-assignment",
    "11-getvec-freevec",
)
# These expectations are observations to collect/verify on MVS, not a
# substitute for an independently accepted golden-output baseline.
FACTORIAL = (1, 2, 6, 24, 120, 720, 5040, 40320, 362880, 3628800)
TRACE = {
    "04-module-test": tuple(f"F({i}), = {value}" for i, value in enumerate(FACTORIAL, 1)),
    "05-named-dd": ("VALUE FROM EXTRA = 12345",),
    "06-dynamic-streams": ("DEEPEST GET VALUE = 24680",),
    "07-many-streams": (
        "OPENED 12 STREAMS",
        *(f"DD{i} = STREAM {i:02d}" for i in range(1, 13)),
        "ALL 12 STREAMS READ AND CLOSED",
    ),
    "09-multiple-assignment": (
        "SWAP BEFORE A=1 B=2", "SWAP AFTER  A=2 B=2",
        "EUCLID BEFORE A=1071 B=462", "EUCLID AFTER  A=462 B=0",
    ),
    "11-getvec-freevec": (
        "ALLOCATED A B C", "A DATA 101 109", "B DATA 201 219",
        "C DATA 301 329", "REUSED B BLOCK",
        "COALESCED ALLOC 777 888", "GETVEC FREEVEC OK",
    ),
}
CODE_RE = re.compile(r"EXECUTION CYCLES\s*=\s*\d+,\s*CODE\s*=\s*(-?\d+)")
JOB_RE = re.compile(r"(?m)^JOB\s+(\d+)\s*$")
CURRENT_RE = re.compile(r"icintv[0-9]+\.asm\Z")


class ProbeError(ValueError):
    pass


def manifest_cases() -> list[dict[str, str]]:
    spec = importlib.util.spec_from_file_location("mr10_probe_contract", VALIDATOR)
    if spec is None or spec.loader is None:
        raise ProbeError(f"cannot load host-only contract validator: {VALIDATOR}")
    module = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(module)
        return module.validate(ROOT)
    except (OSError, ValueError) as exc:
        raise ProbeError(f"probe contract validation failed: {exc}") from exc


def current_interpreter() -> Path:
    try:
        name = CURRENT.read_text(encoding="ascii").strip()
    except (OSError, UnicodeError) as exc:
        raise ProbeError(f"cannot read CURRENT interpreter selection: {exc}") from exc
    if not CURRENT_RE.fullmatch(name):
        raise ProbeError("CURRENT contains an invalid interpreter name")
    asm = (CURRENT.parent / name).resolve()
    if not asm.is_relative_to(ROOT.resolve()) or not asm.is_file():
        raise ProbeError(f"CURRENT interpreter not found within repository: {name}")
    return asm


def git_head() -> str:
    proc = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT,
                          text=True, capture_output=True, check=False)
    if proc.returncode or not re.fullmatch(r"[a-f0-9]{40}", proc.stdout.strip()):
        raise ProbeError("cannot record a valid Git HEAD for probe evidence")
    return proc.stdout.strip()


def command_for(row: dict[str, str], icint: Path, jcl: Path, job: str) -> list[str]:
    ident = row["case_id"]
    if ident not in PROVISIONAL or row["engine"] != "compile-and-run" or row["interpreter"] != "current":
        raise ProbeError(f"{ident}: historical or unsupported probe cannot execute")
    if ident in ACCEPTED_CASES:
        if (row["verification"] != "ACCEPTED" or
                row["oracle"] != f"file:{ACCEPTED_CASES[ident]}"):
            raise ProbeError(f"{ident}: accepted golden contract is required")
    elif row["verification"] != "UNVERIFIED" or not row["oracle"].startswith("pending:"):
        raise ProbeError(f"{ident}: expected pre-acceptance contract")
    command = [str(COMPILE), "--results", "--jcl", str(jcl), "--job-name", job]
    for binding in row["dd_bindings"].split(";") if row["dd_bindings"] else []:
        ddname, rel = binding.split("=", 1)
        command.extend(("--dd", f"{ddname}={ROOT / rel}"))
    command.extend((str(icint), str(ROOT / row["source"])))
    for module in row["modules"].split(";") if row["modules"] else []:
        command.append("+" + str(ROOT / module))
    return command


def assess_output(ident: str, output: str, returncode: int) -> tuple[str, str]:
    """Check provisional trace only; success is OBSERVED, never PASS."""
    if returncode:
        return "FAIL", f"compile-and-run returned RC={returncode}"
    jobs = JOB_RE.findall(output)
    if len(jobs) != 1:
        return "FAIL", f"expected exactly one JES job ID; found {len(jobs)}"
    if output.count("INTCODE SYSTEM ENTERED") != 1:
        return "FAIL", "expected exactly one final ICINT execution banner"
    codes = CODE_RE.findall(output)
    if len(codes) != 1:
        return "FAIL", f"expected one interpreted completion code; found {len(codes)}"
    if codes[0] != "0":
        return "FAIL", f"interpreted CODE={codes[0]}; expected 0"
    lines = [line.strip(" \t\r\f") for line in output.splitlines()]
    if any(line.startswith(("INTCODE ERROR", "SYNTAX ERROR", "MAPSTORE ERROR")) for line in lines):
        return "FAIL", "interpreter/compiler error marker in output"
    # Expect each required line exactly once and in the specified order.
    # Extra diagnostic lines from ICINT are retained in the raw evidence.
    positions = []
    for expected in TRACE[ident]:
        matches = [i for i, line in enumerate(lines) if line == expected]
        if len(matches) != 1:
            return "FAIL", f"expected exactly one occurrence of {expected!r}; got {len(matches)}"
        positions.append(matches[0])
    if positions != sorted(positions) or len(positions) != len(set(positions)):
        return "FAIL", "provisional trace lines are out of order"
    return "OBSERVED", "provisional source-derived trace matched; oracle remains UNVERIFIED"


def final_program_records(output: str) -> list[str]:
    """Extract program-visible lines from the final --results ICINT block.

    ICINT's changing counters and memory statistics are metadata, not the
    user program's golden output. Unknown non-empty lines fail comparison.
    """
    lines = [line.strip() for line in output.splitlines()]
    starts = [i for i, line in enumerate(lines) if line == "INTCODE SYSTEM ENTERED"]
    if len(starts) != 1:
        raise ProbeError("expected exactly one final ICINT execution banner")
    codes = [i for i, line in enumerate(lines) if CODE_RE.fullmatch(line)]
    if len(codes) != 1 or codes[0] <= starts[0]:
        raise ProbeError("expected a final interpreted completion record")
    return [line for line in lines[starts[0] + 1:codes[0]]
            if line and not METADATA_RE.match(line)]


def verify_accepted_output(output: str, golden: Path) -> None:
    try:
        expected = [line.rstrip() for line in golden.read_text(encoding="utf-8").splitlines()]
    except (OSError, UnicodeError) as exc:
        raise ProbeError(f"missing accepted golden output: {exc}") from exc
    if not expected or any(not line for line in expected):
        raise ProbeError("accepted golden output is empty or malformed")
    actual = final_program_records(output)
    if actual != expected:
        raise ProbeError(f"golden output mismatch: expected {expected!r}, got {actual!r}")


def expected_jes_steps(ident: str) -> list[tuple[str, str]]:
    """The original six have either one or two compilation units."""
    steps = list(EXPECTED_STEPS[:7])
    count = 2 if ident in ("04-module-test", "11-getvec-freevec") else 1
    for i in range(1, count + 1):
        comp = "COMP" if count == 1 else f"COMP{i:02d}"
        cg = "CG" if count == 1 else f"CG{i:02d}"
        steps.extend(((comp, "RUNMOD"), (cg, "RUNMOD")))
    steps.append(("RUN", "RUNMOD"))
    return steps


def verify_jes_steps(job_id: str, expected_name: str, folder: Path,
                     ident: str = ACCEPTED_CASE) -> dict:
    """Require exact job identity, zero RCs and interpreted phase completions."""
    if ident not in ACCEPTED_CASES:
        raise ProbeError(f"JES verification is not accepted for {ident}")
    if not PRINTER.is_file() or not JES_SUMMARY.is_file() or not JES_DUMP.is_file():
        raise ProbeError("required existing JES printer output/report tool missing")
    summary_proc = subprocess.run(
        [str(JES_SUMMARY), job_id, "--file", str(PRINTER), "--max-rc", "0"],
        cwd=ROOT, capture_output=True, text=True, check=False)
    dump_proc = subprocess.run(
        [str(JES_DUMP), job_id], cwd=ROOT, capture_output=True,
        text=True, check=False)
    summary_text = summary_proc.stdout + summary_proc.stderr
    report_text = dump_proc.stdout
    summary_path = folder / f"{ident}-jes-summary.txt"
    report_path = folder / f"{ident}-jes-report.txt"
    summary_path.write_text(summary_text, encoding="utf-8")
    if report_text:
        report_path.write_text(report_text, encoding="utf-8")
    if summary_proc.returncode != 0 or dump_proc.returncode != 0:
        raise ProbeError(
            f"JES report extraction failed (summary RC={summary_proc.returncode}; "
            f"dump RC={dump_proc.returncode}): "
            f"{summary_proc.stderr.strip()} {dump_proc.stderr.strip()}")
    summary_lines = summary_proc.stdout.splitlines()
    if not summary_lines or summary_lines[0].strip() != f"JOB {job_id}  {expected_name}":
        raise ProbeError("JES report does not match submitted job ID and name")
    if ("JOB RESULT: SUCCESS" not in summary_lines or
            "HIGHEST RC: 0000" not in summary_lines):
        raise ProbeError("JES report does not establish successful RC=0000 completion")
    steps = [match.groups() for line in summary_lines
             if (match := STEP_RE.fullmatch(line.strip()))]
    required = [(name, pgm, "0000") for name, pgm in expected_jes_steps(ident)]
    if steps != required:
        raise ProbeError(f"JES step list/RC mismatch: expected {required!r}; got {steps!r}")
    codes = [int(value) for value in CODE_RE.findall(report_text)]
    expected_codes = [0] * (2 * (2 if ident in ("04-module-test", "11-getvec-freevec") else 1) + 1)
    if codes != expected_codes:
        raise ProbeError(f"JES compiler, generator and RUN CODEs not {expected_codes}: {codes!r}")
    lines = [line.strip() for line in report_text.splitlines()]
    positions = []
    for record in TRACE[ident]:
        matches = [i for i, line in enumerate(lines) if line == record]
        if len(matches) != 1:
            raise ProbeError(f"accepted output {record!r} absent or duplicated in JES report")
        positions.append(matches[0])
    if positions != sorted(positions):
        raise ProbeError("accepted output records out of order in JES report")
    return {
        "jes_step_codes": [{"step": step, "program": pgm, "rc": 0}
                           for step, pgm in expected_jes_steps(ident)],
        "jes_phase_codes": codes,
        "jes_summary": str(summary_path.relative_to(ROOT)),
        "jes_report": str(report_path.relative_to(ROOT)),
    }


def save(path: Path, data: dict) -> None:
    staging = path.with_suffix(".tmp")
    staging.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    staging.replace(path)


def dispatch_command(row: dict[str, str], icint: Path, jcl: Path,
                     job: str, artifact_dir: Path) -> list[str]:
    if row["case_id"] in PROVISIONAL:
        return command_for(row, icint, jcl, job)
    if row["case_id"] in EXTRAS.ADDITIONAL:
        return EXTRAS.command(ROOT, row, icint, jcl, job, artifact_dir)
    raise ProbeError(f"{row['case_id']}: unsupported case")


def run(rows: list[dict[str, str]], selected: list[str]) -> int:
    if not COMPILE.is_file():
        raise ProbeError(f"missing compile-and-run tool: {COMPILE}")
    icint = current_interpreter()
    revision = git_head()
    entries = {r["case_id"]: r for r in rows}
    # Validate every execution contract before creating evidence or submitting JES.
    for ident in selected:
        dispatch_command(entries[ident], icint,
                         ROOT / "workarea/mr10-probes/preflight.jcl",
                         "DP000000", ROOT / "workarea/mr10-probes/preflight-artifacts")
    os.umask(0o077)
    EVIDENCE_ROOT.mkdir(parents=True, exist_ok=True)
    moment = datetime.now(timezone.utc)
    folder = Path(tempfile.mkdtemp(
        prefix=f"{moment:%Y%m%dT%H%M%SZ}-{os.getpid()}-", dir=EVIDENCE_ROOT))
    summary_path = folder / "summary.json"
    summary = {
        "schema": 1, "suite": "mr10-probes", "git_head": revision,
        "started_utc": moment.isoformat(), "interpreter": str(icint.relative_to(ROOT)),
        "verification": "CASE_SPECIFIC", "status": "IN_PROGRESS",
        "selected_cases": selected,
        "cases": [{"id": item, "status": "NOT_RUN"} for item in selected],
    }
    save(summary_path, summary)
    print(f"MR10 PROBE EVIDENCE: {folder}", flush=True)
    observed = 0
    accepted = 0
    fail = False
    for index, item in enumerate(summary["cases"], 1):
        ident = item["id"]
        slug = ident.replace("/", "--")
        log_path = folder / f"{slug}.log"
        jcl_path = folder / f"{slug}.jcl"
        job_name = f"DP{index:02d}{os.getpid() % 10000:04d}"
        artifact_dir = folder / slug / "artifacts"
        command = dispatch_command(entries[ident], icint, jcl_path,
                                   job_name, artifact_dir)
        item.update({"command": command, "job_name": job_name,
                     "log": str(log_path.relative_to(ROOT)),
                     "jcl": str(jcl_path.relative_to(ROOT)),
                     "expected_code": int(entries[ident]["expected_code"]),
                     "expected_oracle": entries[ident]["oracle"],
                     "verification": entries[ident]["verification"]})
        save(summary_path, summary)
        print(f"RUN      {ident}", flush=True)
        try:
            with log_path.open("w", encoding="utf-8") as logfile:
                proc = subprocess.run(command, cwd=ROOT, stdout=logfile,
                                      stderr=subprocess.STDOUT, check=False)
            content = log_path.read_text(encoding="utf-8", errors="replace")
            if ident in EXTRAS.ADDITIONAL:
                try:
                    candidate = EXTRAS.assess(ROOT, entries[ident], content,
                                             proc.returncode, artifact_dir)
                    state, reason = candidate["status"], candidate["reason"]
                    item["artifacts"] = candidate["artifacts"]
                except (EXTRAS.ExtraError, OSError, UnicodeError) as exc:
                    state, reason = "FAIL", str(exc)
            else:
                state, reason = assess_output(ident, content, proc.returncode)
            jobs = JOB_RE.findall(content)
            codes = CODE_RE.findall(content)
            item.update({"status": state, "reason": reason, "runner_rc": proc.returncode,
                         "jes_job_id": jobs[0] if len(jobs) == 1 else None,
                         "interpreted_code": int(codes[0]) if len(codes) == 1 else None})
            if ident in EXTRAS.ADDITIONAL and len(jobs) == 1:
                try:
                    item.update(EXTRAS.capture_jes(
                        ROOT, entries[ident], jobs[0], job_name, folder, slug))
                except (EXTRAS.ExtraError, OSError, UnicodeError) as exc:
                    if item["status"] == "OBSERVED":
                        item["status"] = "FAIL"
                        item["reason"] = "JES verification: " + str(exc)
                    else:
                        item["jes_review_error"] = str(exc)
            if ident in ACCEPTED_CASES and state == "OBSERVED":
                try:
                    verify_accepted_output(content, ROOT / ACCEPTED_CASES[ident])
                    item.update(verify_jes_steps(jobs[0], job_name, folder, ident))
                    item["status"] = "PASS"
                    item["reason"] = (f"accepted golden output and all "
                                      f"{len(expected_jes_steps(ident))} JES steps verified")
                except ProbeError as exc:
                    item["status"] = "FAIL"
                    item["reason"] = str(exc)
        except OSError as exc:
            item.update({"status": "FAIL", "reason": f"runner I/O failure: {exc}"})
        save(summary_path, summary)
        print(f"{item['status']:<8} {ident}: {item['reason']}", flush=True)
        if item["status"] == "OBSERVED":
            observed += 1
        elif item["status"] == "PASS":
            accepted += 1
        else:
            fail = True
            break
    summary["finished_utc"] = datetime.now(timezone.utc).isoformat()
    summary["status"] = "FAIL" if fail else "UNVERIFIED" if observed else "PASS"
    summary["verification"] = "MIXED" if observed and accepted else "UNVERIFIED" if observed else "ACCEPTED"
    summary["counts"] = {
        "PASS": accepted, "OBSERVED": observed,
        "FAIL": sum(r["status"] == "FAIL" for r in summary["cases"]),
        "NOT_RUN": sum(r["status"] == "NOT_RUN" for r in summary["cases"]),
    }
    save(summary_path, summary)
    print(f"MR10 PROBE RESULT: {summary['status']} "
          f"({accepted} accepted PASS; {observed} provisional OBSERVED)")
    print(f"SUMMARY: {summary_path}")
    return 1 if fail else 3 if observed else 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument("--check", action="store_true", help="validate manifest; no JES")
    modes.add_argument("--list", action="store_true", help="list case contracts; no JES")
    modes.add_argument("--run", action="store_true", help="submit JES for explicitly selected provisional probes")
    parser.add_argument("--case", action="append", default=[], metavar="CASE_ID",
                        help="select historical case ID, repeat for multiple cases")
    parser.add_argument("--all-provisional", action="store_true",
                        help="select the original six BCPL probes for --run")
    parser.add_argument("--all-candidates", action="store_true",
                        help="run all 17 historical contracts (six ACCEPTED, eleven UNVERIFIED)")
    args = parser.parse_args(argv)
    try:
        rows = manifest_cases()
        entries = {r["case_id"]: r for r in rows}
        if len(args.case) != len(set(args.case)):
            raise ProbeError("duplicate --case argument")
        if args.all_provisional and (args.case or args.all_candidates or not args.run):
            raise ProbeError("--all-provisional requires --run without --case or --all-candidates")
        if args.all_candidates and (args.case or not args.run):
            raise ProbeError("--all-candidates requires --run without --case")
        unknown = [ident for ident in args.case if ident not in entries]
        if unknown:
            raise ProbeError("unknown probe case: " + ", ".join(unknown))
        selected = (list(PROVISIONAL) if args.all_provisional else
                    [r["case_id"] for r in rows if not args.case or r["case_id"] in args.case])
        if args.check:
            count_accepted = sum(r["verification"] == "ACCEPTED" for r in rows)
            print(f"MR10 PROBES CHECK: PASS ({len(rows)} contracts; "
                  f"{count_accepted} accepted, {len(PROVISIONAL) - count_accepted} provisional, "
                  f"{len(EXTRAS.ADDITIONAL)} experimental; host-only)")
            return 0
        if args.list:
            for row in rows:
                if row["case_id"] in selected:
                    status = ("ACCEPTED" if row["verification"] == "ACCEPTED" else
                              "PROVISIONAL" if row["case_id"] in PROVISIONAL else
                              "EXPERIMENTAL" if row["case_id"] in EXTRAS.ADDITIONAL else
                              "NOT_IMPLEMENTED")
                    print(f"{row['case_id']}\t{status}\t{row['interpreter']}\t{row['oracle']}")
            return 0
        if not args.case and not args.all_provisional and not args.all_candidates:
            raise ProbeError("--run requires --case CASE_ID, --all-provisional or --all-candidates")
        supported = set(PROVISIONAL) | set(EXTRAS.ADDITIONAL)
        unsupported = [ident for ident in selected if ident not in supported]
        if unsupported:
            raise ProbeError("unsupported/UNVERIFIED case(s); no JES submitted: " + ", ".join(unsupported))
        return run(rows, selected)
    except (ProbeError, EXTRAS.ExtraError, OSError) as exc:
        print(f"run-dev-probes: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
