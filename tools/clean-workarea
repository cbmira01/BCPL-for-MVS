#!/usr/bin/env python3
"""Clean disposable host files; preserve the tracked workarea/.gitignore."""
from __future__ import annotations

import argparse
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT / 'tools/reconstruction'))
from contract import ScopeError, remove_workarea_contents, workarea_scope


def main(argv=None, *, read_line=input, interactive=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--reconstruction-scope', metavar='SHA256')
    args = parser.parse_args(argv)
    if args.reconstruction_scope and (len(args.reconstruction_scope) != 64 or
                                      any(c not in '0123456789abcdef' for c in args.reconstruction_scope)):
        raise ScopeError('invalid reconstruction scope')
    actual_root = subprocess.run(['git', '-C', str(ROOT), 'rev-parse', '--show-toplevel'],
                                 capture_output=True, text=True, check=False)
    if actual_root.returncode or Path(actual_root.stdout.strip()) != ROOT:
        raise ScopeError('not in the expected Git repository')
    tracked = subprocess.run(['git', '-C', str(ROOT), 'ls-files', '-z', '--', 'workarea/'],
                             capture_output=True, check=False)
    if tracked.returncode or tracked.stdout.split(b'\0') != [b'workarea/.gitignore', b'']:
        raise ScopeError('workarea contains unexpected tracked files')
    if not args.reconstruction_scope:
        if interactive is False or (interactive is None and not sys.stdin.isatty()):
            raise ScopeError('interactive terminal required')
    work = ROOT / 'workarea'
    approved = workarea_scope(work)
    if args.reconstruction_scope and approved.fingerprint != args.reconstruction_scope:
        raise ScopeError('workarea changed from approved reconstruction scope')
    top = [row[0] for row in approved.entries if '/' not in row[0]]
    print(f'About to permanently delete {len(top)} top-level item(s) beneath {work}:')
    for name in top:
        print('  ' + repr(name))
    print('workarea/.gitignore will be preserved.')
    if not args.reconstruction_scope:
        if interactive is False or (interactive is None and not sys.stdin.isatty()):
            raise ScopeError('interactive terminal required')
        if read_line('Type DELETE to confirm: ') != 'DELETE':
            print('Cancelled; no files deleted.')
            return 3
    else:
        print('Using the exact previously reviewed reconstruction scope.')
    remove_workarea_contents(work, approved)
    print('Cleaned workarea; preserved .gitignore.')
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (ScopeError, OSError) as exc:
        print(f'ERROR: {exc}', file=sys.stderr)
        raise SystemExit(2)
