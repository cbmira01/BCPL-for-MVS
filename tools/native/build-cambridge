#!/usr/bin/env python3
"""Rebuild native-compiler's resident INTCODE image in M3 NATIVE_* PDSes.

Sources and supporting members must first be staged into NATIVE_SOURCE using
manifest-managed dspal datasets. MR10_SOURCE supplies historical compiler
phases and MR10_LOAD supplies the already-installed ICINT19 interpreter.
No CAMB_* datasets are used or changed.
"""

from __future__ import annotations

import argparse
import importlib.util
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[2]
DSPAL_CORE = ROOT / "tools" / "datasets" / "dspal-core.py"

CAMBRIDGE_UNITS = [
    ("BCPL", "BCPL"),
    ("SYN", "SYN"),
    ("LEX", "LEX"),
    ("TRNA", "TRNA"),
    ("TRNB", "TRNB"),
    ("CGA", "CGA"),
    ("CGB", "CGB"),
    ("CGC", "CGC"),
    ("CGD", "CGD"),
    ("CGE", "CGE"),
    ("BOOTHOST", "BOOTHOST"),
]


def load_core():
    spec = importlib.util.spec_from_file_location("dspal_core", DSPAL_CORE)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {DSPAL_CORE}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


core = load_core()


def runtime_step(step: str, load: str) -> list[str]:
    return [
        f"//{step:<8} EXEC PGM=ICINT19,REGION=256K,TIME=(,30)",
        f"//STEPLIB  DD  DSN={load},DISP=SHR",
        "//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)",
        "//SYSUDUMP DD  DUMMY",
    ]


def build_deck(config, redact_password: bool) -> str:
    source = core.full_dsn(config, config["datasets"]["NATIVE_SOURCE"])
    mr10_source = core.full_dsn(config, config["datasets"]["MR10_SOURCE"])
    intcode = core.full_dsn(config, config["datasets"]["NATIVE_INTCODE"])
    load = core.full_dsn(config, config["datasets"]["MR10_LOAD"])

    lines = core.authenticated_job_card(
        config,
        "CAMBBLD",
        "CAMBRIDGE BUILD",
        redact_password=redact_password,
    )
    lines.extend([
        "//* M3 NATIVE COMPILER BOOTSTRAP; NO CAMB_* DATASETS",
        "//* INPUTS MUST BE POSITIONED USING DSPAL INTO MANIFEST-MANAGED PDS",
        f"//* MR10 INTERPRETER: {load}(ICINT19)",
        f"//* MR10 COMPILER PHASES: {mr10_source}",
        f"//* NATIVE OUTPUT INTCODE: {intcode}",
    ])

    for index, (src_member, out_member) in enumerate(CAMBRIDGE_UNITS, 1):
        oc = f"&&OC{index:02d}"
        comp = f"C{index:02d}CMP"
        cg = f"C{index:02d}CG"
        lines.extend([
            "//*",
            f"//* {source}({src_member}) -> {intcode}({out_member})",
            *runtime_step(comp, load),
            f"//INTIN    DD  DSN={mr10_source}(SYNI),DISP=SHR",
            f"//         DD  DSN={intcode}(TRNILRG),DISP=SHR",
            f"//         DD  DSN={mr10_source}(BLIBI),DISP=SHR",
            f"//         DD  DSN={mr10_source}(ICLIB),DISP=SHR",
            f"//SYSIN    DD  DSN={source}({src_member}),DISP=SHR",
            f"//OPTIONS  DD  DSN={source}(OPTIONS),DISP=SHR",
            f"//LIBHDR   DD  DSN={source}(LIBHDR),DISP=SHR",
            f"//SYNHDR   DD  DSN={source}(SYNHDR),DISP=SHR",
            f"//TRNHDR   DD  DSN={source}(TRNHDR),DISP=SHR",
            f"//CGHDR    DD  DSN={source}(CGHDR),DISP=SHR",
            f"//OCODE    DD  DSN={oc},UNIT=SYSDA,",
            "//             SPACE=(80,(1000,500)),",
            "//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),",
            "//             DISP=(NEW,PASS)",
            *runtime_step(cg, load),
            f"//INTIN    DD  DSN={mr10_source}(CGI),DISP=SHR",
            f"//         DD  DSN={mr10_source}(BLIBI),DISP=SHR",
            f"//         DD  DSN={mr10_source}(ICLIB),DISP=SHR",
            f"//SYSIN    DD  DSN={oc},DISP=(OLD,DELETE)",
            f"//INTCODE  DD  DSN={intcode}({out_member}),DISP=SHR",
        ])

    lines.extend([
        "//*",
        "//* CREATE ONE ICINT-RUNNABLE CAMBRIDGE COMPILER IMAGE",
        "//PACKCOMP EXEC PGM=IEBGENER",
        "//SYSPRINT DD  SYSOUT=*",
        "//SYSIN    DD  DUMMY",
        f"//SYSUT2   DD  DSN={intcode}(CAMBCOMP),DISP=SHR",
    ])
    first = True
    for member in [m for _s, m in CAMBRIDGE_UNITS] + ["BLIBI", "ICLIB"]:
        dd = "SYSUT1" if first else ""
        first = False
        input_dsn = mr10_source if member in ("BLIBI", "ICLIB") else intcode
        lines.append(f"//{dd:<8} DD  DSN={input_dsn}({member}),DISP=SHR")

    return "\n".join(lines) + "\n"


def execution_codes(report: str) -> list[int]:
    pattern = re.compile(
        r"EXECUTION CYCLES\s*=\s*\d+,\s*CODE\s*=\s*(-?\d+)"
    )
    return [int(m.group(1)) for m in pattern.finditer(report.replace("\f", ""))]


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="build-cambridge-mvs",
        description=(
            "Rebuild native-compiler CAMBCOMP using installed MR10 ICINT19 "
            "and manifest-managed NATIVE source/INTCODE datasets."
        ),
    )
    p.add_argument(
        "--show-jcl",
        action="store_true",
        help="show generated build JCL with the batch password redacted",
    )
    return p


def main() -> int:
    args = parser().parse_args()
    try:
        config = core.load_config()
        deck = build_deck(config, redact_password=args.show_jcl)

        if args.show_jcl:
            sys.stdout.write(deck)
            return 0

        core.require_reader_ready(config)
        job, summary = core.submit_and_wait(config, deck, max_rc=4)
        report = core.job_report(job)

        codes = execution_codes(report)
        expected = len(CAMBRIDGE_UNITS) * 2
        if len(codes) != expected:
            raise RuntimeError(
                f"JOB {job}: found {len(codes)} ICINT completion codes; "
                f"expected {expected}"
            )
        bad = [(i + 1, code) for i, code in enumerate(codes) if code != 0]
        if bad:
            raise RuntimeError(
                f"JOB {job}: nonzero interpreted completion codes: {bad}"
            )

        print(summary.rstrip())
        print(f"Cambridge build completed as JOB {job}")
        print("  " + core.full_dsn(config, config["datasets"]["MR10_LOAD"]) + "(ICINT19)")
        print("  " + core.full_dsn(config, config["datasets"]["NATIVE_INTCODE"]) + "(CAMBCOMP)")
        print("No regression was run.")
        return 0
    except (core.DspalError, RuntimeError, ValueError, OSError) as exc:
        print(f"build-cambridge-mvs: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
