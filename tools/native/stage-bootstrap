#!/usr/bin/env python3
"""Stage regenerated M3 compiler bootstrap source through manifest-managed dspal.

Requires tools/native/prepare-bootstrap first. No allocation or CAMB_* writes.
"""
from pathlib import Path
import argparse
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[2]
BASE = ROOT / "workarea/bootstrap-cambridge/demoted"
STAGING = (
    *((name.upper(), BASE / name) for name in
      ("bcpl", "syn", "lex", "trna", "trnb", "cga", "cgb",
       "cgc", "cgd", "cge")),
    ("BOOTHOST", ROOT / "native-compiler/bootstrap-cambridge/bootstrap-host.bcpl"),
    ("OPTIONS", ROOT / "native-compiler/bootstrap-cambridge/options-large-tree.txt"),
    ("CAMBPARM", ROOT / "native-compiler/bootstrap-cambridge/cambridge-options.txt"),
)

def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    missing = [str(path) for _, path in STAGING if not path.is_file()]
    if missing:
        parser.error("missing generated inputs; run tools/native/prepare-bootstrap first: "
                     + ", ".join(missing))
    dspal = ROOT / "tools/datasets/dspal"
    for member, path in STAGING:
        cmd = [str(dspal), "put", "NATIVE_SOURCE", member,
               str(path.relative_to(ROOT))]
        print("+", " ".join(cmd), flush=True)
        if not args.dry_run:
            subprocess.run(cmd, cwd=ROOT, check=True)
    print(f"{len(STAGING)} bootstrap members "
          + ("planned; no MVS writes" if args.dry_run else "staged in NATIVE_SOURCE"))
    return 0

if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as exc:
        print(f"stage-bootstrap: dspal failed with RC={exc.returncode}", file=sys.stderr)
        sys.exit(exc.returncode or 2)
