//* MRBCDEMO - 17 BCPL demos
//* STORED JCL BODY; DSPAL SUBMIT SUPPLIES AUTHENTICATED JOB CARD.
//* INSTALLED ICINT19; NO ASSEMBLY OR LINK-EDIT IN THIS JOB.
//* REVIEW JES SYSPRINT FOR PROGRAM SEMANTICS AND COMPLETION CODE.
//* STAGE PDS INTCODE MEMBERS AS SEQUENTIAL FB80 INPUT DECKS.
//* THIS AVOIDS QSAM END-OF-MEMBER ISSUES IN CONCATENATIONS.
//SSYNI    EXEC PGM=IEBGENER
//SYSPRINT DD  DUMMY
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(SYNI),
//             DISP=SHR
//SYSUT2   DD  DSN=&&SYNI,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//STRNI    EXEC PGM=IEBGENER
//SYSPRINT DD  DUMMY
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(TRNI),
//             DISP=SHR
//SYSUT2   DD  DSN=&&TRNI,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//SCGI     EXEC PGM=IEBGENER
//SYSPRINT DD  DUMMY
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(CGI),
//             DISP=SHR
//SYSUT2   DD  DSN=&&CGI,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//SBLIBI   EXEC PGM=IEBGENER
//SYSPRINT DD  DUMMY
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),
//             DISP=SHR
//SYSUT2   DD  DSN=&&BLIBI,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//SICLIB   EXEC PGM=IEBGENER
//SYSPRINT DD  DUMMY
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),
//             DISP=SHR
//SYSUT2   DD  DSN=&&ICLIB,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//* CASE 01: RFACT
//* C01A COMPILE RFACT
//C01A     EXEC PGM=ICINT19,REGION=1024K,COND=(4,LT)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&SYNI,DISP=(OLD,PASS)
//         DD  DSN=&&TRNI,DISP=(OLD,PASS)
//         DD  DSN=&&BLIBI,DISP=(OLD,PASS)
//         DD  DSN=&&ICLIB,DISP=(OLD,PASS)
//SYSIN    DD  DSN=HERC02.BCPL.MR10KIT.BCPLDEMO(RFACT),
//             DISP=SHR
//OCODE    DD  DSN=&&O01A,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  DUMMY
