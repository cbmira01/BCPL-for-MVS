//VTOC     EXEC PGM=IEHLIST
//SYSPRINT DD SYSOUT=*
//VOL      DD UNIT=SYSDA,VOL=SER=TSO003,DISP=SHR
//SYSIN    DD *
 LISTVTOC FORMAT,VOL=SYSDA=TSO003
/*
