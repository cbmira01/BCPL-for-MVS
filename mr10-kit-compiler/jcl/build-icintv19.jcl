//* ============================================================
//* BUILD-ICINTV19: MVS JOB OR STORED JOB BODY
//* ============================================================
//* ICINT19 - INSTALL MR10 ICINT V19 OBJECT AND LOAD MODULE.
//* SOURCE: HERC02.BCPL.MR10KIT.ASM(ICINT19)
//* OBJECT: HERC02.BCPL.MR10KIT.OBJ(ICINT19)
//* LOAD:   HERC02.BCPL.MR10KIT.LOAD(ICINT19)
//* JOB CARD SUPPLIED BY TOOLS/DSPAL SUBMIT MR10_JCL IC19BLD.
//* ASSEMBLE INTO TEMP OBJECT, LINK TO PERSISTENT LOAD LIBRARY,
//* THEN SAVE THE RELOCATABLE OBJECT IF LINK IS SUCCESSFUL.
//ASM      EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(SHORT)'
//SYSLIB   DD  DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD  SYSOUT=*
//SYSPUNCH DD  DUMMY
//SYSGO    DD  DSN=&&IC19OBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD  DSN=HERC02.BCPL.MR10KIT.ASM(ICINT19),DISP=SHR
//*
//LKED     EXEC PGM=IEWL,REGION=256K,
//             PARM='LET,NCAL,LIST,XREF',COND=(0,NE,ASM)
//SYSLIN   DD  DSN=&&IC19OBJ,DISP=(OLD,PASS)
//         DD  *
  ENTRY ICINT
  NAME ICINT19(R)
/*
//SYSLMOD  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1024,(50,20))
//SYSPRINT DD  SYSOUT=*
//*
//SAVEOBJ  EXEC PGM=IEBGENER,COND=((0,NE,ASM),(0,NE,LKED))
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=&&IC19OBJ,DISP=(OLD,DELETE)
//SYSUT2   DD  DSN=HERC02.BCPL.MR10KIT.OBJ(ICINT19),
//             DISP=SHR
