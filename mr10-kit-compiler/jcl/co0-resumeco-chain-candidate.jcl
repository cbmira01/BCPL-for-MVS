//* CO.0 CANDIDATE COMPATIBILITY: RESUMECO PARENT CHAIN.
//* STANDALONE TEST. NO CANONICAL ICLIB/COROUTIN CHANGES.
//* No JOB card: dspal submit supplies the authenticated JOB card.
//* Uses SOURCE(ICLIBC), LIBRARY(GETVEC), LIBRARY(COCAND).
//* Existing accepted TESTS(T10CHAIN) and golden remain unchanged.
//* Not yet MVS-run; this JCL requires separate JES authorization.
//* Preserve all JES RC, interpreted CODE, main OCODE/INTCODE, SYSOUT.
//* A zero JES RC alone does not establish BCPL behavioral success.
//*
//* Stage SYNI as sequential FB80 for ICINT concatenation.
//SSYNI    EXEC PGM=IEBGENER,COND=(4,LT)
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(SYNI),
//             DISP=SHR
//SYSUT2   DD  DSN=&&SYNI,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//* Stage TRNI as sequential FB80 for ICINT concatenation.
//STRNI    EXEC PGM=IEBGENER,COND=(4,LT)
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(TRNI),
//             DISP=SHR
//SYSUT2   DD  DSN=&&TRNI,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//* Stage CGI as sequential FB80 for ICINT concatenation.
//SCGI     EXEC PGM=IEBGENER,COND=(4,LT)
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(CGI),
//             DISP=SHR
//SYSUT2   DD  DSN=&&CGI,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//* Stage BLIBI as sequential FB80 for ICINT concatenation.
//SBLIBI   EXEC PGM=IEBGENER,COND=(4,LT)
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),
//             DISP=SHR
//SYSUT2   DD  DSN=&&BLIBI,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//* Stage ICLIB as sequential FB80 for ICINT concatenation.
//SICLIB   EXEC PGM=IEBGENER,COND=(4,LT)
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIBC),
//             DISP=SHR
//SYSUT2   DD  DSN=&&ICLIBC,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//*
//* Compile BCPL source T10CHAIN into OCODE.
//COMPMAIN EXEC PGM=ICINT19,REGION=1024K,COND=(4,LT)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&SYNI,DISP=(OLD,PASS)
//         DD  DSN=&&TRNI,DISP=(OLD,PASS)
//         DD  DSN=&&BLIBI,DISP=(OLD,PASS)
//         DD  DSN=&&ICLIBC,DISP=(OLD,PASS)
//SYSIN    DD  DSN=HERC02.BCPL.MR10KIT.TESTS(T10CHAIN),
//             DISP=SHR
//OCODE    DD  DSN=&&OMAIN,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  SYSOUT=*
//*
//* Saved main OCODE is printed in this step's SYSOUT for review.
//SVOCMAIN EXEC PGM=IEBGENER,COND=(4,LT)
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=&&OMAIN,DISP=(OLD,PASS)
//SYSUT2   DD  SYSOUT=*,
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80)
//*
//* Generate INTCODE for CGMAIN.
//CGMAIN   EXEC PGM=ICINT19,REGION=1024K,COND=(4,LT)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&CGI,DISP=(OLD,PASS)
//         DD  DSN=&&BLIBI,DISP=(OLD,PASS)
//         DD  DSN=&&ICLIBC,DISP=(OLD,PASS)
//SYSIN    DD  DSN=&&OMAIN,DISP=(OLD,DELETE)
//INTCODE  DD  DSN=&&IMAIN,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  SYSOUT=*
//*
//* Saved main INTCODE is printed in this step's SYSOUT for review.
//SVINMAIN EXEC PGM=IEBGENER,COND=(4,LT)
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=&&IMAIN,DISP=(OLD,PASS)
//SYSUT2   DD  SYSOUT=*,
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80)
//*
//* Compile BCPL source GETVEC into OCODE.
//COMPGET  EXEC PGM=ICINT19,REGION=1024K,COND=(4,LT)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&SYNI,DISP=(OLD,PASS)
//         DD  DSN=&&TRNI,DISP=(OLD,PASS)
//         DD  DSN=&&BLIBI,DISP=(OLD,PASS)
//         DD  DSN=&&ICLIBC,DISP=(OLD,PASS)
//SYSIN    DD  DSN=HERC02.BCPL.MR10KIT.LIBRARY(GETVEC),
//             DISP=SHR
//OCODE    DD  DSN=&&OGET,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  SYSOUT=*
//*
//* Generate INTCODE for CGGET.
//CGGET    EXEC PGM=ICINT19,REGION=1024K,COND=(4,LT)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&CGI,DISP=(OLD,PASS)
//         DD  DSN=&&BLIBI,DISP=(OLD,PASS)
//         DD  DSN=&&ICLIBC,DISP=(OLD,PASS)
//SYSIN    DD  DSN=&&OGET,DISP=(OLD,DELETE)
//INTCODE  DD  DSN=&&IGET,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  SYSOUT=*
//*
//* Compile BCPL source COROUTIN into OCODE.
//COMPCOR  EXEC PGM=ICINT19,REGION=1024K,COND=(4,LT)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&SYNI,DISP=(OLD,PASS)
//         DD  DSN=&&TRNI,DISP=(OLD,PASS)
//         DD  DSN=&&BLIBI,DISP=(OLD,PASS)
//         DD  DSN=&&ICLIBC,DISP=(OLD,PASS)
//SYSIN    DD  DSN=HERC02.BCPL.MR10KIT.LIBRARY(COCAND),
//             DISP=SHR
//OCODE    DD  DSN=&&OCOR,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  SYSOUT=*
//*
//* Generate INTCODE for CGCOR.
//CGCOR    EXEC PGM=ICINT19,REGION=1024K,COND=(4,LT)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&CGI,DISP=(OLD,PASS)
//         DD  DSN=&&BLIBI,DISP=(OLD,PASS)
//         DD  DSN=&&ICLIBC,DISP=(OLD,PASS)
//SYSIN    DD  DSN=&&OCOR,DISP=(OLD,DELETE)
//INTCODE  DD  DSN=&&ICOR,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  SYSOUT=*
//*
//* Run candidate RESUMECO chain as three-unit INTCODE.
//RUN      EXEC PGM=ICINT19,REGION=1024K,TIME=(,10),COND=(4,LT)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&IMAIN,DISP=(OLD,DELETE)
//         DD  DSN=&&IGET,DISP=(OLD,DELETE)
//         DD  DSN=&&ICOR,DISP=(OLD,DELETE)
//         DD  DSN=&&BLIBI,DISP=(OLD,DELETE)
//         DD  DSN=&&ICLIBC,DISP=(OLD,DELETE)
//SYSUDUMP DD  SYSOUT=*
//*
//
