//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&SYNI,DISP=(OLD,PASS)
//         DD  DSN=&&TRNI,DISP=(OLD,PASS)
//         DD  DSN=&&BLIBI,DISP=(OLD,PASS)
//         DD  DSN=&&ICLIB,DISP=(OLD,PASS)
//SYSIN    DD  DSN=HERC02.BCPL.MR10KIT.LIBRARY(COROUTIN),
//             DISP=SHR
//OCODE    DD  DSN=&&O12C,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  DUMMY
//*
//* G12C GENERATE COROUTIN
//G12C     EXEC PGM=ICINT19,REGION=1024K,COND=(4,LT)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&CGI,DISP=(OLD,PASS)
//         DD  DSN=&&BLIBI,DISP=(OLD,PASS)
//         DD  DSN=&&ICLIB,DISP=(OLD,PASS)
//INTCODE  DD  DSN=&&I12C,UNIT=SYSDA,
//             SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSIN    DD  DSN=&&O12C,DISP=(OLD,DELETE)
//SYSUDUMP DD  DUMMY
//*
//* EXECUTE CASE 12: basic-coroutine
//R12      EXEC PGM=ICINT19,REGION=1024K,COND=(4,LT)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=&&I12A,DISP=(OLD,DELETE)
//         DD  DSN=&&I12B,DISP=(OLD,DELETE)
//         DD  DSN=&&I12C,DISP=(OLD,DELETE)
//         DD  DSN=&&BLIBI,DISP=(OLD,PASS)
//         DD  DSN=&&ICLIB,DISP=(OLD,PASS)
//SYSUDUMP DD  DUMMY
//*
