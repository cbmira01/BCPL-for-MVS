// ======================================================================
// RANDOM: BCPL DEMONSTRATION
// ======================================================================
// DEMO.BCPL
// Demonstrate deterministic use of library/random.bcpl.

// --- Shared global slots ---
GLOBAL $(
START:1
WRITEF:76
SRAND:96
RAND:97
RANDRANGE:98
$)

// --- Program entry and output ---
LET START() BE
$( SRAND(1)
   WRITEF("FIRST FIVE RAND VALUES:*N")
   FOR I = 1 TO 5 DO WRITEF("%N*N", RAND())

   SRAND(12345)
   WRITEF("TEN VALUES IN 0..99:*N")
   FOR I = 1 TO 10 DO WRITEF("%N*N", RANDRANGE(100))

   FINISH
$)
