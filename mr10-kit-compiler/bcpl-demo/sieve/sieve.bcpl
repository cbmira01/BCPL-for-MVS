// ======================================================================
// SIEVE: BCPL DEMONSTRATION
// ======================================================================
// SIEVE.BCPL
// Generate primes through 100 with the Sieve of Eratosthenes.

// --- Shared global slots ---
GLOBAL $( START:1; WRITEF:76 $)

// --- Program entry and output ---
LET START() BE
$( LET COMPOSITE = VEC 100
   WRITEF("DEMO: Find primes with the Sieve of Eratosthenes*N")
   FOR I = 0 TO 100 DO COMPOSITE!I := FALSE

   FOR P = 2 TO 10 DO
      UNLESS COMPOSITE!P DO
      $( LET M = P*P
         WHILE M <= 100 DO
         $( COMPOSITE!M := TRUE
            M := M + P
         $)
      $)

   WRITEF("PRIMES THROUGH 100:*N")
   FOR N = 2 TO 100 DO
      UNLESS COMPOSITE!N DO WRITEF("%N ", N)
   WRITEF("*N")
   FINISH
$)
