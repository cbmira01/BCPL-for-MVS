// ======================================================================
// EXPRESSION PARSER: BCPL DEMONSTRATION
// ======================================================================
// EXPRESSION-PARSER.BCPL
// Recursive-descent parser for +, -, *, /, parentheses, and integers.

// --- Shared global slots ---
GLOBAL $( START:1; GETBYTE:85; WRITEF:76 $)

LET DIGIT(CH) = '0'<=CH & CH<='9'

AND FACTOR(S, P) = VALOF
$( LET CH = GETBYTE(S, P!0)
   AND N = 0
   IF CH='(' DO
   $( LET V = 0
      P!0 := P!0+1
      V := EXPR(S, P)
      IF GETBYTE(S,P!0)=')' DO P!0 := P!0+1
      RESULTIS V
   $)

   WHILE DIGIT(GETBYTE(S,P!0)) DO
   $( N := 10*N + GETBYTE(S,P!0)-'0'
      P!0 := P!0+1
   $)
   RESULTIS N
$)

AND TERM(S, P) = VALOF
$( LET V = FACTOR(S, P)
   $( LET CH = GETBYTE(S, P!0)
      AND R = 0
      UNLESS CH='**' \/ CH='/' BREAK
      P!0 := P!0+1
      R := FACTOR(S, P)
      TEST CH='**' THEN V := V*R OR V := V/R
   $) REPEAT
   RESULTIS V
$)

AND EXPR(S, P) = VALOF
$( LET V = TERM(S, P)
   $( LET CH = GETBYTE(S, P!0)
      AND R = 0
      UNLESS CH='+' \/ CH='-' BREAK
      P!0 := P!0+1
      R := TERM(S, P)
      TEST CH='+' THEN V := V+R OR V := V-R
   $) REPEAT
   RESULTIS V
$)

// --- Small arithmetic checks ---
// Each case starts at byte 1, after the BCPL string length byte.
AND CHECK(S, WANT) BE
$( LET P = VEC 0
   AND GOT = 0
   P!0 := 1
   GOT := EXPR(S, P)
   WRITEF("CHECK: %S EXPECT %N GOT %N POS %N*N",
          S, WANT, GOT, P!0)
   UNLESS GOT=WANT DO WRITEF("PARSER FAIL: %S*N", S)
$)

// --- Program entry and output ---
AND START() BE
$( WRITEF("DEMO: Recursive descent arithmetic expression parsing*N")
   CHECK("2+3", 5)
   CHECK("4+5", 9)
   CHECK("2**3", 6)
   CHECK("2+3**4", 14)
   CHECK("(2+3)", 5)
   CHECK("(2+3)**(4+5)", 45)
   CHECK("(2+3)**(4+5)-6", 39)
   FINISH
$)
