GLOBAL $(
START:1
SELECTINPUT:11
RDCH:13
WRCH:14
FINDINPUT:42
ENDREAD:46
NEWLINE:63
WRITEF:76
$)

LET START () BE $(1

LET S = VEC 11

S!0  := FINDINPUT("DD01")
S!1  := FINDINPUT("DD02")
S!2  := FINDINPUT("DD03")
S!3  := FINDINPUT("DD04")
S!4  := FINDINPUT("DD05")
S!5  := FINDINPUT("DD06")
S!6  := FINDINPUT("DD07")
S!7  := FINDINPUT("DD08")
S!8  := FINDINPUT("DD09")
S!9  := FINDINPUT("DD10")
S!10 := FINDINPUT("DD11")
S!11 := FINDINPUT("DD12")

FOR I = 0 TO 11 DO
    IF S!I=0 DO
    $( WRITEF("FAILED TO OPEN DD%N*N", I+1)
       FINISH $)

WRITEF("OPENED 12 STREAMS*N")

FOR I = 0 TO 11 DO
$( SELECTINPUT(S!I)
   WRITEF("DD%N = ", I+1)
   FOR J = 1 TO 9 DO WRCH(RDCH())
   NEWLINE()
   ENDREAD() $)

WRITEF("ALL 12 STREAMS READ AND CLOSED*N")

FINISH $)1
