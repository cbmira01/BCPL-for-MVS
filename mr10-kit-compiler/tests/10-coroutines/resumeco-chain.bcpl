// RESUMECO-CHAIN.BCPL
//
// Exercise historical RESUMECO parent-transfer semantics through the packaged
// coroutine and allocator runtime modules.

GLOBAL $(
START:1
CURRCO:7
COLIST:8
WRITEF:76
HEAPINIT:89
CREATECO:91
CALLCO:93
COWAIT:94
RESUMECO:95
$)

LET COA(BPTR) = VALOF
$( LET V = 0

   WRITEF("A START*N")
   V := RESUMECO(BPTR, 111)
   WRITEF("A RESUMED WITH %N*N", V)
   COWAIT(444)

   RESULTIS -1
$)

AND COB(ARG) = VALOF
$( LET V = 0

   WRITEF("B START WITH %N*N", ARG)
   V := COWAIT(222)
   WRITEF("B RESUMED WITH %N*N", V)
   COWAIT(666)

   RESULTIS -1
$)

AND START() BE
$( LET ROOT = VEC 2
   AND ARENA = VEC 400
   AND ACO = 0
   AND BCO = 0
   AND V = 0

   HEAPINIT(ARENA, 401)

   CURRCO := ROOT
   ROOT!0 := 0
   ROOT!1 := -1
   ROOT!2 := 0
   COLIST := ROOT

   BCO := CREATECO(COB, 100)
   ACO := CREATECO(COA, 100)

   IF ACO = 0 DO
   $( WRITEF("CREATE A FAILED*N")
      FINISH
   $)

   IF BCO = 0 DO
   $( WRITEF("CREATE B FAILED*N")
      FINISH
   $)

   V := CALLCO(ACO, BCO)
   WRITEF("ROOT GOT %N*N", V)

   V := CALLCO(ACO, 333)
   WRITEF("ROOT GOT %N*N", V)

   V := CALLCO(BCO, 555)
   WRITEF("ROOT GOT %N*N", V)

   FINISH
$)
