// CO.0 U06: exact-fit arena boundary and reuse candidate.
// Not an accepted test; no malformed size or stack overrun.
GLOBAL $(
START:1
CURRCO:7
COLIST:8
WRITEF:76
HEAPINIT:89
CREATECO:91
DELETECO:92
CALLCO:93
$)

LET WORKER(ARG) = ARG+1

AND START() BE
$( LET ROOT = VEC 2
   AND ARENA = VEC 160
   AND CO = 0
   AND R = 0

   HEAPINIT(ARENA, 161)
   CURRCO := ROOT
   ROOT!0 := 0
   ROOT!1 := -1
   ROOT!2 := 0
   COLIST := ROOT

   CO := CREATECO(WORKER, 150)
   WRITEF("ONE TOO LARGE %N*N", CO)
   IF CO \= 0 DO
   $( WRITEF("OVERSIZE UNEXPECTED*N")
      FINISH
   $)

   CO := CREATECO(WORKER, 149)
   IF CO = 0 DO
   $( WRITEF("EXACT CREATE FAILED*N")
      FINISH
   $)
   R := CALLCO(CO, 30)
   WRITEF("EXACT RESULT %N*N", R)
   R := DELETECO(CO)
   WRITEF("EXACT DELETE %N*N", R)

   CO := CREATECO(WORKER, 149)
   IF CO = 0 DO
   $( WRITEF("REUSE CREATE FAILED*N")
      FINISH
   $)
   R := CALLCO(CO, 40)
   WRITEF("REUSE RESULT %N*N", R)
   R := DELETECO(CO)
   WRITEF("REUSE DELETE %N*N", R)
   FINISH
$)
