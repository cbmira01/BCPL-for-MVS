// CO.0 EXPERIMENT: TWO DISTINCT CHANGECO CONTINUATIONS
// This is a candidate MR10 interpreted probe, NOT an accepted test.
// Source-derived values below are hypotheses, not MVS observations.
// Compile with GETVEC and COROUTIN as separate BCPL modules.

GLOBAL $(
START:1
CHANGECO:6
CURRCO:7
COLIST:8
TRVAL:9
TRCONT:10
WRITEF:76
HEAPINIT:89
CREATECO:91
CALLCO:93
COWAIT:94
$)

LET STAGEDWAIT(V) = VALOF
$( LET PARENT = CURRCO!1
   AND RECEIVED = 0
   CURRCO!1 := 0
   RECEIVED := CHANGECO(V, PARENT)
   WRITEF("STAGEDWAIT RETURNED %N*N", RECEIVED)
   RESULTIS RECEIVED
$)

AND NORMALLEAF(V) = VALOF
$( LET RECEIVED = 0
   RECEIVED := COWAIT(V+1)
   WRITEF("NORMALLEAF RESUMED %N*N", RECEIVED)
   RESULTIS RECEIVED+V+1
$)

AND STAGEDLEAF(V) = VALOF
$( LET RECEIVED = 0
   RECEIVED := STAGEDWAIT(V+1)
   WRITEF("STAGEDLEAF RESUMED %N*N", RECEIVED)
   RESULTIS RECEIVED+V+1
$)

AND NORMAL(ARG) = VALOF
$( LET R = 0
   WRITEF("NORMAL ENTER %N*N", ARG)
   R := NORMALLEAF(ARG*10)
   WRITEF("NORMAL CALC %N*N", R)
   COWAIT(103)
   RESULTIS 0
$)

AND STAGED(ARG) = VALOF
$( LET R = 0
   WRITEF("STAGED ENTER %N*N", ARG)
   R := STAGEDLEAF(ARG*10)
   WRITEF("STAGED CALC %N*N", R)
   COWAIT(203)
   RESULTIS 0
$)

AND START() BE
$( LET ROOT = VEC 2
   AND ARENA = VEC 400
   AND A = 0
   AND B = 0
   AND R = 0

   HEAPINIT(ARENA, 401)

   CURRCO := ROOT
   ROOT!0 := 0
   ROOT!1 := -1
   ROOT!2 := 0
   COLIST := ROOT

   A := CREATECO(NORMAL, 100)
   B := CREATECO(STAGED, 100)

   IF A = 0 DO
   $( WRITEF("CREATE A FAILED*N")
      FINISH
   $)

   IF B = 0 DO
   $( WRITEF("CREATE B FAILED*N")
      FINISH
   $)

   R := CALLCO(A, 10)
   WRITEF("ROOT A1 %N*N", R)
   WRITEF("TRACE A1 G9=%N G10=%N*N", TRVAL, TRCONT)

   R := CALLCO(A, 17)
   WRITEF("ROOT A2 %N*N", R)

   R := CALLCO(B, 20)
   WRITEF("ROOT B1 %N*N", R)
   WRITEF("TRACE B1 G9=%N G10=%N*N", TRVAL, TRCONT)

   R := CALLCO(B, 27)
   WRITEF("ROOT B2 %N*N", R)

   FINISH
$)
