// CREATE-DELETE-STATIC-POOL.BCPL
//
// Regression for the packaged coroutine runtime.  Coroutine operations come
// from library/coroutines.bcpl; allocation comes from
// library/getvec-freevec.bcpl.  This source contains only test setup and
// observations.

GLOBAL $(
START:1
CURRCO:7
COLIST:8
WRITEF:76
HEAPINIT:89
CREATECO:91
DELETECO:92
CALLCO:93
$)

LET COUNTCO() = VALOF
$( LET N = 0
   AND C = COLIST

   UNTIL C = 0 DO
   $( N := N+1
      C := C!2
   $)

   RESULTIS N
$)

AND WORKER(A) = A+1

AND START() BE
$( LET ROOT = VEC 2
   AND ARENA = VEC 400
   AND ACO = 0
   AND BCO = 0
   AND CCO = 0
   AND V = 0

   HEAPINIT(ARENA, 401)

   CURRCO := ROOT
   ROOT!0 := 0
   ROOT!1 := -1
   ROOT!2 := 0
   COLIST := ROOT

   ACO := CREATECO(WORKER, 100)
   BCO := CREATECO(WORKER, 100)

   IF ACO = 0 DO
   $( WRITEF("CREATE A FAILED*N")
      FINISH
   $)

   IF BCO = 0 DO
   $( WRITEF("CREATE B FAILED*N")
      FINISH
   $)

   WRITEF("CREATED 2*N")
   WRITEF("LIST COUNT %N*N", COUNTCO())

   V := CALLCO(ACO, 10)
   WRITEF("A RETURNED %N*N", V)

   V := CALLCO(BCO, 20)
   WRITEF("B RETURNED %N*N", V)

   IF DELETECO(ACO) DO WRITEF("DELETED A*N")
   WRITEF("LIST COUNT %N*N", COUNTCO())

   IF DELETECO(BCO) DO WRITEF("DELETED B*N")
   WRITEF("LIST COUNT %N*N", COUNTCO())

   CCO := CREATECO(WORKER, 100)
   IF CCO = 0 DO
   $( WRITEF("RECREATE FAILED*N")
      FINISH
   $)

   V := CALLCO(CCO, 30)
   WRITEF("C RETURNED %N*N", V)
   WRITEF("LIST COUNT %N*N", COUNTCO())

   IF DELETECO(CCO) DO WRITEF("DELETED C*N")
   WRITEF("FINAL LIST COUNT %N*N", COUNTCO())

   FINISH
$)
