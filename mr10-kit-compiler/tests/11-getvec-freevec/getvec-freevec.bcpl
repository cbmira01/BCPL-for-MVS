// GETVEC-FREEVEC.BCPL
//
// Regression for the reusable fixed-arena allocator in
// library/getvec-freevec.bcpl.  START owns the arena for the duration of
// the run and supplies it to the runtime with HEAPINIT.

GLOBAL $(
START:1
WRITEF:76
GETVEC:87
FREEVEC:88
HEAPINIT:89
$)

LET START() BE
$( LET ARENA = VEC 400
   AND A = 0
   AND B = 0
   AND C = 0
   AND D = 0
   AND OLDB = 0

   HEAPINIT(ARENA, 401)

   A := GETVEC(9)
   B := GETVEC(19)
   C := GETVEC(29)

   IF A = 0 DO
   $( WRITEF("ALLOC A FAILED*N")
      FINISH
   $)
   IF B = 0 DO
   $( WRITEF("ALLOC B FAILED*N")
      FINISH
   $)
   IF C = 0 DO
   $( WRITEF("ALLOC C FAILED*N")
      FINISH
   $)

   A!0 := 101
   A!9 := 109
   B!0 := 201
   B!19 := 219
   C!0 := 301
   C!29 := 329

   WRITEF("ALLOCATED A B C*N")
   WRITEF("A DATA %N %N*N", A!0, A!9)
   WRITEF("B DATA %N %N*N", B!0, B!19)
   WRITEF("C DATA %N %N*N", C!0, C!29)

   OLDB := B
   FREEVEC(B)
   D := GETVEC(19)

   IF D = OLDB DO WRITEF("REUSED B BLOCK*N")
   IF D \= OLDB DO WRITEF("B BLOCK NOT REUSED*N")

   FREEVEC(A)
   FREEVEC(D)
   FREEVEC(C)

   D := GETVEC(99)
   IF D = 0 DO
   $( WRITEF("COALESCE ALLOC FAILED*N")
      FINISH
   $)

   D!0 := 777
   D!99 := 888
   WRITEF("COALESCED ALLOC %N %N*N", D!0, D!99)

   FREEVEC(D)
   WRITEF("GETVEC FREEVEC OK*N")

   FINISH
$)
