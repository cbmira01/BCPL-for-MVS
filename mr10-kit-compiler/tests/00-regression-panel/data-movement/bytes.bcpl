// ======================================================================
// BYTES: BCPL REGRESSION TEST
// ======================================================================
// Regression: GETBYTE and PUTBYTE preserve byte values.
// --- Global slots ---
GLOBAL $( START:1; WRITEF:76; GETBYTE:85; PUTBYTE:86 $)

// --- Test entry and result ---
LET START() BE
$(
 LET V = VEC 1
   WRITEF("TEST: GETBYTE and PUTBYTE preserve byte values*N")
   V!0 := 0
   V!1 := 0
   PUTBYTE(V, 0, 65)
   PUTBYTE(V, 1, 66)
   PUTBYTE(V, 2, 67)
   PUTBYTE(V, 3, 68)
   WRITEF("RP: BYTES %N %N %N %N*N",
          GETBYTE(V,0), GETBYTE(V,1), GETBYTE(V,2), GETBYTE(V,3))
   FINISH
$)
