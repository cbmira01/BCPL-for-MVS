// Regression: GETVEC/FREEVEC basic allocation and exact reuse.
GLOBAL $( START:1; WRITEF:76; GETVEC:87; FREEVEC:88; HEAPINIT:89 $)

LET START() BE
$( LET ARENA = VEC 100
   AND A = 0
   AND B = 0

   HEAPINIT(ARENA, 101)

   A := GETVEC(5)
   A!0 := 7
   A!5 := 9
   FREEVEC(A)

   B := GETVEC(5)
   B!0 := 11
   B!5 := 13

   WRITEF("RP: GETVEC %N %N %N*N", B-A, B!0, B!5)
   FREEVEC(B)
   FINISH
$)
