// ======================================================================
// INTEGER-ARITHMETIC: BCPL TEST
// ======================================================================
// Regression: integer arithmetic and remainder.
// --- Global slots ---
GLOBAL $( START:1; WRITEF:76 $)

// --- Test entry ---
LET START() BE
$(
 LET A = 17
   AND B = 5
   WRITEF("TEST: Integer arithmetic and remainder*N")
   WRITEF("RP: ARITH %N %N %N %N %N*N",
          A+B, A-B, A*B, A/B, A REM B)
   FINISH
$)
