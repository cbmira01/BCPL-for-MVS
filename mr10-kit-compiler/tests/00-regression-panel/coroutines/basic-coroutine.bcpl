// Regression: CREATECO/CALLCO/COWAIT/DELETECO basic contract.
GLOBAL $(
START:1
CURRCO:7
COLIST:8
WRITEF:76
HEAPINIT:89
CREATECO:91
DELETECO:92
CALLCO:93
COWAIT:94
$)

LET WORKER(ARG) = VALOF
$( COWAIT(ARG+7)
   RESULTIS 0
$)

AND START() BE
$( LET ROOT = VEC 2
   AND ARENA = VEC 200
   AND C = 0
   AND V = 0
   AND D = 0

   HEAPINIT(ARENA, 201)
   CURRCO := ROOT
   ROOT!0 := 0
   ROOT!1 := -1
   ROOT!2 := 0
   COLIST := ROOT

   C := CREATECO(WORKER, 80)
   V := CALLCO(C, 70)

   IF DELETECO(C) DO D := 1

   WRITEF("RP: COROUTINE %N %N*N", V, D)
   FINISH
$)
