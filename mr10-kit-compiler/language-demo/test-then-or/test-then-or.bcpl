// ======================================================================
// TEST THEN OR: LANGUAGE EXAMPLE
// ======================================================================
// TEST-THEN-OR.BCPL
// Demonstrate BCPL's TEST ... THEN ... OR conditional command.

// --- Shared global slots ---
GLOBAL $( START:1; WRITEF:76 $)

LET SIGN(N) BE
$( TEST N<0
   THEN WRITEF("%N IS NEGATIVE*N", N)
   OR TEST N=0
      THEN WRITEF("%N IS ZERO*N", N)
      OR WRITEF("%N IS POSITIVE*N", N)
$)

// --- Program entry and output ---
AND START() BE
$( WRITEF("DEMO: TEST THEN OR conditional selection*N")
   SIGN(-7)
   SIGN(0)
   SIGN(12)
   FINISH
$)
