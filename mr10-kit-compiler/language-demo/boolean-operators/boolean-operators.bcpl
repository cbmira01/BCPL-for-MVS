// ======================================================================
// BOOLEAN OPERATORS: LANGUAGE EXAMPLE
// ======================================================================
// BOOLEAN-OPERATORS.BCPL
// Demonstrate BCPL truth values and logical/relational operators.

// --- Shared global slots ---
GLOBAL $( START:1; WRITEF:76 $)

// --- Program entry and output ---
LET START() BE
$( LET A = 7
   AND B = 12

   WRITEF("DEMO: Boolean and relational operators*N")
   WRITEF("A<B       = %N*N", A<B)
   WRITEF("A=B       = %N*N", A=B)
   WRITEF("A\=B      = %N*N", A\=B)
   WRITEF("A<B /\ B>0 = %N*N", A<B /\ B>0)
   WRITEF("A>B \/ B=12 = %N*N", A>B \/ B=12)
   WRITEF("\(A=B)    = %N*N", \(A=B))

   FINISH
$)
