// ======================================================================
// FUNCTION VALUES: LANGUAGE EXAMPLE
// ======================================================================
// FUNCTION-VALUES.BCPL
// Demonstrate selecting a routine as a value and calling it indirectly.

// --- Shared global slots ---
GLOBAL $( START:1; WRITEF:76 $)

LET SQUARE(N) = N*N
AND DOUBLE(N) = N+N

AND APPLY(F, N) = F(N)

// --- Program entry and output ---
AND START() BE
$( LET F = SQUARE
   AND X = 7

   WRITEF("DEMO: Functions as values and indirect calls*N")
   WRITEF("SQUARE(%N) THROUGH F = %N*N", X, APPLY(F, X))

   F := DOUBLE
   WRITEF("DOUBLE(%N) THROUGH F = %N*N", X, APPLY(F, X))

   FINISH
$)
