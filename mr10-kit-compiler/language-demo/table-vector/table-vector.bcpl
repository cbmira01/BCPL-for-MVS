// ======================================================================
// TABLE VECTOR: LANGUAGE EXAMPLE
// ======================================================================
// TABLE-VECTOR.BCPL
// Demonstrate TABLE expressions, vectors, ! indexing, and copying values.

// --- Shared global slots ---
GLOBAL $( START:1; WRITEF:76 $)

// --- Program entry and output ---
LET START() BE
$( LET V = VEC 4

   WRITEF("DEMO: Copy TABLE values into a vector*N")
   FOR I = 0 TO 4 DO
      V!I := I!TABLE 11, 22, 33, 44, 55

   WRITEF("TABLE TO VECTOR:")
   FOR I = 0 TO 4 DO WRITEF(" %N", V!I)
   WRITEF("*N")

   WRITEF("INDEX 2 = %N*N", V!2)
   FINISH
$)
