// MANIFEST-GLOBAL.BCPL
// Demonstrate compile-time MANIFEST constants and GLOBAL-vector linkage.

MANIFEST $( ANSWER = 42; SCALE = 3 $)

GLOBAL $( START:1; WRITEF:76; TIMESCALE:180 $)

LET TIMESCALE(N) = N*SCALE

AND START() BE
$( LET X = ANSWER
   WRITEF("MANIFEST ANSWER = %N*N", ANSWER)
   WRITEF("LOCAL X = %N*N", X)
   WRITEF("GLOBAL TIMESCALE(7) = %N*N", TIMESCALE(7))
   FINISH
$)
