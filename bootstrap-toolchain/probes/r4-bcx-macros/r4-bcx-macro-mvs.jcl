//R4BCXMAC JOB (BCPL),'R4 MVS BCX',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1)
//* R.4 MVS-ONLY MACRO/PUNCH/IEWL PROBE. NO HOST BUILD TOOL.
//* NO BOOT_OBJ, BOOT_DEVOBJ, BCPLMAIN OR BCPLRGS WRITES.
//* PUNCH DECKS, OBJECTS AND LOAD MODULES ARE TEMPORARY.
//* R2TESTB AND G299 ARE TEST-ONLY; NOT DISTRIBUTABLE EXTENSIONS.
//PREP     EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  *
* R.4 IFOX MACRO PROBE. TWO KNOWN TEST CATALOG ENTRIES ONLY.
* NO CSECT IS EMITTED UNTIL BCXEND IN BCXPOST.
* BCXSEL SELECTS AN OPTIONAL PACKAGE; BCXREQ ALSO REQUIRES IT.
* ALL IEWL PUNCH CARDS PRECEDE THE FIRST OBJECT CSECT.
         MACRO
         BCXSEL &PKG
         BCXADD &PKG,0
         MEND
         MACRO
         BCXREQ &PKG
         BCXADD &PKG,1
         MEND
         MACRO
         BCXADD &PKG,&REQ
         GBLA  &BXN,&BXM,&BXR(32),&BXGOOD
         GBLC  &BXID(32),&BXBEG(32),&BXFIN(32)
         GBLC  &BXCLIB,&BXCBEG,&BXCFIN
         LCLA  &I
&BXGOOD SETA  0
         BCXCAT &PKG
         AIF   (&BXGOOD EQ 0).EXIT
&I       SETA  1
.FIND    AIF   (&I GT &BXN).NEW
         AIF   ('&BXID(&I)' EQ '&PKG').FOUND
&I       SETA  &I+1
         AGO   .FIND
.FOUND   AIF   (&REQ EQ 0).EXIT
         AIF   (&BXR(&I) EQ 1).EXIT
&BXR(&I) SETA  1
&BXM     SETA  &BXM+1
         AGO   .EXIT
.NEW     AIF   (&BXN GE 32).FULL
&BXN     SETA  &BXN+1
&BXID(&BXN)  SETC '&PKG'
&BXBEG(&BXN) SETC '&BXCBEG'
&BXFIN(&BXN) SETC '&BXCFIN'
         AIF   (&REQ EQ 0).SEL
&BXR(&BXN) SETA  1
&BXM     SETA  &BXM+1
.SEL     ANOP
         PUNCH ' INCLUDE &BXCLIB'
         AGO   .EXIT
.FULL    MNOTE 8,'BCX SELECTED PACKAGE LIMIT 32'
.EXIT    ANOP
         MEND
         MACRO
         BCXEND
         GBLA  &BXN,&BXM,&BXR(32)
         GBLC  &BXID(32),&BXBEG(32),&BXFIN(32)
         LCLA  &I,&BYTES
&BYTES   SETA  28+8*(&BXN+&BXM)
BCPLREG  CSECT
         ENTRY BCRGBEG,BCRGEND
BCRGBEG  DS    0F
         DC    CL4'BCRG'
         DC    F'1',F'28',F'&BYTES',F'&BXN',F'&BXM',F'0'
&I       SETA  1
.DESC    AIF   (&I GT &BXN).REQS
         EXTRN &BXBEG(&I),&BXFIN(&I)
         DC    A(&BXBEG(&I)),A(&BXFIN(&I))
&I       SETA  &I+1
         AGO   .DESC
.REQS    ANOP
&I       SETA  1
.REQLOOP AIF   (&I GT &BXN).DONE
         AIF   (&BXR(&I) EQ 0).NEXT
         DC    CL8'&BXID(&I)'
.NEXT    ANOP
&I       SETA  &I+1
         AGO   .REQLOOP
.DONE    ANOP
BCRGEND  EQU   *
         MEND
/*
//SYSUT2   DD  DSN=&&BCXPRE,UNIT=SYSDA,
//             SPACE=(80,(30,10)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD  DUMMY
//CATP     EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  *
* R.4 MVS RESIDENT PACKAGE CATALOG. TWO TEST ENTRIES ONLY.
* PKGA/PKGB ARE IEWL DD NAMES FOR TEMPORARY OBJECT DATASETS.
         MACRO
         BCXCAT &PKG
         GBLA  &BXGOOD
         GBLC  &BXCLIB,&BXCBEG,&BXCFIN
         AIF   ('&PKG' EQ 'BCPLDEMO').PA
         AIF   ('&PKG' EQ 'R2TESTB').PB
         MNOTE 8,'UNKNOWN BCX PACKAGE: &PKG'
         AGO   .EXIT
.PA      ANOP
&BXCLIB  SETC  'PKGA'
&BXCBEG  SETC  'DMOBEG'
&BXCFIN  SETC  'DMOEND'
         AGO   .GOOD
.PB      ANOP
&BXCLIB  SETC  'PKGB'
&BXCBEG  SETC  'R2BBEG'
&BXCFIN  SETC  'R2BEND'
.GOOD    ANOP
&BXGOOD  SETA  1
.EXIT    ANOP
         MEND
/*
//SYSUT2   DD  DSN=&&BCXCAT,UNIT=SYSDA,
//             SPACE=(80,(30,10)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD  DUMMY
//POSTP    EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  *
* BCPLREG CSECT AND ASSEMBLER END STAY OUT OF APPLICATION SELECTION.
         BCXEND
         END   BCPLREG
/*
//SYSUT2   DD  DSN=&&BCXPOST,UNIT=SYSDA,
//             SPACE=(80,(30,10)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD  DUMMY
//ASMPA    EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD  DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD  SYSOUT=*
//SYSPUNCH DD  DUMMY
//SYSGO    DD  DSN=&&PKGA,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD  *
* TEST-ONLY BCPLDEMO BCEX VERSION 1 STUB.
DMODESC  CSECT
         ENTRY DMOBEG,DMOEND
DMOBEG   DS    0F
         DC    CL4'BCEX'
         DC    F'1',F'48',F'56'
         DC    CL8'BCPLDEMO'
         DC    F'1',F'0',F'1',F'0',F'0',F'0'
         DC    F'203',A(DMODISP)
DMOEND   EQU   *
DMODISP  CSECT
         ENTRY DMODISP
         BCR   15,14
         END   DMODISP
/*
//ASMPB    EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD  DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD  SYSOUT=*
//SYSPUNCH DD  DUMMY
//SYSGO    DD  DSN=&&PKGB,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD  *
* TEST-ONLY R2TESTB BCEX VERSION 1 STUB.
R2BDSC   CSECT
         ENTRY R2BBEG,R2BEND
R2BBEG   DS    0F
         DC    CL4'BCEX'
         DC    F'1',F'48',F'56'
         DC    CL8'R2TESTB'
         DC    F'3',F'2',F'1',F'0',F'0',F'0'
         DC    F'299',A(R2BDISP)
R2BEND   EQU   *
R2BDISP  CSECT
         ENTRY R2BDISP
         BCR   15,14
         END   R2BDISP
/*
//ASMOBS   EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD  DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD  SYSOUT=*
//SYSPUNCH DD  DUMMY
//SYSGO    DD  DSN=&&OBJC,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD  *
* RETURN REGISTRY EXTENT IN R15 AS GO RETURN CODE.
* GENERIC: DOES NOT KNOW EXTENSION SYMBOL NAMES.
R4BCXOBS CSECT
         EXTRN BCRGBEG,BCRGEND
         LR    1,15
         USING R4BCXOBS,1
         L     15,REGEND
         S     15,REGBEG
         BCR   15,14
REGBEG   DC    A(BCRGBEG)
REGEND   DC    A(BCRGEND)
         END   R4BCXOBS
/*
//ASMR0    EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,DECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD  DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD  SYSOUT=*
//SYSPUNCH DD  DSN=&&REG0,UNIT=SYSDA,
//             SPACE=(80,(100,20)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSGO    DD  DUMMY
//SYSIN    DD  DSN=&&BCXPRE,DISP=(OLD,PASS)
//         DD  DSN=&&BCXCAT,DISP=(OLD,PASS)
//         DD  *
*        NO EXTENSIONS
/*
//         DD  DSN=&&BCXPOST,DISP=(OLD,PASS)
//ASMRA    EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,DECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD  DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD  SYSOUT=*
//SYSPUNCH DD  DSN=&&REGA,UNIT=SYSDA,
//             SPACE=(80,(100,20)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSGO    DD  DUMMY
//SYSIN    DD  DSN=&&BCXPRE,DISP=(OLD,PASS)
//         DD  DSN=&&BCXCAT,DISP=(OLD,PASS)
//         DD  *
         BCXREQ BCPLDEMO
/*
//         DD  DSN=&&BCXPOST,DISP=(OLD,PASS)
//ASMRB    EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,DECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD  DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD  SYSOUT=*
//SYSPUNCH DD  DSN=&&REGB,UNIT=SYSDA,
//             SPACE=(80,(100,20)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSGO    DD  DUMMY
//SYSIN    DD  DSN=&&BCXPRE,DISP=(OLD,PASS)
//         DD  DSN=&&BCXCAT,DISP=(OLD,PASS)
//         DD  *
         BCXREQ R2TESTB
/*
//         DD  DSN=&&BCXPOST,DISP=(OLD,PASS)
//ASMRS    EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,DECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD  DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD  SYSOUT=*
//SYSPUNCH DD  DSN=&&REGS,UNIT=SYSDA,
//             SPACE=(80,(100,20)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSGO    DD  DUMMY
//SYSIN    DD  DSN=&&BCXPRE,DISP=(OLD,PASS)
//         DD  DSN=&&BCXCAT,DISP=(OLD,PASS)
//         DD  *
         BCXSEL BCPLDEMO
         BCXREQ R2TESTB
/*
//         DD  DSN=&&BCXPOST,DISP=(OLD,PASS)
//ASMRX    EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,DECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD  DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD  SYSOUT=*
//SYSPUNCH DD  DSN=&&REGX,UNIT=SYSDA,
//             SPACE=(80,(100,20)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSGO    DD  DUMMY
//SYSIN    DD  DSN=&&BCXPRE,DISP=(OLD,PASS)
//         DD  DSN=&&BCXCAT,DISP=(OLD,PASS)
//         DD  *
         BCXSEL BCPLDEMO
         BCXREQ R2TESTB
         BCXREQ BCPLDEMO
/*
//         DD  DSN=&&BCXPOST,DISP=(OLD,PASS)
//L0       EXEC PGM=IEWL,REGION=256K,
//             PARM='NCAL,LIST,XREF,MAP',
//             COND=((0,NE,ASMPA),(0,NE,ASMPB),
//             (0,NE,ASMOBS),(0,NE,ASMR0))
//PKGA     DD  DSN=&&PKGA,DISP=(OLD,PASS)
//PKGB     DD  DSN=&&PKGB,DISP=(OLD,PASS)
//SYSLIN   DD  DSN=&&OBJC,DISP=(OLD,PASS)
//         DD  DSN=&&REG0,DISP=(OLD,PASS)
//         DD  *
 ENTRY R4BCXOBS
 NAME R4BCX0(R)
/*
//SYSLMOD  DD  DSN=&&LOAD0(R4BCX0),
//             UNIT=SYSDA,SPACE=(1024,(30,10,1)),
//             DISP=(NEW,PASS)
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1024,(30,10))
//SYSPRINT DD  SYSOUT=*
//G0       EXEC PGM=*.L0.SYSLMOD,REGION=256K,
//             TIME=(,2),COND=(0,NE,L0)
//SYSUDUMP DD  SYSOUT=*
//LA       EXEC PGM=IEWL,REGION=256K,
//             PARM='NCAL,LIST,XREF,MAP',
//             COND=((0,NE,ASMPA),(0,NE,ASMPB),
//             (0,NE,ASMOBS),(0,NE,ASMRA))
//PKGA     DD  DSN=&&PKGA,DISP=(OLD,PASS)
//PKGB     DD  DSN=&&PKGB,DISP=(OLD,PASS)
//SYSLIN   DD  DSN=&&OBJC,DISP=(OLD,PASS)
//         DD  DSN=&&REGA,DISP=(OLD,PASS)
//         DD  *
 ENTRY R4BCXOBS
 NAME R4BCXA(R)
/*
//SYSLMOD  DD  DSN=&&LOADA(R4BCXA),
//             UNIT=SYSDA,SPACE=(1024,(30,10,1)),
//             DISP=(NEW,PASS)
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1024,(30,10))
//SYSPRINT DD  SYSOUT=*
//GA       EXEC PGM=*.LA.SYSLMOD,REGION=256K,
//             TIME=(,2),COND=(0,NE,LA)
//SYSUDUMP DD  SYSOUT=*
//LB       EXEC PGM=IEWL,REGION=256K,
//             PARM='NCAL,LIST,XREF,MAP',
//             COND=((0,NE,ASMPA),(0,NE,ASMPB),
//             (0,NE,ASMOBS),(0,NE,ASMRB))
//PKGA     DD  DSN=&&PKGA,DISP=(OLD,PASS)
//PKGB     DD  DSN=&&PKGB,DISP=(OLD,PASS)
//SYSLIN   DD  DSN=&&OBJC,DISP=(OLD,PASS)
//         DD  DSN=&&REGB,DISP=(OLD,PASS)
//         DD  *
 ENTRY R4BCXOBS
 NAME R4BCXB(R)
/*
//SYSLMOD  DD  DSN=&&LOADB(R4BCXB),
//             UNIT=SYSDA,SPACE=(1024,(30,10,1)),
//             DISP=(NEW,PASS)
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1024,(30,10))
//SYSPRINT DD  SYSOUT=*
//GB       EXEC PGM=*.LB.SYSLMOD,REGION=256K,
//             TIME=(,2),COND=(0,NE,LB)
//SYSUDUMP DD  SYSOUT=*
//LS       EXEC PGM=IEWL,REGION=256K,
//             PARM='NCAL,LIST,XREF,MAP',
//             COND=((0,NE,ASMPA),(0,NE,ASMPB),
//             (0,NE,ASMOBS),(0,NE,ASMRS))
//PKGA     DD  DSN=&&PKGA,DISP=(OLD,PASS)
//PKGB     DD  DSN=&&PKGB,DISP=(OLD,PASS)
//SYSLIN   DD  DSN=&&OBJC,DISP=(OLD,PASS)
//         DD  DSN=&&REGS,DISP=(OLD,PASS)
//         DD  *
 ENTRY R4BCXOBS
 NAME R4BCXS(R)
/*
//SYSLMOD  DD  DSN=&&LOADS(R4BCXS),
//             UNIT=SYSDA,SPACE=(1024,(30,10,1)),
//             DISP=(NEW,PASS)
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1024,(30,10))
//SYSPRINT DD  SYSOUT=*
//GS       EXEC PGM=*.LS.SYSLMOD,REGION=256K,
//             TIME=(,2),COND=(0,NE,LS)
//SYSUDUMP DD  SYSOUT=*
//LX       EXEC PGM=IEWL,REGION=256K,
//             PARM='NCAL,LIST,XREF,MAP',
//             COND=((0,NE,ASMPA),(0,NE,ASMPB),
//             (0,NE,ASMOBS),(0,NE,ASMRX))
//PKGA     DD  DSN=&&PKGA,DISP=(OLD,PASS)
//PKGB     DD  DSN=&&PKGB,DISP=(OLD,PASS)
//SYSLIN   DD  DSN=&&OBJC,DISP=(OLD,PASS)
//         DD  DSN=&&REGX,DISP=(OLD,PASS)
//         DD  *
 ENTRY R4BCXOBS
 NAME R4BCXX(R)
/*
//SYSLMOD  DD  DSN=&&LOADX(R4BCXX),
//             UNIT=SYSDA,SPACE=(1024,(30,10,1)),
//             DISP=(NEW,PASS)
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1024,(30,10))
//SYSPRINT DD  SYSOUT=*
//GX       EXEC PGM=*.LX.SYSLMOD,REGION=256K,
//             TIME=(,2),COND=(0,NE,LX)
//SYSUDUMP DD  SYSOUT=*
//
