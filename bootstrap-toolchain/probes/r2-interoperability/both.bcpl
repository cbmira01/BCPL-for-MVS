// R.2 two-package selection: each independent BCEX registers once.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          DEMOSVC:203; R2BSVC:299 $)

LET START() BE
$(1
    LET A = VEC 6
    LET B = VEC 8
    LET VALUES = VEC 3

    A!0 := 777
    A!6 := 777
    B!0 := 888
    B!8 := 888
    IF DEMOSVC(0,0,0) NE 6 DO STOP(8)
    IF R2BSVC(0,0,0) NE 8 DO STOP(8)
    IF DEMOSVC(0,A,5) NE -1 DO STOP(8)
    IF R2BSVC(0,B,7) NE -1 DO STOP(8)
    IF A!0 NE 777 | A!6 NE 777 DO STOP(8)
    IF B!0 NE 888 | B!8 NE 888 DO STOP(8)
    IF DEMOSVC(0,A,6) NE 6 DO STOP(8)
    IF R2BSVC(0,B,8) NE 8 DO STOP(8)
    IF A!0 NE 1 | A!1 NE 1 DO STOP(8)
    IF A!2 NE 0 | A!3 NE 6 DO STOP(8)
    IF A!4 NE 1 | A!5 NE 0 DO STOP(8)
    IF B!0 NE 1 | B!1 NE 3 DO STOP(8)
    IF B!2 NE 2 | B!3 NE 8 DO STOP(8)
    IF B!4 NE 5 | B!5 NE 0 DO STOP(8)
    IF B!6 NE 77 | B!7 NE 99 DO STOP(8)
    IF A!6 NE 777 | B!8 NE 888 DO STOP(8)
    IF DEMOSVC(0,0,6) NE -3 DO STOP(8)
    IF R2BSVC(0,0,8) NE -3 DO STOP(8)
    IF DEMOSVC(2,0,0) NE -2 DO STOP(8)
    IF R2BSVC(2,0,0) NE -2 DO STOP(8)
    VALUES!3 := 777
    IF DEMOSVC(1,VALUES,3) NE 3 DO STOP(8)
    IF VALUES!0 NE 10 | VALUES!1 NE 20 DO STOP(8)
    IF VALUES!2 NE 30 | VALUES!3 NE 777 DO STOP(8)
    IF R2BSVC(1,0,0) NE 201 DO STOP(8)
    IF R2BSVC(3,0,0) NE 203 DO STOP(8)
    WRITES("R2 MATRIX AB PASS")
    NEWLINE()
    FINISH
$)1
