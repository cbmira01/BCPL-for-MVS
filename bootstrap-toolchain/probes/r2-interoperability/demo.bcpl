// R.2 BCPLDEMO client: only the dispatcher global is public.
// This declaration mirrors extensions/bcpldemo/bcpldemo.h.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          DEMOSVC:203 $)

LET START() BE
$(1
    LET INFO = VEC 6
    LET VALUES = VEC 3

    IF DEMOSVC(0,0,0) NE 6 DO STOP(8)
    INFO!0 := 777
    INFO!6 := 777
    IF DEMOSVC(0,INFO,5) NE -1 DO STOP(8)
    IF INFO!0 NE 777 | INFO!6 NE 777 DO STOP(8)
    IF DEMOSVC(0,0,6) NE -3 DO STOP(8)
    IF DEMOSVC(0,INFO,-1) NE -3 DO STOP(8)
    IF DEMOSVC(0,INFO,6) NE 6 DO STOP(8)
    IF INFO!0 NE 1 | INFO!1 NE 1 DO STOP(8)
    IF INFO!2 NE 0 | INFO!3 NE 6 DO STOP(8)
    IF INFO!4 NE 1 | INFO!5 NE 0 DO STOP(8)
    IF INFO!6 NE 777 DO STOP(8)

    VALUES!0 := 777
    VALUES!1 := 777
    VALUES!2 := 777
    VALUES!3 := 777
    IF DEMOSVC(1,VALUES,2) NE -1 DO STOP(8)
    IF VALUES!0 NE 777 | VALUES!3 NE 777 DO STOP(8)
    IF DEMOSVC(1,0,3) NE -3 DO STOP(8)
    IF DEMOSVC(1,VALUES,3) NE 3 DO STOP(8)
    IF VALUES!0 NE 10 | VALUES!1 NE 20 DO STOP(8)
    IF VALUES!2 NE 30 | VALUES!3 NE 777 DO STOP(8)
    IF DEMOSVC(2,0,0) NE -2 DO STOP(8)

    WRITES("R2 BCPLDEMO G203 PASS")
    NEWLINE()
    FINISH
$)1
