// Test-only R.2 extension B, never a permanent global allocation.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          R2BSVC:299 $)

LET START() BE
$(1
    LET INFO = VEC 8
    INFO!0 := 777
    INFO!8 := 777
    IF R2BSVC(0,0,0) NE 8 DO STOP(8)
    IF R2BSVC(0,INFO,7) NE -1 DO STOP(8)
    IF INFO!0 NE 777 | INFO!8 NE 777 DO STOP(8)
    IF R2BSVC(0,0,8) NE -3 DO STOP(8)
    IF R2BSVC(0,INFO,-1) NE -3 DO STOP(8)
    IF R2BSVC(0,INFO,8) NE 8 DO STOP(8)
    IF INFO!0 NE 1 | INFO!1 NE 3 DO STOP(8)
    IF INFO!2 NE 2 | INFO!3 NE 8 DO STOP(8)
    IF INFO!4 NE 5 | INFO!5 NE 0 DO STOP(8)
    IF INFO!6 NE 77 | INFO!7 NE 99 DO STOP(8)
    IF INFO!8 NE 777 DO STOP(8)
    IF R2BSVC(1,0,0) NE 201 DO STOP(8)
    IF R2BSVC(3,0,0) NE 203 DO STOP(8)
    IF R2BSVC(2,0,0) NE -2 DO STOP(8)
    WRITES("R2 MATRIX B PASS")
    NEWLINE()
    FINISH
$)1
