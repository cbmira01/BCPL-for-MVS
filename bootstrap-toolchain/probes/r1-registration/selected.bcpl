GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          R1SVC:298 $)
LET START() BE
$(1
    LET INFO = VEC 6
    IF R1SVC(0,0,0) NE 6 DO STOP(8)
    INFO!0 := 777
    INFO!6 := 777
    IF R1SVC(0,INFO,5) NE -1 DO STOP(8)
    IF INFO!0 NE 777 | INFO!6 NE 777 DO STOP(8)
    IF R1SVC(0,INFO,6) NE 6 DO STOP(8)
    IF INFO!0 NE 1 | INFO!1 NE 1 DO STOP(8)
    IF INFO!2 NE 0 | INFO!3 NE 6 DO STOP(8)
    IF INFO!4 NE 1 | INFO!5 NE 0 DO STOP(8)
    IF INFO!6 NE 777 DO STOP(8)
    IF R1SVC(1,0,0) NE 101 DO STOP(8)
    IF R1SVC(2,0,0) NE -2 DO STOP(8)
    WRITES("R1 SELECTED BCPLREG PASS")
    NEWLINE()
    FINISH
$)1
