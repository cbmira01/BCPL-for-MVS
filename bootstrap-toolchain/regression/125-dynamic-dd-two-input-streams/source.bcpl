// M1 dynamic FINDINPUT regression; DEVOBJ modular runtime only.
GLOBAL $( START:1; SELECTINPUT:11; RDCH:13; WRCH:14;
          UNRDCH:15; INPUT:16; STOP:30; FINDINPUT:42;
          ENDREAD:46; WRITES:60 $)

LET START() BE
$(1
    LET A = FINDINPUT("DDA")
    LET B = FINDINPUT("DDB")

    IF A=0 DO STOP(8)
    IF B=0 DO STOP(8)
    IF A=B DO STOP(8)

    SELECTINPUT(A)
    IF INPUT() NE A DO STOP(8)
    IF RDCH() NE 'A' DO STOP(8)
    UNRDCH()
    IF RDCH() NE 'A' DO STOP(8)
    IF RDCH() NE 'B' DO STOP(8)

    SELECTINPUT(B)
    IF INPUT() NE B DO STOP(8)
    IF RDCH() NE '1' DO STOP(8)
    UNRDCH()
    IF RDCH() NE '1' DO STOP(8)
    IF RDCH() NE '2' DO STOP(8)
    IF RDCH() NE 10 DO STOP(8)

    SELECTINPUT(A)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'C' DO STOP(8)

    SELECTINPUT(B)
    IF RDCH() NE '3' DO STOP(8)
    IF RDCH() NE '4' DO STOP(8)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    UNRDCH()
    IF RDCH() NE -1 DO STOP(8)

    SELECTINPUT(A)
    IF RDCH() NE 'D' DO STOP(8)
    IF FINDINPUT("NOFILE") NE 0 DO STOP(8)
    IF INPUT() NE A DO STOP(8)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)

    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(A)
    IF INPUT() NE 0 DO STOP(8)

    SELECTINPUT(B)
    IF INPUT() NE B DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(B)
    IF INPUT() NE 0 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)

    WRITES("BCPL INPUT OK")
    WRCH(10)
    FINISH
$)1
