// M1 FINISH must flush/close all still-open dynamic QSAM streams.
GLOBAL $( START:1; SELECTINPUT:11; SELECTOUTPUT:12; RDCH:13;
          WRCH:14; INPUT:16; OUTPUT:17; STOP:30;
          FINDOUTPUT:41; FINDINPUT:42; WRITES:60 $)
LET START() BE
$(1
    LET MAIN = OUTPUT()
    LET A = FINDOUTPUT("REPORT")
    LET B = FINDOUTPUT("REPORT2")
    LET I = FINDINPUT("DD01")

    IF A=0 DO STOP(8)
    IF B=0 DO STOP(8)
    IF I=0 DO STOP(8)
    IF A=B DO STOP(8)

    SELECTINPUT(I)
    IF INPUT() NE I DO STOP(8)
    IF RDCH() NE 'A' DO STOP(8)

    SELECTOUTPUT(A)
    IF OUTPUT() NE A DO STOP(8)
    WRITES("FINISH REPORT PART")

    SELECTOUTPUT(B)
    IF OUTPUT() NE B DO STOP(8)
    WRITES("FINISH REPORT2 PART")

    SELECTOUTPUT(MAIN)
    IF OUTPUT() NE MAIN DO STOP(8)
    WRITES("FINISH MAIN OK")
    WRCH(10)

    // Deliberately no ENDREAD/ENDWRITE on DD01/REPORT/REPORT2.
    FINISH
$)1
