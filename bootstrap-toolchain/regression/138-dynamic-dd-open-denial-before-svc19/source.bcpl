// M4.2 isolated test-only DQOPEN denial before the second SVC19.
GLOBAL $( START:1; SELECTINPUT:11; RDCH:13; WRCH:14;
          INPUT:16; STOP:30; FINDINPUT:42; ENDREAD:46;
          WRITES:60 $)

LET START() BE
$(1
    LET A = FINDINPUT("DD01")
    LET B = 0
    IF A=0 DO STOP(8)

    SELECTINPUT(A)
    IF INPUT() NE A DO STOP(8)
    IF RDCH() NE 'A' DO STOP(8)

    // Second DQOPEN is denied before SVC19 in test-only BCPLIO.
    B := FINDINPUT("DD02")
    IF B NE 0 DO STOP(8)
    IF INPUT() NE A DO STOP(8)

    // The live stream's cursor must remain undisturbed.
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'B' DO STOP(8)

    // Third DQOPEN issues real SVC19 and must succeed.
    B := FINDINPUT("DD02")
    IF B=0 DO STOP(8)
    IF B=A DO STOP(8)

    SELECTINPUT(B)
    IF INPUT() NE B DO STOP(8)
    IF RDCH() NE 'Q' DO STOP(8)
    IF RDCH() NE 'R' DO STOP(8)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)

    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)

    SELECTINPUT(A)
    IF INPUT() NE A DO STOP(8)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    ENDREAD()

    WRITES("BCPL OPEN BRANCH OK")
    WRCH(10)
    FINISH
$)1
