// M2: sixteen simultaneously open dynamic input streams.
// Use loops, not unrolled assertions, to conserve Cambridge CODE.
GLOBAL $( START:1; SELECTINPUT:11; RDCH:13; WRCH:14;
          UNRDCH:15; INPUT:16; STOP:30; FINDINPUT:42;
          ENDREAD:46; WRITES:60 $)

LET START() BE
$(1
    LET S = VEC 15
    LET F = VEC 15
    LET G = VEC 15

    // Each stream has distinct FB80 record contents.
    F!0 := 'A'
    F!1 := 'B'
    F!2 := 'C'
    F!3 := 'D'
    F!4 := 'E'
    F!5 := 'F'
    F!6 := 'G'
    F!7 := 'H'
    F!8 := 'I'
    F!9 := 'J'
    F!10 := 'K'
    F!11 := 'L'
    F!12 := 'M'
    F!13 := 'N'
    F!14 := 'O'
    F!15 := 'P'
    G!0 := 'Q'
    G!1 := 'R'
    G!2 := 'S'
    G!3 := 'T'
    G!4 := 'U'
    G!5 := 'V'
    G!6 := 'W'
    G!7 := 'X'
    G!8 := 'Y'
    G!9 := 'Z'
    G!10 := '0'
    G!11 := '1'
    G!12 := '2'
    G!13 := '3'
    G!14 := '4'
    G!15 := '5'

    // Establish 16 simultaneous live QSAM streams before reading.
    S!0 := FINDINPUT("DD01")
    S!1 := FINDINPUT("DD02")
    S!2 := FINDINPUT("DD03")
    S!3 := FINDINPUT("DD04")
    S!4 := FINDINPUT("DD05")
    S!5 := FINDINPUT("DD06")
    S!6 := FINDINPUT("DD07")
    S!7 := FINDINPUT("DD08")
    S!8 := FINDINPUT("DD09")
    S!9 := FINDINPUT("DD10")
    S!10 := FINDINPUT("DD11")
    S!11 := FINDINPUT("DD12")
    S!12 := FINDINPUT("DD13")
    S!13 := FINDINPUT("DD14")
    S!14 := FINDINPUT("DD15")
    S!15 := FINDINPUT("DD16")

    // Reject missing handles and any of the 120 possible aliases.
    FOR I = 0 TO 15 DO
    $(2
        IF S!I=0 DO STOP(8)
        FOR J = I+1 TO 15 DO IF S!I=S!J DO STOP(8)
    $)2

    // First record: interleave all sixteen streams.
    FOR I = 0 TO 15 DO
    $(2
        SELECTINPUT(S!I)
        IF INPUT() NE S!I DO STOP(8)
        IF RDCH() NE F!I DO STOP(8)
        IF I=0 DO
        $(3
            UNRDCH()
            IF RDCH() NE F!I DO STOP(8)
        $)3
    $)2

    // Preserve independent newline and second-record position.
    FOR I = 0 TO 15 DO
    $(2
        SELECTINPUT(S!I)
        IF RDCH() NE 10 DO STOP(8)
        IF RDCH() NE G!I DO STOP(8)
    $)2

    // Independent end-of-record newline and repeated EOF.
    FOR I = 0 TO 15 DO
    $(2
        SELECTINPUT(S!I)
        IF RDCH() NE 10 DO STOP(8)
        IF RDCH() NE -1 DO STOP(8)
        IF I=4 DO
        $(3
            UNRDCH()
            IF RDCH() NE -1 DO STOP(8)
        $)3
        IF RDCH() NE -1 DO STOP(8)
    $)2

    // Close in reverse order and reject retired handles.
    FOR I = 0 TO 15 DO
    $(2
        SELECTINPUT(S!(15-I))
        IF INPUT() NE S!(15-I) DO STOP(8)
        ENDREAD()
        IF INPUT() NE 0 DO STOP(8)
        SELECTINPUT(S!(15-I))
        IF INPUT() NE 0 DO STOP(8)
    $)2

    WRITES("BCPL SIXTEEN INPUT OK")
    WRCH(10)
    FINISH
$)1
