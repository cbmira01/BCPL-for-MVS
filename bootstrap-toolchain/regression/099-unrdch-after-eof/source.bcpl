GLOBAL $( START:1; SELECTINPUT:11; RDCH:13
          WRCH:14; UNRDCH:15; FINDINPUT:42 $)
LET START() BE
$(1
 LET S = FINDINPUT("BCPIN")
 IF S=0 DO FINISH
 SELECTINPUT(S)
 TEST RDCH()='A' THEN WRCH('A') ELSE WRCH('?')
 TEST RDCH()=10 THEN WRCH('/') ELSE WRCH('?')
 TEST RDCH()=-1 THEN WRCH('E') ELSE WRCH('?')
 UNRDCH()
 TEST RDCH()=-1 THEN WRCH('E') ELSE WRCH('?')
 TEST RDCH()=-1 THEN WRCH('E') ELSE WRCH('?')
 FINISH
$)1
