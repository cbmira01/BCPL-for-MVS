// T.1 161: interleaved calls detect cross-extension register damage.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          TIMESVC:201; DEMOSVC:203 $)
LET START() BE
$(1
    LET INFO = VEC 6
    LET VALUES = VEC 3
    LET CLOCK = VEC 3
    LET MVS = VEC 2
    IF DEMOSVC(0,0,0) NE 6 DO STOP(8)
    IF TIMESVC(0,0,0) NE 6 DO STOP(8)
    IF TIMESVC(0,INFO,6) NE 6 DO STOP(8)
    IF INFO!4 NE 3 DO STOP(8)
    IF DEMOSVC(0,INFO,6) NE 6 DO STOP(8)
    IF INFO!4 NE 1 DO STOP(8)
    VALUES!3 := 777
    IF DEMOSVC(1,VALUES,3) NE 3 DO STOP(8)
    IF VALUES!0 NE 10 | VALUES!1 NE 20 DO STOP(8)
    IF VALUES!2 NE 30 | VALUES!3 NE 777 DO STOP(8)
    CLOCK!3 := 888
    IF TIMESVC(1,CLOCK,3) NE 3 DO STOP(8)
    IF CLOCK!2 < 0 | CLOCK!2 > 3 DO STOP(8)
    IF CLOCK!3 NE 888 DO STOP(8)
    IF DEMOSVC(1,VALUES,3) NE 3 DO STOP(8)
    IF VALUES!0 NE 10 | VALUES!2 NE 30 DO STOP(8)
    MVS!2 := 999
    IF TIMESVC(2,MVS,2) NE 2 DO STOP(8)
    IF MVS!2 NE 999 DO STOP(8)
    IF DEMOSVC(1,VALUES,3) NE 3 DO STOP(8)
    IF VALUES!1 NE 20 | VALUES!3 NE 777 DO STOP(8)
    IF TIMESVC(1,CLOCK,3) NE 3 DO STOP(8)
    IF TIMESVC(2,MVS,2) NE 2 DO STOP(8)
    IF DEMOSVC(0,INFO,6) NE 6 DO STOP(8)
    IF INFO!4 NE 1 DO STOP(8)
    WRITES("T1 TIME 161 PASS")
    NEWLINE()
    FINISH
$)1
