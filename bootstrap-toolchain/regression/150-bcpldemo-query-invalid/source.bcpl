// R.5 NATIVE BCPL REGRESSION 150.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          DEMOSVC:203 $)
LET START() BE
$(1
    LET INFO = VEC 6
    INFO!0 := 777
    INFO!6 := 999
    IF DEMOSVC(0,0,6) NE -3 DO STOP(8)
    IF DEMOSVC(0,INFO,-1) NE -3 DO STOP(8)
    IF INFO!0 NE 777 | INFO!6 NE 999 DO STOP(8)
    WRITES("R5 EXT 150 PASS")
    NEWLINE()
    FINISH
$)1
