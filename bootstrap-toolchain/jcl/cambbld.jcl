//SYSIN    DD  DSN=HERC02.BCPL.BOOT.SOURCE(BOOTHOST),DISP=SHR
//OPTIONS  DD  DSN=HERC02.BCPL.BOOT.SOURCE(OPTIONS),DISP=SHR
//LIBHDR   DD  DSN=HERC02.BCPL.BOOT.SOURCE(LIBHDR),DISP=SHR
//SYNHDR   DD  DSN=HERC02.BCPL.BOOT.SOURCE(SYNHDR),DISP=SHR
//TRNHDR   DD  DSN=HERC02.BCPL.BOOT.SOURCE(TRNHDR),DISP=SHR
//CGHDR    DD  DSN=HERC02.BCPL.BOOT.SOURCE(CGHDR),DISP=SHR
//OCODE    DD  DSN=&&OC11,UNIT=SYSDA,SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  DUMMY
//*
//C11CG   EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(CGI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=&&OC11,DISP=(OLD,DELETE)
//INTCODE  DD  DSN=HERC02.BCPL.BOOT.INTCODE(BOOTHOST),DISP=SHR
//SYSUDUMP DD  DUMMY
//*
//* PHASE 3 - PACK THE COMPLETE ICINT-RUNNABLE CAMBRIDGE IMAGE
//*
//PACKCOMP EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT2   DD  DSN=HERC02.BCPL.BOOT.INTCODE(CAMBCOMP),DISP=SHR
//SYSUT1   DD  DSN=HERC02.BCPL.BOOT.INTCODE(BCPL),DISP=SHR
//         DD  DSN=HERC02.BCPL.BOOT.INTCODE(SYN),DISP=SHR
//         DD  DSN=HERC02.BCPL.BOOT.INTCODE(LEX),DISP=SHR
//         DD  DSN=HERC02.BCPL.BOOT.INTCODE(TRNA),DISP=SHR
//         DD  DSN=HERC02.BCPL.BOOT.INTCODE(TRNB),DISP=SHR
//         DD  DSN=HERC02.BCPL.BOOT.INTCODE(CGA),DISP=SHR
//         DD  DSN=HERC02.BCPL.BOOT.INTCODE(CGB),DISP=SHR
//         DD  DSN=HERC02.BCPL.BOOT.INTCODE(CGC),DISP=SHR
//         DD  DSN=HERC02.BCPL.BOOT.INTCODE(CGD),DISP=SHR
//         DD  DSN=HERC02.BCPL.BOOT.INTCODE(CGE),DISP=SHR
//         DD  DSN=HERC02.BCPL.BOOT.INTCODE(BOOTHOST),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//*
//* OUTPUT CHECKPOINT:
//*   HERC02.BCPL.MR10KIT.LOAD(ICINT19)
//*   HERC02.BCPL.BOOT.INTCODE(CAMBCOMP)
//*   PLUS THE INDIVIDUAL CAMBRIDGE INTCODE MEMBERS.
//
