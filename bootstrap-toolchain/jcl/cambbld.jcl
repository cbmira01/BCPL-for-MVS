//* CAMBBLD M3 JOB BODY - DSPAL SUBMIT BOOT_JCL CAMBBLD
//* DSPAL SUPPLIES THE AUTHENTICATED JOB CARD THROUGH THE INTERNAL READER.
//* STAGE DEMOTED SOURCES VIA TOOLS/NATIVE/STAGE-BOOTSTRAP.
//* NO CAMB_* DATASETS ARE USED.
//*
//* M3 NATIVE COMPILER BOOTSTRAP: USE INSTALLED MR10_LOAD(ICINT19)
//* ICINT19 IS REBUILT BY MR10_JCL(IC19BLD), NOT BY THIS JOB.
//* ALL PDS ALLOCATIONS ARE CONTROLLED BY CONFIG/DSPAL.YAML.
//*
//* PHASE 2 - COMPILE THE DEMOTED CAMBRIDGE COMPILER TO INTCODE
//*
//* BCPL -> HERC02.BCPL.BOOT.INTCODE(BCPL)
//C01CMP  EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(SYNI),DISP=SHR
//         DD  DSN=HERC02.BCPL.BOOT.INTCODE(TRNILRG),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=HERC02.BCPL.BOOT.SOURCE(BCPL),DISP=SHR
//OPTIONS  DD  DSN=HERC02.BCPL.BOOT.SOURCE(OPTIONS),DISP=SHR
//LIBHDR   DD  DSN=HERC02.BCPL.BOOT.SOURCE(LIBHDR),DISP=SHR
//SYNHDR   DD  DSN=HERC02.BCPL.BOOT.SOURCE(SYNHDR),DISP=SHR
//TRNHDR   DD  DSN=HERC02.BCPL.BOOT.SOURCE(TRNHDR),DISP=SHR
//CGHDR    DD  DSN=HERC02.BCPL.BOOT.SOURCE(CGHDR),DISP=SHR
//OCODE    DD  DSN=&&OC01,UNIT=SYSDA,SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  DUMMY
//*
//C01CG   EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(CGI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=&&OC01,DISP=(OLD,DELETE)
//INTCODE  DD  DSN=HERC02.BCPL.BOOT.INTCODE(BCPL),DISP=SHR
//SYSUDUMP DD  DUMMY
//*
//* SYN -> HERC02.BCPL.BOOT.INTCODE(SYN)
