//* Q.5 BCPLQSAM INSTALL -- SEPARATE OWNER MVS AUTH REQUIRED.
//* PREREQ: GIT-POPULATED EXT_ASM(BCPLQSAM); EXT_OBJ EXISTS.
//* NO BCPLDEMO/BCPLTIME REBUILD OR BOOT_OBJ WRITE.
//* DSPAL SUBMIT BOOT_JCL Q5QINST SUPPLIES JOB CARD.
//* ONLY PERSISTENT WRITE IS PUTQSAM INTO EXT.OBJ(BCPLQSAM).
//ASMQ     EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD  DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD  SYSOUT=*
//SYSPUNCH DD  DUMMY
//SYSGO    DD  DSN=&&Q5OBJ,UNIT=SYSDA,
//             SPACE=(80,(150,50)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD  DSN=HERC02.BCPL.EXT.ASM(BCPLQSAM),DISP=SHR
//* INSTALL REQUIRES EXACT ASMQ RC=0000.
//PUTQSAM  EXEC PGM=IEBGENER,COND=(0,NE,ASMQ)
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=&&Q5OBJ,DISP=(OLD,PASS)
//SYSUT2   DD  DSN=HERC02.BCPL.EXT.OBJ(BCPLQSAM),DISP=OLD
//* READ INSTALLED BINARY OBJECT; NO HOST CONVERSION.
//READBACK EXEC PGM=IEBGENER,COND=(0,NE,PUTQSAM)
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=HERC02.BCPL.EXT.OBJ(BCPLQSAM),DISP=SHR
//SYSUT2   DD  DSN=&&Q5READ,UNIT=SYSDA,
//             SPACE=(80,(150,50)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//* COMPARE ORIGINAL IFOX FB80 OBJECT WITH INSTALLED READBACK.
//VERIFY   EXEC PGM=IEBCOMPR,COND=(0,NE,READBACK)
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  DSN=&&Q5OBJ,DISP=(OLD,DELETE)
//SYSUT2   DD  DSN=&&Q5READ,DISP=(OLD,DELETE)
//SYSIN    DD  *
 COMPARE TYPORG=PS
/*
//
