//* R.5 BCPLDEMO INSTALL -- OWNER AUTH REQUIRED BEFORE SUBMISSION.
//* REQUIRED: EXT_ASM, EXT_OBJ EXIST; TEXT MEMBERS ALREADY POPULATED.
//* SOURCE OF TRUTH: GITHUB; DESTINATION MAY BE REBUILT.
//* DSPAL SUBMIT BOOT_JCL R5DINST SUPPLIES AUTHENTICATED JOB CARD.
//* THE ONLY PERSISTENT WRITE IS PUTDEMO SYSUT2 EXT.OBJ(BCPLDEMO).
//* DO NOT RUN UNTIL THE OWNER APPROVES PERMANENT PDS WRITES.
//ASMDEMO  EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&DMOBJ,UNIT=SYSDA,
//             SPACE=(80,(100,40)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.EXT.ASM(BCPLDEMO),DISP=SHR
//* INSTALL IS BLOCKED UNLESS IFOX RC IS EXACTLY ZERO.
//PUTDEMO  EXEC PGM=IEBGENER,COND=(0,NE,ASMDEMO)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&DMOBJ,DISP=(OLD,PASS)
//SYSUT2   DD DSN=HERC02.BCPL.EXT.OBJ(BCPLDEMO),DISP=OLD
//* READ BACK THE INSTALLED BINARY RECORDS WITHOUT CONVERSION.
//READBACK EXEC PGM=IEBGENER,COND=(0,NE,PUTDEMO)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=HERC02.BCPL.EXT.OBJ(BCPLDEMO),DISP=SHR
//SYSUT2   DD DSN=&&DMREAD,UNIT=SYSDA,
//             SPACE=(80,(100,40)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//* IEBCOMPR COMPARES TWO SEQUENTIAL FB80 DATASETS RECORD-FOR-RECORD.
//VERIFY   EXEC PGM=IEBCOMPR,COND=(0,NE,READBACK)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=&&DMOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=&&DMREAD,DISP=(OLD,DELETE)
//SYSIN    DD *
 COMPARE TYPORG=PS
/*
//
