//* CO.5 PRODUCTION COROUTIN BINARY INSTALL; OWNER AUTHORIZED.
//* Stage BOOT_ASM(COROUTIN) from Git first; no manifest change.
//* Write only BOOT_OBJ(COROUTIN), with exact IFOX read-back.
//ASMCOLIB EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&COOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.BOOT.ASM(COROUTIN),DISP=SHR
//* BLOCK INSTALL UNLESS IFOX RETURNS ZERO.
//PUTCOLIB EXEC PGM=IEBGENER,COND=(0,NE,ASMCOLIB)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&COOBJ,DISP=(OLD,PASS)
//SYSUT2   DD DSN=HERC02.BCPL.BOOT.OBJ(COROUTIN),DISP=OLD
//RDCOLIB  EXEC PGM=IEBGENER,COND=(0,NE,PUTCOLIB)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=HERC02.BCPL.BOOT.OBJ(COROUTIN),DISP=SHR
//SYSUT2   DD DSN=&&COREAD,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//VFCOLIB  EXEC PGM=IEBCOMPR,COND=(0,NE,RDCOLIB)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=&&COOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=&&COREAD,DISP=(OLD,DELETE)
//SYSIN    DD *
 COMPARE TYPORG=PS
/*
//
