//* BLDBMAIN -- BUILD SEVEN ASSEMBLER OBJECTS TO BOOT.OBJ.
//* SOURCE: HERC02.BCPL.BOOT.ASM (SEVEN CANONICAL MEMBERS).
//* TARGET: HERC02.BCPL.BOOT.OBJ; NOT DEVOBJ.
//* EXPLICIT SOURCE-BASED PRODUCTION BUILD, NO BINARY SEEDING.
//* AFTER A CLEAN PURGE: CHECK ASM RC BEFORE EACH FB80 INSTALL.
//* NOT ATOMIC: INSTALL ERROR MAY LEAVE A PARTIAL OBJ LIBRARY.
//ASMMMAIN EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&MAINOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.BOOT.ASM(BCPLMAIN),DISP=SHR
//*
//ASMMMEM  EXEC PGM=IFOX00,REGION=256K,
//             COND=(0,NE),
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&MEMOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.BOOT.ASM(BCPLMEM),DISP=SHR
//*
//ASMMBYTE EXEC PGM=IFOX00,REGION=256K,
//             COND=(0,NE),
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&BYTEOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.BOOT.ASM(BCPLBYTE),DISP=SHR
//*
//ASMMAPT  EXEC PGM=IFOX00,REGION=256K,
//             COND=(0,NE),
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&APTOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.BOOT.ASM(BCPLAPT),DISP=SHR
//*
//ASMMIO   EXEC PGM=IFOX00,REGION=256K,
//             COND=(0,NE),
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&IOOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.BOOT.ASM(BCPLIO),DISP=SHR
//*
//ASMRGS   EXEC PGM=IFOX00,REGION=256K,
//             COND=(0,NE),
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&RGSOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.BOOT.ASM(BCPLRGS),DISP=SHR
//*
//ASMREG   EXEC PGM=IFOX00,REGION=256K,
//             COND=(0,NE),
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&REGOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.BOOT.ASM(BCPLREG),DISP=SHR
//*
//PUTMAIN  EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&MAINOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.BOOT.OBJ(BCPLMAIN),DISP=SHR
//*
//PUTMEM   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&MEMOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.BOOT.OBJ(BCPLMEM),DISP=SHR
//*
//PUTBYTE  EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&BYTEOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.BOOT.OBJ(BCPLBYTE),DISP=SHR
//*
//PUTAPT   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&APTOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.BOOT.OBJ(BCPLAPT),DISP=SHR
//*
//PUTIO    EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&IOOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.BOOT.OBJ(BCPLIO),DISP=SHR
//*
//PUTRGS   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&RGSOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.BOOT.OBJ(BCPLRGS),DISP=SHR
//*
//PUTREG   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&REGOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.BOOT.OBJ(BCPLREG),DISP=SHR
//*
//
