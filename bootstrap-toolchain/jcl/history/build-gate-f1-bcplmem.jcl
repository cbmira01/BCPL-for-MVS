//* BLDGFMEM: GATE F1 SINGLE-MEMBER RESIDENT OBJECT INSTALL.
//* SOURCE: HERC02.BCPL.NATIVE.ASM(BCPLMEM)
//* TARGET: HERC02.BCPL.NATIVE.OBJ(BCPLMEM) ONLY.
//* THIS JOB REPLACES A PRODUCTION OBJECT MEMBER. NOT A DRY RUN.
//* NO BCPLMAIN/BCPLBYTE/BCPLAPT/BLIB WRITE.
//ASMMEM   EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&MEMOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.NATIVE.ASM(BCPLMEM),DISP=SHR
//*
//* ONLY WRITE OBJ(BCPLMEM) IF IFOX ASSEMBLY RC=0.
//PUTMEM   EXEC PGM=IEBGENER,COND=(0,NE,ASMMEM)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&MEMOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.NATIVE.OBJ(BCPLMEM),DISP=SHR
//