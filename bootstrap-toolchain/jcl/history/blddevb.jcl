//* BLDDEVB: M1.7 INDEPENDENT BCPLBYTE DEVELOPMENT OBJECT BUILD.
//* SOURCE: HERC02.BCPL.BOOT.ASM(BCPLBYTE)
//* TARGET: HERC02.BCPL.BOOT.DEVOBJ(BCPLBYTE) ONLY.
//ASMCOMP  EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&COMPOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.BOOT.ASM(BCPLBYTE),DISP=SHR
//*
//* INSTALL BINARY FB80 DECK ONLY AFTER RC=0000.
//PUTCOMP  EXEC PGM=IEBGENER,COND=(0,NE,ASMCOMP)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&COMPOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.BOOT.DEVOBJ(BCPLBYTE),DISP=SHR
//
