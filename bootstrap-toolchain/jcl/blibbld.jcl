//* BLIBBLD JOB BODY -- DSPAL SUBMIT JCL BLIBBLD --WAIT
//* SOURCE: HERC02.BCPL.BOOT.SOURCE(BLIB), DEMOTED HISTORICAL BCPL
//* OUTPUT: HERC02.BCPL.BOOT.OBJ(BLIB), BINARY RELOCATABLE OBJECT
//* RESIDENT CAMBRIDGE -> CG370 -> CARD FIX -> IFOX -> IEBGENER
//* NO HOST-PREPARED ASM, NO APPLICATION LINK-EDIT, NO GO STEP.
//* STAGE 1: RESIDENT CAMBRIDGE GENERATES SYSTEM/370 SOURCE.
//COMP     EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD DSN=&&COMPRPT,UNIT=SYSDA,SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=132),
//            DISP=(NEW,PASS)
//INTIN    DD DSN=HERC02.BCPL.BOOT.INTCODE(CAMBCOMP),DISP=SHR
//SYSIN    DD DSN=HERC02.BCPL.BOOT.SOURCE(BLIB),DISP=SHR
//OPTIONS  DD DSN=HERC02.BCPL.BOOT.SOURCE(OPTIONS),DISP=SHR
//* BLIB ONLY: RESERVE 2000 STACK WORDS; KEEP /N CODEGEN.
//CAMBPARM DD *
P2000/N/////////////////////////////////////////////////////////////////////////
/*
//LIBHDR   DD DSN=HERC02.BCPL.BOOT.SOURCE(LIBHDR),DISP=SHR
//SYNHDR   DD DSN=HERC02.BCPL.BOOT.SOURCE(SYNHDR),DISP=SHR
//TRNHDR   DD DSN=HERC02.BCPL.BOOT.SOURCE(TRNHDR),DISP=SHR
//CGHDR    DD DSN=HERC02.BCPL.BOOT.SOURCE(CGHDR),DISP=SHR
//CODE     DD DSN=&&CODE,UNIT=SYSDA,SPACE=(80,(1000,500)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//            DISP=(NEW,PASS)
//SYSGO    DD DUMMY
//SYSUDUMP DD DUMMY
//*
//* PRESERVE THE COMPLETE COMPILER REPORT FOR JES AND THE GATE.
//COMPRPT  EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&COMPRPT,DISP=(OLD,PASS)
//SYSUT2   DD SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//*
//* STAGE 2: BUILD TEMPORARY FB80 CG370 CARD-FIX PROGRAM.
//* THIS PRESERVES HISTORICAL SOURCE AND THE RESIDENT COMPILER.
//PREPASM  EXEC PGM=IFOX00,REGION=256K,COND=(0,NE),
//             PARM='OBJECT,NODECK,LIST,NOXREF'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&PREPOBJ,UNIT=SYSDA,SPACE=(80,(40,10)),
//             DISP=(NEW,PASS),DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD *
BLIBPREP CSECT
         STM   14,12,12(13)
         LR    12,15
         USING BLIBPREP,12
         LA    3,SAVEAREA
         ST    13,4(3)
         ST    3,8(13)
         LR    13,3
* REQUIRE ONE EXACT ZERO INTERPRETED COMPLETION BEFORE RAW OPEN.
         OPEN  (RPTDCB,(INPUT))
RPTREAD  GET   RPTDCB,RPTCARD
         LA    2,RPTCARD
         LA    3,132(2)
RPTSKIP  CR    2,3
         BNL   RPTREAD
         CLI   0(2),C' '
         BNE   RPTHEAD
         LA    2,1(2)
         B     RPTSKIP
RPTHEAD  LR    4,3
         SR    4,2
         C     4,=F'16'
         BL    RPTREAD
         CLC   0(16,2),=CL16'EXECUTION CYCLES'
         BNE   RPTREAD
         CLI   RPTCNT,0
         BNE   RPTBAD
         C     4,=F'19'
         BL    RPTBAD
         CLC   0(19,2),=CL19'EXECUTION CYCLES = '
         BNE   RPTBAD
         LA    2,19(2)
         CR    2,3
         BNL   RPTBAD
         CLI   0(2),C'0'
         BL    RPTBAD
         CLI   0(2),C'9'
         BH    RPTBAD
RPTDIG   LA    2,1(2)
         CR    2,3
         BNL   RPTBAD
         CLI   0(2),C'0'
         BL    RPTTAIL
         CLI   0(2),C'9'
         BNH   RPTDIG
RPTTAIL  LR    4,3
         SR    4,2
         C     4,=F'10'
         BL    RPTBAD
         CLC   0(10,2),=CL10', CODE = 0'
         BNE   RPTBAD
         LA    2,10(2)
RPTPAD   CR    2,3
         BNL   RPTGOOD
         CLI   0(2),C' '
         BNE   RPTBAD
         LA    2,1(2)
         B     RPTPAD
RPTGOOD  MVI   RPTCNT,1
         B     RPTREAD
RPTBAD   CLOSE (RPTDCB)
         B     BADEND
RPTEOF   CLOSE (RPTDCB)
         CLI   RPTCNT,1
         BNE   BADEND
         OPEN  (INDCB,(INPUT))
         OPEN  (OUTDCB,(OUTPUT))
READLOOP GET   INDCB,CARD
         CLC   CARD(80),SECT1
         BE    FIXSECT
         CLC   CARD(80),SECT9
         BE    FIXSECT
         CLC   CARD(80),BAD1
         BE    FIXMIN
         CLC   CARD(80),BAD9
         BE    FIXMIN
         B     WRREC
FIXSECT  L     2,SECTCNT
         LA    2,1(2)
         ST    2,SECTCNT
         MVC   CARD(80),NEWSECT
         B     WRREC
FIXMIN   L     2,MINCNT
         LA    2,1(2)
         ST    2,MINCNT
         MVC   CARD(80),NEWMIN
WRREC    PUT   OUTDCB,CARD
         B     READLOOP
EOF      CLOSE (INDCB)
         CLOSE (OUTDCB)
         L     2,SECTCNT
         C     2,=F'1'
         BNE   BADEND
         L     2,MINCNT
         C     2,=F'1'
         BNE   BADEND
         L     13,4(13)
         LM    14,12,12(13)
         SR    15,15
         BR    14
BADEND   L     13,4(13)
         LM    14,12,12(13)
         LA    15,8
         BR    14
         DS    0F
SAVEAREA DS    18F
SECTCNT  DC    F'0'
MINCNT   DC    F'0'
CARD     DS    CL80
RPTCARD  DS    CL132
RPTCNT   DC    X'00'
RPTDCB   DCB   DDNAME=CMPRPT,DSORG=PS,MACRF=GM,EODAD=RPTEOF
SECT1    DC    CL80' CSECT'
SECT9    DC    CL80'         CSECT'
BAD1     DC    CL80' DC F''-./,),(-*,('''
BAD9     DC    CL80'         DC F''-./,),(-*,('''
NEWSECT  DC    CL80'BLIB     CSECT'
NEWMIN   DC    CL80'         DC X''80000000'''
INDCB    DCB   DDNAME=RAW,DSORG=PS,MACRF=GM,EODAD=EOF
OUTDCB   DCB   DDNAME=READY,DSORG=PS,MACRF=PM
         LTORG
         END   BLIBPREP
/*
//PREPLK   EXEC PGM=IEWL,PARM='LET,NCAL',REGION=256K,
//             COND=(0,NE)
//SYSLIN   DD DSN=&&PREPOBJ,DISP=(OLD,DELETE)
//         DD *
 ENTRY BLIBPREP
 NAME BLIBPREP(R)
/*
//SYSLMOD  DD DSN=&&PREPLD(BLIBPREP),UNIT=SYSDA,
//             SPACE=(1024,(20,10,1)),DISP=(NEW,PASS)
//SYSUT1   DD UNIT=SYSDA,SPACE=(1024,(20,10))
//SYSPRINT DD SYSOUT=*
//*
//* STAGE 3: REPAIR TWO EXACT CG370 CARDS; REQUIRE ONE EACH.
//FIXASM   EXEC PGM=*.PREPLK.SYSLMOD,REGION=256K,
//             COND=(0,NE)
//CMPRPT   DD DSN=&&COMPRPT,DISP=(OLD,DELETE)
//RAW      DD DSN=&&CODE,DISP=(OLD,DELETE)
//READY    DD DSN=&&BLIBASM,UNIT=SYSDA,SPACE=(80,(1000,500)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//            DISP=(NEW,PASS)
//*
//* STAGE 4: ASSEMBLE PREPARED, NAMED BLIB AS A SEPARATE CSECT.
//ASMBLIB  EXEC PGM=IFOX00,REGION=256K,COND=(0,NE),
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&BLIBOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=&&BLIBASM,DISP=(OLD,DELETE)
//*
//* STAGE 5: INSTALL ONLY AFTER ZERO-CODE IFOX ASSEMBLY.
//INSTALL  EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&BLIBOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.BOOT.OBJ(BLIB),DISP=SHR
//
