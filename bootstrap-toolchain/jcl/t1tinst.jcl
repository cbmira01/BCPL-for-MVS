//* T.1 BCPLTIME INSTALL -- OWNER AUTH REQUIRED BEFORE SUBMISSION.
//* PREREQ: EXT.ASM(BCPLTIME) STAGED FROM GIT, EXT.OBJ EXISTS.
//* NO BCPLDEMO REBUILD. DO NOT PUBLISH BCXCAT UNTIL VERIFIED.
//* DSPAL SUBMIT BOOT_JCL T1TINST ADDS THE AUTHENTICATED JOB CARD.
//* ONLY PERSISTENT WRITE: PUTTIME SYSUT2 EXT.OBJ(BCPLTIME).
//* CSECTS: TIMDESC AND TIMDISP. NO BOOT_OBJ/BOOT_DEVOBJ WRITES.
//ASMTIME  EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&TMOBJ,UNIT=SYSDA,
//             SPACE=(80,(100,40)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.EXT.ASM(BCPLTIME),DISP=SHR
//* BLOCK INSTALL UNLESS IFOX RC IS EXACTLY 0000.
//PUTTIME  EXEC PGM=IEBGENER,COND=(0,NE,ASMTIME)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&TMOBJ,DISP=(OLD,PASS)
//SYSUT2   DD DSN=HERC02.BCPL.EXT.OBJ(BCPLTIME),DISP=OLD
//* READ BACK THE INSTALLED RELOCATABLE FB80 RECORDS.
//READBACK EXEC PGM=IEBGENER,COND=(0,NE,PUTTIME)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=HERC02.BCPL.EXT.OBJ(BCPLTIME),DISP=SHR
//SYSUT2   DD DSN=&&TMREAD,UNIT=SYSDA,
//             SPACE=(80,(100,40)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//* VERIFY EXACT TEMPORARY OBJECT VS INSTALLED BINARY MEMBER.
//VERIFY   EXEC PGM=IEBCOMPR,COND=(0,NE,READBACK)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=&&TMOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=&&TMREAD,DISP=(OLD,DELETE)
//SYSIN    DD *
 COMPARE TYPORG=PS
/*
//
