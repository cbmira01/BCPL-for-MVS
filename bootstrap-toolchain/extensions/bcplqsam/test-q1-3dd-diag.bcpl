// Q.1 DIAGNOSTIC-ONLY 3-DD caller; JOB 6605 GO RC=8 investigation.
GLOBAL $( START:1; STOP:30; WRITES:60; WRITEN:62; NEWLINE:63; QSAMSVC:200 $)
LET START() BE
$(1
    LET Q = VEC 3
    LET R = VEC 7
    LET I = VEC 5
    LET H = VEC 2
    LET S = 0
    WRITES("Q13D START")
    NEWLINE()
    I!0 := 707
    I!5 := 909
    S := QSAMSVC(0,0,0)
    WRITES("Q13D CALL 01 RC=")
    WRITEN(S)
    NEWLINE()
    IF S NE 6 DO STOP(8)
    S := QSAMSVC(0,I,5)
    WRITES("Q13D CALL 02 RC=")
    WRITEN(S)
    NEWLINE()
    IF S NE -1 DO STOP(8)
    WRITES("Q13D ASSERT 01 BEFORE")
    NEWLINE()
    IF I!0 NE 707 | I!5 NE 909 DO STOP(8)
    S := QSAMSVC(0,0,6)
    WRITES("Q13D CALL 03 RC=")
    WRITEN(S)
    NEWLINE()
    IF S NE -3 DO STOP(8)
    S := QSAMSVC(0,I,6)
    WRITES("Q13D CALL 04 RC=")
    WRITEN(S)
    NEWLINE()
    IF S NE 6 DO STOP(8)
    WRITES("Q13D QUERY I0/I1/I2=")
    WRITEN(I!0)
    WRITES(" ")
    WRITEN(I!1)
    WRITES(" ")
    WRITEN(I!2)
    NEWLINE()
    WRITES("Q13D QUERY I3/I4/I5=")
    WRITEN(I!3)
    WRITES(" ")
    WRITEN(I!4)
    WRITES(" ")
    WRITEN(I!5)
    NEWLINE()
    WRITES("Q13D ASSERT 02 BEFORE")
    NEWLINE()
    IF I!0 NE 1 | I!1 NE 1 | I!2 NE 0 DO STOP(8)
    WRITES("Q13D ASSERT 02 AFTER")
    NEWLINE()
    WRITES("Q13D ASSERT 03 BEFORE")
    NEWLINE()
    IF I!3 NE 6 | I!4 NE 25 | I!5 NE 0 DO STOP(8)
    S := QSAMSVC(2,0,0)
    WRITES("Q13D CALL 05 RC=")
    WRITEN(S)
    NEWLINE()
    IF S NE -2 DO STOP(8)
    S := QSAMSVC(3,0,0)
    WRITES("Q13D CALL 06 RC=")
    WRITEN(S)
    NEWLINE()
    IF S NE -2 DO STOP(8)
    Q!1 := 1
    Q!2 := 0
    Q!3 := 0
    Q!0 := "Q00"
    S := QSAMSVC(1,Q,R)
    WRITES("Q13D CALL 07 RC=")
    WRITEN(S)
    NEWLINE()
    WRITES("Q13D CALL 07 RESULT0=")
    WRITEN(R!0)
    WRITES(" RESULT1=")
    WRITEN(R!1)
    WRITES(" RESULT2=")
    WRITEN(R!2)
    NEWLINE()
    IF S NE 0 DO STOP(8)
    H!0 := R!1
    Q!0 := "Q01"
    S := QSAMSVC(1,Q,R)
    WRITES("Q13D CALL 08 RC=")
    WRITEN(S)
    NEWLINE()
    WRITES("Q13D CALL 08 RESULT0=")
    WRITEN(R!0)
    WRITES(" RESULT1=")
    WRITEN(R!1)
    WRITES(" RESULT2=")
    WRITEN(R!2)
    NEWLINE()
    IF S NE 0 DO STOP(8)
    H!1 := R!1
    Q!0 := "Q02"
    S := QSAMSVC(1,Q,R)
    WRITES("Q13D CALL 09 RC=")
    WRITEN(S)
    NEWLINE()
    WRITES("Q13D CALL 09 RESULT0=")
    WRITEN(R!0)
    WRITES(" RESULT1=")
    WRITEN(R!1)
    WRITES(" RESULT2=")
    WRITEN(R!2)
    NEWLINE()
    IF S NE 0 DO STOP(8)
    H!2 := R!1
    Q!0 := H!1
    Q!1 := 0
    S := QSAMSVC(5,Q,R)
    WRITES("Q13D CALL 10 RC=")
    WRITEN(S)
    NEWLINE()
    WRITES("Q13D CALL 10 RESULT0=")
    WRITEN(R!0)
    WRITES(" RESULT1=")
    WRITEN(R!1)
    WRITES(" RESULT2=")
    WRITEN(R!2)
    NEWLINE()
    IF S NE 0 DO STOP(8)
    WRITES("Q13D ASSERT 04 BEFORE")
    NEWLINE()
    WRITES("Q13D INFO 4/5/6/7=")
    WRITEN(R!4)
    WRITES(" ")
    WRITEN(R!5)
    WRITES(" ")
    WRITEN(R!6)
    WRITES(" ")
    WRITEN(R!7)
    NEWLINE()
    IF R!4 NE 1 | R!5 NE 1024 DO STOP(8)
    WRITES("Q13D ASSERT 05 BEFORE")
    NEWLINE()
    WRITES("Q13D INFO 4/5/6/7=")
    WRITEN(R!4)
    WRITES(" ")
    WRITEN(R!5)
    WRITES(" ")
    WRITEN(R!6)
    WRITES(" ")
    WRITEN(R!7)
    NEWLINE()
    IF R!6 NE 1024 | R!7 NE 1024 DO STOP(8)
    S := QSAMSVC(4,Q,R)
    WRITES("Q13D CALL 11 RC=")
    WRITEN(S)
    NEWLINE()
    WRITES("Q13D CALL 11 RESULT0=")
    WRITEN(R!0)
    WRITES(" RESULT1=")
    WRITEN(R!1)
    WRITES(" RESULT2=")
    WRITEN(R!2)
    NEWLINE()
    IF S NE 0 DO STOP(8)
    S := QSAMSVC(4,Q,R)
    WRITES("Q13D CALL 12 RC=")
    WRITEN(S)
    NEWLINE()
    WRITES("Q13D CALL 12 RESULT0=")
    WRITEN(R!0)
    WRITES(" RESULT1=")
    WRITEN(R!1)
    WRITES(" RESULT2=")
    WRITEN(R!2)
    NEWLINE()
    IF S NE -7 DO STOP(8)
    Q!0 := H!0
    S := QSAMSVC(4,Q,R)
    WRITES("Q13D CALL 13 RC=")
    WRITEN(S)
    NEWLINE()
    WRITES("Q13D CALL 13 RESULT0=")
    WRITEN(R!0)
    WRITES(" RESULT1=")
    WRITEN(R!1)
    WRITES(" RESULT2=")
    WRITEN(R!2)
    NEWLINE()
    IF S NE 0 DO STOP(8)
    Q!0 := H!2
    S := QSAMSVC(4,Q,R)
    WRITES("Q13D CALL 14 RC=")
    WRITEN(S)
    NEWLINE()
    WRITES("Q13D CALL 14 RESULT0=")
    WRITEN(R!0)
    WRITES(" RESULT1=")
    WRITEN(R!1)
    WRITES(" RESULT2=")
    WRITEN(R!2)
    NEWLINE()
    IF S NE 0 DO STOP(8)
    WRITES("BCPLQSAM Q1 THREE DD PASS")
    NEWLINE()
    FINISH
$)1
