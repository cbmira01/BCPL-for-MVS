// Q.5 test-only geometry preflight: no unsafe QSAM OPEN on rejected DDs.
// Q00 is the independent valid F1024 input, Q01 omits GO-step DCB.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          QSAMSVC:200 $)
LET START() BE
$(1
    LET Q = VEC 3
    LET R = VEC 7
    LET B = VEC 255
    LET H0 = 0
    Q!1 := 1
    Q!2 := 0
    Q!3 := 0
    Q!0 := "Q00"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(12)
    H0 := R!1
    IF H0 NE 1 DO STOP(12)
    // Blocked fixed geometry must be an integral LRECL multiple.
    Q!0 := "QBAD"
    IF QSAMSVC(1,Q,R) NE -6 DO STOP(12)
    IF R!0 NE -6 | R!1 NE 0 DO STOP(12)
    // F1025 exceeds the supported private 1024-byte stage ceiling.
    Q!0 := "QBIG"
    IF QSAMSVC(1,Q,R) NE -6 DO STOP(12)
    IF R!0 NE -6 | R!1 NE 0 DO STOP(12)
    // Existing Q01 has no usable explicit GO-step JFCB geometry.
    Q!0 := "Q01"
    IF QSAMSVC(1,Q,R) NE -6 DO STOP(12)
    IF R!0 NE -6 | R!1 NE 0 DO STOP(12)
    // All three failures must leave Q00's public handle intact.
    Q!0 := H0
    IF QSAMSVC(5,Q,R) NE 0 DO STOP(12)
    IF R!4 NE 1 | R!5 NE 1024 DO STOP(12)
    IF R!6 NE 1024 | R!7 NE 1024 DO STOP(12)
    Q!1 := B
    Q!2 := 1024
    IF QSAMSVC(2,Q,R) NE 0 DO STOP(12)
    IF R!1 NE 1024 DO STOP(12)
    Q!1 := 0
    Q!2 := 0
    IF QSAMSVC(4,Q,R) NE 0 DO STOP(12)
    IF R!0 NE 0 DO STOP(12)
    WRITES("BCPLQSAM Q5 GEOMETRY NEGATIVE PASS")
    NEWLINE()
    FINISH
$)1
