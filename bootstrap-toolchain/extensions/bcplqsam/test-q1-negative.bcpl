// Q.1 argument, DDNAME, and missing-DD checks.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          QSAMSVC:200 $)
LET START() BE
$(1
    LET Q=VEC 3
    LET R=VEC 7
    Q!0 := "1BAD"
    Q!1 := 1
    Q!2 := 0
    Q!3 := 0
    IF QSAMSVC(1,Q,R) NE -4 DO STOP(8)
    Q!0 := "QLONGNAME"
    IF QSAMSVC(1,Q,R) NE -4 DO STOP(8)
    Q!0 := "QMISS"
    IF QSAMSVC(1,Q,R) NE -5 DO STOP(8)
    Q!0 := "Q00"
    Q!1 := 3
    IF QSAMSVC(1,Q,R) NE -3 DO STOP(8)
    Q!1 := 1
    Q!3 := 1
    IF QSAMSVC(1,Q,R) NE -3 DO STOP(8)
    Q!3 := 0
    Q!0 := 56789
    IF QSAMSVC(4,Q,R) NE -7 DO STOP(8)
    IF QSAMSVC(5,Q,R) NE -7 DO STOP(8)
    WRITES("BCPLQSAM Q1 NEGATIVE PASS")
    NEWLINE()
    FINISH
$)1
