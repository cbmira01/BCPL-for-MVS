// Q.1 sixteen-handle native BCPL candidate, Q00..Q15 DDs.
// All DDs require F1024/1024 input allocations on MVS.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          QSAMSVC:200 $)
LET START() BE
$(1
    LET Q = VEC 3
    LET R = VEC 7
    LET H = VEC 15
    LET OLD = 0
    Q!1 := 1
    Q!2 := 0
    Q!3 := 0
    Q!0 := "Q00"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!0 := R!1
    IF H!0 < 1 DO STOP(8)
    Q!0 := "Q01"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!1 := R!1
    IF H!1 < 1 DO STOP(8)
    Q!0 := "Q02"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!2 := R!1
    IF H!2 < 1 DO STOP(8)
    Q!0 := "Q03"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!3 := R!1
    IF H!3 < 1 DO STOP(8)
    Q!0 := "Q04"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!4 := R!1
    IF H!4 < 1 DO STOP(8)
    Q!0 := "Q05"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!5 := R!1
    IF H!5 < 1 DO STOP(8)
    Q!0 := "Q06"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!6 := R!1
    IF H!6 < 1 DO STOP(8)
    Q!0 := "Q07"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!7 := R!1
    IF H!7 < 1 DO STOP(8)
    Q!0 := "Q08"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!8 := R!1
    IF H!8 < 1 DO STOP(8)
    Q!0 := "Q09"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!9 := R!1
    IF H!9 < 1 DO STOP(8)
    Q!0 := "Q10"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!10 := R!1
    IF H!10 < 1 DO STOP(8)
    Q!0 := "Q11"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!11 := R!1
    IF H!11 < 1 DO STOP(8)
    Q!0 := "Q12"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!12 := R!1
    IF H!12 < 1 DO STOP(8)
    Q!0 := "Q13"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!13 := R!1
    IF H!13 < 1 DO STOP(8)
    Q!0 := "Q14"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!14 := R!1
    IF H!14 < 1 DO STOP(8)
    Q!0 := "Q15"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!15 := R!1
    IF H!15 < 1 DO STOP(8)
    Q!0 := "Q00"
    IF QSAMSVC(1,Q,R) NE -11 DO STOP(8)
    IF R!0 NE -11 | R!1 NE 0 DO STOP(8)
    OLD := H!0
    Q!0 := H!0
    Q!1 := 0
    IF QSAMSVC(4,Q,R) NE 0 DO STOP(8)
    Q!0 := "Q00"
    Q!1 := 1
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    IF R!1 = H!0 DO STOP(8)
    H!0 := R!1
    Q!0 := OLD
    Q!1 := 0
    IF QSAMSVC(4,Q,R) NE -7 DO STOP(8)
    Q!0 := H!15
    Q!1 := 0
    IF QSAMSVC(5,Q,R) NE 0 DO STOP(8)
    IF R!4 NE 1 | R!5 NE 1024 DO STOP(8)
    IF R!6 NE 1024 | R!7 NE 1024 DO STOP(8)
    // Q.2: input handle rejects absent buffer and WRITE direction.
    IF QSAMSVC(2,Q,R) NE -3 DO STOP(8)
    IF QSAMSVC(3,Q,R) NE -8 DO STOP(8)
    WRITES("BCPLQSAM Q1 16 FINISH PASS")
    NEWLINE()
    FINISH
$)1
