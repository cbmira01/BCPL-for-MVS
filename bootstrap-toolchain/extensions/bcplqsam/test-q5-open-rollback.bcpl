// Q.5 test-only: one injected stage refusal AFTER real Q01 QSAM OPEN.
// Q00 remains live; recovery must CLOSE Q01 and allow a fresh OPEN.
// Failure STOP(12) is distinct from intended normal FINISH RC=0.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          QSAMSVC:200 $)
LET START() BE
$(1
    LET Q = VEC 3
    LET R = VEC 7
    LET H0 = 0
    LET H1 = 0
    Q!1 := 1
    Q!2 := 0
    Q!3 := 0
    Q!0 := "Q00"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(12)
    H0 := R!1
    IF H0 < 1 DO STOP(12)
    Q!0 := "Q01"
    IF QSAMSVC(1,Q,R) NE -11 DO STOP(12)
    IF R!0 NE -11 | R!1 NE 0 DO STOP(12)
    Q!0 := H0
    Q!1 := 0
    IF QSAMSVC(5,Q,R) NE 0 DO STOP(12)
    IF R!4 NE 1 | R!5 NE 1024 DO STOP(12)
    IF R!6 NE 1024 | R!7 NE 1024 DO STOP(12)
    Q!0 := "Q01"
    Q!1 := 1
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(12)
    H1 := R!1
    IF H1 < 1 | H1 = H0 DO STOP(12)
    Q!0 := H1
    Q!1 := 0
    IF QSAMSVC(5,Q,R) NE 0 DO STOP(12)
    IF R!4 NE 1 | R!5 NE 1024 DO STOP(12)
    IF R!6 NE 1024 | R!7 NE 1024 DO STOP(12)
    Q!0 := H1
    IF QSAMSVC(4,Q,R) NE 0 DO STOP(12)
    Q!0 := H0
    IF QSAMSVC(5,Q,R) NE 0 DO STOP(12)
    IF QSAMSVC(4,Q,R) NE 0 DO STOP(12)
    WRITES("BCPLQSAM Q5 OPEN ROLLBACK PASS")
    NEWLINE()
$)1
