// A5-GLOBAL.BCPL
// Native acceptance: ordinary GLOBAL load/store plus result mailbox.

GLOBAL $( START:1; NATIVECOUNTER:399; NATIVERESULT:400 $)

LET START() BE
$( NATIVECOUNTER := 17
   NATIVERESULT := NATIVECOUNTER
   NATIVECOUNTER := NATIVECOUNTER+1
   NATIVERESULT := NATIVERESULT*100 + NATIVECOUNTER
   FINISH
$)
