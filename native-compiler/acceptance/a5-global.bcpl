// A5-GLOBAL.BCPL
// Native acceptance: ordinary GLOBAL load/store plus result mailbox.

GLOBAL $( START:1; NATIVE_COUNTER:399; NATIVE_RESULT:400 $)

LET START() BE
$( NATIVE_COUNTER := 17
   NATIVE_RESULT := NATIVE_COUNTER
   NATIVE_COUNTER := NATIVE_COUNTER+1
   NATIVE_RESULT := NATIVE_RESULT*100 + NATIVE_COUNTER
   FINISH
$)
