//* D5LINK - M2.0 GATE D INTEGRATED LINK-MAP PROBE.
//* INCLUDES DEVOBJ(BCPLM5) + BCPLIO + OTHER RUNTIME MEMBERS.
//* NEVER REFERENCES PRODUCTION HERC02.BCPL.OBJ.
//* NO GO STEP. LINK-ONLY EVIDENCE; NO RUNTIME ACCEPTANCE.
//LKED     EXEC PGM=IEWL,PARM='LIST,XREF,MAP,LET,NCAL'
//SYSPRINT DD SYSOUT=*
//SYSLMOD  DD DSN=&&D5LM(D5LINK),UNIT=SYSDA,
//             SPACE=(1024,(40,20,1)),DISP=(NEW,PASS)
//OBJ      DD DSN=HERC02.BCPL.DEVOBJ,DISP=SHR
//SYSLIN   DD *
 INCLUDE OBJ(BCPLM5)
 INCLUDE OBJ(BCPLIO)
 INCLUDE OBJ(BCPLMEM)
 INCLUDE OBJ(BCPLBYTE)
 INCLUDE OBJ(BCPLAPT)
 INCLUDE OBJ(BLIB)
 ENTRY BCPLMAIN
 NAME D5LINK(R)
/*
