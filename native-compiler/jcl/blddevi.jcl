//* BLDDEVI - M2.0 D1 INDEPENDENT BCPLIO DEVOBJ BUILD.
//* SOURCE: HERC02.BCPL.NATIVE.ASM(BCPLIO)
//* TARGET: HERC02.BCPL.NATIVE.DEVOBJ(BCPLIO) ONLY.
//* DOES NOT REBUILD BCPLMAIN OR MODIFY PRODUCTION OBJ.
//ASMIO    EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&IOOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.NATIVE.ASM(BCPLIO),DISP=SHR
//*
//PUTIO    EXEC PGM=IEBGENER,COND=(0,NE,ASMIO)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&IOOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.NATIVE.DEVOBJ(BCPLIO),DISP=SHR
//
