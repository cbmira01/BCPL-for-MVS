//* BLIBBLD JOB BODY -- DSPAL SUBMIT JCL BLIBBLD --WAIT
//* SOURCE: HERC02.BCPL.SOURCE(BLIB), DEMOTED HISTORICAL BCPL
//* OUTPUT: HERC02.BCPL.OBJ(BLIB), BINARY RELOCATABLE OBJECT
//* RESIDENT CAMBRIDGE -> CG370 -> CARD FIX -> IFOX -> IEBGENER
//* NO HOST-PREPARED ASM, NO APPLICATION LINK-EDIT, NO GO STEP.
//* STAGE 1: RESIDENT CAMBRIDGE GENERATES SYSTEM/370 SOURCE.
//COMP     EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD DSN=HERC02.BCPL.LOAD,DISP=SHR
//SYSPRINT DD SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD DSN=HERC02.BCPL.INTCODE(CAMBCOMP),DISP=SHR
//SYSIN    DD DSN=HERC02.BCPL.SOURCE(BLIB),DISP=SHR
//OPTIONS  DD DSN=HERC02.BCPL.SOURCE(OPTIONS),DISP=SHR
//CAMBPARM DD DSN=HERC02.BCPL.SOURCE(CAMBPARM),DISP=SHR
//LIBHDR   DD DSN=HERC02.BCPL.SOURCE(LIBHDR),DISP=SHR
//SYNHDR   DD DSN=HERC02.BCPL.SOURCE(SYNHDR),DISP=SHR
//TRNHDR   DD DSN=HERC02.BCPL.SOURCE(TRNHDR),DISP=SHR
//CGHDR    DD DSN=HERC02.BCPL.SOURCE(CGHDR),DISP=SHR
//CODE     DD DSN=&&CODE,UNIT=SYSDA,SPACE=(80,(1000,500)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//            DISP=(NEW,PASS)
//SYSGO    DD DUMMY
//SYSUDUMP DD DUMMY
//*
//* STAGE 2: BUILD TEMPORARY FB80 CG370 CARD-FIX PROGRAM.
//* THIS PRESERVES HISTORICAL SOURCE AND THE RESIDENT COMPILER.
//PREPASM  EXEC PGM=IFOX00,REGION=256K,COND=(0,NE,COMP),
//             PARM='OBJECT,NODECK,LIST,NOXREF'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&PREPOBJ,UNIT=SYSDA,SPACE=(80,(40,10)),
//             DISP=(NEW,PASS),DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD *
BLIBPREP CSECT
         STM   14,12,12(13)
         LR    12,15
         USING BLIBPREP,12
         LA    3,SAVEAREA
         ST    13,4(3)
         ST    3,8(13)
         LR    13,3
         OPEN  (INDCB,(INPUT))
         OPEN  (OUTDCB,(OUTPUT))
READLOOP GET   INDCB,CARD
         CLC   CARD(80),SECT1
         BE    FIXSECT
         CLC   CARD(80),SECT9
         BE    FIXSECT
         CLC   CARD(80),BAD1
         BE    FIXMIN
         CLC   CARD(80),BAD9
         BE    FIXMIN
         B     WRREC
FIXSECT  L     2,SECTCNT
         LA    2,1(2)
         ST    2,SECTCNT
         MVC   CARD(80),NEWSECT
         B     WRREC
FIXMIN   L     2,MINCNT
         LA    2,1(2)
         ST    2,MINCNT
         MVC   CARD(80),NEWMIN
WRREC    PUT   OUTDCB,CARD
         B     READLOOP
EOF      CLOSE (INDCB)
         CLOSE (OUTDCB)
         L     2,SECTCNT
         C     2,=F'1'
         BNE   BADEND
         L     2,MINCNT
         C     2,=F'1'
         BNE   BADEND
         L     13,4(13)
         LM    14,12,12(13)
         SR    15,15
         BR    14
BADEND   L     13,4(13)
         LM    14,12,12(13)
         LA    15,8
         BR    14
         DS    0F
SAVEAREA DS    18F
SECTCNT  DC    F'0'
MINCNT   DC    F'0'
CARD     DS    CL80
SECT1    DC    CL80' CSECT'
SECT9    DC    CL80'         CSECT'
BAD1     DC    CL80' DC F''-./,),(-*,('''
BAD9     DC    CL80'         DC F''-./,),(-*,('''
NEWSECT  DC    CL80'BLIB     CSECT'
NEWMIN   DC    CL80'         DC X''80000000'''
INDCB    DCB   DDNAME=RAW,DSORG=PS,MACRF=GM,EODAD=EOF
OUTDCB   DCB   DDNAME=READY,DSORG=PS,MACRF=PM
         LTORG
         END   BLIBPREP
/*
//PREPLK   EXEC PGM=IEWL,PARM='LET,NCAL',REGION=256K,
//             COND=(0,NE,PREPASM)
//SYSLIN   DD DSN=&&PREPOBJ,DISP=(OLD,DELETE)
//         DD *
 ENTRY BLIBPREP
 NAME BLIBPREP(R)
/*
//SYSLMOD  DD DSN=&&PREPLD(BLIBPREP),UNIT=SYSDA,
//             SPACE=(1024,(20,10,1)),DISP=(NEW,PASS)
//SYSUT1   DD UNIT=SYSDA,SPACE=(1024,(20,10))
//SYSPRINT DD SYSOUT=*
//*
//* STAGE 3: REPAIR TWO EXACT CG370 CARDS; REQUIRE ONE EACH.
//FIXASM   EXEC PGM=*.PREPLK.SYSLMOD,REGION=256K,
//             COND=((0,NE,COMP),(0,NE,PREPASM),(0,NE,PREPLK))
//RAW      DD DSN=&&CODE,DISP=(OLD,DELETE)
//READY    DD DSN=&&BLIBASM,UNIT=SYSDA,SPACE=(80,(1000,500)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//            DISP=(NEW,PASS)
//*
//* STAGE 4: ASSEMBLE PREPARED, NAMED BLIB AS A SEPARATE CSECT.
//ASMBLIB  EXEC PGM=IFOX00,REGION=256K,COND=(0,NE,FIXASM),
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&BLIBOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=&&BLIBASM,DISP=(OLD,DELETE)
//*
//* STAGE 5: INSTALL ONLY AFTER ZERO-CODE IFOX ASSEMBLY.
//INSTALL  EXEC PGM=IEBGENER,COND=(0,NE,ASMBLIB)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&BLIBOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.OBJ(BLIB),DISP=SHR
//
