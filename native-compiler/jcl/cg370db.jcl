//D04CMP  EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(SYNI),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(TRNILRG),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=HERC02.BCPL.NATIVE.SOURCE(CGDD),DISP=SHR
//OPTIONS  DD  DSN=HERC02.BCPL.NATIVE.SOURCE(OPTIONS),DISP=SHR
//LIBHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(LIBHDR),DISP=SHR
//SYNHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(SYNHDR),DISP=SHR
//TRNHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(TRNHDR),DISP=SHR
//CGHDR    DD  DSN=HERC02.BCPL.NATIVE.SOURCE(CGHDR),DISP=SHR
//OCODE    DD  DSN=&&OD04,UNIT=SYSDA,SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  DUMMY
//*
//D04CG   EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(CGI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=&&OD04,DISP=(OLD,DELETE)
//INTCODE  DD  DSN=HERC02.BCPL.NATIVE.INTCODE(CGDD),DISP=SHR
//SYSUDUMP DD  DUMMY
//*
//* CGED -> HERC02.BCPL.NATIVE.INTCODE(CGED)
//D05CMP  EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(SYNI),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(TRNILRG),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=HERC02.BCPL.NATIVE.SOURCE(CGED),DISP=SHR
//OPTIONS  DD  DSN=HERC02.BCPL.NATIVE.SOURCE(OPTIONS),DISP=SHR
//LIBHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(LIBHDR),DISP=SHR
//SYNHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(SYNHDR),DISP=SHR
//TRNHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(TRNHDR),DISP=SHR
//CGHDR    DD  DSN=HERC02.BCPL.NATIVE.SOURCE(CGHDR),DISP=SHR
//OCODE    DD  DSN=&&OD05,UNIT=SYSDA,SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  DUMMY
//*
//D05CG   EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(CGI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=&&OD05,DISP=(OLD,DELETE)
//INTCODE  DD  DSN=HERC02.BCPL.NATIVE.INTCODE(CGED),DISP=SHR
//SYSUDUMP DD  DUMMY
//*
//* PACK BASELINE FRONT END + DIAGNOSTIC CG INTO CG370D
//PACKDIAG EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT2   DD  DSN=HERC02.BCPL.NATIVE.INTCODE(CG370D),DISP=SHR
//SYSUT1   DD  DSN=HERC02.BCPL.NATIVE.INTCODE(BCPL),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(SYN),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(LEX),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(TRNA),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(TRNB),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(CGAD),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(CGBD),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(CGCD),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(CGDD),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(CGED),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(BOOTHOST),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
