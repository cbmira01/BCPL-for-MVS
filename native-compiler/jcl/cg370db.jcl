//* CG370DB JOB BODY - BUILD DIAGNOSTIC CAMBRIDGE CG370 IMAGE
//* SUBMIT WITH: TOOLS/DATASETS/DSPAL SUBMIT NATIVE_JCL CG370DB
//*
//* PREREQUISITES:
//*   MR10_JCL(IC19BLD) AND NATIVE_JCL(CAMBBLD) HAVE RUN.
//*   STAGE DEMOTED-DIAG CGAD/CGBD/CGCD/CGDD/CGED IN NATIVE_SOURCE.
//*
//* THIS JOB DOES NOT REPLACE CAMBCOMP OR CGA-CGE.
//* IT COMPILES THE FIVE DIAGNOSTIC CG UNITS SEPARATELY, THEN PACKS
//* A COMPLETE ICINT-RUNNABLE COMPILER IMAGE AS INTCODE(CG370D).
//*
//* CGAD -> HERC02.BCPL.NATIVE.INTCODE(CGAD)
//D01CMP  EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(SYNI),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(TRNILRG),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=HERC02.BCPL.NATIVE.SOURCE(CGAD),DISP=SHR
//OPTIONS  DD  DSN=HERC02.BCPL.NATIVE.SOURCE(OPTIONS),DISP=SHR
//LIBHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(LIBHDR),DISP=SHR
//SYNHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(SYNHDR),DISP=SHR
//TRNHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(TRNHDR),DISP=SHR
//CGHDR    DD  DSN=HERC02.BCPL.NATIVE.SOURCE(CGHDR),DISP=SHR
//OCODE    DD  DSN=&&OD01,UNIT=SYSDA,SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  DUMMY
//*
//D01CG   EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(CGI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=&&OD01,DISP=(OLD,DELETE)
//INTCODE  DD  DSN=HERC02.BCPL.NATIVE.INTCODE(CGAD),DISP=SHR
//SYSUDUMP DD  DUMMY
//*
//* CGBD -> HERC02.BCPL.NATIVE.INTCODE(CGBD)
//D02CMP  EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(SYNI),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(TRNILRG),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=HERC02.BCPL.NATIVE.SOURCE(CGBD),DISP=SHR
//OPTIONS  DD  DSN=HERC02.BCPL.NATIVE.SOURCE(OPTIONS),DISP=SHR
//LIBHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(LIBHDR),DISP=SHR
//SYNHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(SYNHDR),DISP=SHR
//TRNHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(TRNHDR),DISP=SHR
//CGHDR    DD  DSN=HERC02.BCPL.NATIVE.SOURCE(CGHDR),DISP=SHR
//OCODE    DD  DSN=&&OD02,UNIT=SYSDA,SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  DUMMY
//*
//D02CG   EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(CGI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=&&OD02,DISP=(OLD,DELETE)
//INTCODE  DD  DSN=HERC02.BCPL.NATIVE.INTCODE(CGBD),DISP=SHR
//SYSUDUMP DD  DUMMY
//*
//* CGCD -> HERC02.BCPL.NATIVE.INTCODE(CGCD)
//D03CMP  EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(SYNI),DISP=SHR
//         DD  DSN=HERC02.BCPL.NATIVE.INTCODE(TRNILRG),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=HERC02.BCPL.NATIVE.SOURCE(CGCD),DISP=SHR
//OPTIONS  DD  DSN=HERC02.BCPL.NATIVE.SOURCE(OPTIONS),DISP=SHR
//LIBHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(LIBHDR),DISP=SHR
//SYNHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(SYNHDR),DISP=SHR
//TRNHDR   DD  DSN=HERC02.BCPL.NATIVE.SOURCE(TRNHDR),DISP=SHR
//CGHDR    DD  DSN=HERC02.BCPL.NATIVE.SOURCE(CGHDR),DISP=SHR
//OCODE    DD  DSN=&&OD03,UNIT=SYSDA,SPACE=(80,(1000,500)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),
//             DISP=(NEW,PASS)
//SYSUDUMP DD  DUMMY
//*
//D03CG   EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.MR10KIT.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(CGI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.MR10KIT.SOURCE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=&&OD03,DISP=(OLD,DELETE)
//INTCODE  DD  DSN=HERC02.BCPL.NATIVE.INTCODE(CGCD),DISP=SHR
//SYSUDUMP DD  DUMMY
