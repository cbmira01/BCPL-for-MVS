//* IO2DPRB - M1 SECONDARY QSAM POINTER SNAPSHOT.
//* BEFORE SUBMIT: STAGE ASM(IO2DPRB), REBUILD DEVOBJ(BCPLIO).
//* NO PROD OBJ WRITES. SOURCE PDS IS NATIVE.ASM.
//ASMDP  EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(300,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,100))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,100))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&PROBOBJ,UNIT=SYSDA,
//             SPACE=(80,(80,40)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.NATIVE.ASM(IO2DPRB),DISP=SHR
//*
//LKED     EXEC PGM=IEWL,COND=(0,NE,ASMDP),
//             PARM='LIST,XREF,MAP'
//SYSPRINT DD SYSOUT=*
//SYSLMOD  DD DSN=&&DPMOD(IO2DPRB),UNIT=SYSDA,
//             SPACE=(1024,(20,10,1)),DISP=(NEW,PASS)
//SYSLIN   DD DSN=&&PROBOBJ,DISP=(OLD,DELETE)
//         DD *
 INCLUDE OBJ(BCPLIO)
 ENTRY IO2DPRB
 NAME IO2DPRB(R)
/*
//OBJ      DD DSN=HERC02.BCPL.NATIVE.DEVOBJ,DISP=SHR
//*
//GO       EXEC PGM=*.LKED.SYSLMOD,COND=(0,NE,LKED)
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//BCPALT   DD SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//
