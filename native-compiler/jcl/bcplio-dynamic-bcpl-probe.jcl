//* DQBPRB M1 BCPL-facing ABI dynamic dual stream regression.
//* Uses ONLY DEVOBJ(BCPLIO), no production OBJ writes.
//ASMDQ    EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(300,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,100))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,100))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&DQOBJ,UNIT=SYSDA,
//             SPACE=(80,(100,40)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.NATIVE.ASM(DQBPRB),DISP=SHR
//LKED     EXEC PGM=IEWL,COND=(0,NE,ASMDQ),PARM='LIST,XREF,MAP'
//SYSPRINT DD SYSOUT=*
//SYSLMOD  DD DSN=&&DQMOD(DQBPRB),UNIT=SYSDA,
//             SPACE=(1024,(20,10,1)),DISP=(NEW,PASS)
//SYSLIN   DD DSN=&&DQOBJ,DISP=(OLD,DELETE)
//         DD *
 INCLUDE OBJ(BCPLIO)
 ENTRY DQBPRB
 NAME DQBPRB(R)
/*
//OBJ      DD DSN=HERC02.BCPL.NATIVE.DEVOBJ,DISP=SHR
//GO       EXEC PGM=*.LKED.SYSLMOD,COND=(0,NE,LKED)
//SYSPRINT DD SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//REPORT   DD SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//REPORT2  DD SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//SYSUDUMP DD SYSOUT=*
//
