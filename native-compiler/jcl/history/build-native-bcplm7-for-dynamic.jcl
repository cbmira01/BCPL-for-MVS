//* BLDD7MN -- REBUILD D7 FROM CANONICAL REPOSITORY SOURCE.
//* SOURCE: HERC02.BCPL.NATIVE.ASM(BCPLM7)
//* TARGET: HERC02.BCPL.NATIVE.DEVOBJ(BCPLM7) ONLY.
//* D6 DEVOBJ(BCPLM6) AND PRODUCTION OBJ ARE UNCHANGED.
//ASMMMAIN EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&MAINOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.NATIVE.ASM(BCPLM7),DISP=SHR
//*
//PUTMAIN  EXEC PGM=IEBGENER,COND=(0,NE,ASMMMAIN)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&MAINOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.NATIVE.DEVOBJ(BCPLM7),DISP=SHR
