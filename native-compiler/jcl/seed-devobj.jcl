//* SEEDDEV -- INITIAL BINARY COPY OF FIVE ACCEPTED RUNTIME MEMBERS.
//* RUN ONLY ONCE AFTER CONFIRMING DEVOBJ IS EMPTY.
//* SOURCE PRODUCTION OBJ IS READ ONLY; TARGET IS DEVOBJ.
//* COPY IS BINARY AND MVS-NATIVE; NO DSPAL TEXT PUT.
//COPYOBJ  EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=HERC02.BCPL.OBJ,DISP=SHR
//SYSUT2   DD DSN=HERC02.BCPL.DEVOBJ,DISP=OLD
//SYSUT3   DD UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSUT4   DD UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSIN    DD *
 COPY OUTDD=SYSUT2,INDD=SYSUT1
 SELECT MEMBER=(BCPLMAIN,BCPLMEM,BCPLBYTE,BCPLAPT,BLIB)
/*
//
