GET "LIBHDR"

|| Bootstrap host-compatibility shims for running the Cambridge compiler
|| resident under the reconstructed MR10/ICINT environment.
||
|| Keep this file deliberately small and evidence-driven.  Add only host
|| services that the resident compiler actually reaches and that are absent
|| from the current MR10 runtime.

GLOBAL $( DATE:29; WRAPOUTPUT:33; FINDPARM:39 $)

STATIC $( WRAPPING = TRUE $)

LET WRAPOUTPUT(NEWSTATE) = VALOF
$(  LET OLDSTATE = WRAPPING
    WRAPPING := NEWSTATE
    RESULTIS OLDSTATE
$)

|| The historical compiler expects FINDPARM() to return an input stream
|| containing its invocation options.  Under the bootstrap harness, keep that
|| stream distinct from the MR10 compiler's OPTIONS DD: CAMBPARM belongs to the
|| resident Cambridge compiler only.
LET FINDPARM() = FINDINPUT("CAMBPARM")


|| CG370 calls DATE() while constructing the standard object-module header.
|| Historical DATEMOD describes that field as an 11-character BCPL string and
|| recognizes "  *UNDATED*" as the canonical placeholder.  The MR10 bootstrap
|| compiler cannot accept an 11-character string literal, so return the exact
|| three packed EBCDIC words through a TABLE expression instead.
|| Native BCPLMAIN will eventually provide the real MVS DATE service.
LET DATE() = TABLE #X0B40405C, #XE4D5C4C1, #XE3C5C45C
