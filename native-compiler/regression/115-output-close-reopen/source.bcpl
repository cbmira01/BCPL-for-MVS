GLOBAL $( START:1; SELECTOUTPUT:12; WRCH:14
 OUTPUT:17; FINDOUTPUT:41; ENDWRITE:47 $)
LET START() BE
$(1
 LET D=FINDOUTPUT("SYSPRINT")
 LET S=FINDOUTPUT("BCPALT")
 SELECTOUTPUT(S)
 WRCH('A')
 ENDWRITE()
 TEST OUTPUT()=D THEN WRCH('Y') ELSE WRCH('?')
 SELECTOUTPUT(S)
 TEST OUTPUT()=D THEN WRCH('C') ELSE WRCH('?')
 LET T=FINDOUTPUT("BCPALT")
 SELECTOUTPUT(T)
 WRCH('B')
 SELECTOUTPUT(D)
 WRCH('Z')
 FINISH
$)1
