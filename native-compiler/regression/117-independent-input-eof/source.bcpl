GLOBAL $( START:1; SELECTINPUT:11; SELECTOUTPUT:12
 RDCH:13; WRCH:14; UNRDCH:15; FINDOUTPUT:41
 FINDINPUT:42; ENDREAD:46; ENDWRITE:47 $)
LET START() BE
$(1
 LET A=FINDINPUT("BCPIN")
 LET B=FINDINPUT("BCPINB")
 SELECTINPUT(A)
 TEST RDCH()='A' THEN WRCH('A') ELSE WRCH('?')
 RDCH()
 TEST RDCH()=-1 THEN WRCH('E') ELSE WRCH('?')
 UNRDCH()
 SELECTINPUT(B)
 TEST RDCH()='B' THEN WRCH('B') ELSE WRCH('?')
 SELECTINPUT(A)
 TEST RDCH()=-1 THEN WRCH('E') ELSE WRCH('?')
 FINISH
$)1
