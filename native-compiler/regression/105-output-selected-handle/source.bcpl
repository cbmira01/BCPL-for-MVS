GLOBAL $( START:1; SELECTOUTPUT:12; WRCH:14
 OUTPUT:17; FINDOUTPUT:41 $)
LET START() BE
$(1
 LET D = FINDOUTPUT("SYSPRINT")
 LET S = FINDOUTPUT("BCPALT")
 IF D=0 | S=0 DO FINISH
 TEST OUTPUT()=D THEN WRCH('D') ELSE WRCH('?')
 SELECTOUTPUT(S)
 IF OUTPUT()=S DO WRCH('A')
 SELECTOUTPUT(D)
 TEST OUTPUT()=D THEN WRCH('S') ELSE WRCH('?')
 FINISH
$)1
