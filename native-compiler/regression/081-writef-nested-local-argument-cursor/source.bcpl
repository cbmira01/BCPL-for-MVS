GLOBAL $( START:1; WRITEN:62; WRCH:14 $)

LET CHECK(FORMAT, A, B, C, D, E, F, G, H, I, J, K) BE
$(1
    LET T = @A
    FOR P = 1 TO 3 DO
    $(2
        LET CH = P
        $(3
            LET FUN, ARG, N = 0, T!0, 0
            $(4 LET TYPE = CH
                WRITEN(ARG)
                IF TYPE < 3 DO WRCH(' ')
            $)4
            T := T + 1
        $)3
    $)2
$)1

LET START() BE
$(1
    CHECK(0, 11, 22, 33)
    FINISH
$)1
