GLOBAL $( START:1; SELECTINPUT:11; SELECTOUTPUT:12
 RDCH:13; WRCH:14; UNRDCH:15; FINDOUTPUT:41
 FINDINPUT:42; ENDREAD:46; ENDWRITE:47 $)
LET START() BE
$(1
 LET I=FINDINPUT("NOFILE")
 LET O=FINDOUTPUT("NOFILE")
 TEST I=0 THEN WRCH('I') ELSE WRCH('?')
 TEST O=0 THEN WRCH('O') ELSE WRCH('?')
 FINISH
$)1
