GLOBAL $( START:1; SELECTINPUT:11; SELECTOUTPUT:12
 RDCH:13; WRCH:14; INPUT:16; OUTPUT:17
 FINDOUTPUT:41; FINDINPUT:42 $)
LET START() BE
$(1
 LET D=FINDOUTPUT("SYSPRINT")
 LET A=FINDINPUT("BCPIN")
 LET I=0
 LET O=0
 SELECTINPUT(A)
 I := FINDINPUT("NOFILE")
 O := FINDOUTPUT("NOFILE")
 TEST I=0 THEN WRCH('I') ELSE WRCH('?')
 TEST O=0 THEN WRCH('O') ELSE WRCH('?')
 TEST INPUT()=A THEN WRCH('A') ELSE WRCH('?')
 TEST OUTPUT()=D THEN WRCH('D') ELSE WRCH('?')
 FINISH
$)1
