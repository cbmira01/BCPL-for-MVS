// M1 contract: duplicate FIND on live DD returns same stream handle.
GLOBAL $( START:1; SELECTINPUT:11; SELECTOUTPUT:12; RDCH:13;
          WRCH:14; INPUT:16; OUTPUT:17; STOP:30;
          FINDOUTPUT:41; FINDINPUT:42; ENDREAD:46;
          ENDWRITE:47; WRITES:60 $)

LET START() BE
$(1
    LET A = FINDINPUT("DD01")
    LET B = FINDINPUT("dd01")
    IF A=0 DO STOP(8)
    IF B NE A DO STOP(8)

    SELECTINPUT(A)
    IF INPUT() NE A DO STOP(8)
    IF RDCH() NE 'A' DO STOP(8)

    SELECTINPUT(B)
    IF INPUT() NE A DO STOP(8)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'B' DO STOP(8)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)

    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(B)
    IF INPUT() NE 0 DO STOP(8)

    LET PRIMARY = OUTPUT()
    LET X = FINDOUTPUT("REPORT")
    LET Y = FINDOUTPUT("report")
    IF X=0 DO STOP(8)
    IF Y NE X DO STOP(8)

    SELECTOUTPUT(X)
    IF OUTPUT() NE X DO STOP(8)
    WRITES("BCPL DUP REPORT")
    WRCH(10)

    SELECTOUTPUT(Y)
    IF OUTPUT() NE X DO STOP(8)
    ENDWRITE()
    IF OUTPUT() NE PRIMARY DO STOP(8)
    SELECTOUTPUT(Y)
    IF OUTPUT() NE PRIMARY DO STOP(8)

    WRITES("BCPL DUPLICATE OK")
    WRCH(10)
    FINISH
$)1
