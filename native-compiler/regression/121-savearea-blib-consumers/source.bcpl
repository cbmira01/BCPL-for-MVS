GLOBAL $( START:1; SAVEAREA:6; WRCH:14; FINISH:30
          ; INPROGRAM:58; VALIDPOINTER:59 $)

LET START() BE
$(1
    LET OK = TRUE
    IF SAVEAREA=0 DO OK := FALSE
    IF SAVEAREA~=0 DO
    $(2
       IF SAVEAREA!29 ~= 0 DO OK := FALSE
       IF SAVEAREA!48 ~= 0 DO OK := FALSE
    $)2
    IF INPROGRAM(0) DO OK := FALSE
    IF VALIDPOINTER(0) DO OK := FALSE
    TEST OK THEN WRCH('G') ELSE WRCH('?')
    FINISH
$)1
