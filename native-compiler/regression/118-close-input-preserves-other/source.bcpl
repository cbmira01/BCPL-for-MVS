GLOBAL $( START:1; SELECTINPUT:11; SELECTOUTPUT:12; RDCH:13; WRCH:14; UNRDCH:15; FINDOUTPUT:41; FINDINPUT:42; ENDREAD:46; ENDWRITE:47 $)
LET START() BE
$(1
 LET A=FINDINPUT("BCPIN")
  LET B=FINDINPUT("BCPINB")
  SELECTINPUT(B)
  TEST RDCH()='1' THEN WRCH('1') ELSE WRCH('?')
  SELECTINPUT(A)
  TEST RDCH()='A' THEN WRCH('A') ELSE WRCH('?')
  ENDREAD()
  SELECTINPUT(B)
  TEST RDCH()='2' THEN WRCH('2') ELSE WRCH('?')
  LET T=FINDINPUT("BCPIN")
  SELECTINPUT(T)
  TEST RDCH()='A' THEN WRCH('A') ELSE WRCH('?')
 FINISH
$)1
