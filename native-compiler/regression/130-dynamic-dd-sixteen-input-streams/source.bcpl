// M2: 16 simultaneously open dynamic DD input streams.
// Exceeds the interpreter's already tested twelve-stream example.
GLOBAL $( START:1; SELECTINPUT:11; RDCH:13; WRCH:14;
          UNRDCH:15; INPUT:16; STOP:30; FINDINPUT:42;
          ENDREAD:46; WRITES:60 $)

LET START() BE
$(1
    LET S = VEC 15

    // All sixteen streams must be live together, not opened serially.
    S!0 := FINDINPUT("DD01")
    S!1 := FINDINPUT("DD02")
    S!2 := FINDINPUT("DD03")
    S!3 := FINDINPUT("DD04")
    S!4 := FINDINPUT("DD05")
    S!5 := FINDINPUT("DD06")
    S!6 := FINDINPUT("DD07")
    S!7 := FINDINPUT("DD08")
    S!8 := FINDINPUT("DD09")
    S!9 := FINDINPUT("DD10")
    S!10 := FINDINPUT("DD11")
    S!11 := FINDINPUT("DD12")
    S!12 := FINDINPUT("DD13")
    S!13 := FINDINPUT("DD14")
    S!14 := FINDINPUT("DD15")
    S!15 := FINDINPUT("DD16")

    // Each live descriptor has a nonzero, unique opaque identity.
    IF S!0=0 DO STOP(8)
    IF S!1=0 DO STOP(8)
    IF S!2=0 DO STOP(8)
    IF S!3=0 DO STOP(8)
    IF S!4=0 DO STOP(8)
    IF S!5=0 DO STOP(8)
    IF S!6=0 DO STOP(8)
    IF S!7=0 DO STOP(8)
    IF S!8=0 DO STOP(8)
    IF S!9=0 DO STOP(8)
    IF S!10=0 DO STOP(8)
    IF S!11=0 DO STOP(8)
    IF S!12=0 DO STOP(8)
    IF S!13=0 DO STOP(8)
    IF S!14=0 DO STOP(8)
    IF S!15=0 DO STOP(8)
    IF S!0=S!1 DO STOP(8)
    IF S!0=S!2 DO STOP(8)
    IF S!0=S!3 DO STOP(8)
    IF S!0=S!4 DO STOP(8)
    IF S!0=S!5 DO STOP(8)
    IF S!0=S!6 DO STOP(8)
    IF S!0=S!7 DO STOP(8)
    IF S!0=S!8 DO STOP(8)
    IF S!0=S!9 DO STOP(8)
    IF S!0=S!10 DO STOP(8)
    IF S!0=S!11 DO STOP(8)
    IF S!0=S!12 DO STOP(8)
    IF S!0=S!13 DO STOP(8)
    IF S!0=S!14 DO STOP(8)
    IF S!0=S!15 DO STOP(8)
    IF S!1=S!2 DO STOP(8)
    IF S!1=S!3 DO STOP(8)
    IF S!1=S!4 DO STOP(8)
    IF S!1=S!5 DO STOP(8)
    IF S!1=S!6 DO STOP(8)
    IF S!1=S!7 DO STOP(8)
    IF S!1=S!8 DO STOP(8)
    IF S!1=S!9 DO STOP(8)
    IF S!1=S!10 DO STOP(8)
    IF S!1=S!11 DO STOP(8)
    IF S!1=S!12 DO STOP(8)
    IF S!1=S!13 DO STOP(8)
    IF S!1=S!14 DO STOP(8)
    IF S!1=S!15 DO STOP(8)
    IF S!2=S!3 DO STOP(8)
    IF S!2=S!4 DO STOP(8)
    IF S!2=S!5 DO STOP(8)
    IF S!2=S!6 DO STOP(8)
    IF S!2=S!7 DO STOP(8)
    IF S!2=S!8 DO STOP(8)
    IF S!2=S!9 DO STOP(8)
    IF S!2=S!10 DO STOP(8)
    IF S!2=S!11 DO STOP(8)
    IF S!2=S!12 DO STOP(8)
    IF S!2=S!13 DO STOP(8)
    IF S!2=S!14 DO STOP(8)
    IF S!2=S!15 DO STOP(8)
    IF S!3=S!4 DO STOP(8)
    IF S!3=S!5 DO STOP(8)
    IF S!3=S!6 DO STOP(8)
    IF S!3=S!7 DO STOP(8)
    IF S!3=S!8 DO STOP(8)
    IF S!3=S!9 DO STOP(8)
    IF S!3=S!10 DO STOP(8)
    IF S!3=S!11 DO STOP(8)
    IF S!3=S!12 DO STOP(8)
    IF S!3=S!13 DO STOP(8)
    IF S!3=S!14 DO STOP(8)
    IF S!3=S!15 DO STOP(8)
    IF S!4=S!5 DO STOP(8)
    IF S!4=S!6 DO STOP(8)
    IF S!4=S!7 DO STOP(8)
    IF S!4=S!8 DO STOP(8)
    IF S!4=S!9 DO STOP(8)
    IF S!4=S!10 DO STOP(8)
    IF S!4=S!11 DO STOP(8)
    IF S!4=S!12 DO STOP(8)
    IF S!4=S!13 DO STOP(8)
    IF S!4=S!14 DO STOP(8)
    IF S!4=S!15 DO STOP(8)
    IF S!5=S!6 DO STOP(8)
    IF S!5=S!7 DO STOP(8)
    IF S!5=S!8 DO STOP(8)
    IF S!5=S!9 DO STOP(8)
    IF S!5=S!10 DO STOP(8)
    IF S!5=S!11 DO STOP(8)
    IF S!5=S!12 DO STOP(8)
    IF S!5=S!13 DO STOP(8)
    IF S!5=S!14 DO STOP(8)
    IF S!5=S!15 DO STOP(8)
    IF S!6=S!7 DO STOP(8)
    IF S!6=S!8 DO STOP(8)
    IF S!6=S!9 DO STOP(8)
    IF S!6=S!10 DO STOP(8)
    IF S!6=S!11 DO STOP(8)
    IF S!6=S!12 DO STOP(8)
    IF S!6=S!13 DO STOP(8)
    IF S!6=S!14 DO STOP(8)
    IF S!6=S!15 DO STOP(8)
    IF S!7=S!8 DO STOP(8)
    IF S!7=S!9 DO STOP(8)
    IF S!7=S!10 DO STOP(8)
    IF S!7=S!11 DO STOP(8)
    IF S!7=S!12 DO STOP(8)
    IF S!7=S!13 DO STOP(8)
    IF S!7=S!14 DO STOP(8)
    IF S!7=S!15 DO STOP(8)
    IF S!8=S!9 DO STOP(8)
    IF S!8=S!10 DO STOP(8)
    IF S!8=S!11 DO STOP(8)
    IF S!8=S!12 DO STOP(8)
    IF S!8=S!13 DO STOP(8)
    IF S!8=S!14 DO STOP(8)
    IF S!8=S!15 DO STOP(8)
    IF S!9=S!10 DO STOP(8)
    IF S!9=S!11 DO STOP(8)
    IF S!9=S!12 DO STOP(8)
    IF S!9=S!13 DO STOP(8)
    IF S!9=S!14 DO STOP(8)
    IF S!9=S!15 DO STOP(8)
    IF S!10=S!11 DO STOP(8)
    IF S!10=S!12 DO STOP(8)
    IF S!10=S!13 DO STOP(8)
    IF S!10=S!14 DO STOP(8)
    IF S!10=S!15 DO STOP(8)
    IF S!11=S!12 DO STOP(8)
    IF S!11=S!13 DO STOP(8)
    IF S!11=S!14 DO STOP(8)
    IF S!11=S!15 DO STOP(8)
    IF S!12=S!13 DO STOP(8)
    IF S!12=S!14 DO STOP(8)
    IF S!12=S!15 DO STOP(8)
    IF S!13=S!14 DO STOP(8)
    IF S!13=S!15 DO STOP(8)
    IF S!14=S!15 DO STOP(8)

    // First record, interleaved across all sixteen DDs.
    SELECTINPUT(S!0)
    IF INPUT() NE S!0 DO STOP(8)
    IF RDCH() NE 'A' DO STOP(8)
    UNRDCH()
    IF RDCH() NE 'A' DO STOP(8)
    SELECTINPUT(S!1)
    IF INPUT() NE S!1 DO STOP(8)
    IF RDCH() NE 'B' DO STOP(8)
    SELECTINPUT(S!2)
    IF INPUT() NE S!2 DO STOP(8)
    IF RDCH() NE 'C' DO STOP(8)
    SELECTINPUT(S!3)
    IF INPUT() NE S!3 DO STOP(8)
    IF RDCH() NE 'D' DO STOP(8)
    SELECTINPUT(S!4)
    IF INPUT() NE S!4 DO STOP(8)
    IF RDCH() NE 'E' DO STOP(8)
    SELECTINPUT(S!5)
    IF INPUT() NE S!5 DO STOP(8)
    IF RDCH() NE 'F' DO STOP(8)
    SELECTINPUT(S!6)
    IF INPUT() NE S!6 DO STOP(8)
    IF RDCH() NE 'G' DO STOP(8)
    SELECTINPUT(S!7)
    IF INPUT() NE S!7 DO STOP(8)
    IF RDCH() NE 'H' DO STOP(8)
    SELECTINPUT(S!8)
    IF INPUT() NE S!8 DO STOP(8)
    IF RDCH() NE 'I' DO STOP(8)
    SELECTINPUT(S!9)
    IF INPUT() NE S!9 DO STOP(8)
    IF RDCH() NE 'J' DO STOP(8)
    SELECTINPUT(S!10)
    IF INPUT() NE S!10 DO STOP(8)
    IF RDCH() NE 'K' DO STOP(8)
    SELECTINPUT(S!11)
    IF INPUT() NE S!11 DO STOP(8)
    IF RDCH() NE 'L' DO STOP(8)
    SELECTINPUT(S!12)
    IF INPUT() NE S!12 DO STOP(8)
    IF RDCH() NE 'M' DO STOP(8)
    SELECTINPUT(S!13)
    IF INPUT() NE S!13 DO STOP(8)
    IF RDCH() NE 'N' DO STOP(8)
    SELECTINPUT(S!14)
    IF INPUT() NE S!14 DO STOP(8)
    IF RDCH() NE 'O' DO STOP(8)
    SELECTINPUT(S!15)
    IF INPUT() NE S!15 DO STOP(8)
    IF RDCH() NE 'P' DO STOP(8)

    // Independent newline and second FB80 logical record.
    SELECTINPUT(S!0)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'Q' DO STOP(8)
    SELECTINPUT(S!1)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'R' DO STOP(8)
    SELECTINPUT(S!2)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'S' DO STOP(8)
    SELECTINPUT(S!3)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'T' DO STOP(8)
    SELECTINPUT(S!4)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'U' DO STOP(8)
    SELECTINPUT(S!5)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'V' DO STOP(8)
    SELECTINPUT(S!6)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'W' DO STOP(8)
    SELECTINPUT(S!7)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'X' DO STOP(8)
    SELECTINPUT(S!8)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'Y' DO STOP(8)
    SELECTINPUT(S!9)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE 'Z' DO STOP(8)
    SELECTINPUT(S!10)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE '0' DO STOP(8)
    SELECTINPUT(S!11)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE '1' DO STOP(8)
    SELECTINPUT(S!12)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE '2' DO STOP(8)
    SELECTINPUT(S!13)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE '3' DO STOP(8)
    SELECTINPUT(S!14)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE '4' DO STOP(8)
    SELECTINPUT(S!15)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE '5' DO STOP(8)

    // Per-stream newline then repeated EOF, including unread EOF.
    SELECTINPUT(S!0)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!1)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!2)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!3)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!4)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    UNRDCH()
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!5)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!6)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!7)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!8)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!9)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!10)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!11)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!12)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!13)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!14)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    SELECTINPUT(S!15)
    IF RDCH() NE 10 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)
    IF RDCH() NE -1 DO STOP(8)

    // Reverse-close all streams; stale handles must not reselect.
    SELECTINPUT(S!15)
    IF INPUT() NE S!15 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!15)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!14)
    IF INPUT() NE S!14 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!14)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!13)
    IF INPUT() NE S!13 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!13)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!12)
    IF INPUT() NE S!12 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!12)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!11)
    IF INPUT() NE S!11 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!11)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!10)
    IF INPUT() NE S!10 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!10)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!9)
    IF INPUT() NE S!9 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!9)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!8)
    IF INPUT() NE S!8 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!8)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!7)
    IF INPUT() NE S!7 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!7)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!6)
    IF INPUT() NE S!6 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!6)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!5)
    IF INPUT() NE S!5 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!5)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!4)
    IF INPUT() NE S!4 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!4)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!3)
    IF INPUT() NE S!3 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!3)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!2)
    IF INPUT() NE S!2 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!2)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!1)
    IF INPUT() NE S!1 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!1)
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!0)
    IF INPUT() NE S!0 DO STOP(8)
    ENDREAD()
    IF INPUT() NE 0 DO STOP(8)
    SELECTINPUT(S!0)
    IF INPUT() NE 0 DO STOP(8)

    WRITES("BCPL SIXTEEN INPUT OK")
    WRCH(10)
    FINISH
$)1
