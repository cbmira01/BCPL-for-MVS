// M1 STOP(8) must flush pending named output before termination.
GLOBAL $( START:1; SELECTINPUT:11; SELECTOUTPUT:12; RDCH:13;
          WRCH:14; INPUT:16; OUTPUT:17; STOP:30;
          FINDOUTPUT:41; FINDINPUT:42; WRITES:60 $)
LET START() BE
$(1
    LET MAIN = OUTPUT()
    LET A = FINDOUTPUT("REPORT")
    LET B = FINDOUTPUT("REPORT2")
    LET I = FINDINPUT("DD01")

    IF A=0 DO STOP(12)
    IF B=0 DO STOP(12)
    IF I=0 DO STOP(12)
    IF A=B DO STOP(12)

    SELECTINPUT(I)
    IF INPUT() NE I DO STOP(12)
    IF RDCH() NE 'A' DO STOP(12)

    SELECTOUTPUT(A)
    IF OUTPUT() NE A DO STOP(12)
    WRITES("STOP REPORT PART")

    SELECTOUTPUT(B)
    IF OUTPUT() NE B DO STOP(12)
    WRITES("STOP REPORT2 PART")

    SELECTOUTPUT(MAIN)
    IF OUTPUT() NE MAIN DO STOP(12)
    WRITES("STOP MAIN OK")
    WRCH(10)

    // No ENDREAD/ENDWRITE; STOP must close outstanding streams.
    STOP(8)
$)1
