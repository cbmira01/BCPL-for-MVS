//* BLIBBLD JOB BODY: DSPAL SUBMIT JCL BLIBBLD --WAIT
//* INPUT:  HERC02.BCPL.ASM(BLIB) - PREPARED CAMBRIDGE CG370 OUTPUT
//* OUTPUT: HERC02.BCPL.OBJ(BLIB) - RELOCATABLE FB80 OBJECT
//* ASSUMES BOTH DATA SETS EXIST; DOES NOT ALLOCATE/DELETE PDS.
//* COMPILE DEMOTED BCPL TO S370 AND PREPARE CSECT ON HOST FIRST.
//* DOES NOT LINK-EDIT OR EXECUTE THE OBJECT.
//ASMBLIB  EXEC PGM=IFOX00,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD',
//             REGION=256K
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&BLIBOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.ASM(BLIB),DISP=SHR
//* INSTALL ONLY AFTER ERROR-FREE ASSEMBLY.
//INSTALL  EXEC PGM=IEBGENER,COND=(0,NE,ASMBLIB)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&BLIBOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.OBJ(BLIB),DISP=SHR
//
