//CAMBBLD  JOB (BCPL),'CAMBRIDGE BUILD',CLASS=A,MSGCLASS=A,
//             USER=HERC02,PASSWORD=XXXXXXXX,
//             MSGLEVEL=(1,1)
//*
//* REPLACE XXXXXXXX WITH THE LOCAL HERC02 PASSWORD BEFORE SUBMISSION.
//* ALL INPUT MEMBERS MUST ALREADY HAVE BEEN POSITIONED BY DSPAL.
//*
//* PHASE 1 - BUILD A READY-TO-RUN ICINT V19 LOAD MODULE
//*
//ASM      EXEC PGM=IFOX00,
//             PARM='OBJECT,NODECK,NOLIST,NOXREF',REGION=256K
//SYSLIB   DD  DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD  UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD  SYSOUT=*
//SYSPUNCH DD  DUMMY
//SYSGO    DD  DSN=&&ICOBJ,UNIT=SYSDA,SPACE=(80,(300,100)),
//             DISP=(NEW,PASS)
//SYSIN    DD  DSN=HERC02.BCPL.ASM(ICINT19),DISP=SHR
//*
//LKED     EXEC PGM=IEWL,PARM='LET,NCAL',REGION=256K,
//             COND=(4,LT,ASM)
//SYSLIN   DD  DSN=&&ICOBJ,DISP=(OLD,DELETE)
//         DD  *
  ENTRY ICINT
  NAME ICINT19(R)
/*
//SYSLMOD  DD  DSN=HERC02.BCPL.LOAD,DISP=SHR
//SYSUT1   DD  UNIT=SYSDA,SPACE=(1024,(50,20))
//SYSPRINT DD  SYSOUT=*
//*
//* PHASE 2 - COMPILE THE DEMOTED CAMBRIDGE COMPILER TO INTCODE
