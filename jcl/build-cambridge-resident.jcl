//* BCPL -> HERC02.BCPL.INTCODE(BCPL)
//C01CMP  EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.INTCODE(SYNI),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(TRNILRG),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(ICLIB),DISP=SHR
