//*
//C11CG   EXEC PGM=ICINT19,REGION=256K,TIME=(,30)
//STEPLIB  DD  DSN=HERC02.BCPL.LOAD,DISP=SHR
//SYSPRINT DD  SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//INTIN    DD  DSN=HERC02.BCPL.INTCODE(CGI),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(ICLIB),DISP=SHR
//SYSIN    DD  DSN=&&OC11,DISP=(OLD,DELETE)
//INTCODE  DD  DSN=HERC02.BCPL.INTCODE(BOOTHOST),DISP=SHR
//SYSUDUMP DD  DUMMY
//*
//* PHASE 3 - PACK THE COMPLETE ICINT-RUNNABLE CAMBRIDGE IMAGE
//*
//PACKCOMP EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT2   DD  DSN=HERC02.BCPL.INTCODE(CAMBCOMP),DISP=SHR
//SYSUT1   DD  DSN=HERC02.BCPL.INTCODE(BCPL),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(SYN),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(LEX),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(TRNA),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(TRNB),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(CGA),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(CGB),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(CGC),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(CGD),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(CGE),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(BOOTHOST),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(BLIBI),DISP=SHR
//         DD  DSN=HERC02.BCPL.INTCODE(ICLIB),DISP=SHR
//*
//* OUTPUT CHECKPOINT:
//*   HERC02.BCPL.LOAD(ICINT19)
//*   HERC02.BCPL.INTCODE(CAMBCOMP)
//*   PLUS THE INDIVIDUAL CAMBRIDGE INTCODE MEMBERS.
//
