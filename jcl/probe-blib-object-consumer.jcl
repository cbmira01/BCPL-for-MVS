//* BLIBLINK: INDEPENDENT CONSUMER OF PREBUILT OBJ(BLIB)
//* READ ONLY OBJ(BLIB). NO BLIB ASSEMBLY OR INSTALLATION.
//* BCPLMAIN-WIP IS ASSEMBLED IN THIS SEPARATE JOB.
//* IEWL RESOLVES BLIB'S EXTERNAL BCPLMAIN REFERENCE.
//* NO GO STEP; NO BCPL GLOBAL-VECTOR INITIALIZATION CLAIM.
//ASMRUN   EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&RUNOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.ASM(BCMWIP),DISP=SHR
//*
//LKED     EXEC PGM=IEWL,PARM='NCAL,LIST,XREF,MAP',
//             COND=(0,NE,ASMRUN)
//OBJ      DD DSN=HERC02.BCPL.OBJ,DISP=SHR
//SYSLIN   DD DSN=&&RUNOBJ,DISP=(OLD,DELETE)
//         DD *
 INCLUDE OBJ(BLIB)
 ENTRY BLIB
 NAME BLIBCHK(R)
/*
//SYSLMOD  DD DSN=&&GOSET(BLIBCHK),UNIT=SYSDA,
//             SPACE=(1024,(50,20,1)),DISP=(NEW,PASS)
//SYSUT1   DD UNIT=SYSDA,SPACE=(1024,(50,20))
//SYSPRINT DD SYSOUT=*
//
