//* BCIOPRB - D2.2 INDEPENDENT BCPLIO OUTPUT EXERCISE.
//* SOURCE(BCIOPRB) + DEVOBJ(BCPLIO), NO BCPLMAIN OR PROD OBJ.
//ASMPROB EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(300,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,100))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,100))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&PROBOBJ,UNIT=SYSDA,
//             SPACE=(80,(80,40)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.SOURCE(BCIOPRB),DISP=SHR
//*
//LKED     EXEC PGM=IEWL,COND=(0,NE,ASMPROB),
//             PARM='LIST,XREF,MAP,LET,NCAL'
//SYSPRINT DD SYSOUT=*
//SYSLMOD  DD DSN=&&PROGLM,UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),DISP=(NEW,PASS),
//             DCB=(RECFM=U,BLKSIZE=32760)
//SYSLIN   DD DSN=&&PROBOBJ,DISP=(OLD,DELETE)
//         DD *
 INCLUDE OBJ(BCPLIO)
 ENTRY BCIOPRB
 NAME BCIOPRB(R)
/*
//OBJ      DD DSN=HERC02.BCPL.DEVOBJ,DISP=SHR
//*
//GO       EXEC PGM=*.LKED.SYSLMOD,COND=(0,NE,LKED)
//SYSPRINT DD SYSOUT=*,DCB=(RECFM=FB,LRECL=132,BLKSIZE=132)
//SYSUDUMP DD SYSOUT=*
//
