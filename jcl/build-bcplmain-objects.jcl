//* BLDBMAIN -- MVS-RESIDENT ASSEMBLY OF BCPLMAIN AND BCPLMEM
//* SOURCE: HERC02.BCPL.SOURCE(BCPLMAIN,BCPLMEM)
//* GATE D: INSTALL BOTH OBJECTS ONLY AFTER CLEAN ASSEMBLY.
//* IEBGENER COPIES BINARY FB80 RECORDS; DO NOT USE DSPAL PUT OBJ.
//ASMMMAIN EXEC PGM=IFOX00,REGION=256K,
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&MAINOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.SOURCE(BCPLMAIN),DISP=SHR
//*
//ASMMMEM  EXEC PGM=IFOX00,REGION=256K,
//             COND=(0,NE,ASMMMAIN),
//             PARM='OBJECT,NODECK,LIST,XREF(FULL),ESD,RLD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1700,(600,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSUT3   DD UNIT=SYSDA,SPACE=(1700,(300,50))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&MEMOBJ,UNIT=SYSDA,
//             SPACE=(80,(300,100)),DISP=(NEW,PASS),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DSN=HERC02.BCPL.SOURCE(BCPLMEM),DISP=SHR
//*
//VERIFY   EXEC PGM=IEFBR14,COND=((0,NE,ASMMMAIN),
//             (0,NE,ASMMMEM))
//SYSPRINT DD SYSOUT=*
//*
//* INSTALL BCPLMAIN ONLY WHEN BOTH ASSEMBLIES RETURN ZERO.
//PUTMAIN  EXEC PGM=IEBGENER,
//             COND=((0,NE,ASMMMAIN),(0,NE,ASMMMEM))
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&MAINOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.OBJ(BCPLMAIN),DISP=SHR
//*
//* INSTALL BCPLMEM ONLY AFTER SUCCESSFUL BCPLMAIN INSTALL.
//PUTMEM   EXEC PGM=IEBGENER,
//             COND=((0,NE,ASMMMAIN),(0,NE,ASMMMEM),
//             (0,NE,PUTMAIN))
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&MEMOBJ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=HERC02.BCPL.OBJ(BCPLMEM),DISP=SHR
