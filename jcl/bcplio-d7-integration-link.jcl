//* D7LINK -- M2.1 GATE B DEVELOPMENT LINK-MAP PROBE.
//* INCLUDES DEVOBJ(BCPLM7) + INDEPENDENT RUNTIME MEMBERS.
//* D6 AND PRODUCTION OBJ UNCHANGED; NO GO STEP.
//LKED     EXEC PGM=IEWL,PARM='LIST,XREF,MAP,LET,NCAL'
//SYSPRINT DD SYSOUT=*
//SYSLMOD  DD DSN=&&D7LM(D7LINK),UNIT=SYSDA,
//             SPACE=(1024,(40,20,1)),DISP=(NEW,PASS)
//OBJ      DD DSN=HERC02.BCPL.DEVOBJ,DISP=SHR
//SYSLIN   DD *
 INCLUDE OBJ(BCPLM7)
 INCLUDE OBJ(BCPLIO)
 INCLUDE OBJ(BCPLMEM)
 INCLUDE OBJ(BCPLBYTE)
 INCLUDE OBJ(BCPLAPT)
 INCLUDE OBJ(BLIB)
 ENTRY BCPLMAIN
 NAME D7LINK(R)
