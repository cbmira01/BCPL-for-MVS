// HANOI.BCPL
// Solve the Towers of Hanoi recursively.

GLOBAL $( START:1; WRITEF:76 $)

LET MOVE(N, SRC, DST, AUX) BE
$( IF N=0 RETURN
   MOVE(N-1, SRC, AUX, DST)
   WRITEF("MOVE DISK %N FROM %C TO %C*N", N, SRC, DST)
   MOVE(N-1, AUX, DST, SRC)
$)

AND START() BE
$( WRITEF("TOWERS OF HANOI - FOUR DISKS*N")
   MOVE(4, 'A', 'C', 'B')
   FINISH
$)
