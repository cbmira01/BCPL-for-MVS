// DEMO.BCPL
// Demonstrate deterministic use of suite/random/random.bcpl.

GLOBAL $(
START:1
WRITEF:76
RANDSEED:190
RAND:191
RANDRANGE:192
$)

LET START() BE
$( RANDSEED(1)
   WRITEF("FIRST FIVE RAND VALUES:*N")
   FOR I = 1 TO 5 DO WRITEF("%N*N", RAND())

   RANDSEED(12345)
   WRITEF("TEN VALUES IN 0..99:*N")
   FOR I = 1 TO 10 DO WRITEF("%N*N", RANDRANGE(100))

   FINISH
$)
