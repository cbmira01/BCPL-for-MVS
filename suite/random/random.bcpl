// RANDOM.BCPL
//
// Small reusable pseudo-random number generator for the demonstration suite.
// Implements the Park-Miller "minimal standard" generator using Schrage's
// method, so the multiplication does not require signed 32-bit overflow.
//
// Interface:
//   RANDSEED(N)   Set the generator state.  Zero and negative seeds are
//                 normalized into the valid range 1..2147483646.
//   RAND()        Return the next value in 1..2147483646.
//   RANDRANGE(N)  Return a value in 0..N-1.  Returns 0 if N<=0.
//
// GLOBAL slots 190..193 are reserved by this module within the suite.

GLOBAL $(
RANDSEED:190
RAND:191
RANDRANGE:192
RANDSTATE:193
$)

LET RANDSEED(N) BE
$( N := N REM 2147483647
   IF N<0 DO N := -N
   IF N=0 DO N := 1
   RANDSTATE := N
$)

AND RAND() = VALOF
$( LET HI = RANDSTATE / 127773
   AND LO = RANDSTATE REM 127773
   AND T = 16807*LO - 2836*HI

   IF T<=0 DO T := T + 2147483647
   RANDSTATE := T
   RESULTIS T
$)

AND RANDRANGE(N) = N<=0 -> 0, RAND() REM N
