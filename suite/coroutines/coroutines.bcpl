// COROUTINES.BCPL
//
// Demonstrate the reconstructed BCPL coroutine runtime as a simple generator.
// A coroutine preserves its local FOR-loop state while repeatedly yielding
// values to the root coroutine with COWAIT.

GLOBAL $(
START:1
CURRCO:7
COLIST:8
WRITEF:76
HEAPINIT:89
CREATECO:91
DELETECO:92
CALLCO:93
COWAIT:94
$)

LET GENERATOR(IGNORED) = VALOF
$( FOR N = 1 TO 5 DO
   $( WRITEF("  GENERATOR YIELDS %N*N", N)
      COWAIT(N)
   $)

   COWAIT(-1)
   RESULTIS 0
$)

AND START() BE
$( LET ROOT = VEC 2
   AND ARENA = VEC 400
   AND GEN = 0
   AND VALUE = 0
   AND DONE = FALSE

   HEAPINIT(ARENA, 401)

   CURRCO := ROOT
   ROOT!0 := 0
   ROOT!1 := -1
   ROOT!2 := 0
   COLIST := ROOT

   WRITEF("COROUTINE GENERATOR DEMO*N")

   GEN := CREATECO(GENERATOR, 100)
   IF GEN = 0 DO
   $( WRITEF("CREATECO FAILED*N")
      FINISH
   $)

   WRITEF("ROOT CREATED GENERATOR*N")

   UNTIL DONE DO
   $( VALUE := CALLCO(GEN, 0)
      TEST VALUE = -1
      THEN DONE := TRUE
      OR WRITEF("ROOT RECEIVED %N*N", VALUE)
   $)

   WRITEF("GENERATOR FINISHED*N")

   TEST DELETECO(GEN)
   THEN WRITEF("GENERATOR DELETED*N")
   OR WRITEF("DELETECO FAILED*N")

   FINISH
$)
