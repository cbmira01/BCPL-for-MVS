// Q.5 test-only geometry preflight: no unsafe QSAM OPEN on rejected DDs.
// Q00 is the independent valid F1024 input, Q01 omits GO-step DCB.
// FAIL IDs: 10-11 Q00, 20-21 QBAD, 30-31 QBIG, 40-41 Q01.
// FAIL IDs: 50-52 INFO, 60-61 READ, 70-71 CLOSE.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          WRITEF:76; QSAMSVC:200 $)
LET FAIL(N,V) BE
$(1
    WRITEF("Q5G FAIL %N VALUE=%N",N,V)
    NEWLINE()
    STOP(12)
$)1
LET START() BE
$(1
    LET Q = VEC 3
    LET R = VEC 7
    LET B = VEC 255
    LET H0 = 0
    LET RC = 0
    Q!1 := 1
    Q!2 := 0
    Q!3 := 0
    Q!0 := "Q00"
    RC := QSAMSVC(1,Q,R)
    IF RC NE 0 DO FAIL(10,RC)
    H0 := R!1
    IF H0 NE 1 DO FAIL(11,H0)
    // Blocked fixed geometry must be an integral LRECL multiple.
    Q!0 := "QBAD"
    RC := QSAMSVC(1,Q,R)
    IF RC NE -6 DO FAIL(20,RC)
    IF R!0 NE -6 | R!1 NE 0 DO FAIL(21,R!0)
    // F1025 exceeds the supported private 1024-byte stage ceiling.
    Q!0 := "QBIG"
    RC := QSAMSVC(1,Q,R)
    IF RC NE -6 DO FAIL(30,RC)
    IF R!0 NE -6 | R!1 NE 0 DO FAIL(31,R!0)
    // Existing Q01 has no usable explicit GO-step JFCB geometry.
    Q!0 := "Q01"
    RC := QSAMSVC(1,Q,R)
    IF RC NE -6 DO FAIL(40,RC)
    IF R!0 NE -6 | R!1 NE 0 DO FAIL(41,R!0)
    // All three failures must leave Q00's public handle intact.
    Q!0 := H0
    Q!1 := 0
    RC := QSAMSVC(5,Q,R)
    IF RC NE 0 DO FAIL(50,RC)
    IF R!4 NE 1 | R!5 NE 1024 DO FAIL(51,R!4)
    IF R!6 NE 1024 | R!7 NE 1024 DO FAIL(52,R!6)
    Q!1 := B
    Q!2 := 1024
    RC := QSAMSVC(2,Q,R)
    IF RC NE 0 DO FAIL(60,RC)
    IF R!1 NE 1024 DO FAIL(61,R!1)
    Q!1 := 0
    Q!2 := 0
    RC := QSAMSVC(4,Q,R)
    IF RC NE 0 DO FAIL(70,RC)
    IF R!0 NE 0 DO FAIL(71,R!0)
    WRITES("BCPLQSAM Q5 GEOMETRY NEGATIVE PASS")
    NEWLINE()
    FINISH
$)1
