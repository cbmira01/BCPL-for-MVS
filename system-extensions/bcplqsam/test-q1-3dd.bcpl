// Q.1 preliminary native 3-DD caller; DDs Q00/Q01/Q02.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63; QSAMSVC:200 $)
LET START() BE
$(1
    LET Q = VEC 3
    LET R = VEC 7
    LET I = VEC 5
    LET H = VEC 2
    I!0 := 707
    I!5 := 909
    IF QSAMSVC(0,0,0) NE 6 DO STOP(8)
    IF QSAMSVC(0,I,5) NE -1 DO STOP(8)
    IF I!0 NE 707 | I!5 NE 909 DO STOP(8)
    IF QSAMSVC(0,0,6) NE -3 DO STOP(8)
    IF QSAMSVC(0,I,6) NE 6 DO STOP(8)
    IF I!0 NE 1 | I!1 NE 1 | I!2 NE 0 DO STOP(8)
    IF I!3 NE 6 | I!4 NE 25 | I!5 NE 0 DO STOP(8)
    IF QSAMSVC(2,0,0) NE -2 DO STOP(8)
    IF QSAMSVC(3,0,0) NE -2 DO STOP(8)
    Q!1 := 1
    Q!2 := 0
    Q!3 := 0
    Q!0 := "Q00"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!0 := R!1
    Q!0 := "Q01"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!1 := R!1
    Q!0 := "Q02"
    IF QSAMSVC(1,Q,R) NE 0 DO STOP(8)
    H!2 := R!1
    Q!0 := H!1
    Q!1 := 0
    IF QSAMSVC(5,Q,R) NE 0 DO STOP(8)
    IF R!4 NE 1 | R!5 NE 1024 DO STOP(8)
    IF R!6 NE 1024 | R!7 NE 1024 DO STOP(8)
    IF QSAMSVC(4,Q,R) NE 0 DO STOP(8)
    IF QSAMSVC(4,Q,R) NE -7 DO STOP(8)
    Q!0 := H!0
    IF QSAMSVC(4,Q,R) NE 0 DO STOP(8)
    Q!0 := H!2
    IF QSAMSVC(4,Q,R) NE 0 DO STOP(8)
    WRITES("BCPLQSAM Q1 THREE DD PASS")
    NEWLINE()
    FINISH
$)1
