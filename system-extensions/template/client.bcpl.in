// Optional extension client using declared G!N, not an export trailer.
// This is an instantiation template, not a linked or tested program.
GLOBAL $( START:1; STOP:30; WRITES:60; NEWLINE:63;
          @SERVICE@:@GLOBAL@ $)
MANIFEST $( TM_QUERY=0; TM_GETVALUES=1; TM_MAJOR=1;
           TM_MINOR=0; TM_QUERY_WORDS=6; TM_VALUE_WORDS=3 $)

LET START() BE
$(1
    LET INFO = VEC 6
    LET VALUES = VEC 3

    IF @SERVICE@(TM_QUERY,0,0) NE TM_QUERY_WORDS DO STOP(8)
    INFO!0 := 777
    INFO!6 := 777
    IF @SERVICE@(TM_QUERY,INFO,5) NE -1 DO STOP(8)
    IF INFO!0 NE 777 | INFO!6 NE 777 DO STOP(8)
    IF @SERVICE@(TM_QUERY,INFO,TM_QUERY_WORDS) NE 6 DO STOP(8)
    IF INFO!0 NE 1 | INFO!1 NE TM_MAJOR DO STOP(8)
    IF INFO!2 NE TM_MINOR | INFO!3 NE 6 DO STOP(8)
    IF INFO!4 NE 1 | INFO!5 NE 0 DO STOP(8)
    IF INFO!6 NE 777 DO STOP(8)

    VALUES!3 := 777
    IF @SERVICE@(TM_GETVALUES,VALUES,TM_VALUE_WORDS) NE 3
       DO STOP(8)
    IF VALUES!0 NE 10 | VALUES!1 NE 20 DO STOP(8)
    IF VALUES!2 NE 30 | VALUES!3 NE 777 DO STOP(8)
    IF @SERVICE@(2,0,0) NE -2 DO STOP(8)

    WRITES("R3 TEMPLATE CLIENT PASS")
    NEWLINE()
    FINISH
$)1
