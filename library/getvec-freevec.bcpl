// GETVEC-FREEVEC.BCPL
//
// Reconstructed fixed-arena BCPL allocator for the MR10 bootstrap runtime.
//
// The MR10 bootstrap LIBHDR currently ends its machine-dependent service
// assignments at GETBYTE:85 and PUTBYTE:86.  This reconstruction therefore
// uses the following provisional runtime globals:
//
//     GETVEC:87
//     FREEVEC:88
//     HEAPINIT:89
//     FREEHEAD:90
//
// HEAPINIT(BASE, WORDS) supplies an already BCPL-addressable arena.  This
// keeps allocation policy in portable BCPL and avoids changing ICINT's V12
// pointer representation.
//
// Free-block format, in BCPL words:
//
//     B!0 = total block size including this two-word header
//     B!1 = next free block, or 0
//
// GETVEC(N) returns B+2 and supplies N+1 payload words, matching VEC N.
// FREEVEC(V) reinserts by address and coalesces adjacent free blocks.

GLOBAL $(
GETVEC:87
FREEVEC:88
HEAPINIT:89
FREEHEAD:90
$)

LET HEAPINIT(BASE, WORDS) BE
$( FREEHEAD := 0

   IF BASE = 0 RETURN
   IF WORDS < 3 RETURN

   BASE!0 := WORDS
   BASE!1 := 0
   FREEHEAD := BASE
$)

AND GETVEC(N) = VALOF
$( LET NEED = N+3
   AND PREV = 0
   AND B = FREEHEAD

   IF N < 0 RESULTIS 0

   UNTIL B = 0 DO
   $( LET SIZE = B!0

      IF SIZE >= NEED DO
      $( LET LEFT = SIZE-NEED

         IF LEFT >= 3 DO
         $( LET REST = B+NEED
            REST!0 := LEFT
            REST!1 := B!1

            IF PREV = 0 DO FREEHEAD := REST
            IF PREV \= 0 DO PREV!1 := REST

            B!0 := NEED
            B!1 := 0
            RESULTIS B+2
         $)

         IF PREV = 0 DO FREEHEAD := B!1
         IF PREV \= 0 DO PREV!1 := B!1

         B!1 := 0
         RESULTIS B+2
      $)

      PREV := B
      B := B!1
   $)

   RESULTIS 0
$)

AND FREEVEC(V) BE
$( LET B = V-2
   AND PREV = 0
   AND NEXT = FREEHEAD
   AND SEARCHING = TRUE

   IF V = 0 RETURN

   UNTIL NEXT = 0 | ~SEARCHING DO
   $( TEST NEXT > B
      THEN SEARCHING := FALSE
      OR
      $( PREV := NEXT
         NEXT := NEXT!1
      $)
   $)

   B!1 := NEXT

   IF PREV = 0 DO FREEHEAD := B
   IF PREV \= 0 DO PREV!1 := B

   IF NEXT \= 0 DO
      IF B+B!0 = NEXT DO
      $( B!0 := B!0 + NEXT!0
         B!1 := NEXT!1
      $)

   IF PREV \= 0 DO
      IF PREV+PREV!0 = B DO
      $( PREV!0 := PREV!0 + B!0
         PREV!1 := B!1
      $)
$)
